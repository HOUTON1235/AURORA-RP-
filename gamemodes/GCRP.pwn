CMD:desbanip(playerid, params[])
{
	if(Pp[playerid][Admin] >= 2)
	{
    	new IP[30 + 1], string[450];
    	if(sscanf(params, "s[30]", IP)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /desbanip [ip]");
    	format(string, sizeof(string), "BanidosIp/%s.ini", IP);
    	if(DOF2_FileExists(string))
		{
		    DOF2_RemoveFile(string);
		    SCM(playerid, -1, "{FFFFFF}IP desbanido com sucesso.");
		    return 1;
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este IP nao esta banido ou voce digitou errado!");
		    return 1;
		}
	}
    return 1;
}

