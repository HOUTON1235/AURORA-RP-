CMD:cnn(playerid, params[])
{
	new msg[5000];
	if(Pp[playerid][Admin] >= 4)
	{
		if(sscanf(params,"s[5000]",msg))return SCM(playerid, -1,"{FFD700}INFO: {FFFFFF}Use: /cnn [anuncio].");
	    {
            // Funcional da Escrita
            new str[6000];
            format(str,sizeof(str),"%s", msg);
            for(new i; i < MAX_PLAYERS; i++)
            {
                PlayerTextDrawSetString(i, TextDrawAviso2[i][0], str);
                PlayerTextDrawShow(i, TextDrawAviso2[i][0]);
                SetTimerEx("TirarTD2", 10000, false, "i", i);
            }
            GameTextForAll("~w~Admin ~p~GCRP", 3000, 15);
	    }
	}
	return 1;
}
CMD:continuar(playerid)
{
	if(PodeContinuar[playerid] == false)
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pode voltar mais a sua ultima posicao.");
	}
	else if(PodeContinuar[playerid] == true)
	{
		SetPlayerInterior(playerid, Pp[playerid][Interior]);
		SetPlayerVirtualWorld(playerid, Pp[playerid][VirtualW]);
		SetPlayerPos(playerid, Pp[playerid][PosX], Pp[playerid][PosY], Pp[playerid][PosZ]);
		PodeContinuar[playerid] = false;
		//Continuar
		SetTimerEx("CarregandoObjetos", 5000, false, "d", playerid);
        for(new i = 1; i < 3; i++){PlayerTextDrawShow(playerid, TdCarregarINT[playerid][i]);}
		Controle(playerid, 1);
	}
	return 1;
}
CMD:saquear(playerid, params[])
{
	if(IsBandido(playerid))
	{
	    new id, grana, String[220], string[450];
		if(sscanf(params,"ii",id, grana))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /saquear [IDF] [GRANA]");
		{
      		for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
					    if(id == Pp[playerid][IDF])
						{
							SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode Saquear a se Mesmo!");
							return true;
						}
                        if(Pp[i][Ferido] == true)
                        {
    					    new Float:x,Float:y,Float:z;
    						GetPlayerPos(i,x,y,z);
    						if(ISP(playerid,5,x,y,z))
    						{
                                if(GetPlayerMoney(i) >= grana)
    							{
                                    if(grana < 5000)
                                    {
			                            format(string, sizeof(string), "* O ID: [%d] Saqueou o Jogador ID:[%d]", Pp[playerid][IDF], Pp[i][IDF]);
	   		                            ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
    									SendClientMessageEx(playerid,-1,"{FFFFFF}Voce saqueou o Player: %s[%d] e Pegou: {00FF00}R$%d {FFFFFF}Do Bolso Dele", PlayerName(i), Pp[i][IDF], grana);
    									GivePlayerCash(playerid,grana);
    									GivePlayerCash(i,-grana);
    									ApplyAnimation(playerid, "CARRY", "liftup", 3.0, 0, 0, 0, 0, 0);
    								}
    								else
    								{
    									SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce so pode saquear ate 5 mil!");
    								}
    							}
    							else
    							{
    							    format(String,sizeof(String),"{FFFFFF}Este Player %s[%d] Tem {00FF00}R$%d\n{FFFFFF}Para Saquear Use: /saquear %d",PlayerName(i),Pp[i][IDF],GetPlayerMoney(i));
    								ShowPlayerDialog(playerid,5000,DIALOG_STYLE_MSGBOX,"{FFFFFF}Money Roubo {FFDC33}GCRP",String,"Ok","");
    							    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Nao tem esse Dinheiro");
    							    return 1;
    							}
    						}
    						else
    						{
    						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a este player");
    						}
                        }
                        else
                        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Nao esta Ferido");
                        }
					}
				}
			}
			return 1;
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e de Org");
	}
	return 1;
}
CMD:jogardrogas(playerid,params[])
{
	if(IsPlayerConnected(playerid))
	{
        if(Pp[playerid][Droga] >= 1)
        {
	       	new quemenviou[1500];
	        format(quemenviou, sizeof(quemenviou), "{FFFFFF}Voce jogou %d Gramas de Drogas no Chao", Pp[playerid][Droga]);
	        SCM(playerid, - 1,quemenviou);
	        new string[10000];
            format(string, sizeof(string), "* O ID:[%d] Jogou %dg de Drogas Fora", Pp[playerid][IDF], Pp[playerid][Droga]);
            ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
	        Pp[playerid][Droga] = 0;
	        SalvarDados(playerid);
	        ApplyAnimation(playerid, "CARRY", "liftup", 3.0, 0, 0, 0, 0, 0);
        }
        else
        {
	        SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao tem Drogas");
	        return 1;
        }
	}else return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao esta conectado");
	return 1;
}
CMD:removerarmas(playerid, params[])
{
	new id;
	if(IsPolicial(playerid))
	{
	    if(sscanf(params,"i",id))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /removerarmas [IDF]");
	    {
   			for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
				        if(id == Pp[playerid][IDF])
						{
				 			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Remover Drogas!");
						 	return 1;
						}
						new Float:x,Float:y,Float:z;
						GetPlayerPos(i,x,y,z);
						if(ISP(playerid,5,x,y,z))
						{
							new string[10000];
					        SendClientMessageEx(playerid, -1, "{FFFFFF}Voce Removeu As Armas do Jogador: %s, Bom Trabalho", PlayerName(i));
			    			format(string, sizeof(string), "* O ID:[%d] Removeu as Armas do ID:[%d]", Pp[playerid][IDF], Pp[i][IDF]);
			   				ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
						    ResetPlayerWeapons(i);
						    return 1;
                        }
						else
						{
						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a este player");
						}
				    }
				}
			}
			return 1;
		}
 	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e de Corp");
	    return 1;
	}
}

CMD:venderdroga(playerid, params[])
{
	new id, gramas;
	if(sscanf(params,"ii",id,gramas))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /venderdroga [IDF] [GRAMAS]");
 	{
    	for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
			        if(id == Pp[playerid][IDF])
					{
						SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Vender Drogas!");
					 	return 1;
					}
					if(Pp[playerid][Droga] >= 1)
					{
				        if(Pp[i][Droga] < 5000)
				        {
				            new Float:x,Float:y,Float:z;
							GetPlayerPos(i,x,y,z);
							if(ISP(playerid,5,x,y,z))
							{
								new string[10000];
						        SendClientMessageEx(playerid, -1, "{FFFFFF}Voce Vendeu %d Gramas de Droga Para o Player: %s", gramas, PlayerName(i));
							    format(string, sizeof(string), "* O ID:[%d] Vendeu Drogas Para o ID:[%d]", Pp[playerid][IDF], Pp[i][IDF]);
				    			ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
							    Pp[i][Droga] += gramas;
							    Pp[playerid][Droga] -= gramas;
							    return 1;
	                        }
							else
							{
							    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a este player");
							}
						}
						else
						{
						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Nao Ter mais de 5kg de Drogas.");
						    return 1;
						}
					}
					else
					{
					    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce tem que ter pelo menos 1g de Droga.");
				    	return 1;
					}
			    }
			}
		}
		return 1;
	}
}
CMD:procurados(playerid, params[])
{
    if(IsPolicial(playerid))
	{
		new IsVip, String[220];
	    SCM(playerid, -1, "{48D1CC}=-=-=-=-=-= {FFFFFF}[Procurados] {48D1CC}=-=-=-=-=-=");
	    for(new i = 0; i < MAX_PLAYERS; ++i)
	    {
	        if(GetPlayerWantedLevel(i) >= 1)
	        {
				format(String, sizeof(String), "{FFFFFF}Nome: %s[%d] | Nivel: (%d) de procurado", PlayerName(i), Pp[i][IDF], GetPlayerWantedLevel(i));
				SCM(playerid, -1, String);
				IsVip++;
			}
		}
		if(IsVip == 0)
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Nenhum Procurado online.");
		}
		IsVip = 0;
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e de Corp");
	}
	return 1;
}
CMD:localizarp(playerid, params[])
{
	if(IsPolicial(playerid))
	{
	    new id;
	    if(sscanf(params,"i",id))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /localizarp [IDF]");
	    {
      		for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
						if(id == Pp[playerid][IDF])
						{
							SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode Procurar a se Mesmo!");
							return true;
						}
                        if(UsouLocalizar[playerid] == 0)
                        {
    						if(GetPlayerWantedLevel(i) >= 1)
    						{
    			     			if(GetPlayerInterior(i) != GetPlayerInterior(playerid))
    							{
    								SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Esta Em Um Interior, Por Isso Nao Pode Ser Procurado");
    				   				return true;
    			 				}
    			 				new string[450];
    							DisablePlayerCheckpoint(playerid);
    							DisablePlayerRaceCheckpoint(playerid);
    							KillTimer(timer[playerid]);
                                UsouLocalizar[playerid] = 1;
                                SetTimerEx("TempoSairLoc", 300000, 0, "i", playerid);
    							new Float:x,Float:y,Float:z;
    							GetPlayerPos(i, x,y,z);
    							SetPlayerCheckpoint(playerid, x,y,z, 5);
    							SCM(playerid, -1, "{FFFFFF}Este Criminoso Foi Localizado Em Seu Mapa!");///procurar
                                GameTextForPlayer(playerid, "~w~Computador de ~b~bordo", 1200, 1);
    							format(string, sizeof(string), "* O ID:[%d] Ligou o Computador de Bordo e Localizou o Player %s[%d}", Pp[playerid][IDF], PlayerName(i), Pp[i][IDF]);
    							ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
    							timer[playerid] = SetTimerEx("TempoDeAttLoc", 100, true, "ii", playerid, i);
    							return 1;
    						}
    						else
    						{
    						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Nao Esta Procurado!");
    						}
                        }
                        else
                        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce so pode localizar novamente apos 5 minutos.");
                        }
					}
				}
			}
			return 1;
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e de Corp");
	}
	return 1;
}
CMD:fumar(playerid)
{
	if(Pp[playerid][Droga] >= 3)
	{
	    new Float:armour;
	    GetPlayerArmour(playerid, Float:armour);
		if(armour < 100)
		{
			new string[10000], Float:ColeteP[MAX_PLAYERS];
			ColeteP[playerid] = armour;
			ColeteP[playerid] += 15;
		    format(string, sizeof(string), "* O ID:[%d] Fumou 3 Gramas de Drogas", Pp[playerid][IDF]);
			ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
		    Pp[playerid][Droga] -= 3;
			SetPlayerArmour(playerid, ColeteP[playerid]);
		    ApplyAnimation(playerid,"GANGS","smkcig_prtl",4.1,0,1,1,1,1);
		    SetTimerEx("DCANIM", 5000, false, "d", playerid);
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja esta muito Louco, e com isso nao pode fumar mais...");
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce precisa ter no Minimo 3 Gramas de Drogas Para Poder Fumar");
	}
    return 1;
}

CMD:usarkit(playerid)
{
	if(Pp[playerid][TemKit] >= 1)
	{
	    new Float:vidapp;
	    GetPlayerHealth(playerid, Float:vidapp);
		if(vidapp < 100)
		{
			new string[10000], Float:VidaP[MAX_PLAYERS];
			VidaP[playerid] = vidapp;
			VidaP[playerid] += 30;
		    format(string, sizeof(string), "* O ID:[%d] Usou um Medkit", Pp[playerid][IDF]);
			ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
		    Pp[playerid][TemKit] -= 1;
			SetPlayerHealth(playerid, VidaP[playerid]);
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao precisa usar Medkit");
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem mais Medkit");
	}
    return 1;
}
CMD:darkit(playerid, params[])
{
	if(Pp[playerid][TemKit] >= 1)
	{
		new id, string[450];
		if(sscanf(params, "i", id))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /darkit [IDF]");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
                {
                    new Float:X, Float:Y, Float:Z;
                    GetPlayerPos(i, X, Y, Z);
					if(ISP(playerid, 3.0, X, Y, Z))
					{
    			        if(id == Pp[playerid][IDF])
    			        {
    						SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Transferir medkits");
    			        }
                        else if(Pp[i][TemKit] >= 3)
                        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player ja tem 3 MedKits!");
                            return 1;
                        }
                        else if(Pp[i][TemKit] <= 2)
                        {
                            Pp[playerid][TemKit] -= 1;
                            Pp[i][TemKit] += 1;
                            GameTextForPlayer(playerid, "~w~Voce deu um ~r~Medkit", 3000, 4);
                            GameTextForPlayer(playerid, "~w~Alguem deu um Medkit a Voce!", 3000, 4);
                            SCM(playerid, -1, "{FFFFFF}Voce entregou um medkit a Alguem");
                            SCM(i, -1, "{FFFFFF}Voce recebeu um medkit em suas maos, = /usarkit");
        	                format(string, sizeof(string), "* O ID:[%d] entregou um medkit ao ID:[%d]", Pp[playerid][IDF], Pp[i][IDF]);
                            ProxDetector(20.0, playerid, string, COR_PURPLE, COR_PURPLE, COR_PURPLE,COR_PURPLE,COR_PURPLE);
                        }
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a este player");
                    }
                }
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem MedKits");
    }
    return 1;
}

CMD:levantar(playerid, params[])
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
	if(Pp[playerid][TemKit] >= 1)
    {
        if(Pp[playerid][Logado] == true)
        {
            new id;
			if(sscanf(params,"i",id)) return SCM(playerid,COR_VERMELHO,"{FFD700}INFO: {FFFFFF}Use: /levantar [IDF]");
			{
       			for(new i; i < MAX_PLAYERS; i++)
				{
					if(Pp[i][Logado] == true)
					{
					    if(Pp[i][IDF] == id)
					    {
					        if(id == Pp[playerid][IDF])
					        {
								SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se levantar");
					        }
						    if(Pp[i][Ferido] == true)
						    {
                                new Float:x,Float:y,Float:z;
    							GetPlayerPos(i,x,y,z);
    							if(ISP(playerid,5,x,y,z))
    							{
    						        new string[1200];
    								format(string, sizeof(string), "* O ID:[%d] esta tentando levantar o jogador ID:[%d].", Pp[playerid][IDF], Pp[i][IDF]);
    							    ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                                    Pp[playerid][TemKit] -= 1;
    								ApplyAnimation(playerid, "MEDIC", "CPR", 4.0, 1, 0, 0, 0, 0);
    								SetTimerEx("DCANIM", 10000, false, "i", playerid);
    								SetTimerEx("DCANIM", 10001, false, "i", i);
    								SetTimerEx("Levantar", 10001, false, "i", i);
                                    GameTextForPlayer(playerid, "~w~levantando", 1200, 1);
    								return 1;
                                }
                                else
    							{
    							    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Nao esta Proximo a Voce..");
    							}
							}
							else
							{
							    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Nao esta Ferido..");
							}
						}
					}
				}
				return 1;
			}
		}
	}
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce precisa ter pelo menos um Medkit, se nao tem, va ao hospital.");
    }
	return 1;
}

