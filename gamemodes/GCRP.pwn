					format(String,sizeof(String),"* O ID:[%d] Esta Lavando Dinheiro Sujo...",Pp[playerid][IDF]);
					ProxDetector(15.0, playerid, String, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
				}
                else if(Pp[playerid][Droga] > 10)
				{
                    new stg[5000];
                    strcat(stg,  "{FFD700}1. {FFFFFF}Lavar meu Dinheiro\t\t{00FF00}[Disponivel, Chara!]\n");
                    strcat(stg,  "{FFD700}2. {FFFFFF}Vender Droga\t\t{00FF00}[Disponivel, Chara!]\n");
                    strcat(stg,  "{FFD700}3. {FFFFFF}Vender Celular Roubado\t\t{00FF00}[Disponivel, Chara!]\n");
                    ShowPlayerDialog(playerid, DIALOG_MENUBOT, DIALOG_STYLE_LIST, "O que Voce me Oferece?", stg, "Selecionar", "X");
                    new String[220], string[450], granaa = 150 + random(300);
				    GameTextForPlayer(playerid, "~w~Droga ~g~Vendida!", 2000, 3);
                    SendClientMessageEx(playerid, -1, "{FFDC33}[ MENU-BOT ]: {FFFFFF}Voce vendeu: %dg por {00FF00}R$%d", Pp[playerid][Droga], granaa);
					format(String,sizeof(String),"* O ID:[%d] Esta Lavando Dinheiro Sujo...",Pp[playerid][IDF]);
					ProxDetector(15.0, playerid, String, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                    Pp[playerid][Droga] = 0;
                    GivePlayerCash(playerid, granaa);
                    ApplyAnimation(playerid, "CARRY", "putdwn", 3.0, 0, 0, 0, 0, 0);
                }
                else
                {
                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem droga o suficiente!");
                }
			}
            if(listitem == 2)
			{
                if(Pp[playerid][Celulares] >= 5)
