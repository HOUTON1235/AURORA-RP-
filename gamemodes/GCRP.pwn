CMD:setcarro(playerid, params[])
{
	if(Pp[playerid][Admin] >= 6)
	{
		new id, VehId, Slot, Str[6000];
		if(sscanf(params, "ddd", id, VehId, Slot))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /setcarro [IDF] [Id do Veiculo] [Slot 1 - 10]");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
                    if(Slots[i][Slot] == 1)  return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Jogador Ja Tem Um Veiculo Nesse Slot!");
     	            {
                        if(Slot > 10 || Slot < 1 ) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use Somente Slots de 1 a 10!." );
                        {
                            if(VehId > 611 || VehId < 400 ) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use Somente Veiculos de 400 a 611!." );
                            {
                                Slots[i][Slot] = VehId;
       	                        PlayerTextDrawSetPreviewModel(i, InvCarTDP[i][Slot], VehId);
                                format(Str, sizeof(Str), "{48D1CC}Info-Inventario: {FFFFFF}Voce Colocou O Veiculo ID:[%d] no Slot: %d do Jogador: %s", VehId, Slot, PlayerName(i));
                                SendClientMessage(playerid,-1, Str);
                                format(Str, sizeof(Str), "{48D1CC}Info-Inventario: {FFFFFF}O Admin: %s Setou um Veiculo de Inventario em Voce! Infos: VehID:[%d] - Slot %d", PlayerName(playerid), VehId, Slot);
                                SendClientMessage(i,-1, Str);
                                GameTextForPlayer(playerid, "~w~Veiculo ~g~Setado", 3000, 3);
                                GameTextForPlayer(i, "~w~Veiculo ~g~Setado", 3000, 3);
                            }
                        }
                    }
                }
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um admin com nivel 6+");
    }
    return 1;
}
CMD:pegarcarro(playerid,params[])
{
    if(Pp[playerid][Admin] >= 6)
    {
    	new VehId, Slot, Str[50000];
    	if(sscanf(params, "ii", VehId, Slot)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /pegarcarro [Id Do Veiculo] [Slot]! ");
    	if(Slots[playerid][Slot] ==1)  return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Ja Tem Um Veiculo Nesse Slot!");
     	if(Slot > 10 || Slot < 1 ) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use Somente Slots de 1 a 10!." );
        if(VehId > 611 || VehId < 400 ) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use Somente Veiculos de 400 a 611!." );
    	Slots[playerid][Slot] = VehId;
       	PlayerTextDrawSetPreviewModel(playerid, InvCarTDP[playerid][Slot], VehId);
        format(Str, sizeof(Str), "{48D1CC}Info-Inventario: {FFFFFF}Voce Colocou O Veiculo %d No Slot %d", VehId, Slot);
        SendClientMessage(playerid,-1, Str);
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um admin com nivel 6+");
    }
	return 1;
}
