CallBack:: lockP(playerid)
{
    for(new s;s < MAX_VEHICLES;s++)
	{
		new Float:cx,Float:cy,Float:cz;
		GetVehiclePos(s,cx,cy,cz);
		if(IsPlayerInRangeOfPoint(playerid,3.0,cx,cy,cz))
		{
            RemovePlayerAttachedObject(playerid, 9);
            CarroTrank[s] = 0;
         	CarroInfo[s][ChaveCarro] = 0;
            PutPlayerInVehicle(playerid,s,0);
            GameTextForPlayer(playerid,"~w~Veiculo ~g~Roubado", 2000, 1);
	    }
	}
	return 1;
}

