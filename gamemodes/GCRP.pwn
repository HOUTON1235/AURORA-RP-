                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao bateu seu cartao no Menu da Empresa");
                    }
                }
            }
        }
        for(new i; i < 8; i++)
        {
            if(ISP(playerid, 2.0, MenusDeMercados[i][0], MenusDeMercados[i][1], MenusDeMercados[i][2]))
        	{
                if(Pp[playerid][FezRg] == 1)
