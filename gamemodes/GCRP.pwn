			new MsgOc[5000];
			format(MsgOc, sizeof(MsgOc), "Todas as Unidades, O Suspeito: %s(%d) Roubou a 24/7 Da Morro[LS]", PlayerName(playerid), Pp[playerid][IDF]);
			MsgOcorrencia(MsgOc);
		    RoubandoReg[playerid] = 0;
			ClearAnimations(playerid);
		}
	}
	return 1;
}

CallBack:: TempoPlayerReg(playerid)
{
    if(RoubouReg[playerid] == 1)
    {
	    new string[1200];
