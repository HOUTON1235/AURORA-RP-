	}
	return 1;
}

CMD:delveh(playerid)
{
    if(Pp[playerid][Admin] >= 4)
	{
		if(AcessouMenuCar[playerid] == 1)
		{
			AcessouMenuCar[playerid] = 0;
			DestroyVehicle(CarroEvento[playerid]);
			SCM(playerid, -1, "{FF00FF}: {FFFFFF}Voce deletou um Veiculo Criado..");
		}
		else
		{
		    SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao spawnou nenhum Veiculo.");
		}
	}
	return 1;
}

//PORTAO
CMD:editarptadm(playerid)
{
    if(Pp[playerid][Admin] >= 4)
	{
		for(new x; x != MAX_PORTAO; x++)
		{
		    if(InfoPortao[x][porT] && ISP(playerid, 4.0, InfoPortao[x][XP], InfoPortao[x][YP], InfoPortao[x][ZP]))
			{
		        SCM(playerid, -1, "{FF00FF}: {FFFFFF}Voce esta editando um Portao....");
	            SetPVarInt(playerid, "EDPT", x);
	            EditDynamicObject(playerid, InfoPortao[x][porT]);
	            EditandoPortao[playerid] = true;
				SetPVarInt(playerid, "EditandoPt", 999);
		        return 1;
		    }
		}
		SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce Nao esta perto de nenhum portao");
		return 1;
	}
	return 1;
}
CMD:portaoc(playerid)
{
	for(new x; x != MAX_PORTAO; x++)
	{
        if(Pp[playerid][Admin] >= 4)
	    {
			if(!InfoPortao[x][Cria])
			{
				new Float: X, Float: y, Float: z;
				GetPlayerPos(playerid, X, y, z);
				SetPVarInt(playerid, "EDPT", CriarPt(X,y,z,0,0,0,PlayerName(playerid), PlayerName(playerid)));
	        	return 1;
			}
		}
	}
	return 1;
}

CMD:dportao(playerid, params[])
{
	if(Pp[playerid][Admin] >= 4)
	{
		new id, arquivoCA[5000], mensagem[128];
		if(sscanf(params, "i", id)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /dportao [ID do Portao].");
		{
		    if(ISP(playerid, 15.0, InfoPortao[id][XP], InfoPortao[id][YP], InfoPortao[id][ZP]))
			{
				format(arquivoCA, sizeof(arquivoCA), PASTA_PORTOES, id);
				if(DOF2_FileExists(arquivoCA))
				{
				    DOF2_RemoveFile(arquivoCA);
					format(mensagem, sizeof(mensagem), "{FFFFFF}Voce deletou o Portao id: %d.", id);
				    SCM(playerid, 0xFF0000FF, mensagem);
				    DestroyDynamicObject(InfoPortao[id][porT]);
					InfoPortao[id][XP] = 0;
				    InfoPortao[id][YP] = 0;
					InfoPortao[id][ZP] = 0;
					InfoPortao[id][RXP] = 0;
					InfoPortao[id][RYP] = 0;
					InfoPortao[id][RZP] = 0;
					DestroyDynamic3DTextLabel(InfoPortao[id][PortLabel]);
					return 1;
				}
				else
				{
			        format(mensagem, sizeof(mensagem), "{FFD700}INFO: {FFFFFF}O Portao [%d] Nao Existe nso Arquivos do Servidor.", id);
					SCM(playerid, 0xFF0000FF, mensagem);
				}
			}
			else
			{
			    format(mensagem, sizeof(mensagem), "{FFD700}INFO: {FFFFFF}Voce nao esta Proximo do Portao Id: %d.", id);
				SCM(playerid, 0xFF0000FF, mensagem);
			}
		}
	}
	return 1;
}

CMD:editarpt(playerid)
{
	for(new x; x != MAX_PORTAO; x++)
	{
 		if(InfoPortao[x][Cria] && !strcmp(PlayerName(playerid), InfoPortao[x][Donop], true) && ISP(playerid, 8.0, 	InfoPortao[x][XP], 	InfoPortao[x][YP], 	InfoPortao[x][ZP]))
 		{
 		    SetPVarInt(playerid, "EDPT", x);
   			SCM(playerid, COR_VERMELHO, "{FFFFFF}Voce esta editado um Portao....");
	        EditDynamicObject(playerid,  InfoPortao[GetPVarInt(playerid, "EDPT")][porT]);
	        EditandoPortao[playerid] = true;
	        SetPVarInt(playerid, "EditandoPt", 999);
		    return 1;
 		}
	}
	SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao e dono deste Portao!");
	return 1;
}
CMD:abpt(playerid, params[])
{
	for(new x; x != MAX_PORTAO; x++)
	{
	    new id;
 		if(sscanf(params, "i", id)) return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /abpt [ id do portao ] ");
 		if(!InfoPortao[id][Cria]) return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este portao nao existe ou nao esta criado!");
 		if(!ISP(playerid, 20.0, InfoPortao[id][XP], InfoPortao[id][YP], InfoPortao[id][ZP])) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce esta muito longe deste portao!");
	    SetPVarInt(playerid, "SenhaDop", id);
		ShowPlayerDialog(playerid, DIALOG_SENHAP, DIALOG_STYLE_PASSWORD, "Senha Do {FFD700}Portao", "{FF00FF}: {FFFFFF}Digite a senha do portao no campo abaixo", "ok", "sair");
		return 1;
	}
	return 1;
}

CMD:creditos(playerid)
{
    return MenuCreditos(playerid);
}

//ENVIAR LOCALIZACAO
CMD:evloc(playerid,params[])
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
	new id;
	if(sscanf(params,"i",id)) return SCM(playerid,COR_VERMELHO,"{FFD700}INFO: {FFFFFF}Use: /evloc [IDF]");
 	for(new i; i < MAX_PLAYERS; i++)
	{
		if(Pp[i][Logado] == true)
		{
		    if(Pp[i][IDF] == id)
		    {
			    if(id == Pp[playerid][IDF])
				{
		 			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Enviar uma Localizacao!");
				 	return 1;
				}
                if(CheckCorridaC[i] == 0 && CheckCorridaC2[i] == 0 && CheckCorridaC3[i] == 0 && CheckCorridaC4[i] == 0)
                {
    				new Float:x, Float:y, Float:z, nome[MAX_PLAYER_NAME], quemenviou[256],quemrecebeu[256];
    		   		DisablePlayerCheckpoint(i);
    		   		DisablePlayerRaceCheckpoint(i);
    		  		GetPlayerName(playerid, nome, sizeof(nome));
    		  		format(quemrecebeu,sizeof(quemrecebeu), "{FFD700}[Info-Loc]: {FFFFFF}O Player: %s[%d] Enviou a Localizacao Dele Para Voce.", nome, Pp[playerid][IDF]);
    		  		format(quemenviou, sizeof(quemenviou), "{FFD700}[Info-Loc]: {FFFFFF}Voce Enviou Sua Localizacao Para Um Jogador.");
    		  		SendClientMessage(i,-1,quemrecebeu);
    		  		SCM(playerid, - 1,quemenviou);
    		    	GetPlayerPos(playerid,x,y,z);
    		  		DisablePlayerCheckpoint(i);
    		  		DisablePlayerRaceCheckpoint(i);
    		  		SetPlayerCheckpoint(i, x, y, z, 6);
    		  		CheckPointProfissao[i] = 1;
    		  		return 1;
                }
                else
                {
                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este jogador esta em uma corrida.");
                    return 1;
                }
            }
		}
	}
	return 1;
}
