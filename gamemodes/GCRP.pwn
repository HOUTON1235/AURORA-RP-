stock SalvarInvCars(playerid)
{
	new File[70];
    format(File, sizeof(File), PASTA_CARROSINV, PlayerName(playerid));
    if(DOF2_FileExists(File))
    {
		new query[50];
		for (new i = 1; i <= 10; i++)
		{
            format(query, sizeof(query), "Slot%d", i);
		    DOF2_SetInt(File, query, Slots[playerid][i]);
		    DOF2_SaveFile();
		}
	}
	return 1;
}
stock CarregarInvCar(playerid)
{
	new File[70];
    format(File, sizeof(File), PASTA_CARROSINV, PlayerName(playerid));
    if(DOF2_FileExists(File))
    {
   		new query[50];
		for (new i = 1; i <= 10; i++)
        {
            format(query, sizeof(query), "Slot%d", i);
		    PlayerTextDrawSetPreviewModel(playerid, InvCarTDP[playerid][i],DOF2_GetInt(File, query));
		    Slots[playerid][i] = DOF2_GetInt(File, query);
	    }
	}
	else
    {
    	DOF2_CreateFile(File);
		new query[50];
		for (new i = 1; i <= 10; i++)
		{
		    Slots[playerid][i] =999999;
		    format(query, sizeof(query), "Slot%d", i);
		    DOF2_SetInt(File, query, Slots[playerid][i]);
		    DOF2_SaveFile();
		}
	}
	return 1;
}
