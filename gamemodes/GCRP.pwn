	strfind(PlayerName(playerid), "@", true) != -1 || strfind(PlayerName(playerid), "!", true) != -1 ||  strfind(PlayerName(playerid), ".", true) != -1 || strfind(PlayerName(playerid), "*", true) != -1 || strfind(PlayerName(playerid), "__", true) != -1 ||
