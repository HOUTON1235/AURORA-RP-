stock ShowTextDrawF(playerid)
{
    new String[220], orgid = GetPlayerOrg(playerid), stg[15000];

    format(gstring, sizeof(gstring), "{FFDC33}Nome da Corp:{FFFFFF} %s\n",OrgInfo[orgid][OrgNome]);
    strcat(stg, gstring);
    format(gstring, sizeof(gstring), "{FFDC33}Nome:{FFFFFF} %s\n",PlayerName(playerid));
    strcat(stg, gstring);
    format(gstring, sizeof(gstring), "{FFDC33}Nome do Cargo:{FFFFFF} %s\n",NomeCargo(playerid));
    strcat(stg, gstring);

    ShowPlayerDialog(playerid, 5000, DIALOG_STYLE_LIST, "{FFFFFF}Funcional {FFDC33}Gold City", stg, "Ok", "");

	SCM(playerid, -1, "{FFFFFF}Para desativar o Funcional Use: /tf");
    format(String, sizeof(String), "* O ID:[%d] Retirou da Carteira Seu Documento Dinstintivo", Pp[playerid][IDF]);
    ProxDetector(30.0, playerid, String, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
	return 1;
}

stock RemovePlayerWeapon(playerid, weaponid)
{
	new pWeaponData[13][2];
	for (new i = 0; i < 13; i++)
	{
	    GetPlayerWeaponData(playerid, i, pWeaponData[i][0], pWeaponData[i][1]);
	}

	ResetPlayerWeapons(playerid);
	for(new i=0; i<13; i++)
	{
		if(pWeaponData[i][0] != 0 && pWeaponData[i][0] != weaponid)
		{
			GivePlayerWeapon(playerid, pWeaponData[i][0], pWeaponData[i][1]);
		}
	}
	return 0;
}

//MOCHILA - ARMAS
stock GuardarItem(playerid)
{
	new Item = GetPlayerWeapon(playerid);
	new Ammo = GetPlayerAmmo(playerid);
	if(Item == 0) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode Guardar Sua Mao na Mochila.");
	new i;
	while(i != 8)
	{
		if(InventarioArma[i][playerid] == 0)
		{
			InventarioArma[i][playerid]=Item;
			InventarioAmmo[i][playerid]=Ammo;
			RemoverItem(playerid, Item);
			break;
		}
		i++;
	}
 	return i == 8 ? SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Sua Mochila Esta Cheia!") : 1;
}

stock RemoverItem(playerid, item)
{
	new Arma[13][2];
	for(new i = 1; i < 13; ++i) GetPlayerWeaponData(playerid, i, Arma[i][0], Arma[i][1]);
	ResetPlayerWeapons(playerid);
	for(new i = 1; i < 13; ++i)
	{
		if(item != Arma[i][0]) GivePlayerWeapon(playerid, Arma[i][0], Arma[i][1]);
	}
}

stock ItemOpcoes(playerid, Item)
{
	if(InventarioArma[Item][playerid] == 0) return PlayerPlaySound(playerid, 1053, 0.0, 0.0, 0.0);
	ItemOpcao[playerid]=Item;
	return ShowPlayerDialog(playerid,DIALOG_ARMAS1,DIALOG_STYLE_LIST,"{FFFFFF}Mochila {FFD700}Costas","Usar Arma\nJogar Arma Fora","OK","Fechar");
}
//Baus de Orgs
stock GuardarItem2(playerid)
{
	new Item = GetPlayerWeapon(playerid);
	new Ammo = GetPlayerAmmo(playerid);
	new orgid = GetPlayerOrg(playerid);
	if(Item == 0) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode Guardar Sua Mao no Bau.");
	new i;
	while(i != 20)
	{
		if(CofreArma[i][orgid] == 0)
		{
			CofreArma[i][orgid]=Item;
			CofreAmmo[i][orgid]=Ammo;
			RemoverItem2(playerid, Item);
            SalvarCofre(orgid);
			break;
		}
		i++;
	}
 	return i == 20 ? SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Seu Bau Esta Cheio!") : 1;
}

stock RemoverItem2(playerid, item)
{
	new Arma[13][2];
	for(new i = 1; i < 13; ++i) GetPlayerWeaponData(playerid, i, Arma[i][0], Arma[i][1]);
	ResetPlayerWeapons(playerid);
	for(new i = 1; i < 13; ++i)
	{
		if(item != Arma[i][0]) GivePlayerWeapon(playerid, Arma[i][0], Arma[i][1]);
	}
}

stock ItemOpcoes2(playerid, Item)
{
	new orgid = GetPlayerOrg(playerid);
	if(CofreArma[Item][orgid] == 0) return PlayerPlaySound(playerid, 1053, 0.0, 0.0, 0.0);
	ItemOpcao[playerid]=Item;
	return ShowPlayerDialog(playerid,DIALOG_ARMAS12,DIALOG_STYLE_LIST,"Bau da Org","Pegar Arma\nRetirar do Bau e Jogar no Chao","OK","Fechar");
}

stock SalvarArmas(playerid)
{
    if(EntrouArea[playerid] == 0)
    {
    	new Arq[5000], str[5000], wid, wammo;
    	format(Arq, sizeof(Arq), PASTA_ARMAS, PlayerName(playerid));
    	if(!DOF2_FileExists(Arq))
    	{
    	    DOF2_CreateFile(Arq);
    	}
    	for(new i = 0; i < 13; i++)
    	{
     		GetPlayerWeaponData(playerid, i, wid, wammo);
    		format(str, sizeof(str), "Arma%d", i);
    		DOF2_SetInt(Arq, str, wid);
    		format(str, sizeof(str), "Municao%d", i);
    		DOF2_SetInt(Arq, str, wammo);
    	}
    	DOF2_SaveFile();
    }
	return 1;
}
stock CarregarArmas(playerid)
{
	new Arq[5000], str[5000], wid, wammo;
	format(Arq, sizeof(Arq), PASTA_ARMAS, PlayerName(playerid));
	if(DOF2_FileExists(Arq))
	{
		for(new i = 0; i < 13; i++)
		{
			format(str, sizeof(str), "Arma%d", i);
			wid = DOF2_GetInt(Arq, str);
			format(str, sizeof(str), "Municao%d", i);
			wammo = DOF2_GetInt(Arq, str);
			GivePlayerWeapon(playerid, wid, wammo);
		}
	}
	return 1;
}

stock SalvarInventario(playerid)
{
	new Arq[5000], str[5000];
	format(Arq, sizeof(Arq), PASTA_MOCHILAS, PlayerName(playerid));
	if(DOF2_FileExists(Arq))
	{
		for(new i = 0; i != 8; ++i)
		{
			format(str, sizeof(str), "Arma inv %d", i);
			DOF2_SetInt(Arq, str, InventarioArma[i][playerid]);
			format(str, sizeof(str), "Ammo inv %d", i);
			DOF2_SetInt(Arq, str, InventarioAmmo[i][playerid]);
		}
		DOF2_SaveFile();
	}
	else
	{
	    DOF2_CreateFile(Arq);
	    for(new i = 0; i != 8; ++i)
		{
			format(str, sizeof(str), "Arma inv %d", i);
			DOF2_SetInt(Arq, str, InventarioArma[i][playerid]);
			format(str, sizeof(str), "Ammo inv %d", i);
			DOF2_SetInt(Arq, str, InventarioAmmo[i][playerid]);
		}
		DOF2_SaveFile();
	}
	return 1;
}

