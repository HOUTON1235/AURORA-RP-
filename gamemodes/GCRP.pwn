							SCM(playerid, COR_GREY, gstring);

							GivePlayerCash(playerid, -EmPp[i][EmpresaValor]);
							Pp[playerid][Empresa] = i;

							format(arquivo, sizeof(arquivo), PASTA_CONTAS, PlayerName(playerid));
