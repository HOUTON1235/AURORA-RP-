CallBack:: Lotto(number)
{
	new JackpotFallen = 0;
	format(gstring, sizeof(gstring), "{FFFFFF}Loterica: O numero sorteado da vez foi: {FFD700}%d.", number);
	OOCNews(0x33CCFFAA, gstring);
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (IsPlayerConnected(i))
		{
			if (Pp[i][LotericaN] > 0)
			{
				if (Pp[i][LotericaN] == number)
				{
					JackpotFallen = 1;
					format(gstring, sizeof(gstring), "{FFFFFF}Loterica: O jogador: {FFD700}%s {FFFFFF}ganhou a loteria! e ficou com: {00FF00}R$%d", PlayerName(i), Jackpot);
					OOCNews(0x33CCFFAA, gstring);
					format(gstring, sizeof(gstring), "{FFDC33}!!! * Voce ganhou R$%d com seu bilhete de lot?ia. !!!", Jackpot);
					SCM(i, 0x33CCFFAA, gstring);
                    GameTextForPlayer(i, "~w~Sortudo da Vez! ~n~ ~b~Loteria!!", 3000, 4);
					ConsumingMoney[i] = 1;
					GivePlayerCash(i, Jackpot);
				}
				else
				{
					SCM(i, -1, "{FFD700}INFO: {FFFFFF}Voc? nao tem um bilhete.");
				}
			}
			Pp[i][LotericaN] = 0;
		}
	}
	if (JackpotFallen)
	{
		new rand = random(125000);
		rand += 15789;
		Jackpot = rand;
		format(gstring, sizeof(gstring), "{FFFFFF}Loterica: A Loteria acumulou: {00FF00}R$%d.", Jackpot);
		OOCNews(0x33CCFFAA, gstring);
	}
	else
	{
		new rand = random(15000);
		rand += 2158;
		Jackpot += rand;
		format(gstring, sizeof(gstring), "{FFFFFF}Loterica: O Banco Central acumulou: {00FF00}R$%d.", Jackpot);
		OOCNews(0x33CCFFAA, gstring);
	}
	return true;
}
CallBack:: OOCNews(COLOR,const string[])
{
	for(new i = 0; i < MAX_PLAYERS; i++)
	{
		if(IsPlayerConnected(i))
		{
			SendClientMessage(i, COLOR, string);
		}
	}
}
CallBack:: Status(playerid)
{
	new var0 = 0, var1 = 0, var2 = 0, var3 = 0;
	new var4 = GetPlayerVehicleID(playerid);
	if(GetPVarInt(playerid, "Use") == 1)
	{
		GetVehicleDamageStatus(var4, var0, var1, var2, var3);
		UpdateVehicleDamageStatus(var4, var0, var1, var2, 5);
        GameTextForPlayer(playerid, "~w~Pneus ~r~Desgastados!", 1200, 1);
	}
	return 0;
}
