CMD:kick(playerid, params[])
{
	new id, motivo[30 + 1], String[220];
    if(Pp[playerid][Admin] < 1) return false;
    if(sscanf(params, "ds[30]", id, motivo)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /kick [IDF] [MOTIVO]");

    for(new i; i < MAX_PLAYERS; i++) {
		if(Pp[i][Logado] == false) continue;
		if(Pp[i][IDF] != id) continue;
		if(id == Pp[playerid][IDF]) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode Se dar Kick!");
        if(Pp[playerid][Admin] < 6)
        {
            if(Pp[i][Admin] >= 1)
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode kickar outro admin.");
            }
            else
            {
                format(String,sizeof(String), "Voce foi kickado pelo Admin %s pelo motivo de %s", PlayerName(playerid), motivo);
            	SendClientMessage(i,COLOR_LIGHTRED,String);
            	format(String,sizeof(String),"[INFO] O Admin: %s[%d] expulsou o jogador: %s[%d] pelo motivo: %s",PlayerName(playerid), Pp[playerid][IDF], PlayerName(i), Pp[i][IDF], motivo);
            	SendClientMessageToAll(COLOR_LIGHTRED,String);
            	SetTimerEx("KickPlayer", 100, false, "i", i);
            }
        }
        else
        {
            format(String,sizeof(String), "Voce foi kickado pelo Admin %s pelo motivo de %s", PlayerName(playerid), motivo);
        	SendClientMessage(i,COLOR_LIGHTRED,String);
        	format(String,sizeof(String),"[INFO] O Jogador: %s[%d] Foi Kickado do Servidor Pelo Motivo: (%s)",PlayerName(i), Pp[i][IDF], motivo);
        	SendClientMessageToAll(COLOR_LIGHTRED,String);
        	SetTimerEx("KickPlayer", 100, false, "i", i);
        }
    	return 1;
    }
	return 1;
}
CMD:a(playerid, params[])
{
    if(Pp[playerid][Logado] == true)
    {
    	if(Pp[playerid][Admin] >= 1)
    	{
    		new msg[15000], string[50000];
    		if(sscanf(params, "s[15000]", msg))
    		{
    			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /a [Mensagem]");
    		}
    		else
    		{
    			format(string, sizeof(string), "{FFD700}[CHAT-ADMIN] {FFFFFF}(%s)%s[%d] diz: {FFD700}%s", NomeAdm(Pp[playerid][Admin]), PlayerName(playerid), Pp[playerid][IDF], msg);
    			for(new i = 0; i < MAX_PLAYERS; i++)
    			{
    				if(Pp[i][Admin] > 0)
    				{
    					SendClientMessage(i, COLOR_LIGHTRED, string);
    				}
    			}
    		}
    	}
    	else SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    }
	return 1;
}

