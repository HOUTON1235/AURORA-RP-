CMD:aa(playerid)
{
    if(Pp[playerid][Logado] == true)
    {
    	new stg[15000];
    	if(Pp[playerid][Admin] == 0) // Civil
    	{
    		SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando.");
    	}
    	else if(Pp[playerid][Admin] == 1) // Suporte
    	{
    		strcat(stg, "{FFD700}_____________________________________________________________\n");
            strcat(stg, "{FFFFFF}/kick /calar /calar /descalar /calados /kick /ir /trazer /trazertodos /tv /desbugar /tv /tvoff /vernome\n");
            strcat(stg, "{FFFFFF}/a /aa /tadm /cadeia /pcs /tvtab /irtab /trazertab /veridf\n");
            strcat(stg, "{FFD700}_____________________________________________________________\n");
    		ShowPlayerDialog(playerid, DIALOG_CMD_STAFF, DIALOG_STYLE_MSGBOX, "{FFFFFF}Comandos Admin {FFD700}Gold City", stg, "Ok", "");
    	}
    	else if(Pp[playerid][Admin] == 2) // Moderador
    	{
    		strcat(stg, "{FFD700}_____________________________________________________________\n");
            strcat(stg, "{FFFFFF}/kick /calar /calar /descalar /calados /kick /ir /trazer /trazertodos /tv /desbugar /tv /tvoff /vernome\n");
            strcat(stg, "{FFFFFF}/a /aa /tadm /cadeia /reviver /lchat /setvida /setcolete /pcs /tvtab /irtab /veridf /trazertab\n");
            strcat(stg, "{FFD700}_____________________________________________________________\n");
    		ShowPlayerDialog(playerid, DIALOG_CMD_STAFF, DIALOG_STYLE_MSGBOX, "{FFFFFF}Comandos Admin {FFD700}Gold City", stg, "Ok", "");
    	}
    	else if(Pp[playerid][Admin] == 3) // Admin Neutro
    	{
    		strcat(stg, "{FFD700}_____________________________________________________________\n");
            strcat(stg, "{FFFFFF}/kick /calar /calar /descalar /calados /kick /ir /trazer /trazertodos /tv /desbugar /tv /tvoff /vernome\n");
            strcat(stg, "{FFFFFF}/a /aa /tadm /cadeia /reviver /ban /banip /desbanip /agendarban /desbanid /avisarp /veridf /rtavisop\n");
            strcat(stg, "{FFFFFF}/agendaraviso /agendarbannick /pcs /agendarcadeia /av /tvtab /lchat /irtab /trazertab /setvida /setcolete /pntab /pntabn\n");
            strcat(stg, "{FFD700}_____________________________________________________________\n");
    		ShowPlayerDialog(playerid, DIALOG_CMD_STAFF, DIALOG_STYLE_MSGBOX, "{FFFFFF}Comandos Admin {FFD700}Gold City", stg, "Ok", "");
    	}
    	else if(Pp[playerid][Admin] == 4) // Admin Neutro
    	{
    		strcat(stg, "{FFD700}_____________________________________________________________\n");
            strcat(stg, "{FFFFFF}/kick /calar /calar /descalar /calados /kick /ir /trazer /trazertodos /tv /desbugar /tv /tvoff /vernome\n");
            strcat(stg, "{FFFFFF}/a /aa /tadm /cadeia /reviver /ban /banip /desbanip /agendarban /desbanid /avisarp /veridf /rtavisop\n");
            strcat(stg, "{FFFFFF}/agendaraviso /agendarbannick /pcs /agendarcadeia /av /tvtab /irtab /trazertab /setvida /settag /rttag /setcolete /pntab /pntabn /setlider /lchat /limparlider /rtlider /rtmembro /lchat\n");
        	strcat(stg, "{FFD700}_____________________________________________________________\n");
    		ShowPlayerDialog(playerid, DIALOG_CMD_STAFF, DIALOG_STYLE_MSGBOX, "{FFFFFF}Comandos Admin {FFD700}Gold City", stg, "Ok", "");
    	}
    	else if(Pp[playerid][Admin] == 5) // Gerente
    	{
    		strcat(stg, "{FFD700}_____________________________________________________________\n");
            strcat(stg, "{FFFFFF}/kick /calar /calar /descalar /calados /kick /ir /trazer /trazertodos /tv /desbugar /tv /tvoff /vernome\n");
            strcat(stg, "{FFFFFF}/a /aa /tadm /cadeia /reviver /ban /banip /desbanip /agendarban /desbanid /avisarp /rtavisop\n");
            strcat(stg, "{FFFFFF}/agendaraviso /agendarbannick /agendarcadeia /av /setlider /irtab /trazertab /limparlider /rtlider /rtmembro /lchat\n");
            strcat(stg, "{FFFFFF}/setvip /lbadm /setlevel /lchat /pcs /setvida /setcolete /tvtab /settag /rttag /pntab /veridf /pntabn\n");
            strcat(stg, "{FFD700}_____________________________________________________________\n");
    		ShowPlayerDialog(playerid, DIALOG_CMD_STAFF, DIALOG_STYLE_MSGBOX, "{FFFFFF}Comandos Admin {FFD700}Gold City", stg, "Ok", "");
    	}
    	else if(Pp[playerid][Admin] == 6) // Sub Dono
    	{
    	    strcat(stg, "{FFD700}_____________________________________________________________\n");
    		strcat(stg, "{FFFFFF}/kick, /ban, /manutencaoGCRP, /banip, /agendarbannick,  /agendarban /desbanid /cadeia, /soltar, /av, /ls /lv /sf /aerols\n");
    		strcat(stg, "{FFFFFF}/tv /tvoff /trazer /trazertodos /ir /a /rscar /cnn /clima /tadm /reviver /cv /setskin /lchat /destrancaradm /calar /descalar /calados\n");
    		strcat(stg, "{FFFFFF}/setlevel /setprofissao, /dcaixa /rtaccsadm /dportao /fazerdancar /setdinheiro, /pntabn /veridf\n");
    		strcat(stg, "{FFFFFF}/rc /setadmin, /tsv /asv /recbanco /vernome /resetlicencas /criargrafite /deslogartodos\n");
    		strcat(stg, "{FFFFFF}/reviver /setvip /setyt /setcarro /pegarcarro. /cevento /fecharevento /dspawn /pevento /deletarconta\n");
    		strcat(stg, "{FFFFFF}/deletarmotos /darlider /expulsar /abastecertd /rsmoney /convidarfa, /permitirsenha /pntab\n");
    		strcat(stg, "{FFFFFF}/criarempresa, /criarcasa /criarposto /abastecerpostos /lbadm /colisao /dcasap /dempp /trazercofre\n");
    		strcat(stg, "{FFFFFF}/criaradar, /setlider /limparlider /irbase /rtlider /rtmembro /setidf /criarsp /dsp /criarspemp /dspemp\n");
    		strcat(stg, "{FFFFFF}/matar /desbugar /explodir /darlicencas /rtavisop /pintarc /ejetarc /tapa /avisarp /tapao\n");
            strcat(stg, "{FFFFFF}/agendaraviso /granatodos /baniptab /dararma /pcs /settag /irtab /trazertab /tvtab /rttag /setvida /setcolete /abastecerveh /rclocal /igg /fgg /igf /fgf /igm /fgm\n");
    		strcat(stg, "{FFD700}_____________________________________________________________\n");
    		ShowPlayerDialog(playerid, DIALOG_CMD_STAFF, DIALOG_STYLE_MSGBOX, "{FFFFFF}Comandos Admin {FFD700}Gold City", stg, "Ok", "");
    	}
    	else if(Pp[playerid][Admin] >= 7) // Dono Oficial
    	{
    		strcat(stg, "{FFD700}_____________________________________________________________\n");
    		strcat(stg, "{FFFFFF}/kick, /ban, /manutencaoGCRP, /banip, /agendarbannick, /agendarban /desbanid /cadeia, /soltar, /av, /ls /lv /sf /aerols\n");
    		strcat(stg, "{FFFFFF}/tv /tvoff /trazer /trazertodos /ir /a /rscar /cnn /clima /tadm /reviver /cv /setskin /lchat /destrancaradm /calar /descalar /calados\n");
    		strcat(stg, "{FFFFFF}/setlevel /setprofissao, /dcaixa /vernome /dportao /setdinheiro, /setlideremp /retiraremp\n");
    		strcat(stg, "{FFFFFF}/rc /setadmin, /deletarmotos /recbanco /resetlicencas /abastecertd /rsmoney /criargrafite /dspawn /deslogartodos\n");
    		strcat(stg, "{FFFFFF}/reviver /setvip /setsocio /setpatrocinador /setyt. /rtaccsadm /cevento /pevento /rtlider /rtmembro\n");
    		strcat(stg, "{FFFFFF}/darlicencas /expulsar /abastecerpostos /convidarfa /irbase /veridf /avisarp /permitirsenha\n");
    		strcat(stg, "{FFFFFF}/criarempresa, /criarcasa /fecharevento /setcarro /pegarcarro /criarposto /lbpc /lbadm /modificarorg /trazercofre\n");
    		strcat(stg, "{FFFFFF}/criaradar, /setlider /limparlider /deletarconta /rtavisop /colisao /setidf /fazerdancar /pntab\n");
    		strcat(stg, "{FFFFFF}/matar /desbugar /explodir /ejetarc /pintarc /tapa /settag /tvtab /rttag /pntabn /tapao /dcasap /dempp /criarsp /dsp /criarspemp /dspemp\n");
            strcat(stg, "{FFFFFF}/agendaraviso /granatodos /dararma /baniptab /pcs /irtab /trazertab /setvida /setcolete /abastecerveh /rclocal /igg /fgg /igf /fgf /igm /fgm \n");
            strcat(stg, "{FFD700}_____________________________________________________________\n");
    		ShowPlayerDialog(playerid, DIALOG_CMD_STAFF, DIALOG_STYLE_MSGBOX, "{FFFFFF}Comandos Admin {FFD700}Gold City", stg, "Ok", "");
    	}
    }
	return 1;
}

CMD:criarempresa(playerid, params[])
{
	if(Pp[playerid][Admin] >= 4)
	{
		new valor, interior;
		if(sscanf(params, "ii", valor, interior))
		{
			SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /criarempresa [valor] [interior 1 - 5].");
			SCM(playerid, COR_VERMELHO, "{FFFFFF}[1] - Pizzaria // [2] - 24/7 // [3] - Loja Roupas // [4] - Loja Arma // [5] - Bar // [6] - Clube de Danca(Maior) // [7] - Bar Streep");
		}
		else if(interior < 0 || interior > 7)
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Digite um interior correto para criar a empresa 1 - 7.");
		}

		else if(interior == 1) // Pizzaria
		{
			for(new i; i < MAX_EMPRESAS; i++)
			{
				format(arquivo, sizeof(arquivo), PASTA_EMPRESA, i);
				if(!DOF2_FileExists(arquivo))
				{
					new Float:X, Float:Y, Float:Z;
					GetPlayerPos(playerid, Float:X, Float:Y, Float:Z);
					DOF2_CreateFile(arquivo);
					DOF2_SetString(arquivo, "EmpresaDono", "Nenhum");
					DOF2_SetString(arquivo, "EmpresaNome", "Pizzaria");
					DOF2_SetInt(arquivo, "EmpresaId", i);
					DOF2_SetInt(arquivo, "EmpresaAVenda", 1);
					DOF2_SetInt(arquivo, "EmpresaPickup", 19132);
					DOF2_SetInt(arquivo, "EmpresaMapIcon", 29);
					DOF2_SetInt(arquivo, "EmpresaValor", valor);
                    DOF2_SetInt(arquivo, "EmpresaInterior", 5);

                    DOF2_SetInt(arquivo, "EmpresaValores", 0);
                    DOF2_SetInt(arquivo, "EmpresaValoresRC", 25);

					DOF2_SetFloat(arquivo, "EmpresaX", X);
					DOF2_SetFloat(arquivo, "EmpresaY", Y);
					DOF2_SetFloat(arquivo, "EmpresaZ", Z);

					DOF2_SetFloat(arquivo, "EmpresaInteriorX", 372.6363);
					DOF2_SetFloat(arquivo, "EmpresaInteriorY", -133.5244);
					DOF2_SetFloat(arquivo, "EmpresaInteriorZ", 1001.4922);
					DOF2_SaveFile();

					format(EmPp[i][EmpresaDono], 30, DOF2_GetString(arquivo, "EmpresaDono"));
					format(EmPp[i][EmpresaNome], 64, DOF2_GetString(arquivo, "EmpresaNome"));
					EmPp[i][EmpresaId] = DOF2_GetInt(arquivo, "EmpresaId");
					EmPp[i][EmpresaAVenda] = DOF2_GetInt(arquivo, "EmpresaAVenda");
					EmPp[i][EmpresaPickup] = DOF2_GetInt(arquivo, "EmpresaPickup");
					EmPp[i][EmpresaMapIcon] = DOF2_GetInt(arquivo, "EmpresaMapIcon");
					EmPp[i][EmpresaValor] = DOF2_GetInt(arquivo, "EmpresaValor");
                    EmPp[i][EmpresaInterior] = DOF2_GetInt(arquivo, "EmpresaInterior");

                    EmPp[i][EmpresaValores] = DOF2_GetInt(arquivo, "EmpresaValores");

                    EmPp[i][EmpresaValoresRC] = DOF2_GetInt(arquivo, "EmpresaValoresRC");

					EmPp[i][EmpresaX] = DOF2_GetFloat(arquivo, "EmpresaX");
					EmPp[i][EmpresaY] = DOF2_GetFloat(arquivo, "EmpresaY");
					EmPp[i][EmpresaZ] = DOF2_GetFloat(arquivo, "EmpresaZ");

					EmPp[i][EmpresaInteriorX] = DOF2_GetFloat(arquivo, "EmpresaInteriorX");
					EmPp[i][EmpresaInteriorY] = DOF2_GetFloat(arquivo, "EmpresaInteriorY");
					EmPp[i][EmpresaInteriorZ] = DOF2_GetFloat(arquivo, "EmpresaInteriorZ");

                    GameTextForPlayer(playerid, "~w~Empresa ~g~Criada!", 3000, 1);

					PickupEmpresa[i] = CreateDynamicPickup(EmPp[i][EmpresaPickup], 23, EmPp[i][EmpresaX], EmPp[i][EmpresaY], EmPp[i][EmpresaZ]);
					MapIconEmpresa[i] = CreateDynamicMapIcon(EmPp[i][EmpresaX], EmPp[i][EmpresaY], EmPp[i][EmpresaZ], EmPp[i][EmpresaMapIcon], 0, -1, -1, -1, 100.0, MAPICON_LOCAL);

                    new string[450];
				    format(string, sizeof(string), "{FFD700} Empresa Gold City\n\n{FFFFFF}Empresa ID: {FFDC33}%d\n{FFFFFF}Valor da Empresa: {00FF00}%d\n{FFFFFF}Aperte {FFD700}Y\n{FFFFFF}Nome da Empresa: %s\nFundos da Empresa: {00FF00}R$%d", EmPp[i][EmpresaId], EmPp[i][EmpresaValor], EmPp[i][EmpresaNome], EmPp[i][EmpresaValores]);
                    TextoEmpresa[i] = CreateDynamic3DTextLabel(string, -1, EmPp[i][EmpresaX], EmPp[i][EmpresaY], EmPp[i][EmpresaZ]+1, 15.0);
					return 1;
				}
			}
		}
		else if(interior == 2) // 24/7
		{
			for(new i; i < MAX_EMPRESAS; i++)
			{
				format(arquivo, sizeof(arquivo), PASTA_EMPRESA, i);
				if(!DOF2_FileExists(arquivo))
				{
					new Float:X, Float:Y, Float:Z;
					GetPlayerPos(playerid, Float:X, Float:Y, Float:Z);
