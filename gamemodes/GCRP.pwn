CMD:lchat(playerid)
{
	new String[220];
	if(Pp[playerid][Admin] >= 4)
	{
		for(new a = 0; a < 100; a++)
	    {
     		SendClientMessageToAll(0xFFFFFFFF, " ");
	    }
		GameTextForAll("~w~Chat ~p~Limpo", 3000, 1);
		format(String,sizeof(String),"O Admin: %s[%d] Limpou o Chat do Servidor.",PlayerName(playerid),Pp[playerid][IDF]);
	    SendClientMessageToAll(COLOR_LIGHTRED,String);
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	}
	return 1;
}
CMD:ptr(playerid, params[])
{
    if(IsPolicial(playerid))
	{
        if(Pp[playerid][OrgLider] == 15 || Pp[playerid][OrgMembro] == 15)
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando sendo desta corp.");
        }
        else
        {
    	    new string[15000], orgid = GetPlayerOrg(playerid), String[220];
    		format(string, sizeof(string), "{1E90FF}O Oficial: {FFFFFF}%s[%d] {1E90FF}Da Corp: (({FFFFFF}%s{1E90FF})) Esta em Patrulhamento.", PlayerName(playerid), Pp[playerid][IDF], OrgInfo[orgid][OrgNome]);
    		SendClientMessageToAll(-1, string);
            for(new i; i < MAX_PLAYERS; i++)
            {
                format(String,sizeof(String),"~w~%s ~b~entraram em patrulhamento", OrgInfo[orgid][OrgNome]);
                PlayerTextDrawSetString(i, TextDrawAviso2[i][0], String);
                PlayerTextDrawShow(i, TextDrawAviso2[i][0]);
                SetTimerEx("TirarTD2", 10000, false, "i", i);
            }
        }
    }
 	else
 	{
		SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Policial");
 	}
	return 1;
}
CMD:cone(playerid,params[])
{
    if(Pp[playerid][Preso] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(IsPolicial(playerid))
	{
	    if(Koniler[playerid] < 5)
	    {
			new Float:xxX,Float:yyY,Float:zzZ,Float:aaA;
			GetPlayerPos(playerid, xxX, yyY, zzZ);
			GetPlayerFacingAngle(playerid, aaA);
			AddTrafficCone(playerid, Float:xxX,Float:yyY,Float:zzZ,Float:aaA);
		 	Koniler[playerid] += 1;
		 	SCM(playerid, -1, "{FFFFFF}Cone {00FF00}Criado!");
	 		GameTextForPlayer(playerid, "~w~Cone ~g~Colocado!", 2000, 3);
 		}
	 	else
	 	{
			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce so pode Colocar 5 Cones no Maximo, Use: '/rcones'");
	 	}
 	}
 	else
 	{
		SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Policial");
 	}
	return 1;
}
CMD:rcone(playerid,params[])
{
    if(IsPolicial(playerid))
	{
		if(Koniler[playerid] == 0)
	   	{
			SCM(playerid, -1, "{FFFFFF}Voce nao tem cones");
			return 1;
		}
		for(new i = 1; i < 11; i++)
		{
	 		DestroyObject(TrafikKoni[playerid][i]);
		}
		Koniler[playerid] = 0;
		SCM(playerid, -1, "{FFFFFF}Cones {FFD700}Retirados!");
	 	GameTextForPlayer(playerid, "~w~Cones ~r~Retirados.", 2000, 3);
	}
 	else
 	{
		SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Policial");
 	}
	return 1;
}
CMD:servicotaxi(playerid)
{
    new string[450];
    for(new i; i < MAX_PLAYERS; i++)
	{
		if(Pp[i][Logado] == true)
		{
			if(Pp[i][Profissao] == PROF_TAXISTA)
			{
			    ServicoT[playerid] = 1;
                CheckPointProfissao[playerid] = 1;
				format(string, sizeof(string), "{FFDC33}| 99-POP | O Jogador %s[%d] Esta Precisando de um Taxi, Use: '/aceitart %d'.", PlayerName(playerid), Pp[playerid][IDF], Pp[playerid][IDF]);
				SendClientMessage(i, -1, string);
                GameTextForPlayer(i, "~w~Viagem ~p~Solicitada!", 2000, 1);
				format(string, sizeof(string), "{FFDC33}| 99-POP | Voce chamou um Taxi, Aguarde....");
				SCM(playerid, -1, string);
			}
		}
	}
	return 1;
}
CMD:aceitart(playerid, params[])
{
    if(Pp[playerid][Profissao] == PROF_TAXISTA)
	{
	    if(BcTaxista[playerid] == 1)
	    {
			new id, Float:p[3], String[220];
			if(sscanf(params, "i", id))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /aceitart [IDF]");
		    {
          		for(new i; i < MAX_PLAYERS; i++)
				{
					if(Pp[i][Logado] == true)
					{
					    if(Pp[i][IDF] == id)
					    {
				            new vehicleid = GetPlayerVehicleID(playerid);
				            if(vehicleid == CarroEventoProfs[playerid])
				        	{
				            	if(ServicoT[i] != 1)return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Essa pessoa nao Solicitou servico de Taxi");
				            	ServicoT[i] = 0;
				            	GetPlayerPos(i,p[0],p[1],p[2]);
				                SetPlayerCheckpoint(playerid,p[0],p[1],p[2],5);
				                SCM(playerid,-1,"{FFFFFF}Cliente marcado com sucesso");
				            	format(String,sizeof(String),"{FFFFFF}%s atendeu ao seu chamado e esta a caminho",PlayerName(playerid));
				            	SendClientMessage(i, -1, String);
				                GameTextForPlayer(i, "~w~Um Taxista Esta Vindo Ate Voce", 5000, 1);
				                GameTextForPlayer(playerid, "~r~Voce Aceitou um Chamado, Va Ate o Local.", 5000, 0);
				                return 1;
				            }
				            else
				            {
				                SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce Voce precisa estar no veiculo da empresa!");
				                return 1;
				            }
						}
					}
				}
				return 1;
	        }
        }
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao Bateu seu Cartao");
		}
    }
    else
    {
    	SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao e Taxista");
    	return 1;
    }
	return 1;
}

CMD:qrr(playerid)
{
    if(IsPolicial(playerid))
    {
        if(Pp[playerid][Ferido] == false)
		{
            for(new i; i < MAX_PLAYERS; i++)
        	{
        		if(Pp[i][Logado] == true)
        		{
        			if(IsPolicial(i) && Equipado[i] == true)
        			{
        			    ServicoQRR[playerid] = 1;
        				new string[256];
        				format(string, sizeof(string), "{FFFFFF}Atencao!!! O Oficial: {FFFFFF}%s[%d] {FFFFFF}Esta Solicitando uma QRR, Utilize: {FFFFFF}/aceitarqrr %d", PlayerName(playerid), Pp[playerid][IDF], Pp[playerid][IDF]);
        				SendClientMessage(i, -1, string);
                        GameTextForPlayer(playerid, "~w~QRR ~g~Solicitada!!", 1200, 6);
                        GameTextForPlayer(i, "~w~QRR ~r~Solicitada!!", 1200, 1);
        			}
        		}
        	}
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce esta ferido e por isso nao pode usar este Comando");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Policial");
    }
	return 1;
}
CMD:aceitarqrr(playerid, params[])
{
    if(IsPolicial(playerid))
	{
	    if(Equipado[playerid] == true)
	    {
			new id, Float:p[3], String[220];
			if(sscanf(params, "i", id))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /aceitarqrr [IDF]");
		    {
          		for(new i; i < MAX_PLAYERS; i++)
				{
					if(Pp[i][Logado] == true)
					{
					    if(Pp[i][IDF] == id)
					    {
				            if(ServicoQRR[i] != 1)return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Essa pessoa nao Solicitou servico de QRR");
				            ServicoQRR[i] = 0;
				            GetPlayerPos(i,p[0],p[1],p[2]);
				            SetPlayerCheckpoint(playerid,p[0],p[1],p[2],5);
				            SCM(playerid,-1,"{FFFFFF}QRR marcada com sucesso");
				            format(String,sizeof(String),"{FFFFFF}%s atendeu ao seu chamado de QRR e esta a caminho",PlayerName(playerid));
				            SendClientMessage(i, -1, String);
				            GameTextForPlayer(i, "~w~Unidade a ~r~Caminho", 5000, 4);
				            GameTextForPlayer(playerid, "~w~Qrr ~g~Aceita", 5000, 4);
                            KillTimer(timer[playerid]);
                            timer[playerid] = SetTimerEx("TempoDeAttLoc", 100, true, "ii", playerid, i);
				            return 1;
						}
					}
				}
				return 1;
	        }
        }
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Equipado");
		}
    }
    else
    {
    	SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao e um Policial");
    	return 1;
    }
	return 1;
}

CMD:servicomecanico(playerid)
{
    for(new i; i < MAX_PLAYERS; i++)
	{
		if(Pp[i][Logado] == true)
		{
			if(Pp[i][Profissao] == PROF_MECANICO)
			{
			    ServicoMEC[playerid] = 1;
				new string[256];
				format(string, sizeof(string), "{FFFFFF}Urgencia: O Jogador: {FFD700}%s[%d]{FFFFFF} esta precisando de mecanico, use: {FFFFFF}/aceitarmec %d", PlayerName(playerid), Pp[playerid][IDF], Pp[playerid][IDF]);
				SendClientMessage(i, -1, string);
                GameTextForPlayer(i, "~w~Servico ~r~Solicitado!", 3000, 1);
				SCM(playerid, -1, "{FFFFFF}Mecanico: {FFFFFF}Voce solicitou um mecanico, aguarde ser atendido.");
			}
		}
	}
	return 1;
}
CMD:aceitarmec(playerid, params[])
{
    if(Pp[playerid][Profissao] == PROF_MECANICO)
	{
	    if(BcMecanico[playerid] == 1)
	    {
			new id, Float:p[3], String[220];
			if(sscanf(params, "i", id))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /aceitarmec [IDF]");
		    {
          		for(new i; i < MAX_PLAYERS; i++)
				{
					if(Pp[i][Logado] == true)
					{
					    if(Pp[i][IDF] == id)
					    {
                            new vehicleid = GetPlayerVehicleID(playerid);
	                        if(vehicleid == CarroEventoProfs[playerid])
	                        {
				            	if(ServicoMEC[i] != 1)return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Essa pessoa nao Solicitou servico de Taxi");
				            	ServicoMEC[i] = 0;
				            	GetPlayerPos(i,p[0],p[1],p[2]);
				                SetPlayerCheckpoint(playerid,p[0],p[1],p[2],5);
				                SCM(playerid,-1,"{FFFFFF}Cliente marcado com sucesso");
				            	format(String,sizeof(String),"{FFFFFF}%s[%d] atendeu ao seu chamado e esta a caminho",PlayerName(playerid),Pp[playerid][IDF]);
				            	SendClientMessage(i, -1, String);
				                GameTextForPlayer(i, "~w~Um Mecanico Esta Vindo Ate Voce", 5000, 3);
				                GameTextForPlayer(playerid, "~w~Cliente ~g~Marcado!.", 5000, 1);
				                return 1;
				            }
				            else
				            {
				                SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce precisa estar no veiculo da empresa!");
				                return 1;
				            }
						}
					}
				}
				return 1;
	        }
        }
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao Bateu seu Cartao");
		}
    }
    else
    {
    	SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao e Taxista");
    	return 1;
    }
	return 1;
}
CMD:corrida(playerid, params[])
{
    if(Pp[playerid][Profissao] == PROF_TAXISTA)
	{
	    if(BcTaxista[playerid] == 1)
	    {
	        new preco, String[220];
	        if(sscanf(params,"i",preco))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /corrida [PRECO]");
            new vehicleid = GetPlayerVehicleID(playerid);
			if(vehicleid == CarroEventoProfs[playerid])
			{
	            format(String,sizeof(String),"{00FF00}Taxista %s esta em servico, Corrida: R$[%d] - Chame um taxi /servicotaxi", PlayerName(playerid), preco);
	            SendClientMessageToAll(-1,String);
	            return 1;
	        }
	        else
	        {
	      		SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce Voce precisa estar no veiculo da empresa!");
	       	}
        }
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao Bateu seu Cartao");
		}
    }
    else
    {
        SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao e um Taxista");
    }
    return 1;
}
