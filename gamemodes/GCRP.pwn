stock CriarEmpresas()
{
	for(new i; i < MAX_EMPRESAS; i++)
	{
		format(arquivo, sizeof(arquivo), PASTA_EMPRESA, i);
		if(DOF2_FileExists(arquivo))
		{
			format(EmPp[i][EmpresaDono], 30, DOF2_GetString(arquivo, "EmpresaDono"));
			format(EmPp[i][EmpresaNome], 64, DOF2_GetString(arquivo, "EmpresaNome"));
			EmPp[i][EmpresaId] = DOF2_GetInt(arquivo, "EmpresaId");
			EmPp[i][EmpresaAVenda] = DOF2_GetInt(arquivo, "EmpresaAVenda");
			EmPp[i][EmpresaPickup] = DOF2_GetInt(arquivo, "EmpresaPickup");
			EmPp[i][EmpresaMapIcon] = DOF2_GetInt(arquivo, "EmpresaMapIcon");
			EmPp[i][EmpresaValor] = DOF2_GetInt(arquivo, "EmpresaValor");
			EmPp[i][EmpresaInterior] = DOF2_GetInt(arquivo, "EmpresaInterior");

            EmPp[i][EmpresaValores] = DOF2_GetInt(arquivo, "EmpresaValores");

            EmPp[i][EmpresaValoresRC] = DOF2_GetInt(arquivo, "EmpresaValoresRC");

			EmPp[i][EmpresaX] = DOF2_GetFloat(arquivo, "EmpresaX");
			EmPp[i][EmpresaY] = DOF2_GetFloat(arquivo, "EmpresaY");
			EmPp[i][EmpresaZ] = DOF2_GetFloat(arquivo, "EmpresaZ");

			EmPp[i][EmpresaInteriorX] = DOF2_GetFloat(arquivo, "EmpresaInteriorX");
			EmPp[i][EmpresaInteriorY] = DOF2_GetFloat(arquivo, "EmpresaInteriorY");
			EmPp[i][EmpresaInteriorZ] = DOF2_GetFloat(arquivo, "EmpresaInteriorZ");
			IniciarEmpresas ++;

			if(!strcmp(EmPp[i][EmpresaDono], "Nenhum", true))
			{
				PickupEmpresa[i] = CreateDynamicPickup(EmPp[i][EmpresaPickup], 23, EmPp[i][EmpresaX], EmPp[i][EmpresaY], EmPp[i][EmpresaZ]);
				MapIconEmpresa[i] = CreateDynamicMapIcon(EmPp[i][EmpresaX], EmPp[i][EmpresaY], EmPp[i][EmpresaZ], EmPp[i][EmpresaMapIcon], 0, -1, -1, -1, 100.0, MAPICON_LOCAL);
                new string[450];
				format(string, sizeof(string), "{FFD700}Empresa\n\n{6B8E23}Tipo de empresa {FFFFFF}%s\n{6B8E23}Numero da Empresa: {FFFFFF}%d\n{6B8E23}Pressione {FFD700}[{FFFFFF}Y{FFD700}]\n{6B8E23}Empresa a venda: {FFFFFF}$ %d", EmPp[i][EmpresaNome], EmPp[i][EmpresaId], EmPp[i][EmpresaValor]);
                TextoEmpresa[i] = CreateDynamic3DTextLabel(string, -1, EmPp[i][EmpresaX], EmPp[i][EmpresaY], EmPp[i][EmpresaZ]+1, 15.0);
			}
			else
			{
				PickupEmpresa[i] = CreateDynamicPickup(EmPp[i][EmpresaPickup], 23, EmPp[i][EmpresaX], EmPp[i][EmpresaY], EmPp[i][EmpresaZ]);
				MapIconEmpresa[i] = CreateDynamicMapIcon(EmPp[i][EmpresaX], EmPp[i][EmpresaY], EmPp[i][EmpresaZ], EmPp[i][EmpresaMapIcon], 0, -1, -1, -1, 100.0, MAPICON_LOCAL);
                new string[450];
				format(string, sizeof(string), "{FFD700} Empresa Gold City\n\n{FFFFFF}Empresa ID: {FFDC33}%d\n{FFFFFF}Valor da Empresa: {00FF00}%d\n{FFFFFF}Aperte {FFD700}Y\n{FFFFFF}Nome da Empresa: %s\nFundos da Empresa: {00FF00}R$%d", EmPp[i][EmpresaId], EmPp[i][EmpresaDono], EmPp[i][EmpresaNome], EmPp[i][EmpresaValores]);
                TextoEmpresa[i] = CreateDynamic3DTextLabel(string, -1, EmPp[i][EmpresaX], EmPp[i][EmpresaY], EmPp[i][EmpresaZ]+1, 15.0);
			}
		}
	}
	return 1;
}
stock CriarCasas()
{
	for(new i = 0; i < MAX_CASAS; i++)
	{
		format(arquivo, sizeof(arquivo), PASTA_CASAS, i);
		if(DOF2_FileExists(arquivo))
		{
			format(CasaInfo[i][CasaDono], 30, DOF2_GetString(arquivo, "CasaDono"));
			format(CasaInfo[i][CasaTexto], 64, DOF2_GetString(arquivo, "CasaTexto"));
			CasaInfo[i][CasaId] = DOF2_GetInt(arquivo, "CasaId");
			CasaInfo[i][CasaAVenda] = DOF2_GetInt(arquivo, "CasaAVenda");
			CasaInfo[i][CasaPickup] = DOF2_GetInt(arquivo, "CasaPickup");
			CasaInfo[i][CasaMapIcon] = DOF2_GetInt(arquivo, "CasaMapIcon");
			CasaInfo[i][CasaValor] = DOF2_GetInt(arquivo, "CasaValor");
			CasaInfo[i][CasaInterior] = DOF2_GetInt(arquivo, "CasaInterior");

			CasaInfo[i][CasaX] = DOF2_GetFloat(arquivo, "CasaX");
			CasaInfo[i][CasaY] = DOF2_GetFloat(arquivo, "CasaY");
			CasaInfo[i][CasaZ] = DOF2_GetFloat(arquivo, "CasaZ");

			CasaInfo[i][CasaInteriorX] = DOF2_GetFloat(arquivo, "CasaInteriorX");
			CasaInfo[i][CasaInteriorY] = DOF2_GetFloat(arquivo, "CasaInteriorY");
			CasaInfo[i][CasaInteriorZ] = DOF2_GetFloat(arquivo, "CasaInteriorZ");
			IniciarCasas ++;

			if(!strcmp(CasaInfo[i][CasaDono], "Nenhum", true))
			{
				PickupCasa[i] = CreateDynamicPickup(CasaInfo[i][CasaPickup], 23, CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ]);
				MapIconCasa[i] = CreateDynamicMapIcon(CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ], CasaInfo[i][CasaMapIcon], 0, -1, -1, -1, 100.0, MAPICON_LOCAL);
			}
			else
			{
				PickupCasa[i] = CreateDynamicPickup(CasaInfo[i][CasaPickup], 23, CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ]);
				MapIconCasa[i] = CreateDynamicMapIcon(CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ], CasaInfo[i][CasaMapIcon], 0, -1, -1, -1, 100.0, MAPICON_LOCAL);
			}
			new string[450];
			format(string, sizeof(string), "{FFD700}*** Casa Ocupada ***\n\n{FFFFFF}Numero da casa: {B0C4DE}[%d]\n{FFFFFF}Pressione {FF0000}[{FFFFFF}Y{FF0000}]\n{FFFFFF}Proprietario: {B0C4DE}%s", CasaInfo[i][CasaId], CasaInfo[i][CasaDono]);
			TextoCasa[i] = CreateDynamic3DTextLabel(string, -1, CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ]+1, 15.0);
		}
	}
	return 1;
}

stock SalvarOrg(idorg)
{
	format(arquivo, sizeof(arquivo), PASTA_ORGS, idorg);
	if(DOF2::FileExists(arquivo))
	{
		DOF2::GetString(arquivo, "Lider", OrgInfo[idorg][Lider]);
		DOF2::SetString(arquivo, "SubLider", OrgInfo[idorg][SubLider]);
		DOF2::SetString(arquivo, "Membro3", OrgInfo[idorg][Membro3]);
