						{
						    return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Essa empresa ja pertencente a voce.");
						}
						else if(EmPp[i][EmpresaAVenda] == 0)
						{
							return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF} Esta empresa nao esta a venda.");
						}
