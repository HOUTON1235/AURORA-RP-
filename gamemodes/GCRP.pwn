    		{
    			format(gstring, sizeof(gstring), "{FFD700}Habilitacao C:{FF0000} Nao\n");
    			strcat(stg, gstring);
    		}
    		if(Pp[playerid][HabilitacaoD] == 1)
    		{
    			format(gstring, sizeof(gstring), "{FFD700}Habilitacao Aerea:{00FF00} Sim\n");
    			strcat(stg, gstring);
    		}
    		if(Pp[playerid][HabilitacaoD] == 0)
    		{
    			format(gstring, sizeof(gstring), "{FFD700}Habilitacao Aerea:{FF0000} Nao\n");
    			strcat(stg, gstring);
    		}
    		if(Pp[playerid][FezPorte] == 1)
    		{
