CMD:comprimentar(playerid, params[])
{
	new id, Float:PosX1, Float:PosY1, Float:PosZ1;
	if(sscanf(params, "i", id))
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /comprimentar [IDF]");
	}
 	for(new i; i < MAX_PLAYERS; i++)
	{
		if(Pp[i][Logado] == true)
		{
		    if(Pp[i][IDF] == id)
		    {
		        if(id == Pp[playerid][IDF])
		        {
					SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Comprimentar");
		        }
		        GetPlayerPos(i, PosX1, PosY1, PosZ1);
          		if(ISP(playerid, 3.0, PosX1, PosY1, PosZ1))
  				{
			        new string[450];
				   	format(string, sizeof(string), "* O ID [%d] Esta Comprimentando O ID:[%d]. ", Pp[playerid][IDF], Pp[i][IDF]);
				   	ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
				   	ApplyAnimation(playerid,"GANGS","hndshkfa",4.0,0,0,0,0,0);
				   	ApplyAnimation(i,"GANGS","hndshkfa",4.0,0,0,0,0,0);
				}
				else
				{
				    SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a este Player");
				}
			}
		}
	}
	return 1;
}
