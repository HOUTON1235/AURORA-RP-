CMD:entregarlista(playerid)
{
    if(IsBandido(playerid))
    {
        if(ISP(playerid, 2.0, 2058.0818,-1698.3513,14.1172))
        {
            if(EntregouPacotes[playerid] == 1)
            {
                new string[450], granaa = 2000 + random(200);
                EntregouPacotes[playerid] = 0;
                GivePlayerCash(playerid, granaa);
                Pp[playerid][NumeroPayday] += 1;
                GameTextForPlayer(playerid, "~y~Missao Concluida ~n~ ~w~+Dinheiro ~n~ ~w~+XP", 5000, 6);
                SendClientMessageEx(playerid, -1, "{FFFFFF}Voce entregou a Lista para o Big Smoke e ele deu: {00FF00}R$%d {FFFFFF}para Voce", granaa);
                SCM(playerid, -1, "{FFFFFF}Voce tambem ganhou +1 de XP!");
            }
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao entregou os Pacotes que pedi lesma!");
            }
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta na casa do Big Smoke");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Criminoso");
    }
    return 1;
}
CMD:aceitarmissao(playerid)
{
    if(IsBandido(playerid))
    {
        if(ISP(playerid, 2.0, 556.2463,-203.3579,16.7846))
        {
            if(AceitouMissao[playerid] == 0)
        	{
                GameTextForPlayer(playerid, "~w~Missao Aceita!", 1200, 6);
                SCM(playerid, -1, "{FFFFFF}Voce aceitou a Missao, pegue seu Veiculo e Digira-se a Area de Carregamento.");
                SCM(playerid, -1, "{FFFFFF}Voce tera que espalhar pacotes de Drugs em Toda a Cidade, Apos isso, fale com o Big Smoke.");
                SCM(playerid, -1, "{FFFFFF}Para Cancelar a Missao, Utilize: /aceitarmissao, Novamente!.");
                AceitouMissao[playerid] = 1;
            }
            else if(AceitouMissao[playerid] == 1)
            {
                GameTextForPlayer(playerid, "~r~Missao cancelada!", 1200, 6);
                SCM(playerid, -1, "{FFFFFF}Voce cancelou a Missao.");
                AceitouMissao[playerid] = 0;
            }
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta no Bot das Drugs");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Criminoso");
    }
    return 1;
}
CMD:carregarkg(playerid)
{
    new vehicleid = GetPlayerVehicleID(playerid);
    if(IsBandido(playerid))
    {
        if(Pp[playerid][TemCarro2] == 1)
        {
            if(VeiculoSpawnado[playerid] == 1)
            {
                if(!IsPlayerInAnyVehicle(playerid))
				{
					return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta em um veiculo.");
				}
				else
				{
                    if(ISP(playerid, 2.0, 563.4730,-203.6026,15.8182))
                    {
                        if(AceitouMissao[playerid] == 1)
                    	{
                            if(DrugsVeh[vehicleid] == 0)
                            {
                                PlayerPlaySound(playerid,1137,0.0,0.0,0.0);
            					DisablePlayerRaceCheckpoint(playerid);
            					SetPlayerRaceCheckpoint(playerid, 0, EntregasPacotes[0][0], EntregasPacotes[0][1], EntregasPacotes[0][2],EntregasPacotes[0][0], EntregasPacotes[0][1], EntregasPacotes[0][2], 7);
            					SCM(playerid, COR_VERDE, "{FFD700}>> Pacotes: {FFFFFF}Pacotes Pegos, Entregue-os agora Menor do k**.");
            					GameTextForPlayer(playerid, "~w~Siga os ~~Checkpoints", 3000, 1);
            					DrugsVeh[vehicleid] = 1;
                            }
                            else
                            {
                                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Seu Veiculo ja Tem Pacotes de Drugs");
                            }
                        }
                        else
                        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao aceitou a missao");
                        }
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta no Local de Pegar Drugs");
                    }
                }
            }
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao Spawnou seu Veiculo");
            }
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem um Veiculo Proprio");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Criminoso");
    }
    return 1;
}
CMD:fazerdancar(playerid, params[])
{
	if(Pp[playerid][Admin] > 1)
	{
        new id, danca;
		if(sscanf(params, "i", id, danca))
		{
			return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /fazerdancar [IDF] [1~10]");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
                    if(danca > 10)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /fazerdancar [IDF] [1~10]");
        	        switch(danca)
        	        {
        	            case 1:ApplyAnimation(i, "DANCING","dance_loop", 4.0, 1, 1, 1, 1, 0, 1);
        			    case 2:ApplyAnimation(i, "DANCING","DAN_Down_A", 4.0, 1, 1, 1, 1, 0, 1);
        			    case 3:ApplyAnimation(i, "DANCING","DAN_Left_A", 4.0, 1, 1, 1, 1, 0, 1);
        			    case 4:ApplyAnimation(i, "DANCING","DAN_Loop_A", 4.0, 1, 1, 1, 1, 0, 1);
        			    case 5:ApplyAnimation(i, "DANCING","DAN_Right_A", 4.0, 1, 1, 1, 1, 0, 1);
        			    case 6:ApplyAnimation(i, "DANCING","DAN_Up_A", 4.0, 1, 1, 1, 1, 0, 1);
        			    case 7:ApplyAnimation(i, "DANCING","dnce_M_a", 4.0, 1, 1, 1, 1, 0, 1);
        			    case 8:ApplyAnimation(i, "DANCING","dnce_M_b", 4.0, 1, 1, 1, 1, 0, 1);
        			    case 9:ApplyAnimation(i, "DANCING","dnce_M_c", 4.0, 1, 1, 1, 1, 0, 1);
        			    case 10:ApplyAnimation(i, "DANCING","dnce_M_d", 4.0, 1, 1, 1, 1, 0, 1);
        			    case 11:ApplyAnimation(i, "DANCING","dnce_M_ e", 4.0, 1, 1, 1, 1, 0, 1);
                    }
                }
            }
        }
  	}
  	else
   	{
    	SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este Comando");
     	return 1;
    }
    return 1;
}
CMD:colisao(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(Pp[playerid][Admin] >= 5)
    {
        new string[256];
        if(Colisao[playerid] == 1)
        {
			format(string, sizeof(string), "{FFFFFF}Colisao esta agora {FFD700}Desativado'");
			SendClientMessage(playerid, 0xFFFFFFFF, string);
			Colisao[playerid] = 0;
			DisableRemoteVehicleCollisions(playerid, 1);
			return 1;
		}
		if(Colisao[playerid] == 0)
        {
			format(string, sizeof(string), "{FFFFFF}Colisao esta agora {00FF00}Ativado!");
			SendClientMessage(playerid, 0xFFFFFFFF, string);
			Colisao[playerid] = 1;
			DisableRemoteVehicleCollisions(playerid, 0);
		}
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este Comando");
    }
    return 1;
}
CMD:pintarc(playerid, params[])
{
    new cor1, cor2;
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(Pp[playerid][Admin] >= 1)
    {
        if(!IsPlayerInAnyVehicle(playerid)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um Veiculo");
        if(sscanf(params,"ii",cor1,cor2))return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /pintarc [COR1] [COR2]");
        {
            new carro = GetPlayerVehicleID(playerid);
        	ChangeVehicleColor(carro, cor1, cor2);
            SCM(playerid, -1, "{FFFFFF}Veiculo Pintado!");
            GameTextForPlayer(playerid, "~w~Veiculo ~g~Pintado!", 1200, 1);
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este Comando.");
    }
	return 1;
}
CMD:presos(playerid)
{
	new string[450];
    if(Pp[playerid][Logado] == true)
    {
		SCM(playerid, -1, "{FFD700}--------------- | {FFFFFF}Presos Gold City {FFD700} | ---------------");
		for(new i = 0; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][Preso] == true)
			    {
					format(string, 128, "{FFFFFF}Preso: %s[%d] Esta Preso por: %02d:%02d.",  PlayerName(i), Pp[i][IDF], Pp[i][PresoMinutos], Pp[i][PresoSegundos]);
      				SendClientMessage(playerid, -1, string);
				}
			}
		}
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    }
    return 1;
}
CMD:carregarprod(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(Pp[playerid][Profissao] == PROF_INDUSTRIAL)
    {
        if(ISP(playerid, 2.0, 7.2306,1179.5481,19.4427))
        {
            if(BcIndustrial[playerid] == 1)
		    {
                new vehicleid = GetPlayerVehicleID(playerid);
        		if(VehProfIndustrial(vehicleid))
        		{
        			if(ProdutosVeh[vehicleid] == 0)
        			{
        				new indx2 = random(sizeof(EntregasIN));
            			SetPlayerCheckpoint(playerid, EntregasIN[indx2][0], EntregasIN[indx2][1], EntregasIN[indx2][2], 1.0);
            			SCM(playerid, -1, "{BDB76B}(( Industria )): {FFFFFF}Marcamos em seu mapa um Local de Entrega, va ate la e use: /pegarprod na van");
                        SCM(playerid, -1, "{BDB76B}(( Industria )): {FFFFFF}Apos o Produto, utilize: /entregarprod no Checpoint.");
            			GameTextForPlayer(playerid, "~w~Sua Van foi ~g~Carregada!", 2000, 4);
        				ProdutosVeh[vehicleid] = 1;
        				return 1;
        			}
        			else
        			{
        		    	SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Veiculo ja esta carregado.");
        			}
        		}
        		else
        		{
        		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em uma Van Industrial");
        		}
            }
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Uniformizado");
            }
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta no Local de Procura de Entregas");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um(a) Transportador(a) Industrial");
    }
    return 1;
}
CMD:pegarprod(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(Pp[playerid][Profissao] == PROF_INDUSTRIAL)
    {
        if(BcIndustrial[playerid] == 1)
    	{
            for(new v; v < MAX_VEHICLES; v++)
            {
                new Float:X, Float:Y, Float:Z;
                GetVehiclePos(v, X, Y, Z);
                if(ISP(playerid, 3.0, X, Y, Z))
                {
                    if(VehProfIndustrial(v))
            		{
            			if(ProdutosVeh[v] == 1)
            			{
                            ProdutosVeh[v] = 0;
                            PegouProd[playerid] = 1;
                            SCM(playerid, -1, "{BDB76B}(( Industrial )): {FFFFFF}Voce pegou um Produto em Maos, Utilize: /entregarprod no Checkpoint");
                            GameTextForPlayer(playerid, "~w~Produto ~g~Pego!", 3000, 4);
                            SetPlayerAttachedObject(playerid, 9, 1271, 1, 0.3689, 0.5740, 0.0000, 0.0000, 0.0000, 0.0000, 1.0000, 1.0000, 1.0000);//caixa - box
                            ApplyAnimation(playerid, "CARRY", "CRRY_PRTIAL", 4.1, 0, 0, 0, 1, 1, 1);
                        }
                        else
                        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Veiculo nao tem Nenhum Produto.");
                        }
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Veiculo nao e da Empresa Industrial.");
                    }
                }
            }
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Uniformizado.");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um(a) Transportador(a) Industrial");
    }
    return 1;
}
CMD:entregarprod(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(Pp[playerid][Profissao] == PROF_INDUSTRIAL)
    {
        if(PegouProd[playerid] == 1)
        {
            for(new i; i < 7; i++)
            {
                if(ISP(playerid, 2.0, EntregasIN[i][0], EntregasIN[i][1], EntregasIN[i][2]))
            	{
                    if(BcIndustrial[playerid] == 1)
    		        {
                        DisablePlayerRaceCheckpoint(playerid);
                        DisablePlayerCheckpoint(playerid);
                        new string[450], granaa = 1000 + random(2000);
                        PegouProd[playerid] = 0;
                        GivePlayerCash(playerid, granaa);
                        RemovePlayerAttachedObject(playerid, 9);
                        SendClientMessageEx(playerid, -1, "{BDB76B}(( Industrial )): {FFFFFF}Voce entregou um Produto e Ganhou: {00FF00}R$%d", granaa);
                        GameTextForPlayer(playerid, "~w~Produto ~g~Entregue!", 3000, 4);
                        SetTimerEx("DCANIM", 500, false, "d", playerid);
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Uniformizado.");
                    }
                }
            }
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem nenhum produto em maos.");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um(a) Transportador(a) Industrial");
    }
    return 1;
}
CMD:vendersementes(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(Pp[playerid][Profissao] == PROF_FAZENDEIRO)
    {
        if(ISP(playerid, 2.0, 1938.4309, 165.4832, 37.2813))
        {
            if(BcFazendeiro[playerid] == 1)
		    {
		        if(SementesP[playerid] >= 5)
		        {
                    DisablePlayerRaceCheckpoint(playerid);
                    DisablePlayerCheckpoint(playerid);
                    new granaa = 200 + random(200), string[450];
		            GivePlayerCash(playerid, granaa);
		            SendClientMessageEx(playerid, -1, "{FFDC33}(( Fazneda )): {FFFFFF}Voce vendeu: {FFDC33}%d {FFFFFF}Sementes e Ganhou: {00FF00}R$%d", SementesP[playerid], granaa);
                    GameTextForPlayer(playerid, "~w~Sementes ~g~Vendidas!", 3000, 6);
                    SementesP[playerid] = 0;
		            return 1;
				}
				else
				{
				    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem 5 Sementes no Bolso!");
				}
			}
			else
			{
			    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao bateu seu Cartao!");
			}
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um Local de Vendas de Semenetes");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Fazendeiro");
    }
    return 1;
}
CMD:colherp(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(Pp[playerid][Profissao] == PROF_FAZENDEIRO)
    {
        for(new i; i < 20; i++)
        {
            if(ISP(playerid, 2.0, Colheitas[i][0], Colheitas[i][1], Colheitas[i][2]))
        	{
                if(BcFazendeiro[playerid] == 1)
		        {
                    if(SementesP[playerid] < 5)
                    {
                        if(ColhendoS[playerid] == 0)
                        {
                            SCM(playerid, -1, "{FFFFFF}Voce esta procurando sementes neste local, aguarde...");
                            GameTextForPlayer(playerid, "~w~Procurando..", 1200, 1);
                            ColhendoS[playerid] = 1;
            				ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1,1,1,1,1,0,1);
            				TimerColhendo[playerid] = SetTimerEx("TimerColhendoS", 1000, true, "i", playerid);
            				TogglePlayerControllable(playerid, 0);
            				ProtecaoAlgemas[playerid] = SetTimerEx("k", 500, true, "d", playerid);
                            return 1;
                        }
                        else
                        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja esta colhendo uma Semente, Aguarde...");
                            return 1;
                        }
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja tem 5 sementes  no Bolso");
                    }
                }
                else
                {
                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Uniformizado.");
                    return 1;
                }
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Fazendeiro");
    }
    return 1;
}
CMD:pradar(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	if(Pp[playerid][Profissao] == PROF_DNIT)
	{
        new vehicleid = GetPlayerVehicleID(playerid);
		if(vehicleid == CarroEventoProfs[playerid])
		{
         	if(BcDNIT[playerid] == 0) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta com seu uniforme");
          	{
                if(DnitRadar[playerid] == 0)
                {
           			new indx = random(MAX_RADAR);
                    format(arquivo, sizeof(arquivo), PASTA_RADAR, indx);
            		if(DOF2_FileExists(arquivo))
            		{
                		SetPlayerCheckpoint(playerid, RadarInfo[indx][RadarPosX], RadarInfo[indx][RadarPosY], RadarInfo[indx][RadarPosZ], 1.0);
                        SCM(playerid, -1, "{FFDC33}[ DNIT ]: {FFFFFF}Voce localizou um Radar Danificado.");
                        SCM(playerid, -1, "{FFDC33}[ DNIT ]: {FFFFFF}Diriga-se ao local demarcado para reparar o Radar.");
                        GameTextForPlayer(playerid, "~w~Radar ~g~Localizado!", 3000, 1);
            			DnitRadar[playerid] = 1;
            			return 1;
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Nenhum Radar encontrado");
                        GameTextForPlayer(playerid, "~w~Nenhum Radar ~n~ ~r~Encontrado!", 3000, 4);
                    }
                }
                else
                {
                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja pegou um Servico");
                }
            }
    	}
    	else
    	{
    	 	SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce Precisa esta no Veiculo da Empresa");
    	}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um(a) DNIT(a)!");
	}
    return 1;
}
CMD:entregarcorpo(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    new string[450];
    if(Pp[playerid][Profissao] == PROF_COVEIRO)
	{
        new vehicleid = GetPlayerVehicleID(playerid);
		if(vehicleid == CarroEventoProfs[playerid])
		{
    	    if(ISP(playerid, 2.0, 949.4603,-1102.9373,23.6476))
    		{
    		    if(BcCoveiro[playerid] == 1)
    		    {
    			    if(CorpoMV[vehicleid] == 1)
    			    {
                        new DinheiroEntrega = 800 + random(200);
    			        SendClientMessageEx(playerid, -1, "{FFD700}>> Cemiterio: {FFFFFF}Voce entregou um Corpo no Cemiterio e Ganhou: {00FF00}R$%d", DinheiroEntrega);
    			        format(string, sizeof(string), "* O ID:[%d] Entregou um Corpo no Cemiterio", Pp[playerid][IDF]);
    					ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                        format(string, sizeof(string), "~g~+R$%d", DinheiroEntrega);
    			        GameTextForPlayer(playerid, string, 5000, 1);
    			        GivePlayerCash(playerid, DinheiroEntrega);
    		   			CorpoMV[vehicleid] = 0;
    				}
    				else
    				{
    				    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce Nao esta com um Corpo no Carro");
    				}
    			}
    			else
    			{
    			    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao bateu o Cartao");
    			}
    		}
    		else
    		{
    		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta no cemiterio");
    		}
        }
        else
    	{
    	 	SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce Precisa esta no Veiculo do Cemiterio");
    	}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Coveiro(a)");
	}
	return 1;
}
