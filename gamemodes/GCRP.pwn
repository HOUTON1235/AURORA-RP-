            PlayerTextDrawShow(playerid, TdVelocimetro[playerid][13]);
            PlayerTextDrawShow(playerid, TdVelocimetro[playerid][14]);
            PlayerTextDrawShow(playerid, TdVelocimetro[playerid][15]);
            PlayerTextDrawShow(playerid, TdVelocimetro[playerid][16]);
            PlayerTextDrawShow(playerid, TdVelocimetro[playerid][17]);
            PlayerTextDrawShow(playerid, TdVelocimetro[playerid][18]);
		}

		new carid = GetVehicleModel(GetPlayerVehicleID(playerid));
		for(new i; i < MAX_RADAR; i++)
		{
			if(carid != 417 && carid != 425 && carid != 430 && carid != 446 && carid != 447 && carid != 449 && carid != 452 && carid != 453 && carid != 454 &&
			carid != 460 && carid != 469 && carid != 472 && carid != 473 && carid != 476 && carid != 481 && carid != 484 && carid != 487 && carid != 488 && carid != 493 &&
			carid != 497 && carid != 509 && carid != 510 && carid != 511 && carid != 512 && carid != 513 && carid != 519 && carid != 520 && carid != 537 && carid != 538 &&
			carid != 548 && carid != 553 && carid != 563 && carid != 577 && carid != 592 && carid != 593 && carid != 595)
			{
				format(arquivo, sizeof(arquivo), PASTA_RADAR, i);
				if(ISP(playerid, 20.0, RadarInfo[i][RadarPosX], RadarInfo[i][RadarPosY], RadarInfo[i][RadarPosZ]))
				{
					new velocidade = VelocidadeDoVeiculo(GetPlayerVehicleID(playerid));
				    if(velocidade <= RadarInfo[i][RadarVelocidade])
				    {
				        if(PassouRadar[playerid] == 0)
				        {
					        PassouRadar[playerid] = 1;

					        new str2[5000];
					        format(str2, sizeof(str2),"{FFFFFF}[RADAR] O radar registrou a velocidade de %d KM/H no limite de %d KM/H", velocidade, RadarInfo[i][RadarVelocidade]);
							SCM(playerid, 0xFD0600FF,str2);
					        SetTimerEx("LiberarRadar", 5000, false, "d", playerid);
					        return 1;
						}
				    }
				    else if(IsPolicial(playerid))
				    {
				        if(Equipado[playerid] == true)
				        {
					    	if(PassouRadar[playerid] == 0)
					        {
						    	PassouRadar[playerid] = 1;

                                new str2[5000];
					            format(str2, sizeof(str2),"{FFFFFF}[RADAR] O radar registrou a velocidade de %d KM/H no limite de %d KM/H", velocidade, RadarInfo[i][RadarVelocidade]);
							    SCM(playerid, 0xFD0600FF,str2);
							   	SetTimerEx("LiberarRadar", 5000, false, "d", playerid);
							   	return 1;
							}
						}
                        else
                        {
                            if(PassouRadar[playerid] == 0)
    				        {
    				            if(GetPlayerScore(playerid) >= 2)
    				            {
    					            if(Pp[playerid][Multas] < 10)
    					            {
    					                new str2[5000];
    					                if(Pp[playerid][HabilitacaoA] == 1 || Pp[playerid][HabilitacaoB] == 1 || Pp[playerid][HabilitacaoC] == 1)
    					            	{
    					            	    PassouRadar[playerid] = 1;
                                            GameTextForPlayer(playerid, "~r~Multado", 2000, 4);
    									   	SetTimerEx("LiberarRadar", 5000, false, "d", playerid);
    									    PlayerPlaySound(playerid,1132,0.0,0.0,0.0);
    									    format(str2, sizeof(str2),"{FFD700}[RADAR]: Voce passou a: [{FFFFFF}%d KM/H{FFD700}] No Radar de: [{FFFFFF}%d KM/H{FFD700}] e Foi Multado!", velocidade, RadarInfo[i][RadarVelocidade]);
    										SCM(playerid, 0xFD0600FF,str2);
                                            SendClientMessageEx(playerid, -1, "{FFD700}[RADAR]: Voce agora esta com: [{FFFFFF}%d/10{FFD700}] Multas, tenha mais cuidado!", Pp[playerid][Multas]);
                                            Pp[playerid][Multas] += 1;
    										return 1;
    					            	}
    									else
    									{
                                            PassouRadar[playerid] = 1;
    									   	SetTimerEx("LiberarRadar", 5000, false, "d", playerid);
    									    SCM(playerid, -1, "{FFFFFF}[RADAR] Voce nao tem Licencas Por Isso nao Foi Multado!");
    									}
    							    	return 1;
    							    }
    							    else
    							    {
                                        PassouRadar[playerid] = 1;
    									SetTimerEx("LiberarRadar", 5000, false, "d", playerid);
    							        SCM(playerid, -1, "{FFFFFF}[RADAR] Voce perdeu Todas as Suas CNH's por exesso de Multas");
    						         	Pp[playerid][HabilitacaoA] = 0;
    							        Pp[playerid][HabilitacaoB] = 0;
    							        Pp[playerid][HabilitacaoC] = 0;
    							        Pp[playerid][HabilitacaoD] = 0;
    							        Pp[playerid][Multas] = 0;
    							    }
    							}
    						    else
    						    {
                                    PassouRadar[playerid] = 1;
    								SetTimerEx("LiberarRadar", 5000, false, "d", playerid);
    						        SCM(playerid, -1, "{FFFFFF}[RADAR] Voce nao tem Nivel +2 Para Poder Receber Multas, e o Radar Foi Liberado.");
    						        GameTextForPlayer(playerid, "~w~Radar ~g~Liberado ~n~ ~r~Level -2", 5000, 6);
    						    }
    						}
    				    }
                    }
				    else
				    {
				    	if(PassouRadar[playerid] == 0)
				        {
				            if(GetPlayerScore(playerid) >= 2)
				            {
					            if(Pp[playerid][Multas] < 10)
					            {
					                new str2[5000];
					                if(Pp[playerid][HabilitacaoA] == 1 || Pp[playerid][HabilitacaoB] == 1 || Pp[playerid][HabilitacaoC] == 1)
					            	{
					            	    PassouRadar[playerid] = 1;
                                        GameTextForPlayer(playerid, "~r~Multado", 2000, 4);
									   	SetTimerEx("LiberarRadar", 5000, false, "d", playerid);
									    PlayerPlaySound(playerid,1132,0.0,0.0,0.0);
									    format(str2, sizeof(str2),"{FFD700}[RADAR]: Voce passou a: [{FFFFFF}%d KM/H{FFD700}] No Radar de: [{FFFFFF}%d KM/H{FFD700}] e Foi Multado!", velocidade, RadarInfo[i][RadarVelocidade]);
										SCM(playerid, 0xFD0600FF,str2);
                                        SendClientMessageEx(playerid, -1, "{FFD700}[RADAR]: Voce agora esta com: [{FFFFFF}%d/10{FFD700}] Multas, tenha mais cuidado!", Pp[playerid][Multas]);
                                        Pp[playerid][Multas] += 1;
										return 1;
					            	}
									else
									{
                                        PassouRadar[playerid] = 1;
									   	SetTimerEx("LiberarRadar", 5000, false, "d", playerid);
									    SCM(playerid, -1, "{FFFFFF}[RADAR] Voce nao tem Licencas Por Isso nao Foi Multado!");
									}
							    	return 1;
							    }
							    else
							    {
                                    PassouRadar[playerid] = 1;
									SetTimerEx("LiberarRadar", 5000, false, "d", playerid);
							        SCM(playerid, -1, "{FFFFFF}[RADAR] Voce perdeu Todas as Suas CNH's por exesso de Multas");
						         	Pp[playerid][HabilitacaoA] = 0;
							        Pp[playerid][HabilitacaoB] = 0;
							        Pp[playerid][HabilitacaoC] = 0;
							        Pp[playerid][HabilitacaoD] = 0;
							        Pp[playerid][Multas] = 0;
							    }
							}
						    else
						    {
                                PassouRadar[playerid] = 1;
								SetTimerEx("LiberarRadar", 5000, false, "d", playerid);
						        SCM(playerid, -1, "{FFFFFF}[RADAR] Voce nao tem Nivel +2 Para Poder Receber Multas, e o Radar Foi Liberado.");
						    }
						}
				    }
				}
			}
		}
	}
	else
	{
		for(new i; i < 19; i++)
		{
			PlayerTextDrawHide(playerid, TdVelocimetro[playerid][i]);
		}
	}
	return 1;
}


CallBack:: AtualizandoTextdraw(playerid)
{
    if(Pp[playerid][Profissao] == PROF_SAMU)
    {
        if(BcSamu[playerid] == 1)
        {
        	if(Pp[localizarjogador[playerid]][Ferido] == true)
        	{
        		new zone[MAX_ZONE_NAME], string[100];

        		GetPlayer2DZone(localizarjogador[playerid], zone, MAX_ZONE_NAME);

        		format(string, sizeof(string), "~b~Nome: ~w~%s ~y~Local:~w~ %s ~g~Resistencia: ~w~%02d:%02d", PlayerName(localizarjogador[playerid]), zone, Pp[localizarjogador[playerid]][MinutosFerido], Pp[localizarjogador[playerid]][SegundosFerido]);
        		PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], string);
        		PlayerTextDrawShow(playerid, TextDrawAviso3[playerid][0]);
        	}
        	else
        	{
        		SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este jogador nao precisa mais de socorro");
        		KillTimer(TimerLocalizado[playerid]);
        		PlayerTextDrawHide(playerid, TextDrawAviso3[playerid][0]);
        		return 1;
        	}
        }
    }
	return 1;
}

CallBack:: LimparAvisos(playerid)
{
	if(dmsafe[playerid] == 0)
	{
		KillTimer(VLimparAvisos[playerid]);
	}
	else if(dmsafe[playerid] > 0)
	{
		dmsafe[playerid] --;

		new string[2000];
		format(string, sizeof(string), "{FFFFFF}Seu aviso de matar em Area-Safe foi Limpo. {FFD700}({FFFFFF}0%d/03{FFD700}).", dmsafe[playerid]);
		SCM(playerid, -1, string);
	}
	return 1;
}
CallBack:: LimparAvisos2(playerid)
{
    if(AvisoCbug[playerid] >= 1)
    {
        KillTimer(VLimparAvisos[playerid]);
        AvisoCbug[playerid] = 0;
        SCM(playerid, -1, "{00FF00}>> Ant-CBUG: Avisos de C-BUG Limpos, Bom RP.");
    }
	return 1;
}
CallBack:: JogadorFerido(playerid)
{
	if(Pp[playerid][Logado] == true && Pp[playerid][Ferido] == true && CriandoPersonagem[playerid] == false)
	{
		if(Pp[playerid][SegundosFerido] > 0)
		{
		    Pp[playerid][SegundosFerido] --;
		}
		if(Pp[playerid][SegundosFerido] == 0 && Pp[playerid][MinutosFerido] >= 1)
		{
		    Pp[playerid][SegundosFerido] = 59;
		    Pp[playerid][MinutosFerido] --;
		}
		if(Pp[playerid][SegundosFerido] == 0 && Pp[playerid][MinutosFerido] == 0)
		{
            if(Pp[playerid][TemPlano] == 0)
            {
                KillTimer(ProtecaoAlgemas[playerid]);
    			ProtecaoAlgemas[playerid] = 0;
    			KillTimer(TimerFerido[playerid]);
    			TimerFerido[playerid] = 0;
    			SetPlayerHealth(playerid, 50.0);

    			Pp[playerid][Ferido] = false;
    			Pp[playerid][MinutosFerido] = 0;
    			Pp[playerid][SegundosFerido] = 0;
                KillTimer(ProtecaoAlgemas[playerid]);
                SetPlayerInterior(playerid, 3);
                SetPlayerVirtualWorld(playerid, 333);
    			new index = random(sizeof(CamasHospital));
    			SetPlayerPos(playerid, CamasHospital[index][0], CamasHospital[index][1], CamasHospital[index][2]);
    			ClearAnimations(playerid);
    			SetTimerEx("DCANIM", 5001, false, "d", playerid);
    			Impostos[DinheiroDispGov] += 1200;

    			SCM(playerid, COR_VERMELHO, "{FFD700}Hospital: {FFFFFF}Voce nao resistiu aos ferimentos e foi levado ao hospital {FFD700}-R$1200.");
    			GameTextForPlayer(playerid, "~w~Governo Federal ~n~ ~g~Voce Pagou R$1.200.00 ~n~ ~w~Por Ser Salvo!", 1200, 6);

    			SetTimerEx("CarregandoObjetos", 5000, false, "d", playerid);
    			Controle(playerid, 0);

                for(new i = 1; i < 4; i++)
                {
                    PlayerTextDrawHide(playerid, TextDrawMorte[playerid][i]);
                }
    			SalvarDados(playerid);
            }
            else if(Pp[playerid][TemPlano] == 1)
            {
                KillTimer(ProtecaoAlgemas[playerid]);
    			ProtecaoAlgemas[playerid] = 0;
    			KillTimer(TimerFerido[playerid]);
    			TimerFerido[playerid] = 0;
    			SetPlayerHealth(playerid, 50.0);

    			Pp[playerid][Ferido] = false;
    			Pp[playerid][MinutosFerido] = 0;
    			Pp[playerid][SegundosFerido] = 0;
                KillTimer(ProtecaoAlgemas[playerid]);

                Impostos[DinheiroDispGov] += 3200;

    			SCM(playerid, COR_VERMELHO, "{FFD700}Hospital: {FFFFFF}Voce Tem um Plano e foi levado ao Hospital.");
                for(new i = 1; i < 3; i++){PlayerTextDrawShow(playerid, TdCarregarINT[playerid][i]);}

    			SetTimerEx("CarregandoObjetos", 5000, false, "d", playerid);
    			Controle(playerid, 0);

                for(new i = 1; i < 4; i++)
                {
                    PlayerTextDrawHide(playerid, TextDrawMorte[playerid][i]);
                }
    			SalvarDados(playerid);
                SpawnPlayer(playerid);
            }
			return 1;
		}
		new string[10000];
		format(string, sizeof(string), "~w~Tempo de Resistencia: %02d:%02d", Pp[playerid][MinutosFerido], Pp[playerid][SegundosFerido]);
		PlayerTextDrawSetString(playerid, TextDrawMorte[playerid][2], string);
		ApplyAnimation(playerid, "CRACK", "CGCRPDETH2", 4.1, 1, 1, 1, 0, 0, 1);
		return 1;
	}
	return 1;
}


CallBack:: IsPolicial(playerid)
{
	if(IsPlayerConnected(playerid))
	{
	    new lider = Pp[playerid][OrgLider];
	    new sublider = Pp[playerid][OrgSubLider];
	    new member = Pp[playerid][OrgMembro];
	    if(member==1 || member==2 || member==3 || member==4
        || member==5 || member==6 || member==7 || member==8
        || member==9 || member==10 || member==23
        || member==25 || member==27 || member== 29 || member==36
        || member==37 || member==38 || member== 39 || member==40
        || member==44 || member==45 || member== 47)
		{
		    return 1;
		}
		else if(lider==1 || lider==2 || lider==3 || lider==4
        || lider==5 || lider==6 || lider==7 || lider==8 || lider==9
        || lider==10 || lider==23 || lider==25 || lider==27 || lider== 29 || lider==36
        || lider==37 || lider==38 || lider==39 || lider== 29 || lider==40
        || lider==44 || lider==45 || lider== 47)
		{
		    return 1;
		}
		else if(sublider==1 || sublider==2 || sublider==3 || sublider==4
        || sublider==5 || sublider==6 || sublider==7 || sublider==8
        || sublider==9 || sublider==10 || sublider==23
        || sublider==25 || sublider==27 || sublider== 29 || sublider==36
        || sublider==37 || sublider==38 || sublider== 39 || sublider==40
        || sublider==44 || sublider==45 || sublider== 47)
		{
		    return 1;
		}
	}
	return 0;
}

CallBack:: IsGoverno(playerid)
{
	if(IsPlayerConnected(playerid))
	{
	    new lider = Pp[playerid][OrgLider];
	    new sublider = Pp[playerid][OrgSubLider];
	    new member = Pp[playerid][OrgMembro];
	    if(member==1)
		{
		    return 1;
		}
		else if(lider==1)
		{
		    return 1;
		}
		else if(sublider==1)
		{
		    return 1;
		}
	}
	return 0;
}

CallBack:: IsBandido(playerid)
{
	if(IsPlayerConnected(playerid))
	{
	    new lider = Pp[playerid][OrgLider];
	    new sublider = Pp[playerid][OrgSubLider];
	    new member = Pp[playerid][OrgMembro];
	    if(member==11 || member==12 || member==13 || member==14
        || member==16 || member==17 || member==18 || member==19
        || member==20 || member==21 || member==22 || member==24
        || member==26 || member==28 || member==30 || member==31
        || member==32 || member==33 || member==34 || member==35
        || member==41 || member==46 || member==15 || member==48)
		{
		    return 1;
		}
		else if(lider==11 || lider==12 || lider==13 || lider==14
        || lider==16 || lider==17 || lider==18 || lider==19
        || lider==20 || lider==21 || lider==22 || lider==24
        || lider==26 || lider==28 || lider==30 || lider==31
        || lider==32 || lider==33 || lider==34 || lider==35
        || lider==41 || lider==46 || lider==15 || lider==48)
		{
		    return 1;
		}
		else if(sublider==11 || sublider==12 || sublider==13 || sublider==14
        || sublider==16 || sublider==17 || sublider==18 || sublider==19
        || sublider==20 || sublider==21 || sublider==22 || sublider==24
        || sublider==26 || sublider==28 || sublider==30 || sublider==31
        || sublider==32 || sublider==33 || sublider==34 || sublider==35
        || sublider==41 || sublider==46 || sublider==15 || sublider==48)
		{
		    return 1;
		}
	}
	return 0;
}

CallBack:: IsCivil(playerid)
{
	if(IsPlayerConnected(playerid))
	{
	    new lider = Pp[playerid][OrgLider];
	    new sublider = Pp[playerid][OrgSubLider];
	    new member = Pp[playerid][OrgMembro];
	    if(member==0)
		{
		    return 1;
		}
		else if(lider==0)
		{
		    return 1;
		}
		else if(sublider==0)
		{
		    return 1;
		}
	}
	return 0;
}


public OnPlayerEditDynamicObject(playerid, objectid, response, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz)
{
    if(GetPVarInt(playerid, "EditandoPt") == 999)
    {
		if(EditandoPortao[playerid] == true)
		{
            if ( response == EDIT_RESPONSE_FINAL )
            {
		   			new filep[128], p = GetPVarInt(playerid, "EDPT");
				    DestroyDynamicObject(InfoPortao[p][porT]);
				    InfoPortao[p][porT] = CreateDynamicObject(980, x, y, z, rx, ry, rz);
		 			format(filep, sizeof(filep), PASTA_PORTOES, p);
		 			if(!DOF2_FileExists(filep))
		 			{
		 			    DOF2_CreateFile(filep);
					}
					InfoPortao[p][XP] = x;
				    InfoPortao[p][YP] = y;
					InfoPortao[p][ZP] = z;
					InfoPortao[p][RXP] = rx;
					InfoPortao[p][RYP] = ry;
					InfoPortao[p][RZP] = rz;
		 			DOF2_CreateFile(filep);
					DOF2_SetFloat(filep, "X", x);
					DOF2_SetFloat(filep, "Y", y);
					DOF2_SetFloat(filep, "Z", z);
					DOF2_SetFloat(filep, "RX", rx);
					DOF2_SetFloat(filep, "RY", ry);
					DOF2_SetFloat(filep, "RZ", rz);
					DOF2_SetBool(filep, "Criado",true);
					DOF2_SetString(filep, "Dono",PlayerName(playerid));
					DOF2_SaveFile();
					SCM(playerid, -1, "{FFD700}[Dados-Aquivos]: {FFFFFF}Este Portao foi Salvo nos Arquivos da Gamemode Gold City Roleplay");
					EditandoPortao[playerid] = false;
					InfoPortao[p][Cria] = true;
					new st[128];
					DestroyDynamic3DTextLabel(InfoPortao[p][PortLabel]);
	  				format(st, sizeof(st), "{FF8C00}Portao ID: {FFFFFF}%d\nUse: '/abpt'",p);
		   			InfoPortao[p][PortLabel] = CreateDynamic3DTextLabel(st, -1, DOF2_GetFloat(filep, "X"),DOF2_GetFloat(filep, "Y"),DOF2_GetFloat(filep, "Z"), 15.0);
		   			ShowPlayerDialog(playerid, DIALOG_CRIARPT, DIALOG_STYLE_INPUT, "Senha Do {FFD700}Portao", "{FF00FF}: {FFFFFF}Digite uma senha a baixo para seu PORTAO!", "Ok", "");
			}
		}
	}
	if(response == EDIT_RESPONSE_FINAL)
	{
		if(GetPVarInt(playerid, "GRAFITE_EDIT") == 1)
		{
			if(!ISP(playerid, 3, x, y, z))
			{
				DestroyDynamicObject(GRAFITE_object[playerid]);
				DeletePVar(playerid, "GRAFITE_EDIT");
				return SCM(playerid, -1, "Voce nao esta perto da Grafite tag.");
			}

			GRAFITE_positions[playerid][0] = x;
			GRAFITE_positions[playerid][1] = y;
			GRAFITE_positions[playerid][2] = z;
			GRAFITE_positions[playerid][3] = rx;
			GRAFITE_positions[playerid][4] = ry;
			GRAFITE_positions[playerid][5] = rz;

			GRAFITE_timer[playerid] = SetTimerEx("GRAFITE", 1000, true, "ii", playerid, 2);

			ApplyAnimation(playerid, "SPRAYCAN", "spraycan_full", 4.0, 1, 1, 1, 0, 0, 1);

			GRAFITE_timer_left[playerid] = SPRAY_TAG_TIMER;
			DestroyDynamicObject(GRAFITE_object[playerid]);
		}
		if(GetPVarInt(playerid, "GRAFITE_EDIT") == 2)
		{
			new
				iIndex = GRAFITE_slot[playerid]
			;

			if(!ISP(playerid, 3, x, y, z))
			{
				DestroyDynamicObject(GRAFITEs[playerid][iIndex][_spObject]);
				GRAFITE_Spawn(playerid, iIndex);
				DeletePVar(playerid, "GRAFITE_EDIT");
				return SCM(playerid, -1, "Voce nao esta perto da Grafite tag.");
			}

			GRAFITE_positions[playerid][0] = x;
			GRAFITE_positions[playerid][1] = y;
			GRAFITE_positions[playerid][2] = z;
			GRAFITE_positions[playerid][3] = rx;
			GRAFITE_positions[playerid][4] = ry;
			GRAFITE_positions[playerid][5] = rz;

			GRAFITE_timer[playerid] = SetTimerEx("GRAFITE", 1000, true, "ii", playerid, 1);

			ApplyAnimation(playerid, "SPRAYCAN", "spraycan_full", 4.0, 1, 1, 1, 0, 0, 1);

			GRAFITE_timer_left[playerid] = SPRAY_TAG_TIMER;
			DestroyDynamicObject(GRAFITEs[playerid][iIndex][_spObject]);
		}
	}
	if(response == EDIT_RESPONSE_CANCEL)
	{
		if(GetPVarInt(playerid, "GRAFITE_EDIT") >= 1)
		{
			DestroyDynamicObject(GRAFITE_object[playerid]);
			DestroyDynamicObject(GRAFITEs[playerid][GRAFITE_slot[playerid]][_spObject]);
			GRAFITE_Spawn(playerid, GRAFITE_slot[playerid]);
			DeletePVar(playerid, "GRAFITE_EDIT");
		}
	}
	return 1;
}

CallBack:: IsPlayerOnline(name[])
{
	new PlayerName2[MAX_PLAYER_NAME];
 	for(new i=0; i<MAX_PLAYERS; i++)
	{
	    if(Pp[i][Logado] == true)
		{
	    	GetPlayerName(i, PlayerName2, sizeof(PlayerName2));
	    	if(strcmp(name,PlayerName2,true)==0)
			{
		    	return 1;
			}
		}
	}
	return 0;
}
CallBack:: GetPlayerID(string[])
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
    	if(Pp[i][Logado] == true)
		{
        	new testname[MAX_PLAYER_NAME];
	    	GetPlayerName(i, testname, sizeof(testname));
	    	if(strcmp(testname,string,true)==0)
	    	{
	    	    return i;
	    	}
		}
    }
    return INVALID_PLAYER_ID;
}

