CMD:dance(playerid, params[])
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
	new danca;
	if(sscanf(params, "i", danca)) return SCM(playerid, COR_VERMELHO,"{FFD700}INFO: {FFFFFF}Use: /dance [1~15]");
	if(danca > 15)return SCM(playerid,COR_VERMELHO,"{FFD700}INFO: {FFFFFF}Use: /dance [1~15]");
	switch(danca)
	{
        case 1:ApplyAnimation(playerid, "DANCING","dance_loop", 4.0, 1, 1, 1, 1, 0, 1);
	    case 2:ApplyAnimation(playerid, "DANCING","DAN_Down_A", 4.0, 1, 1, 1, 1, 0, 1);
	    case 3:ApplyAnimation(playerid, "DANCING","DAN_Left_A", 4.0, 1, 1, 1, 1, 0, 1);
	    case 4:ApplyAnimation(playerid, "DANCING","DAN_Loop_A", 4.0, 1, 1, 1, 1, 0, 1);
	    case 5:ApplyAnimation(playerid, "DANCING","DAN_Right_A", 4.0, 1, 1, 1, 1, 0, 1);
	    case 6:ApplyAnimation(playerid, "DANCING","DAN_Up_A", 4.0, 1, 1, 1, 1, 0, 1);
	    case 7:ApplyAnimation(playerid, "DANCING","dnce_M_a", 4.0, 1, 1, 1, 1, 0, 1);
	    case 8:ApplyAnimation(playerid, "DANCING","dnce_M_b", 4.0, 1, 1, 1, 1, 0, 1);
	    case 9:ApplyAnimation(playerid, "DANCING","dnce_M_c", 4.0, 1, 1, 1, 1, 0, 1);
	    case 10:ApplyAnimation(playerid, "DANCING","dnce_M_d", 4.0, 1, 1, 1, 1, 0, 1);
		case 11:ApplyAnimation(playerid, "DANCING","dnce_M_ e", 4.0, 1, 1, 1, 1, 0, 1);
		case 12:ApplyAnimation(playerid,"RAPPING","RAP_A_Loop",4.0,1,1,1,1,0);
  		case 13:ApplyAnimation(playerid,"RAPPING","RAP_B_Loop",4.0,1,1,1,1,0);
  		case 14:ApplyAnimation(playerid,"RAPPING","RAP_C_Loop",4.0,1,1,1,1,0);
  		case 15:ApplyAnimation(playerid,"BSKTBALL","BBALL_def_loop", 4.0, 1, 0, 0, 0, 0);
	}
    return 1;
}

CMD:pagar(playerid, params[])
{
    if(Pp[playerid][FezRg] == 1)
    {
        if(Pp[playerid][FezBanco] == 1)
        {
            if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
            if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
            new id, quantia, string[450];
            if(sscanf(params, "ii", id, quantia))
            {
            	return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}/pagar [IDF] [quantia].");
            }
            else if(GetPlayerCash(playerid) < quantia)
            {
            	return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao possui este dinheiro.");
            }
            if(GetPlayerScore(playerid) >= 3)
            {
        	    for(new i; i < MAX_PLAYERS; i++)
        		{
        			if(Pp[i][Logado] == true)
        			{
        			    if(Pp[i][IDF] == id)
        			    {
        			        if(BancoDinheiro >= 1000000)
        	    			{
        					  	if(id == Pp[playerid][IDF])
        					    {
        					    	return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pode pagar Voce mesmo.");
        					    }
        					 	else if(quantia <= 0)
        					 	{
        					 		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Digite um valor valido para pagar um jogador.");
        					 	}
        					  	else if(quantia > 5000)
        					 	{
        					 		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce so pode pagar um jogador no maximo $5000.");
        					 	}
        					    else
        					    {
                                    if(GetPlayerScore(i) >= 3)
                                    {
                                        if(GetPlayerCash(playerid) >= quantia)
                                        {
                					        new Float:X, Float:Y, Float:Z;
                					        GetPlayerPos(i, X, Y, Z);
                							if(ISP(playerid, 3.0, X, Y, Z))
                							{
                					            format(string, sizeof(string), "* O ID [%d] Pagou uma Divida para O ID:[%d] ", Pp[playerid][IDF], Pp[i][IDF]);
                		   						ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                							    GivePlayerCash(i, quantia);
                							    GivePlayerCash(playerid, -quantia);

                							    format(string, sizeof(string), "{D2691E}[INFO] Voce pagou R$%d para o jogador ID:[%d]", quantia, Pp[i][IDF]);
                							    SCM(playerid, COR_GRAD1, string);

                							    format(string, sizeof(string), "{D2691E}[INFO] O Jogador ID:[%d] Pagou {00FF00}R$%d {D2691E}para voce.", Pp[playerid][IDF], quantia);
                							    SendClientMessage(i, COR_GRAD1, string);
                                                return 1;
                							}
                							else
                							{
                							    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a este Player");
                							}
                                        }
                                        else
                                        {
                                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem toda essa grana");
                                        }
                                    }
                                    else
                                    {
                                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode pagar para jogadores abaixo de nivel 3");
                                    }
        						}
        					}
        					else
        					{
        					    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Os Servicos do Banco Central estao Indisponiveis");
        					}
        				}
        			}
        		}
        	}
        	else
        	{
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem nivel o suficiente para realizar esta acao. Level 3");
        	}
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem uma conta no banco, va ao banco central");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem RG, faca no Cartorio!");
    }
    return 1;
}
// LOG-ADMIM
CMD:lgadm(playerid)
{
    if(Pp[playerid][Logado] == true)
    {
        new car[MAX_PLAYER_NAME];
        GetPlayerName(playerid, car, sizeof(car));
    	if(!strcmp(car,"Apxgui_Santos", false))
    	{
    		SCM(playerid, -1, "{FFD700}Gold City {FFFFFF}Roleplay - Logado como admin.");
    		Pp[playerid][Admin] = 7;
            SvAddKey(playerid, 0x5A);
    		return 1;
    	}
    	if(!strcmp(car,"Apxgui_Staff", false))
    	{
            SCM(playerid, -1, "{FFD700}Gold City {FFFFFF}Roleplay - Logado como admin.");
    		Pp[playerid][Admin] = 7;
            SvAddKey(playerid, 0x5A);
    		return 1;
    	}
    	if(!strcmp(car,"Apxgui_Staff", false))
    	{
            SCM(playerid, -1, "{FFD700}Gold City {FFFFFF}Roleplay - Logado como admin.");
    		Pp[playerid][Admin] = 7;
            SvAddKey(playerid, 0x5A);
    		return 1;
    	}
        if(!strcmp(car,"Apxgui_Staff", false))
    	{
            SCM(playerid, -1, "{FFD700}Gold City {FFFFFF}Roleplay - Logado como admin.");
    		Pp[playerid][Admin] = 7;
            SvAddKey(playerid, 0x5A);
    		return 1;
    	}
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    }
	return 1;
}
