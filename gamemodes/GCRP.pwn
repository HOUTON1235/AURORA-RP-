CallBack:: ExplodirDinamite(playerid)
{
	if(CaixaExplodir[playerid] != 0)
	{
	    if(ISP(playerid, 50.0, CaixaInfo[CaixaExplodir[playerid]][CaixaPosX], CaixaInfo[CaixaExplodir[playerid]][CaixaPosY], CaixaInfo[CaixaExplodir[playerid]][CaixaPosZ]))
		{
			new zone[MAX_ZONE_NAME], string[450];
			GetPlayer2DZone(playerid, zone, MAX_ZONE_NAME);

			CreateExplosion(CaixaInfo[CaixaExplodir[playerid]][CaixaPosX], CaixaInfo[CaixaExplodir[playerid]][CaixaPosY], CaixaInfo[CaixaExplodir[playerid]][CaixaPosZ], 2, 5.0);
			CaixaInfo[CaixaExplodir[playerid]][CaixaExplodido] = true;

			DestroyDynamicObject(ObjetoCaixa[CaixaExplodir[playerid]]);
			DestroyDynamicObject(ObjectDinamite[playerid]);

			format(string, sizeof(string), "{FFFFFF}Caixa Explodido\n\n{FFFFFF}ID do Caixa: [{FFD700}%d{FFFFFF}]", CaixaInfo[CaixaExplodir[playerid]][CaixaID]);
			UpdateDynamic3DTextLabelText(TextoCaixa[CaixaExplodir[playerid]], -1, string);

			ObjetoCaixa[CaixaExplodir[playerid]] = CreateDynamicObject(3067, CaixaInfo[CaixaExplodir[playerid]][CaixaPosX], CaixaInfo[CaixaExplodir[playerid]][CaixaPosY], CaixaInfo[CaixaExplodir[playerid]][CaixaPosZ]-0.3, 0.0, 0.0, CaixaInfo[CaixaExplodir[playerid]][CaixaPosR]);

            for(new i; i < MAX_PICKUPS_ROUBO; i++)
        	{
        		Pickups_Roubo[CaixaExplodir[playerid]][i] = CreatePickup(1212, 23, CaixaInfo[CaixaExplodir[playerid]][CaixaPosX]+(RdonPickups[random(sizeof(RdonPickups))][0]),CaixaInfo[CaixaExplodir[playerid]][CaixaPosY]-(RdonPickups[random(sizeof(RdonPickups))][0]),CaixaInfo[CaixaExplodir[playerid]][CaixaPosZ]-0.3);
        	}

			CaixaExplodir[playerid] = 0;

   			for(new i; i < MAX_PLAYERS; i++)
			{
				if(IsPolicial(i))
				{
			    	format(string, sizeof(string), "*** (( RouboGCRP: Um Caixa Eletronico foi explodido nas Proximidades de: %s )) ***", zone);
			    	SendClientMessage(i, COLOR_LIGHTRED, string);
                    GameTextForPlayer(i, "~w~Caixa ~r~Explodido!", 3000, 1);
			    }
			}
		}
		else
		{
		    new orgid2 = GetPlayerOrg(playerid), zone[MAX_ZONE_NAME];
			GetPlayer2DZone(playerid, zone, MAX_ZONE_NAME);
		    format(gstring, sizeof(gstring), "[INFO] A Org: (%s) Falhou e nao conseguiu roubar um Caixa de: %s", OrgInfo[orgid2][OrgNome], zone);
			SendClientMessageToAll(COLOR_LIGHTRED, gstring);
		    DestroyDynamicObject(ObjectDinamite[playerid]);
		    CaixaExplodir[playerid] = 0;
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo ao Caixa e a Acao foi Cancelada");
		}
		return 1;
	}
	if(CaixaExplodir[playerid] == 0)
	{
		new zone[MAX_ZONE_NAME], string[500];
		GetPlayer2DZone(playerid, zone, MAX_ZONE_NAME);

		CreateExplosion(ExplosivoX[playerid], ExplosivoY[playerid], ExplosivoZ[playerid], 2, 5.0);
		DestroyDynamicObject(ObjetoCaixa[playerid]);

		GameTextForPlayer(playerid, "~w~Bomba ~g~Explodida!", 3000, 1);

  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(IsPolicial(i))
			{
		    	format(string, sizeof(string), "*** (( RouboGCRP: Um Explosivo foi explodido nas Proximidades de: %s )) ***", zone);
		    	SendClientMessage(i, COLOR_LIGHTRED, string);
                GameTextForPlayer(i, "~w~Bomba ~r~Explodida!", 3000, 1);
		    }
		}
	}
	return 1;
}

CallBack:: ExplodirDinamiteBanco(playerid)
{
	if(ISP(playerid, 35.0, 2144.1882, 1627.0665, 994.2648))
	{
        new string[450];
		CreateExplosion(BancoX, BancoY, BancoZ, 2, 5.0);

		DestroyDynamicObject(portacofre);
		DestroyDynamicObject(ObjectDinamite[playerid]);

		format(string, sizeof(string), "{FFFFFF}Porta do Cofre {00FF00}Arrombada!");
		UpdateDynamic3DTextLabelText(TextPortaCofre, -1, string);

		format(string, sizeof(string), "~w~Porta do Cofre ~n~ ~g~Aberta!!");
		GameTextForPlayer(playerid, string, 3000, 4);

        BancoDisp = 1;
		new MsgOc[5000];
		format(MsgOc, sizeof(MsgOc), "Todas as Unidades!! O Cofre do Banco do Brasil, Acaba de Ser Invadido");
		MsgOcorrencia(MsgOc);
		return 1;
	}
	return 1;
}

CallBack:: ReparandoVeiculo(playerid)
{
    if(Pp[playerid][Logado] == true)
    {
        if(idvehicle[playerid] > -1)
        {
        	new Float:Heath;
        	GetVehicleHealth(idvehicle[playerid], Float:Heath);
        	if(Heath >= 1000)
        	{
        		KillTimer(VeiculoReparoKit[playerid]);
        		KillTimer(ProtecaoAlgemas[playerid]);
        		Controle(playerid, 1);
        		SetTimerEx("DCANIM", 500, false, "d", playerid);

        		Heath = 1000;
        		SetVehicleHealth(idvehicle[playerid], Heath);
        		SCM(playerid, -1, "{00FF00}Reparo: {FFFFFF}O veiculo que voce estava reparando foi reparo com sucesso.");

        		SegurandoMaoDireita[playerid] = 0;
        		RemovePlayerAttachedObject(playerid, 9);
        		ClearAnimations(playerid);
        		PlayerTextDrawHide(playerid, TextdrawKitReparo[0][playerid]);
        		Pp[playerid][KitReparo] --;
        		return 1;
        	}
        	if(Heath < 1000)
        	{
        		Heath += 100;
        		SetVehicleHealth(idvehicle[playerid], Heath);
        	}
        }
    }
	return 1;
}

CallBack:: AbastecendoVeiculoG(playerid)
{
	if(Combustivel[idvehicle[playerid]] < 60)
	{
		KillTimer(VeiculoGalaoGas[playerid]);
		KillTimer(ProtecaoAlgemas[playerid]);
		Controle(playerid, 1);
		SetTimerEx("DCANIM", 500, false, "d", playerid);

        Combustivel[idvehicle[playerid]] += 20;
		SCM(playerid, -1, "{00FF00}Galao: {FFFFFF}Veiculo {00FF00}Abastecido."), GameTextForPlayer(playerid, "~g~Abastecido", 1200, 1);

		SegurandoMaoDireita[playerid] = 0;
		RemovePlayerAttachedObject(playerid, 9);
		ClearAnimations(playerid);
		PlayerTextDrawHide(playerid, TextdrawGalaoGas[0][playerid]);
		Pp[playerid][GasGalao] -= 20;
		return 1;
	}
	return 1;
}

CallBack:: ReparandoVeiculoMec(playerid)
{
	new Float:Heath;
	GetVehicleHealth(idvehicle[playerid], Float:Heath);
	if(Heath < 9999)
	{
		KillTimer(VeiculoReparoKit[playerid]);
		ReparandoVeiculo2[playerid] = 0;
		RepairVehicle(idvehicle[playerid]);

		Heath = 1000;
		SetVehicleHealth(idvehicle[playerid], Heath);
		RepairVehicle(idvehicle[playerid]);
		SCM(playerid, -1, "{00FF00}Reparo: {FFFFFF}O veiculo que voce estava reparando foi reparo com sucesso.");
        GameTextForPlayer(playerid, "~w~Veiculo ~g~Reparado!", 3000, 3);
		ClearAnimations(playerid);
		PlayerTextDrawHide(playerid, TextdrawReparo[0][playerid]);
		Pp[playerid][Ferramentas] -= 1;
		return 1;
	}
	return 1;
}
