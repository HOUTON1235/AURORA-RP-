formatTime()
{
    new output[24], date[3], hour[3];
    getdate(date[2], date[1], date[0]);
    gettime(hour[0], hour[1], hour[2]);
    format(output, sizeof(output), "%02d/%02d/%04d - %02d:%02d:%02d", date[0], date[1], date[2], hour[0], hour[1], hour[2]);
    return output;
}
// Comandos
CMD:trazercofre(playerid, params[])
{
	if(Pp[playerid][Admin] < 6)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem autorizacao para usar este comando.");
	new id;
	if(sscanf(params, "i", id))return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /trazercofre [id da org do 11 ao 39]");
	{
	    if(id >= 11 && id < 50)
	    {
	        new Float:XX, Float:YY, Float:ZZ, Float:RR, string[550];
     		GetPlayerPos(playerid, XX, YY, ZZ);
     		GetPlayerFacingAngle(playerid, RR);

            CofreInfo[id][CofreID] = id;
			CofreInfo[id][CofrePosX] = XX;
			CofreInfo[id][CofrePosY] = YY;
			CofreInfo[id][CofrePosZ] = ZZ;
			CofreInfo[id][CofrePosR] = RR;

			SetPlayerPos(playerid, XX, YY, ZZ+5);

			DestroyDynamicObject(ObjetoCofre[id]);
			DestroyDynamic3DTextLabel(TextoCofreOrg[id]);

			ObjetoCofre[id] = CreateDynamicObject(3796, CofreInfo[id][CofrePosX], CofreInfo[id][CofrePosY], CofreInfo[id][CofrePosZ]-1, 0.0, 0.0, CofreInfo[id][CofrePosR]);
			format(string, sizeof(string), "{FFFFFF}ID Cofre: %d\nAperte {FFD700}H\n{FFFFFF}Para Abrir o Menu do Bau", CofreInfo[id][CofreID]);
			TextoCofreOrg[id] = CreateDynamic3DTextLabel(string, -1, CofreInfo[id][CofrePosX], CofreInfo[id][CofrePosY], CofreInfo[id][CofrePosZ]+1, 25.0);

			SendClientMessageEx(playerid, -1, "{00CED1}[Debug] Voce atualizou o cofre da org %s do id %d", OrgInfo[id][OrgNome], id);
			SalvarCofreF(id);
	    }
	    else
	    {
	        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce so pode colocar orgs do 11 ao 49");
	    }
	}
	return 1;
}
CMD:clima(playerid, params[])
{
	if(Pp[playerid][Admin] < 5)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando.");
    new id, string[550];
	if(sscanf(params, "i", id))
	{
		return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /clima [ID do clima]");
	}
	SetWeather(id);
	format(string, sizeof(string), "[CLIMA] O CLIMA DO SERVIDOR FOI ALTERADO PARA O ID [%d]", id);
	SendClientMessageToAll(0xFFDC33FF, string);
	return 1;
}
CMD:modificarorg(playerid, params[])
{
    if(Pp[playerid][Admin] < 6)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem autorizacao para usar este comando.");
	new id;
	if(sscanf(params, "i", id))
	{
		return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /modificarorg [ID da org]");
	}
	OrgConfigID[playerid] = id;
	MenuModificarOrg(playerid);
	return 1;
}
CMD:mudarorg(playerid)
{
    if(Pp[playerid][OrgLider] >= 1)
    {
        new car[MAX_PLAYER_NAME];
        GetPlayerName(playerid, car, sizeof(car));
        if(!strcmp(car,"Juan_Gamer", false))
        {
            new string[1000], mercada[100];
            strcat(string, "Nome\tFuncionalidade\n");
            format(mercada, sizeof(mercada), "{FFFFFF}Tropa do Juan\t{FFDC33}Principal\n");
            strcat(string, mercada);
            format(mercada, sizeof(mercada), "{FFFFFF}Tropa do Juan\t{FFDC33}Secundaria\n");
            strcat(string, mercada);

            return ShowPlayerDialog(playerid, DIALOG_MUDARORGJ, DIALOG_STYLE_TABLIST_HEADERS, "Suas Orgs {FFD700}Gold City", string, "Alternar", "X");
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e o Juan_Gamer");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta como lider de nenhuma org.");
    }
    return 1;
}
CMD:mudarimpostos(playerid)
{
    if(Pp[playerid][OrgLider] == 1 || Pp[playerid][OrgSubLider] == 1 || Pp[playerid][OrgMembro] == 1)
    {
        if(!ISP(playerid, 2.0, 1490.7418,1307.7142,1093.2891))return 1;
        MenuGovernoF(playerid);
    }
    return 1;
}
CMD:noite(playerid)
{
    if(Pp[playerid][Admin] >= 6)
    {
        SetWorldTime(0);
    }
    return 1;
}
CMD:pegarentregas(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(Pp[playerid][Profissao] == PROF_BIGBK)
    {
        if(ISP(playerid, 2.0, 1337.1536,-1562.0483,13.6893))
        {
            if(BcBigBk[playerid] == 1)
		    {
                new vehicleid = GetPlayerVehicleID(playerid);
    			if(vehicleid == CarroEventoProfs[playerid])
    			{
        			if(ProdutosVeh[vehicleid] == 0)
        			{
        				new indx2 = random(sizeof(EntregasBK));
            			SetPlayerCheckpoint(playerid, EntregasBK[indx2][0], EntregasBK[indx2][1], EntregasBK[indx2][2], 1.0);
            			SCM(playerid, -1, "{FFDC33}Entregas: {FFFFFF}Foi marcado em seu mapa a localizacao da primeira entrega.");
                        SCM(playerid, -1, "{FFDC33}Entregas: {FFFFFF}Quando chegar la, use: /pegarlanche na van e o entregue.");
            			GameTextForPlayer(playerid, "~w~Entregas ~g~Carregadas", 2000, 4);
        				ProdutosVeh[vehicleid] = 10;
        				return 1;
        			}
        			else
        			{
        		    	SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Veiculo ja esta carregado.");
        			}
        		}
        		else
        		{
        		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em uma Van Industrial");
        		}
            }
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Uniformizado");
            }
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta no Local de Procura de Entregas");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um(a) Transportador(a) Industrial");
    }
    return 1;
}
CMD:pegarlanche(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(Pp[playerid][Profissao] == PROF_BIGBK)
    {
        if(BcBigBk[playerid] == 1)
    	{
            for(new v; v < MAX_VEHICLES; v++)
            {
                new Float:X, Float:Y, Float:Z;
                GetVehiclePos(v, X, Y, Z);
                if(ISP(playerid, 3.0, X, Y, Z))
                {
                    if(ProdutosVeh[v] >= 1)
            		{
                        ProdutosVeh[v] -= 1;
                        PegouProd[playerid] = 1;
                        SCM(playerid, -1, "{FFDC33}Entregas: {FFFFFF}Voce pegou um lanche na mao, use: /entregarl no local marcado");
                        GameTextForPlayer(playerid, "~w~Lanche ~g~Pego!", 3000, 4);
                        SetPlayerAttachedObject(playerid, 9, 1271, 1, 0.3689, 0.5740, 0.0000, 0.0000, 0.0000, 0.0000, 1.0000, 1.0000, 1.0000);//caixa - box
                        ApplyAnimation(playerid, "CARRY", "CRRY_PRTIAL", 4.1, 0, 0, 0, 1, 1, 1);
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Veiculo nao tem Nenhum Produto, Pegue m ais no BK");
                    }
                }
            }
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Uniformizado.");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um(a) Transportador(a) Industrial");
    }
    return 1;
}
CMD:entregarl(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(Pp[playerid][Profissao] == PROF_BIGBK)
    {
        if(PegouProd[playerid] == 1)
        {
            for(new i; i < 63; i++)
            {
                if(ISP(playerid, 2.0, EntregasBK[i][0], EntregasBK[i][1], EntregasBK[i][2]))
            	{
                    if(BcBigBk[playerid] == 1)
    		        {
                        DisablePlayerRaceCheckpoint(playerid);
                        DisablePlayerCheckpoint(playerid);
                        new string[450], granaa = 250 + random(250);
                        PegouProd[playerid] = 0;
                        GivePlayerCash(playerid, granaa);
                        RemovePlayerAttachedObject(playerid, 9);
                        new indx2 = random(sizeof(EntregasBK));
            			SetPlayerCheckpoint(playerid, EntregasBK[indx2][0], EntregasBK[indx2][1], EntregasBK[indx2][2], 1.0);
            			SCM(playerid, -1, "{FFDC33}Entregas: {FFFFFF}Foi marcado em seu mapa a localizacao da primeira entrega.");
                        SCM(playerid, -1, "{FFDC33}Entregas: {FFFFFF}Quando chegar la, use: /pegarlanche na van e o entregue.");
                        SendClientMessageEx(playerid, -1, "{00FF00}Entregas: {FFFFFF}Voce entregou um Lanche e Ganhou: {00FF00}R$%d", granaa);
                        GameTextForPlayer(playerid, "~w~Lanche ~g~Entregue!", 3000, 4);
                        SetTimerEx("DCANIM", 500, false, "d", playerid);
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Uniformizado.");
                    }
                }
            }
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem nenhum lanche em maos.");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um(a) Entregador[BK]");
    }
    return 1;
}
CMD:pntab(playerid, params[])
{
	if(Pp[playerid][Admin] >= 3)
	{
	    new nickle[30 + 1], string[450];
	    if(sscanf(params,"s[30]",nickle))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /pntab [Nome Do Jogador]");
		{
            new id = GetPlayerID(nickle);
			if(IsPlayerOnline(nickle))
			{
                new ip[128];
        	    GetPlayerIp(id,ip,128);
                format(string, sizeof(string), "Info: Nome: %s / ID[Tab]: %d / IDF:[%d] / IP: %s", PlayerName(id), id, Pp[id][IDF], ip);
			    SCM(playerid, -1, string);
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando.");
    }
    return 1;
}

CMD:pntabn(playerid, params[])
{
	if(Pp[playerid][Admin] >= 3)
	{
	    new id, string[450];
	    if(sscanf(params,"i",id))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /pntabn [id[Tab] Do Jogador]");
		{
            if(IsPlayerConnected(id))
        	{
                new ip[128];
            	GetPlayerIp(id,ip,128);
                format(string, sizeof(string), "Info: Nome: %s / ID[Tab]: %d / IDF:[%d] / IP: %s", PlayerName(id), id, Pp[id][IDF], ip);
    			SCM(playerid, -1, string);
            }
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este player nao esta online.");
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando.");
    }
    return 1;
}
CMD:camaleao(playerid)
{
	if(Pp[playerid][Camaleao] == 1)
	{
        if(!IsPlayerInAnyVehicle(playerid)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um Veiculo");
	    if(AtivadoC[playerid] == 0)
	    {
	        AtivadoC[playerid] = 1;
	    	SCM(playerid, -1, "{FFFFFF}Camaleao: {FFFFFF}Voce ativou o modo camaleao nos veiculos");
	    	GameTextForPlayer(playerid, "~w~Camaleao ~g~Ativo!", 3000, 1);
	    	TempoCamaleao[playerid] = SetTimerEx("CamaleaoT", 200, true, "i", playerid);
	    }
	    else if(AtivadoC[playerid] == 1)
	    {
	        AtivadoC[playerid] = 0;
	    	SCM(playerid, -1, "{FFFFFF}Camaleao: {FFFFFF}Voce desativou o modo camaleao dos veiculos");
	    	GameTextForPlayer(playerid, "~w~Camaleao ~r~Desativado!", 3000, 1);
	    	KillTimer(TempoCamaleao[playerid]);
	    }
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem um Pacote Carro Camaleao");
	}
	return 1;
}
CMD:mudarsenha(playerid)
{
    if(AutorizadoSenha[playerid] == 1)
    {
        format(arquivo, sizeof(arquivo), PASTA_CONTAS, PlayerName(playerid));
		if(DOF2_FileExists(arquivo))
	    {
            ShowPlayerDialog(playerid, DIALOG_MUDARSENHA, DIALOG_STYLE_INPUT, "{FFFFFF}Mudar {FFD700}Senha","{FFFFFF}Digite a senha para subistituir\n{FFFFFF}Cuidado ao Digitar, pois pode dar muito errado", "Redefinir", "X");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando.");
    }
    return 1;
}
CMD:permitirsenha(playerid, params[])
{
    if(Pp[playerid][Admin] >= 6)
    {
        new id, string[450];
		if(sscanf(params, "i", id))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /permitirsenha [IDF]");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
                    if(AutorizadoSenha[i] == 0)
                    {
                        SendClientMessageEx(playerid, -1, "{FFDC33}Arquivos: {FFFFFF}Voce autorizou o Jogador: %s[%d] a mudar a senha dele.", PlayerName(i), Pp[i][IDF]);
                        SendClientMessageEx(i, -1, "{00FF00}Arquivos: {FFFFFF}O Admin: %s[%d] autorizou voce a mudar sua senha, use: /mudarsenha.", PlayerName(playerid), Pp[playerid][IDF]);
                        GameTextForPlayer(playerid, "~b~Autorizado", 1200, 1), GameTextForPlayer(i, "~g~Autorizado", 1200, 1);
                        AutorizadoSenha[i] = 1;
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este jogador ja foi autorizado a mudar a senha.");
                    }
                }
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando.");
    }
    return 1;
}
