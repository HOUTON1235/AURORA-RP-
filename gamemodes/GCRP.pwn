    	}
    	else
    	{
    	    SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce Nao Esta no Cartorio da sua Cidade");
    	}
    }
	return 1;
}
CMD:dormir(playerid)
{
    if(Pp[playerid][Sono] < 20)
    {
        for(new i = 1; i < 3; i++)
        {
            PlayerTextDrawShow(playerid, TextDrawSono[playerid][i]);
        }
        DormindoP[playerid] = 1;
        ContagemDormir[playerid] = 60;
		TimerAcordar[playerid] = SetTimerEx("AcordarP", 1000, true, "i", playerid);
		TogglePlayerControllable(playerid, 0);
		ProtecaoAlgemas[playerid] = SetTimerEx("k", 500, true, "d", playerid);
    	ApplyAnimation(playerid, "CRACK", "cGCRPdeth2", 4.1, 1, 1, 1, 0, 0, 1);
    	SCM(playerid, -1, "{FFD700}Sono-Info: {FFFFFF}Voce esta dormindo, Zzz Zzz");
        return 1;
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ainda nao esta cansado para dormir agora.");
    }
    return 1;
}

CMD:mijar(playerid)
{
    if(Pp[playerid][Bexiga] < 80)
    {
        new string[450];
        format(string, sizeof(string), "* O ID:[%d] Esta Mijando", Pp[playerid][IDF]);
        ProxDetector(30.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
        SetPlayerSpecialAction(playerid, 68);
        Pp[playerid][Bexiga] += 16;
        GameTextForPlayer(playerid, "~w~Urinando...", 5001, 3);
        SetTimerEx("DCANIM2", 5000, false, "d", playerid);
        return 1;
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ainda nao esta Apertado.");
        return 1;
    }
}
CMD:plantar(playerid)
{
	if(Pp[playerid][Sementes] == 0) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce Nao Tem Nenhuma Semente!");
	ApplyAnimation(playerid,"BOMBER","BOM_Plant_Loop",2.0,1,0,0,0,0);
	SetTimerEx("PlantarMaconhas", 5000, false, "i", playerid);
	GameTextForPlayer(playerid, "~w~Plantando...", 5000, 3);
	SCM(playerid, -1, "{FFFFFF}Plantando Maconha...!");
	return 1;
}
CMD:colhermaconha(playerid)
{
	for(new i = 0 ;i<MAX_MACONHAS;i++)
	{
		if(MaconhaInfo[i][MaconhaUsada] == true && MaconhaInfo[i][Pronta] == true)
		{
			if(ISP(playerid, 4.0, MaconhaInfo[i][XM],MaconhaInfo[i][YM],MaconhaInfo[i][ZM]))
			{
				if(!new_strcmp(MaconhaInfo[i][Dono],PlayerName(playerid)))
				{
					return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce Nao Pode Fazer Isso!");
				}
				Pp[playerid][Droga] += MaconhaInfo[i][Gramas];
				new Str[5000];
				format(Str, sizeof(Str), "{48D1CC}| Maconha | {FFFFFF}Voce Colheu: %dg de Maconha!", MaconhaInfo[i][Gramas]);
				SCM(playerid, -1, Str);
				GameTextForPlayer(playerid, "~y~Colhida!", 5000, 3);
				DestroyDynamicObject(MaconhaInfo[i][MudaMac]);
				Delete3DTextLabel(MaconhaInfo[i][MudaMac3D]);
				MaconhaInfo[i][MaconhaUsada] = false;
				return 1;
			}
		}
	}
	return 1;
}
CMD:colocarfogo(playerid)
{
	if(IsPolicial(playerid))
	{
		for(new i = 0 ;i<MAX_MACONHAS;i++)
		{
			if(MaconhaInfo[i][MaconhaUsada] == true)
			{
				if(ISP(playerid, 5.0, MaconhaInfo[i][XM],MaconhaInfo[i][YM],MaconhaInfo[i][ZM]))
				{
				    ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 1, 1, 0, 0, 1);
					MaconhaInfo[i][Timer2] = SetTimerEx("colocarfogo", 1000, true, "ii",playerid,i);
					GameTextForPlayer(playerid, "~y~Colocando Fogo!!", 1000, 3);
					return 1;
				}
			}
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Policial");
	}
	return 1;
}
CMD:venderpecasv(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(ISP(playerid, 2.0, -636.4114,1446.8098,13.9965))
    {
		if(PecasDesmanchadas[playerid] >= 10)
		{
            DisablePlayerRaceCheckpoint(playerid);
            DisablePlayerCheckpoint(playerid);
            new granaa = 8000 + random(2000), string[450];
		    Pp[playerid][DinheiroSujo] += granaa;
		    SendClientMessageEx(playerid, -1, "{FFDC33}Desmanche: {FFFFFF}Voce vendeu: [%d] pecas pelo valor de R$%d de {FFD700}dinheiro sujo.", PecasDesmanchadas[playerid], granaa);
            GameTextForPlayer(playerid, "~w~10 Pecas ~g~Vendidas!", 3000, 6);
            PecasDesmanchadas[playerid] = 0;
		    return 1;
		}
		else
		{
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem 5 Sementes no Bolso!");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Fazendeiro");
    }
    return 1;
}
CMD:desmancharv(playerid)
{
	if(ISP(playerid, 2.0, 1309.2191,141.4081,21.3041))
	{
        if(IsBandido(playerid))
        {
            if(GetPlayerScore(playerid) >= 5)
            {
                if(AcessouMenuCar[playerid] == 0)
                {
                    if(AcessouMenuCarInv[playerid] == 0)
                    {
                        new vehicleid = GetPlayerVehicleID(playerid);
                	    if(IsPlayerInAnyVehicle(playerid))
                	    {
                            if(!InAnyBike(playerid))
                        	{
                                if(!InAnyMoto(playerid))
                        	    {
                                    if(VeiculoSpawnado[playerid] == 0)
                                    {
                                        if(vehicleid != VehConce[playerid])
                                        {
                                            for(new i; i < MAX_PLAYERS; i++)
                                            {
                                                if(vehicleid == CarroEventoProfs[i])
                                                {
                                                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode desmanchar veiculos de profissoes.");
                                                    return 1;
                                                }
                                                else if(PecasDesmanchadas[playerid] == 0)
                                                {
                                                    if(VeiculoOrgDT[vehicleid] == 0)
                                                    {
                                                        ShowPlayerDialog(playerid, DIALOG_DESMANCHE, DIALOG_STYLE_LIST, "Desmanche de {FFDC33}Veiculos", "{FFDC33}>> {FFFFFF}Desmanchar este veiculo", "Selecionar", "X");
                                                    }
                                                    else
                                                    {
                                                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este veiculo e de org e nao pode ser desmanchado!");
                                                    }
                                                }
                                                else
                                                {
                                                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja tem 10 pecas de veiculos desmanchadas, venda-as");
                                                }
                                                return 1;
                                            }
                                        }
                                        else
                                        {
                                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode desmanchar seu proprio veiculo.");
                                        }
                                    }
                                    else
                                    {
                                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode desmanchar um veiculo com o seu spawnado.");
                                    }
                                }
                                else
                                {
                        			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Nao desmanchamos motos.");
                        		}
                            }
                            else
                            {
                    			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Nao desmanchamos bikes");
                    		}
                        }
                		else
                        {
                			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em nenhum veiculo");
                		}
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode desmanchar tendo um veiculo de Inv Spawnado.");
                    }
                }
                else
                {
                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode desmanchar tendo um veiculo de Inv Spawnado.");
                }
            }
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem nivel 5 ou mais.");
            }
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um criminoso.");
        }
    }
	return 1;
}
CMD:desmanchar(playerid)
{
    if(Pp[playerid][Profissao] != PROF_CARROFORTE)
    {
    	if(ISP(playerid, 10.0, 1289.3651,205.7563,20.9037))
    	{
    	    new vehicleid = GetPlayerVehicleID(playerid), string[450], orgid = GetPlayerOrg(playerid), MsgOc[5000];
    	    if(!IsPlayerInAnyVehicle(playerid)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um Veiculo");
    	    {
    	        if(Desmanchando[vehicleid] == 0)
    	        {
    	            if(Desman[playerid] == 0)
    	            {
                        if(vehicleid == CarroEventoProfs[playerid])
	                    {
    					    if(MalotesCr[vehicleid] == 10)
    					    {
                                new zone[MAX_ZONE_NAME];
                                GetPlayer2DZone(playerid, zone, MAX_ZONE_NAME);
                                format(gstring, sizeof(gstring), "[INFO] A Org: (%s) Esta Tentando Desmanchar um Transportador de Valores nas Proximidades de: %s", OrgInfo[orgid][OrgNome], zone);
            					SendClientMessageToAll(COLOR_LIGHTRED, gstring);

            					for(new ip; ip < MAX_PLAYERS; ip++)
            					{
            						if(IsPolicial(ip))
                                    {
            						   	new Float:x,Float:y,Float:z;
            							GetPlayerPos(playerid, x,y,z);
            							SetPlayerCheckpoint(ip, x,y,z, 6);
            							GameTextForPlayer(ip, "~w~Desmanche ~r~Marcado!", 3000, 1);
                                        CheckPointProfissao[ip] = 1;
            						}
            					}
            					format(MsgOc, sizeof(MsgOc), "OCORRENCIA!! A Faccao %s Esta Tentando Desmanchar um Transportador de Valores nas Proximidades de: %s", OrgInfo[orgid][OrgNome], zone);
            					MsgOcorrencia(MsgOc);

    				            Desman[playerid] = 1;
    					        Desmanchando[vehicleid] = 1;
    							SCM(playerid, -1, "{FFFFFF}Desmanche: {FFFFFF}Voce Esta Desmanchando Um Veiculo, Aguarde 30 Segundos...!");
    							format(string, sizeof(string), "* %d Esta Desmanchando um Veiculo...", Pp[playerid][IDF]);
    							ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
    							GameTextForPlayer(playerid, "~r~Desmanchando...!", 30000,3);
    							Desmanchar[playerid] = SetTimerEx("DesmancharVeh", 30000, false, "i", playerid);
    							Controle(playerid, 0);
    							ProtecaoAlgemas[playerid] = SetTimerEx("k", 500, true, "d", playerid);
    						}
    						else
    						{
    						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Transportador de Valores nao esta Carregado");
    						}
    					}
    					else
    					{
    					    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um Transportador de Valores");
    					}
    				}
    				else
    				{
    				    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja esta desmanchando um Veiculo, Aguarde 30 Segundos");
    				}
    			}
    			else
    			{
    			    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Veiculo Ja Esta Sendo Desmanchado");
    			}
    		}
    	    return 1;
    	}
    	else
    	{
    	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta no Desmanche");
    	}
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode desmanchar um veiculo sendo Trans.CarroFT");
    }
	return 1;
}
CMD:carregarcr(playerid)
{
 	if(Pp[playerid][Profissao] == PROF_CARROFORTE)
	{
	    if(ISP(playerid, 2.0, 1347.5717,348.3924,20.0862))
		{
		    if(BcCarroForte[playerid] == 1)
		    {
                new vehicleid = GetPlayerVehicleID(playerid);
	            if(vehicleid == CarroEventoProfs[playerid])
	            {
				    if(MalotesCr[vehicleid] < 10)
				    {
				        MalotesCr[vehicleid] = 10;
				        new string[450], rand6666 = random(sizeof(RandCarroFt));//VspawnPris;
						format(string, sizeof(string), "{00FF00}>> Bank: {FFFFFF}Voce Carregou seu Caminhao com %d Malotes, Leve Para o Local Marcado!", MalotesCr[vehicleid]);
						SCM(playerid, -1, string);
						format(string, sizeof(string), "* %d Carregou seu Caminhao com %d Malotes.", Pp[playerid][IDF], MalotesCr[vehicleid]);
			    		ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
			    		GameTextForPlayer(playerid, "~r~Carregado!", 2000,3);
		                GameTextForPlayer(playerid, "~g~+10 MALOTES", 5000,1);
						SetPlayerRaceCheckpoint(playerid, 0, RandCarroFt[rand6666][0], RandCarroFt[rand6666][1], RandCarroFt[rand6666][2], RandCarroFt[rand6666][3],0,0,7);
				        return 1;
					}
					else
					{
					    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode Carregar Mais de 10 Malotes no Seu Caminhao");
					}
				    return 1;
				}
				else
	   			{
	   			    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um Transportador de Valores");
				}
			}
			else
			{
			    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao Bateu seu Cartao");
			}
		    return 1;
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta na Area de Carregamento");
		}
	    return 1;
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Transportador de Valores'r");
	}
	return 1;
}
