    		   	ProxDetector(15.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                new Float:vida;
    	        GetPlayerHealth(playerid, Float:vida);
			    SetPlayerHealth(playerid, vida-2);
                SCM(playerid, COR_VERMELHO, "{FFDC33}INFO: {FFFFFF}Sua bexiga esta cheia, use: /mijar, voce esta perdendo vida..");
                GameTextForPlayer(playerid, "~w~Voce esta com ~y~a bexiga cheia", 2000, 3);
    		}
    		else if(Pp[playerid][Bexiga] < 4)
    		{
    			SCM(playerid, COR_RED, "{FFDC33}INFO: {FFFFFF}Voce esta com muita Urina! Mije em algo! - /Mijar");
    			GameTextForPlayer(playerid, "~w~/mijar", 2000, 1);
    		}
        }
	}
	return 1;
}

CallBack:: AttSono(playerid)
{
    if(Pp[playerid][Logado] == true)
	{
        if(Trabalhando[playerid] == false)
		{
    		Pp[playerid][Sono] --;

    		if(Pp[playerid][Sono] < 3)
    		{
                new string[450];
                format(string, sizeof(string), "* O ID [%d] esta com loucura por falta de descanso. ", Pp[playerid][IDF]);
    		   	ProxDetector(15.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                new Float:vida;
    	        GetPlayerHealth(playerid, Float:vida);
			    SetPlayerHealth(playerid, vida-2);
                SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce esta maluco! use: /dormir, voce esta perdendo vida..");
                GameTextForPlayer(playerid, "~w~Voce esta ~r~Maluco", 2000, 3);
    		}
    		else if(Pp[playerid][Sono] < 4)
    		{
    			SCM(playerid, COR_RED, "{FFD700}INFO: {FFFFFF}Voce esta com muito sono! durma usando: /dormir");
    			GameTextForPlayer(playerid, "~w~/dormir", 2000, 3);
    		}
        }
	}
	return 1;
}

CallBack:: AcordarP(playerid)
{
    if(Pp[playerid][Logado] == true)
	{
        if(DormindoP[playerid] == 1)
        {
            new Str[5000];
            if(ContagemDormir[playerid] >= 1)
            {
                ContagemDormir[playerid] -= 1;
                format(Str, sizeof(Str), "~w~Tempo para Acordar: %02d/60", ContagemDormir[playerid]);
                PlayerTextDrawSetString(playerid, TextDrawSono[playerid][2], Str);
                PlayerTextDrawShow(playerid, TextDrawSono[playerid][2]);
            }
            else
            {
                for(new i = 1; i < 3; i++)
                {
                    PlayerTextDrawHide(playerid, TextDrawSono[playerid][i]);
                }
                KillTimer(ProtecaoAlgemas[playerid]);
                ClearAnimations(playerid);
               	SetTimerEx("DCANIM", 500, false, "d", playerid);
                GameTextForPlayer(playerid, "~w~Acordou!", 4000, 4);
                Controle(playerid, 1);
                Pp[playerid][Sono] = 100;
                ContagemDormir[playerid] = 0;
                DormindoP[playerid] = 0;
                new string[450];
            	format(string, sizeof(string), "* O ID [%d] Acordou Apos um Desmaio. ", Pp[playerid][IDF]);
            	ProxDetector(15.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
    		}
        }
	}
    return 1;
}

