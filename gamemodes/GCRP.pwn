	return 1;
}

CMD:menuvip(playerid)
{
	return MostrarLojaCoins(playerid);
}

CMD:su(playerid, params[])
{
	if(IsPolicial(playerid))
	{
	    new id, estrelas, string[450], Float:X, Float:Y, Float:Z;
	    if(sscanf(params,"ii",id,estrelas))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /su [IDF] [Estrelas]");
	    {
   			for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
				        if(id == Pp[playerid][IDF])
						{
				 			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Alto Acusdar de um Crime!");
						 	return 1;
						}
						GetPlayerPos(i, X, Y, Z);
						if(ISP(playerid, 3.0, X, Y, Z))
		 				{
							if(estrelas >= 1 && estrelas < 6)
							{
							    if(GetPlayerWantedLevel(i) < 6)
							    {
							        new ProcuradoP[MAX_PLAYERS];
							        ProcuradoP[i] = GetPlayerWantedLevel(i);
							        ProcuradoP[i] += estrelas;
				    				SetPlayerWantedLevel(i, ProcuradoP[i]);
				    				ProcuradoP[i] = 0;
									SalvarDados(i);
									GameTextForPlayer(i, "~r~Acusado!", 1500, 0);
				     				format(string, sizeof(string), "* O ID:[%d] Setou Estrelas de Acusacao no ID:[%d]", Pp[playerid][IDF], Pp[i][IDF]);
									ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
									SendClientMessageEx(playerid, COR_PURPLE, "[INFO] Voce Acusou o Player %s Com %d Estrelas",PlayerName(i), estrelas);
									SendClientMessageEx(i, COR_PURPLE, "[INFO] O Policial: %s Te Acusou Com %d Estrelas",PlayerName(playerid), estrelas);
									return 1;
					    		}
							    else
							    {
			        				SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player ja tem 6 Estrelas");
								}
							}
						    else
							{
							    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce pode encriminar o Player com No Minimo 1 Estrela, e no maximo 6 estrelas");
							}
						}
						else
						{
						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a este Player");
						}
					}
				}
			}
			return 1;
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Policial");
	}
	return 1;
}

CMD:fecharsenha(playerid, params[])
{
	if(Pp[playerid][Admin] >= 1)
	{
		new id;
		if(sscanf(params, "i", id))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /fecharsenha [IDF]");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
				    SenhaAt[i] = 0;
				    Fila--;

					format(gstring, sizeof(gstring), "{FFD700}[ ATENDIMENTO ]: {FFFFFF}O Staff %s[%d] Fechou seu Atendimento!", PlayerName(playerid), Pp[playerid][IDF]);
					SendClientMessage(i, COR_BLUE, gstring);

					format(gstring, sizeof(gstring), "{FFD700}[ ATENDIMENTO ]: {FFFFFF}Voce fechou o Atendimento do Player: %s[%d].", PlayerName(i), Pp[i][IDF]);
					SCM(playerid, COR_BLUE, gstring);
					return 1;
				}
			}
		}
		return 1;
	}
	else
	{
		SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	}
	return 1;
}

CMD:senha(playerid, params[])
{
    if(Pp[playerid][Admin] != 0)return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Staff's nao pode solicitar Atendimento!");
    else
    {
        if(SenhaAt[playerid] != 0)return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce ja esta aguardando Atendimento!");
        else
        {
            Fila++;
            SenhaAt[playerid] = Fila;
            SCM(playerid,0x0080FFAA,"{FFFFFF}Voce Solicitou a ajuda de um staff, aguarde sua vez chegar!");
            SCM(playerid,0x0080FFAA,"{FFFFFF}Caso nao precise mais, use /sairsenha!");
            foreach(Player, i)
            {
                new string[1200];
                if(Pp[i][Admin] >= 1 && Trabalhando[i] == true)
                {
                    format(string,sizeof(string),"[ AJUDA ]: O Player %s[%d] esta solicitando uma ajuda, use /ir (%d)", PlayerName(playerid), Pp[playerid][IDF], Pp[playerid][IDF]);
                    SendClientMessage(i,COLOR_LIGHTRED,string);
                }
            }
        }
    }
    return true;
}
CMD:sairsenha(playerid,params[])
{
    if(SenhaAt[playerid] == 0)return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao solicitou Atendimento!");
    else
    {
        SenhaAt[playerid] = 0;
        Fila--;
        SCM(playerid,0x0080FFAA,"{FFFFFF}Voce saiu da fila de espera com sucesso!");
    }
    return true;
}
CMD:irsenha(playerid, params[])
{
	if(Pp[playerid][Admin] >= 1)
	{
		new Float:IX, Float:IY, Float:IZ, id, string[450];
		if(sscanf(params, "i", id))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /irsenha [IDF]");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
			        if(id == Pp[playerid][IDF])
			        {
						SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Dar TP");
			        }
			        if(SenhaAt[i] == 0)
			        {
			            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player nao usou /senha...");
			        }
			        else
			        {
					    SenhaAt[i] = 0;
					    Fila--;
						GetPlayerPos(i, Float:IX, Float:IY, Float:IZ);

						if (GetPlayerState(playerid) == 2)
	     				{
	         				new tmpcar = GetPlayerVehicleID(playerid);
	             			SetVehiclePos(tmpcar, IX, IY+4, IZ);
					 		LinkVehicleToInterior(tmpcar, 0);
	             			TelePos[playerid][0] = 0.0;
					 		TelePos[playerid][1] = 0.0;
	             		}
	             		else
	             		{
	             		    SetPlayerPos(playerid, IX, IY, IZ);
	             		}

	             		if(GetPlayerInterior(i) > 0)
	               		{
	                 		SetPlayerInterior(playerid, GetPlayerInterior(i));
	                 		Pp[playerid][Interior] = GetPlayerInterior(i);
	                        Pp[playerid][VirtualW] = GetPlayerVirtualWorld(i);
	                   	}
	                   	SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(i));

                        //Carregamento
                		SetTimerEx("CarregandoObjetos", 5000, false, "d", playerid);
                        for(new i22; i22 < 4; i22++){PlayerTextDrawShow(playerid, TdCarregarINT[playerid][i22]);}
                		Controle(playerid, 0);

                        GameTextForPlayer(playerid, "~w~TP", 3000, 1);

                        GameTextForPlayer(i, "~w~TP", 3000, 1);

						format(string, sizeof(string), "{FFFFFF}O Staff %s teleportou ate sua posicao", PlayerName(playerid));
						SendClientMessage(i, COR_BLUE, string);

						format(string, sizeof(string), "{FFD700}>> TP: {FFFFFF}Voce teleportou ate a posicao do jogador %s.", PlayerName(i));
						SCM(playerid, COR_BLUE, string);
						return 1;
					}
				}
			}
		}
		return 1;
	}
	else
	{
		SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	}
	return 1;
}
CMD:atendimentos(playerid, params[])
{
    if(Pp[playerid][Admin] >= 1)
	{
        if(Pp[playerid][Logado] == true)
        {
            new stg[5000];
         	for(new i; i < MAX_PLAYERS; i++)
        	{
         		if(Pp[i][Logado] == true)
        	   	{
                    if(SenhaAt[i] >= 1)
    	            {
