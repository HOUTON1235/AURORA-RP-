CallBack:: DescarregandoCaminhaoCA(playerid)
{
    new vehicleid = GetPlayerVehicleID(playerid);
	if(vehicleid == CarroEventoProfs[playerid])
	{
  		if(ProdutosCA[vehicleid] >= 1)
	    {
		    new dinheiromt = 1500 + random(2500), string[450];
		    GivePlayerCash(playerid, dinheiromt);
		    ProdutosCA[vehicleid] = 0;
            DescarregandoCaminhao[playerid] = 0;
		    KillTimer(TimerCaminhoneiroDES[playerid]);
		    KillTimer(ProtecaoAlgemas[playerid]);
		    GameTextForPlayer(playerid, "~w~Descarregado!", 5000, 6);
            SendClientMessageEx(playerid, COR_VERDE, "{FFFFFF}[GCRP] Os Funcionarios Descarregaram seu Caminhao e Voce Ganhou: {00FF00}R$%d {FFFFFF}Belo Trabalho! Pegue mais Produtos!", dinheiromt);
		    Controle(playerid, 1);
		}
	}
	return 1;
}
CallBack:: GRAFITE_Dialog(iPlayerID, iType)
{
	new
		szDialog[500],
		szText[50],
		szFont[50],
		szBold[4],
		szColor[30]
	;

	switch(iType)
	{
		case TYPE_LIST_MENU:
		{
			ShowPlayerDialog(iPlayerID, GRAFITE_MENU, DIALOG_STYLE_LIST, "{F7EC6F}Grafite Tag - {469BF0}Menu", "Criar Grafite tag\nEditar Grafite tag\nDeletar Grafite tag\nRastrear tag's", "Selecionar", "Sair");
		}
		case TYPE_LIST_CREATE:
		{
			switch(GRAFITE_bold[iPlayerID])
			{
				case 0: szBold = "Nao";
				case 1: szBold = "Sim";
			}
			switch(GRAFITE_color[iPlayerID])
			{
				case -65536: szColor = "{FF0000}Vermelho";
				case -16468988: szColor = "{04B404}Verde";
				case -16730675: szColor = "{00B5CD}Azul Claro";
				case -256: szColor = "{FFFF00}Amarelo";
				case -16776961: szColor = "{0000FF}Azul";
				case -8092540: szColor = "{848484}Cinza";
				case -65281: szColor = "{FF00FF}Rosa";
				case -1: szColor = "{FFFFFF}Branco";
			}

			format(szText, 50, GRAFITE_text[iPlayerID]);
			format(szFont, 50, GRAFITE_font[iPlayerID]);

			format(szDialog, sizeof szDialog, "\
				{F7EC6F}Texto: %s\n\
				{F7EC6F}Fonte: %s\n\
				{F7EC6F}Tamanho: %d\n\
				{F7EC6F}Cor: %s\n\
				{F7EC6F}Negrito: %s\n\
				{FFB957}Criar Tag",
