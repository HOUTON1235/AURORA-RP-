CMD:alugarmoto(playerid)
{
    for(new i; i < 8; i++)
    {
        if(ISP(playerid, 2.0, LocaisSpawnM[i][0], LocaisSpawnM[i][1], LocaisSpawnM[i][2]))
    	{
    		if(VehAlugado[playerid] == 0)
    		{
                if(ISP(playerid, 2.0, LocaisSpawnM[3][0], LocaisSpawnM[3][1], LocaisSpawnM[3][2]))
        	    {
                    ShowPlayerDialog(playerid, DIALOG_ALUGUELB2, DIALOG_STYLE_MSGBOX, "Aluguel {FFD700}Moto", "{FFFFFF}Voce Deseja alugar uma Moto?\n{FFFFFF}Valor de Aluguel da Moto: {00FF00}R$20\n{FFFFFF}Aperte em Alugar para adquirir a sua!", "Alugar", "X");
                }
                else if(ISP(playerid, 2.0, LocaisSpawnM[4][0], LocaisSpawnM[4][1], LocaisSpawnM[4][2]))
        	    {
                    ShowPlayerDialog(playerid, DIALOG_ALUGUELB2, DIALOG_STYLE_MSGBOX, "Aluguel {FFD700}Moto", "{FFFFFF}Voce Deseja alugar uma Moto?\n{FFFFFF}Valor de Aluguel da Moto: {00FF00}R$20\n{FFFFFF}Aperte em Alugar para adquirir a sua!", "Alugar", "X");
                }
                else
                {
                    ShowPlayerDialog(playerid, DIALOG_ALUGUELB, DIALOG_STYLE_MSGBOX, "Aluguel {FFD700}Moto", "{FFFFFF}Voce Deseja alugar uma Moto?\n{FFFFFF}Valor de Aluguel da Moto: {00FF00}R$20\n{FFFFFF}Aperte em Alugar para adquirir a sua!", "Alugar", "X");
                }
            }
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja alugou uma Moto, Use: /entregarmoto");
            }
        }
    }
    return 1;
}

CMD:carvip(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(Pp[playerid][Vip] >= 4)
    {
        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode criar um carro estando dentro de um.");
        {
            new Float:Pos[3];
            GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
            if(AcessouMenuCar[playerid] == 0)
            {
                if(GetPlayerInterior(playerid) == 0)
                {
                    CarroEvento[playerid] = CreateVehicle(560, Pos[0], Pos[1], Pos[2], 90, 6, 6, false);
                    PutPlayerInVehicle(playerid, CarroEvento[playerid], 0);
                    cmd_trancar(playerid);
                    AcessouMenuCar[playerid] = 1;
                    GameTextForPlayer(playerid, "~w~Veiculo ~y~Vip ~n~ ~g~Spawnado!", 3000, 3);
                    SCM(playerid, -1, "{FFDC33}InfoVIP: {FFFFFF}Voce spawnou seu Veiculo Vip, Para Sair dele, Bom Proveito");
                    new string[1200];
	                format(string, sizeof(string), "* O ID:[%d]: Spawnou seu Veiculo Vip Diamante", Pp[playerid][IDF]);
                    ProxDetector(20.0, playerid, string, COR_PURPLE, COR_PURPLE, COR_PURPLE,COR_PURPLE,COR_PURPLE);
                }
                else
                {
                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode spawnar veiculos aqui!");
                }
            }
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja tem um Veiculo de INV-Vip Spawnado");
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem permissao, ou nao e Vip Diamante");
    }
    return 1;
}

