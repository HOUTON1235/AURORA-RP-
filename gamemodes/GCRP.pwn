			    {
					new string[1200];
					Pp[i][Youtuber] = level;
					SalvarDados(i);

					if(level == 1)
					{
						format(string,sizeof(string),"AdmCMD: %s definiu o jogador %s como Youtuber Mirim", PlayerName(playerid), PlayerName(i));
		            	SendClientMessageToAll(COLOR_LIGHTRED, string);
					}
					else if(level == 2)
					{
						format(string,sizeof(string),"AdmCMD: %s definiu o jogador %s como Youtuber Oficial", PlayerName(playerid), PlayerName(i));
		            	SendClientMessageToAll(COLOR_LIGHTRED, string);
					}
					format(string, sizeof(string), "SERVER: Voce definiu o jogador %s como um membro youtuber", PlayerName(i));
					SCM(playerid, -1, string);
					format(string, sizeof(string), "SERVER: O Admin %s te setou Youtuber, Use: /ajuda - Youtuber", PlayerName(playerid));
					SendClientMessage(i, -1, string);
					return 1;
				}
			}
		}
		return 1;
	}
	else SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	return 1;
}

CMD:setadmin(playerid, params[])
{
	if(Pp[playerid][Admin] >= 7)
	{
		new id, level;
		if(sscanf(params, "ii", id, level))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /setadmin [IDF] [level]");
		}
		else if(level < 0 || level > 7)
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Os valor tem que ser entre 1 e 4");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
					new string[1200];
					Pp[i][Admin] = level;

					format(string, sizeof(string), "SERVER: Voce definiu o jogador %s como um membro da staff", PlayerName(i));
					SCM(playerid, -1, string);

					format(string,sizeof(string),"AdmCMD: %s definiu o jogador %s como %s", PlayerName(playerid), PlayerName(i), NomeAdm(level));
		            SendClientMessageToAll(COLOR_LIGHTRED, string);

					return 1;
				}
			}
		}
		return 1;
	}
	else SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	return 1;
}

CMD:setlevel(playerid, params[])
{
	if(Pp[playerid][Admin] >= 5)
	{
		new id, level;
		if(sscanf(params, "ii", id, level))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /setlevel [IDF] [level].");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
					new string[1200];
					format(string, sizeof(string), "{FFFFFF}O Staff %s setou level %d para o jogador %s.", PlayerName(playerid), level, PlayerName(i));
		            SendClientMessageToAll(COLOR_LIGHTRED, string);
		            SetPlayerScore(i, level);
