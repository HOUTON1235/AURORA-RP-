    if(dialogid == DIALOG_CRIARVSPAWNEMP)
	{
		if(response)
		{
			if(listitem == 0)
			{
                new Float:XX, Float:YY, Float:ZZ, Float:RR;
        		for(new i; i < MAX_SPAWNS; i++)
        		{
        			format(arquivo, sizeof(arquivo), PASTA_SPAWNSEMP, i);
        			if(!DOF2_FileExists(arquivo))
        			{
        				GetPlayerPos(playerid, Float:XX, Float:YY, Float:ZZ);
                        GetPlayerFacingAngle(playerid, Float:RR);

        				DOF2_CreateFile(arquivo);
        				DOF2_SetInt(arquivo, "SpID", i);
                        DOF2_SetInt(arquivo, "SpProf", PROF_SAMU);
                        DOF2_SetInt(arquivo, "SpIDVEH", 416);

        				DOF2_SetFloat(arquivo, "SpPosX", XX);
        				DOF2_SetFloat(arquivo, "SpPosY", YY);
        				DOF2_SetFloat(arquivo, "SpPosZ", ZZ);
        				DOF2_SetFloat(arquivo, "SpPosR", RR);
        				DOF2_SaveFile();

