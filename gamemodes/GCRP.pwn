						SCM(playerid, COR_GRAD1, "{FFD700}Lanches: {FFFFFF}Voce comprou uma {FFD700}Refrigerante{FFFFFF} e pode beber-lo usando /beber");
						SCM(playerid, COR_GRAD1, "{FFD700}Lanches: {FFFFFF}Para Guardar Este Item em Sua Mochila, Aperte Y ou Use: /guardaritem");
					}
					else if(SegurandoMaoDireita[playerid] > 0)
					{
						SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce esta com as maos cheias.");
					}
                }
			}
