	if(dialogid == DIALOG_DEPOSITO)
	{
	    if(response)
		{
			new dinheiro = strval(inputtext);
			if(dinheiro > GetPlayerCash(playerid))
			{
				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Insira um valor que voce possui em suas maos.");
				ShowPlayerDialog(playerid, DIALOG_DEPOSITO, DIALOG_STYLE_INPUT, "Banco - {FFFDC33}Deposito", "{FFFFFF}Digite Abaixo o Valor que Voce Deseja Depositar\n{FFDC33}Banco Central GCRP", "Depositar", "X");
				return 1;
			}
			else if(dinheiro < 0)
			{
				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Insira um valor positivo.");
				ShowPlayerDialog(playerid, DIALOG_DEPOSITO, DIALOG_STYLE_INPUT, "Banco - {FFDC33}Deposito", "{FFFFFF}Digite Abaixo o Valor que Voce Deseja Depositar\n{FFDC33}Banco Central GCRP", "Depositar", "X");
			}
			else
			{
				new year, month, day, hour, minute, second;
				getdate(year, month, day);//getamos a data em ANO:MES:DIA
				gettime(hour,minute,second);//getamos o tempo em HORAS:MINUTOS:SEGUNDOS
				GivePlayerCash(playerid, - dinheiro);
				Pp[playerid][SaldoBancario] = Pp[playerid][SaldoBancario] + dinheiro;
				SalvarDados(playerid);
                // Saldo
                new str[5000];
                format(str,sizeof(str),"%d", Pp[playerid][SaldoBancario]);
                PlayerTextDrawSetString(playerid, TextDrawCaixaL[playerid][18], str); //ok

				new string[1200];
				format(string, sizeof(string), "{FFFFFF}Voce depositou em sua conta bancaria, {00FF00}[R$%d].", dinheiro);
				SCM(playerid, -1, string);
				GameTextForPlayer(playerid, "~w~Valor ~g~Depositado!", 3200, 1);
			}
		}
	}
