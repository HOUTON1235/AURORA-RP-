}

CMD:tvoff(playerid)
{
	if(Pp[playerid][Admin] >= 1)
	{
	    if(Trabalhando[playerid] == true)
		{
			SetPlayerSkin(playerid, 217);
		}
	    SCM(playerid, -1, "{FFFFFF}Info: Voce saiu do Modo Tv dos Admins");
		TogglePlayerSpectating(playerid, 0);
        PlayerTextDrawHide(playerid, TextDrawAviso2[playerid][0]);
        PlayerSpectatePlayer(playerid, playerid);
		PlayerSpectateVehicle(playerid, GetPlayerVehicleID(playerid));
	}
	else SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	return 1;
}

