CMD:dempresa(playerid, params[])
{
	if(Pp[playerid][Admin] >= 4)
	{
		new id, arquivoCA[5000], mensagem[128];
		if(sscanf(params, "i", id)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /dempresa [ID da Empresa].");
		{
		    if(ISP(playerid, 2.0, EmPp[id][EmpresaX], EmPp[id][EmpresaY], EmPp[id][EmpresaZ]))
			{
				format(arquivoCA, sizeof(arquivoCA), PASTA_EMPRESA, id);
				if(DOF2_FileExists(arquivoCA))
				{
				    DOF2_RemoveFile(arquivoCA);
					format(mensagem, sizeof(mensagem), "{FFD700}[Info-Empresa]: {FFFFFF}Voce deletou a Empresa id: %d.", id);
				    SCM(playerid, 0xFF0000FF, mensagem);
				    DestroyDynamicPickup(PickupEmpresa[id]);
        			DestroyDynamicMapIcon(MapIconEmpresa[id]);
        			DestroyDynamic3DTextLabel(TextoEmpresa[id]);
				    EmPp[id][EmpresaX] = 0;
					EmPp[id][EmpresaY] = 0;
					EmPp[id][EmpresaZ] = 0;
					EmPp[id][EmpresaInteriorX] = 0;
					EmPp[id][EmpresaInteriorY] = 0;
					EmPp[id][EmpresaInteriorZ] = 0;
					return 1;
				}
				else
				{
			        format(mensagem, sizeof(mensagem), "{FFD700}INFO: {FFFFFF}A Empresa [%d] Nao Existe nso Arquivos do Servidor.", id);
					SCM(playerid, 0xFF0000FF, mensagem);
				}
			}
			else
			{
			    format(mensagem, sizeof(mensagem), "{FFD700}INFO: {FFFFFF}Voce nao esta Proximo da Empresa Id: %d.", id);
				SCM(playerid, 0xFF0000FF, mensagem);
			}
		}
	}
	return 1;
}

CMD:venderempresa(playerid, params[])
{
	for(new i = 0; i < MAX_EMPRESAS; i++)
	{
		if(ISP(playerid, 10.0, EmPp[i][EmpresaX], EmPp[i][EmpresaY], EmPp[i][EmpresaZ]))
		{
			format(arquivo, sizeof(arquivo), PASTA_EMPRESA, i);
   			if(strcmp(DOF2_GetString(arquivo, "EmpresaDono"), PlayerName(playerid), false))
			{
				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Essa empresa nao pertence a voce.");
				return 1;
			}
			else if(EmPp[i][EmpresaAVenda] == 1)
			{
		        SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Sua empresa ja esta a venda.");
		        return 1;
			}
			else
			{
				if(IsPlayerConnected(playerid))
				{
					format(gstring, sizeof(gstring), "{FFDC33}INFO: {FFD700}O Jogador(a) {FFDC33}%s {FFD700} esta vendendo sua empresa ID: [%d] no valor de {00FF00}R$%d", PlayerName(playerid), EmPp[i][EmpresaId], EmPp[i][EmpresaValor]);
	                SendClientMessageToAll(COR_GREY, gstring);
	                Pp[playerid][Empresa] = -1;

	                GivePlayerCash(playerid, EmPp[i][EmpresaValor]);

	                DOF2_SetString(arquivo, "EmpresaDono", "Nenhum");
	                DOF2_SetInt(arquivo, "EmpresaAVenda", 1);
					DOF2_SetInt(arquivo, "EmpresaPickup", 19132);
					DOF2_SaveFile();

					format(EmPp[i][EmpresaDono], 30, DOF2_GetString(arquivo, "EmpresaDono"));
					EmPp[i][EmpresaAVenda] = DOF2_GetInt(arquivo, "EmpresaAVenda");
					EmPp[i][EmpresaPickup] = DOF2_GetInt(arquivo, "EmpresaPickup");

					DestroyDynamicPickup(PickupEmpresa[i]);
					DestroyDynamicMapIcon(MapIconEmpresa[i]);
                    DestroyDynamic3DTextLabel(TextoEmpresa[i]);

					PickupEmpresa[i] = CreateDynamicPickup(EmPp[i][EmpresaPickup], 23, EmPp[i][EmpresaX], EmPp[i][EmpresaY], EmPp[i][EmpresaZ]);
					MapIconEmpresa[i] = CreateDynamicMapIcon(EmPp[i][EmpresaX], EmPp[i][EmpresaY], EmPp[i][EmpresaZ], EmPp[i][EmpresaMapIcon], 0, -1, -1, -1, 100.0, MAPICON_LOCAL);

                    new string[450];
				    format(string, sizeof(string), "{FFD700} Empresa Gold City\n\n{FFFFFF}Empresa ID: {FFDC33}%d\n{FFFFFF}Valor da Empresa: {00FF00}%d\n{FFFFFF}Aperte {FFD700}Y\n{FFFFFF}Nome da Empresa: %s\nFundos da Empresa: {00FF00}R$%d", EmPp[i][EmpresaId], EmPp[i][EmpresaValor], EmPp[i][EmpresaNome], EmPp[i][EmpresaValores]);
                    TextoEmpresa[i] = CreateDynamic3DTextLabel(string, -1, EmPp[i][EmpresaX], EmPp[i][EmpresaY], EmPp[i][EmpresaZ]+1, 15.0);
					return 1;
				}
			}
		}
	}
	return 1;
}

CMD:sacarempresa(playerid, params[])
{
	for(new i = 0; i < MAX_EMPRESAS; i++)
	{
		if(ISP(playerid, 10.0, EmPp[i][EmpresaX], EmPp[i][EmpresaY], EmPp[i][EmpresaZ]))
		{
            new granasacar;
    		if(sscanf(params, "i", granasacar))return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /sacarempresa [Valor]");
    		{
    			format(arquivo, sizeof(arquivo), PASTA_EMPRESA, i);
       			if(strcmp(DOF2_GetString(arquivo, "EmpresaDono"), PlayerName(playerid), false))
    			{
    				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Essa empresa nao pertence a voce.");
    				return 1;
    			}
    			else
    			{
    				if(IsPlayerConnected(playerid))
    				{
                        if(EmPp[i][EmpresaValores] >= granasacar)
                        {
        					format(gstring, sizeof(gstring), "{FFDC33}INFO: {FFD700}O Jogador(a) {FFDC33}%s {FFD700}sacou de sua empresa o valor de: {00FF00}R$%d", PlayerName(playerid), granasacar);
        	                SendClientMessageToAll(COR_GREY, gstring);
                            EmPp[i][EmpresaValores] -= granasacar;

        	                GivePlayerCash(playerid, granasacar);
    					    return 1;
                        }
                        else
                        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Sua empresa nao tem tudo isso de Dinheiro");
                        }
    				}
    			}
            }
		}
	}
	return 1;
}

CMD:mudarentrada(playerid, params[])
{
	for(new i = 0; i < MAX_EMPRESAS; i++)
	{
		if(ISP(playerid, 10.0, EmPp[i][EmpresaX], EmPp[i][EmpresaY], EmPp[i][EmpresaZ]))
		{
            new granamud;
    		if(sscanf(params, "i", granamud))return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /mudarentrada [Valor]");
    		{
    			format(arquivo, sizeof(arquivo), PASTA_EMPRESA, i);
       			if(strcmp(DOF2_GetString(arquivo, "EmpresaDono"), PlayerName(playerid), false))
    			{
    				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Essa empresa nao pertence a voce.");
    				return 1;
    			}
    			else
    			{
    				if(IsPlayerConnected(playerid))
    				{
                        if(granamud < 1000)
                        {
        					format(gstring, sizeof(gstring), "{FFDC33}INFO: {FFD700}O Jogador(a) {FFDC33}%s {FFD700} Alterou o Valor de Entrada de uma Empresa Para: {00FF00}R$%d", PlayerName(playerid), granamud);
        	                SendClientMessageToAll(COR_GREY, gstring);
                            EmPp[i][EmpresaValoresRC] = granamud;
                            DOF2_SetInt(arquivo, "EmpresaValoresRC", granamud);
    					    return 1;
                        }
                        else
                        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode colocar a entrada da empresa a mais do que R$1000");
                        }
    				}
    			}
            }
		}
	}
	return 1;
}

CMD:saldoempresa(playerid, params[])
{
	for(new i = 0; i < MAX_EMPRESAS; i++)
	{
		if(ISP(playerid, 10.0, EmPp[i][EmpresaX], EmPp[i][EmpresaY], EmPp[i][EmpresaZ]))
		{
            format(arquivo, sizeof(arquivo), PASTA_EMPRESA, i);
       		if(strcmp(DOF2_GetString(arquivo, "EmpresaDono"), PlayerName(playerid), false))
    		{
    			SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Essa empresa nao pertence a voce.");
    			return 1;
    		}
    		else
    		{
    			if(IsPlayerConnected(playerid))
    			{
        			format(gstring, sizeof(gstring), "{FFD700}[ EMPRESA ]: {FFFFFF}Sua Empresa Tem {00FF00}R$%d {FFFFFF}De Saldo no Cofre", EmPp[i][EmpresaValores]);
        	        SCM(playerid, COR_GREY, gstring);
    				return 1;
    			}
            }
		}
	}
	return 1;
}

CMD:criarcasa(playerid, params[])
{
	if(Pp[playerid][Admin] >= 4)
	{
		new valor, interior;
