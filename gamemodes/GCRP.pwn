forward AtendenteMira(playerid);
public AtendenteMira(playerid)
{
	new Str[5000];
	if(IsBandido(playerid))
	{
		if(AssantandoBanco[playerid] == 1)
		{
		    if(ISP(playerid, 10.0, 2142.9478,1605.9424,993.5684)) // Mira na Cabeca do BotAtendente
			{
			    if(TempoAttBot[playerid] < 30)
			    {
			        TempoAttBot[playerid] += 1;
			        format(Str, sizeof(Str), "~r~Aguarde ~n~ ~w~%02d/30", TempoAttBot[playerid]);
			        GameTextForPlayer(playerid, Str, 1000, 3);
			    }
			    else
			    {
			        SCM(playerid, -1, "{FFFFFF}Voce ameacou o Vigilante, e ele abriu a Porta do Setor N?1");
					GameTextForPlayer(playerid, "~w~Porta ~g~Aberta!", 1000, 3);
					KillTimer(TimerBotMira[playerid]);
					TempoAttBot[playerid] = 0;
					MoveDynamicObject(portaacesso, 2143.1123, 1606.7130, 993.7818+10, 2.0, 0.00000, 0.00000, 0.0);
                    for(new i; i < 4; i++)
                    {
                        DestroyDynamicPickup(PickDinheiro[i]);
                    }
                    // Dinheiro no Chao
                    PickDinheiro[0] = CreateDynamicPickup(1550, 1, 2145.1687, 1640.3270, 993.5761, 0);
                    PickDinheiro[1] = CreateDynamicPickup(1550, 1, 2146.1750, 1630.0837, 993.5761, 0);
                    PickDinheiro[2] = CreateDynamicPickup(1550, 1, 2144.4607, 1634.4076, 993.5761, 0);
                    PickDinheiro[3] = CreateDynamicPickup(1550, 1, 2142.1033, 1637.1849, 993.5761, 0);
			    }
			}
		}
	}
    return 1;
}
forward AtendenteMira2(playerid);
public AtendenteMira2(playerid)
{
	new Str[5000];
	if(IsBandido(playerid))
	{
		if(RoubandoJO[playerid] == 1)
		{
		    if(ISP(playerid, 10.0, 1856.1652,-1593.0793,13.6703)) // Mira na Cabeca do BotAtendente
			{
			    if(TempoAttBot[playerid] < 20)
			    {
			        TempoAttBot[playerid] += 1;
			        format(Str, sizeof(Str), "~r~Aguarde ~n~ ~w~%02d/20", TempoAttBot[playerid]);
			        GameTextForPlayer(playerid, Str, 1000, 3);
			    }
			    else
			    {
                    for(new i; i < 4; i++)
                    {
                        DestroyDynamicPickup(PickDinheiroJO[i]);
                    }
                    // Dinheiro no Chao
                    PickDinheiroJO[0] = CreateDynamicPickup(1550, 1, 1856.9838,-1595.7874,13.6703, 0);
                    PickDinheiroJO[1] = CreateDynamicPickup(1550, 1, 1856.9806,-1590.1964,13.6703, 0);
                    PickDinheiroJO[2] = CreateDynamicPickup(1550, 1, 1870.3042,-1590.4778,13.6703, 0);
                    PickDinheiroJO[3] = CreateDynamicPickup(1550, 1, 1870.3246,-1596.9133,13.6703, 0);
			        SCM(playerid, -1, "{FFFFFF}Voce ameacou a Fiscal de Joias e ela falou onde esta dinheiro da loja");
					GameTextForPlayer(playerid, "~w~Dinheiro Localizado, pegue-os!", 1000, 3);
					KillTimer(TimerBotMira[playerid]);
					TempoAttBot[playerid] = 0;
                    RoubandoJO[playerid] = 0;
                    JODisp = 1;
			    }
			}
		}
	}
    return 1;
}
forward AttDyna2(playerid);
public AttDyna2(playerid)
{
	new Str[5000];
	if(IsBandido(playerid))
	{
		if(AssantandoBanco[playerid] == 1)
		{
		    if(ISP(playerid, 10.0, 2144.1882, 1627.0665, 994.2648)) // Mira na Cabeca do BotAtendente
			{
			    if(TempoAttDyna[playerid] < 90)
			    {
			        TempoAttDyna[playerid] += 1;
			        format(Str, sizeof(Str), "~r~Aguarde ~n~ ~w~%02d/90", TempoAttDyna[playerid]);
			        GameTextForPlayer(playerid, Str, 1000, 3);
			    }
			    else
			    {
			        SCM(playerid, -1, "{FFFFFF}Voce plantou a Bomba, Aguarde + 30 segundos...");
					GameTextForPlayer(playerid, "~w~Plantada!", 3000, 3);
					KillTimer(TimerDyna[playerid]);
					KillTimer(ProtecaoAlgemas[playerid]);
                    TempoDinamite[playerid] = SetTimerEx("ExplodirDinamiteBanco", 30000, false, "i", playerid);
					Controle(playerid, 1);
					SetTimerEx("DCANIM", 200, false, "i", playerid);
					TempoAttDyna[playerid] = 0;
			    }
			}
		}
	}
    return 1;
}

public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
    if((newkeys & 40 == 40 && 40 != oldkeys & 40) && GetPlayerState(playerid) == 2)
	{
		SetPVarInt(playerid, "Use", 1);
		SetTimerEx("Status", 10000, 0, "i", playerid);
	}
	else
	{
		SetPVarInt(playerid, "Use", 0);
	}
    if(newkeys & KEY_FIRE && oldkeys & KEY_CROUCH && IsCbugWeapon(playerid))
    {
        CallLocalFunction("OnPlayerMakeCBug", "i", playerid);
    }
    // Portoes
    if(newkeys == KEY_CROUCH)
    {
        cmd_pt(playerid);
        cmd_pegarentrega(playerid);
        cmd_mecanica(playerid);
    }
    // Abrir partes do veiculo Apertando H
    if(newkeys == KEY_CTRL_BACK)
	{
        cmd_pt(playerid);
        if(!IsPlayerInAnyVehicle(playerid))
		{
            for(new v; v < MAX_VEHICLES; v++)
            {
                new Float:X, Float:Y, Float:Z;
                GetVehiclePos(v, X, Y, Z);
                if(ISP(playerid, 3.0, X, Y, Z))
                {
                    if(ptml[playerid] == 0)
                    {
                        new
        					mot,
        					lu,
        					alar,
        					por,
        					cap,
        					porma,
        					ob
        				;
        				GetVehicleParamsEx(v, mot, lu, alar, por, cap, porma, ob);
            			SetVehicleParamsEx(v, mot, lu, alar, por, cap, VEHICLE_PARAMS_ON, ob);
            			ptml[playerid] = 1;
                    }
                    else if(ptml[playerid] == 1)
                    {
                        new
                			mot,
                			lu,
                			alar,
                			por,
                			cap,
                			porma,
                			ob
                		;
                        GetVehicleParamsEx(v, mot, lu, alar, por, cap, porma, ob);
                        SetVehicleParamsEx(v, mot, lu, alar, por, cap, VEHICLE_PARAMS_OFF, ob);
            			ptml[playerid] = 0;
                    }
                    if(cp[playerid] == 0)
          			{
          				new
    						mot,
    						lu,
    						alar,
    						por,
    						cap,
    						porma,
    						ob
    					;
    					GetVehicleParamsEx(v, mot, lu, alar, por, cap, porma, ob);
    					SetVehicleParamsEx(v, mot, lu, alar, por, VEHICLE_PARAMS_ON, porma, ob);
    					cp[playerid] = 1;
            		}
    				else if(cp[playerid] == 1)
    				{
    				    new
    						mot,
    						lu,
    						alar,
    						por,
    						cap,
    						porma,
    						ob
    					;
    					GetVehicleParamsEx(v, mot, lu, alar, por, cap, porma, ob);
           				SetVehicleParamsEx(v, mot, lu, alar, por, VEHICLE_PARAMS_OFF, porma, ob);
    	            	cp[playerid] = 0;
            		}
                    ApplyAnimation(playerid, "PED", "CAR_open_RHS", 4.0, 0, 0, 0, 0, 0);
                }
            }
        }
    }
	if(newkeys == KEY_AIM)
	{
	    if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	    {
	        if(IsBandido(playerid))
	        {
	            if(AssantandoBanco[playerid] == 0)
	            {
	                if(BancoDisp == 0)
	                {
				        if(ISP(playerid, 10.0, 2142.9478,1605.9424,993.5684)) // Mira na Cabeca do BotAtendente
						{
						    new Str[5000], orgid = GetPlayerOrg(playerid), MsgOc[5000];
						    ApplyDynamicActorAnimation(BotAtendente, "PED", "handsup", 4.0, 0, 1, 1, 1, -1);
						    format(Str, sizeof(Str), "{FFD700}Seguranca Nascimento\n{FFFFFF}SOCORRO!!!!!\n\n{FFFFFF}Se Voce For da Policia\nUse: /acalmaratendente");
				   			UpdateDynamic3DTextLabelText(TextBotAtendente, 0x1FF61F99, Str);
				   			TimerBotMira[playerid] = SetTimerEx("AtendenteMira", 1000, true, "i", playerid);
							SCM(playerid, -1, "{FFFFFF}Voce esta Ameacando o Vigilante do Cofre do {FFDC33}'Banco do Brasil'");
							GameTextForPlayer(playerid, "~r~Aguarde ~n~ ~w~Voce esta Ameacando o Vigilante", 1000, 3);
							AssantandoBanco[playerid] = 1;
							new LevelHT[MAX_PLAYERS];
							LevelHT[playerid] = GetPlayerWantedLevel(playerid);
							LevelHT[playerid] += 5;
							SetPlayerWantedLevel(playerid, LevelHT[playerid]);
							format(MsgOc, sizeof(MsgOc), "Todas as Unidades!! A Faccao %s Esta Roubando o Banco Central de Los Santos", OrgInfo[orgid][OrgNome]);
							MsgOcorrencia(MsgOc);
						    return 1;
						}
					}
				}
			}
	    }
        if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	    {
	        if(IsBandido(playerid))
	        {
	            if(RoubandoJO[playerid] == 0)
	            {
	                if(JODisp == 0)
	                {
				        if(ISP(playerid, 5.0, 1856.1652,-1593.0793,13.6703)) // Mira na Cabeca do BotAtendente
						{
						    new Str[5000], orgid = GetPlayerOrg(playerid), MsgOc[5000];
						    ApplyDynamicActorAnimation(BotJO, "PED", "handsup", 4.0, 0, 1, 1, 1, -1);
						    format(Str, sizeof(Str), "{FFD700}Fiscal de Joias\n{FFFFFF}SOCORRO!!!!!\n\n{FFFFFF}Se Voce For da Policia\nUse: /acalmaratendente");
				   			UpdateDynamic3DTextLabelText(TextBotJO, 0x1FF61F99, Str);
				   			TimerBotMira[playerid] = SetTimerEx("AtendenteMira2", 1000, true, "i", playerid);
							SCM(playerid, -1, "{FFFFFF}Voce esta ameacando o Fiscal de Joias atras do dinheiro delas...");
							GameTextForPlayer(playerid, "~r~Aguarde ~n~ ~w~Voce esta Ameacando o Fiscal", 1000, 3);
							RoubandoJO[playerid] = 1;
							new LevelHT[MAX_PLAYERS];
							LevelHT[playerid] = GetPlayerWantedLevel(playerid);
							LevelHT[playerid] += 3;
							SetPlayerWantedLevel(playerid, LevelHT[playerid]);
							format(MsgOc, sizeof(MsgOc), "Todas as Unidades!! A Faccao %s Esta Roubando a Joalheria de Los Santos", OrgInfo[orgid][OrgNome]);
							MsgOcorrencia(MsgOc);
						    return 1;
						}
					}
				}
			}
	    }
	}
	if(newkeys == KEY_CTRL_BACK)
	{
		new Inv[5000], Nick[5000], orgid = GetPlayerOrg(playerid);
		if(ISP(playerid, 10.0, CofreInfo[orgid][CofrePosX], CofreInfo[orgid][CofrePosY], CofreInfo[orgid][CofrePosZ]))
		{
            if(IsBandido(playerid))
            {
				for(new ii = 0; ii != 20; ii++)
				{
					GetWeaponName(CofreArma[ii][orgid], Nick, 20);
					strcat(Inv, CofreArma[ii][orgid] > 0 ? (CofreArma[ii][orgid] == 18 ? ("{FFDC33}Cocktail Molotov") : (Nick)) : ("{FFDC33}(Vazio)"));
					strcat(Inv, "\n");
				}
				strcat(Inv, "Guardar Arma");
				ShowPlayerDialog(playerid, DIALOG_ARMAS2, DIALOG_STYLE_LIST, "Menu da Org {FFDC33}[Bau]", Inv, "Selecionar", "X");
				return 1;
			}
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Criminoso");
                return 1;
            }
		}
		return 1;
	}
    if(newkeys == KEY_SECONDARY_ATTACK)
	{ //Entrada
        if(ISP(playerid, 2.0, 913.9498, -1004.6286, 37.9795)) // Entrada Banco Central FezBanco
		{
			SetPlayerPos(playerid,  1109.6423, 1052.5334, -19.9389);
			SetPlayerInterior(playerid, 3);
			SetPlayerVirtualWorld(playerid, 333);

			SetTimerEx("CarregandoObjetos", 5000, false, "d", playerid);
            for(new i = 1; i < 3; i++){PlayerTextDrawShow(playerid, TdCarregarINT[playerid][i]);}
			Controle(playerid, 0);
		}
        if(ISP(playerid, 2.0, 1170.9006,-1489.6990,22.7551)) // Entrada Farmacia LS
		{
			SetPlayerPos(playerid,  662.6807, -573.4129, 16.3341);
			SetPlayerInterior(playerid, 0);
			SetPlayerVirtualWorld(playerid, 333);

			SetTimerEx("CarregandoObjetos", 5000, false, "d", playerid);
            for(new i = 1; i < 3; i++){PlayerTextDrawShow(playerid, TdCarregarINT[playerid][i]);}
			Controle(playerid, 0);
		}
        if(ISP(playerid, 2.0, 1290.7421, -1161.0035, 23.9561)) // Entrada Cassino LS
		{
			SetPlayerPos(playerid,  2271.0105,1637.2705,1008.3594);
			SetPlayerInterior(playerid, 1);
			SetPlayerVirtualWorld(playerid, 333);

