}

CallBack:: TempoDeAttLoc(playerid, give)
{
	if (!IsPlayerConnected(give))
	{
		KillTimer(timer[playerid]);
		DisablePlayerCheckpoint(playerid);
		DisablePlayerRaceCheckpoint(playerid);
		return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}O Player Desconectou do Servidor");
	}
	static Float: x,
	Float: y,
	Float: z;
	GetPlayerPos(give, x, y, z);
	SetPlayerCheckpoint(playerid, x, y, z, 5);
	if (PlayerToPoint(7.0, playerid, x, y, z))
	{
		DisablePlayerCheckpoint(playerid);
		DisablePlayerRaceCheckpoint(playerid);
		KillTimer(timer[playerid]);
		GameTextForPlayer(playerid, "~w~Voce chegou ao ~r~individuo", 5000, 6);
	}
	return true;
}

CallBack:: PlayerToPoint(Float:radi, playerid, Float:x, Float:y, Float:z)
{
    if(IsPlayerConnected(playerid))
    {
        new Float:oldposx, Float:oldposy, Float:oldposz;
        new Float:tempposx, Float:tempposy, Float:tempposz;
        GetPlayerPos(playerid, oldposx, oldposy, oldposz);
        tempposx = (oldposx -x);
        tempposy = (oldposy -y);
        tempposz = (oldposz -z);
        if (((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)) && ((tempposz < radi) && (tempposz > -radi)))
        {
            return 1;
        }
    }
    return 0;
}
CallBack:: TempoDeLogin(playerid)
{
    KillTimer(TempoColocarSenha[playerid]);
    TempoColocarSenha[playerid] = 0;
    Pp[playerid][Logado] = false;
    ShowPlayerDialog(playerid, 5000, DIALOG_STYLE_MSGBOX, "{FFFFFF}Status do {FFDC33}Kick", "{FFDC33}: {FFFFFF}Voce foi kickado do servidor\nvoce nao pode ficar muito tempo na tela de login\nentao para evitar que isso aconteca novamente\ndigite sua senha a tempo para que isso nao ocorra.", "Ok", "");
    SCM(playerid, -1, "{FFDC33}Kick: {FFFFFF}Voce tomou kick por nao logar no servidor.");
    SetTimerEx("KickPlayer", 100, false, "i", playerid);
    return 1;
}
CallBack:: IniciandoServidor(playerid)
{
	format(arquivo, sizeof(arquivo), PASTA_CONTAS, PlayerName(playerid));
	if(DOF2_FileExists(arquivo))
	{
        Registrado[playerid] = true;
        LimparChat(playerid, 20);
        TempoColocarSenha[playerid] = SetTimerEx("TempoDeLogin", 30000, false, "i", playerid);
    	ShowPlayerDialog(playerid, DIALOG_SENHA, DIALOG_STYLE_PASSWORD, "{FFFFFF}Login", "{FFFFFF}Estamos verificando os dados do servidor...\n\nAchamos sua conta como {00FF00}Registrada.\n{FFFFFF}Para logar no servidor, basta digitar a senha abaixo.\nEm caso de erros, nos contacte no discord.", "Logar", "X");
	}
	else
	{
		Registrado[playerid] = false;
        LimparChat(playerid, 20);
    	ShowPlayerDialog(playerid, DIALOG_SENHA, DIALOG_STYLE_PASSWORD, "{FFFFFF}Cadastro", "{FFFFFF}Estamos verificando os dados do servidor...\n\nAchamos sua conta como {FFD700}Sem registro.\n{FFFFFF}Para registrar no servidor, basta digitar a senha abaixo.\nEm caso de erros, nos contacte no discord.", "Registrar", "X");
	}
	SetPlayerColor(playerid, 0xFFFFFFFF);

	// CAMERA LOGIN
    SetPlayerCameraPos(playerid, -3054.954833, 1463.255615, 106.046577);
    SetPlayerCameraLookAt(playerid, -3050.775146, 1465.991821, 105.838813);
    SetPlayerPos(playerid, 1424.7526, 222.3414, 21.1601-5);

	for(new i=0; i<MAX_PLAYER_ATTACHED_OBJECTS; i++)
  	{
   		if(IsPlayerAttachedObjectSlotUsed(playerid, i))
   		{
   			RemovePlayerAttachedObject(playerid, i);
   		}
   	}
	return 1;
}

CallBack:: DesmancharVeh(playerid)
{
    if(!IsPlayerInAnyVehicle(playerid)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um Veiculo");
    {
        new vehicleid = GetPlayerVehicleID(playerid), string[450];
    	if(Desmanchando[vehicleid] == 1)
     	{
     	    if(MalotesCr[vehicleid] >= 10)
     	    {
     	        new granaa = 20000 + random(10000);
	          	PlayerPlaySound(playerid,1137,0.0,0.0,0.0);
	          	MalotesCr[vehicleid] = 0;
	     	    Desman[playerid] = 0;
		       	Desmanchando[vehicleid] = 0;
		       	SetVehicleToRespawn(vehicleid);
		       	format(string, sizeof(string), "{00FFFF}[!!] {FFFFFF}Voce Desmanchou um Transportador de Valores e Ganhou {FFD700}R$%d {FFFFFF}De Dinheiro Sujo, Bom Desmanche", granaa);
				SCM(playerid, -1, string);
				format(string,sizeof(string),"SOS: Um Carro Forte foi Desmanchado no Desmanche de Los Santos!");
				SendClientMessageToAll(COLOR_LIGHTRED, string);
				new MsgOc[5000];
				format(MsgOc, sizeof(MsgOc), "Todas as Unidades, O Suspeito: %s(%d) Desmanchou um Carro Forte no Desmanche LS -", PlayerName(playerid), Pp[playerid][IDF]);
				MsgOcorrencia(MsgOc);
				roubando[playerid] += 4;
				SetPlayerWantedLevel(playerid, roubando[playerid]);
				roubando[playerid] = 0;
				format(string, sizeof(string), "* %d Desmanchou um Carro Forte!", Pp[playerid][IDF]);
				ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
				GameTextForPlayer(playerid, "~w~Carro Forte ~r~Desmanchado!", 3000,3);
				Pp[playerid][DinheiroSujo] += granaa;
				Controle(playerid, 1);
				KillTimer(ProtecaoAlgemas[playerid]);
     	    }
     	    else
     	    {
	     	    new granaa = 3000 + random(4000);
	          	PlayerPlaySound(playerid,1137,0.0,0.0,0.0);
	     	    Desman[playerid] = 0;
		       	Desmanchando[vehicleid] = 0;
		       	SetVehicleToRespawn(vehicleid);
		       	format(string, sizeof(string), "{00FFFF}[!!] {FFFFFF}Voce Desmanchou um Veiculo e Ganhou {FFD700}R$%d {FFFFFF}De Dinheiro Sujo, Bom Desmanche", granaa);
				SCM(playerid, -1, string);
				new MsgOc[5000];
				format(MsgOc, sizeof(MsgOc), "Todas as Unidades, O Suspeito: %s(%d) Desmanchou um Veiculo no Desmanche LS -", PlayerName(playerid), Pp[playerid][IDF]);
				MsgOcorrencia(MsgOc);
				roubando[playerid] += 2;
				SetPlayerWantedLevel(playerid, roubando[playerid]);
				roubando[playerid] = 0;
				format(string, sizeof(string), "* %d Desmanchou um Veiculo!", Pp[playerid][IDF]);
				ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
				GameTextForPlayer(playerid, "~y~Desmanchado!", 3000,3);
				Pp[playerid][DinheiroSujo] += granaa;
				Controle(playerid, 1);
				KillTimer(ProtecaoAlgemas[playerid]);
			}
     	    return 1;
     	}
		else
		{
			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Veiculo Nao Esta Sendo Desmanchado");
		}
	}
	return 1;
}
CallBack:: PlantarMaconhas(playerid)
{
	ClearAnimations(playerid, 1);
	for(new i = 0 ;i<MAX_MACONHAS;i++)
	{
		if(MaconhaInfo[i][MaconhaUsada] == true)
		{
			if(ISP(playerid, 10.0, MaconhaInfo[i][XM],MaconhaInfo[i][YM],MaconhaInfo[i][ZM]))
			{
				return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce Nao Pode Plantar Ai!");
			}
		}
	}
	for(new i = 0 ;i<MAX_MACONHAS;i++)
	{
		if(MaconhaInfo[i][MaconhaUsada] == false)
		{
		    GameTextForPlayer(playerid, "~w~Maconha ~y~Plantada!", 2500, 3);
			Pp[playerid][Sementes] --;
			GetPlayerPos(playerid,MaconhaInfo[i][XM],MaconhaInfo[i][YM],MaconhaInfo[i][ZM]);
			format(MaconhaInfo[i][Dono], MAX_PLAYER_NAME, "%s",PlayerName(playerid));
			MaconhaInfo[i][TempoS] = 60;
			MaconhaInfo[i][TempoM] = MinutosPFicaPronto-1;
			MaconhaInfo[i][Gramas] = 0;
			MaconhaInfo[i][MudaMac] = CreateDynamicObject(19473, MaconhaInfo[i][XM],MaconhaInfo[i][YM],MaconhaInfo[i][ZM]-3, 0.0, 0.0, 0.0);
			MoveDynamicObject(MaconhaInfo[i][MudaMac], MaconhaInfo[i][XM],MaconhaInfo[i][YM],MaconhaInfo[i][ZM]-1.3, SpeedParaMoverObject,0.0, 0.0, 0.0);
			new Str[250];format(Str, sizeof Str, "{48D1CC}Muda de Maconha\n{FFFFFF}Dono: %s\nTempo: %d:%d\nGramas:%dg",MaconhaInfo[i][Dono],MaconhaInfo[i][TempoM],MaconhaInfo[i][TempoS],MaconhaInfo[i][Gramas]);
			MaconhaInfo[i][MudaMac3D] = Create3DTextLabel(Str, 0x1FF61F99, MaconhaInfo[i][XM],MaconhaInfo[i][YM],MaconhaInfo[i][ZM]-1, 15.0, 0);
			MaconhaInfo[i][MaconhaUsada] = true;
			MaconhaInfo[i][Pronta] = false;
			MaconhaInfo[i][Vida] = 100;
			MaconhaInfo[i][Timer] =  SetTimerEx("AtzMaconha", 1000, true, "i",i);
			return 1;
		}
	}
	return 1;
}
CallBack:: AtzMaconha(i)
{
	MaconhaInfo[i][TempoS] --;
	new Str[250];format(Str, sizeof Str, "{48D1CC}Muda de Maconha\n{FFFFFF}Dono: %s\nTempo: %d:%d\nGramas:%dg",MaconhaInfo[i][Dono],MaconhaInfo[i][TempoM],MaconhaInfo[i][TempoS],MaconhaInfo[i][Gramas]);
	Update3DTextLabelText(MaconhaInfo[i][MudaMac3D], 0x1FF61F99, Str);
	if(MaconhaInfo[i][TempoS] <1 && MaconhaInfo[i][TempoM] <1)
	{
		KillTimer(MaconhaInfo[i][Timer]);
		MaconhaInfo[i][Gramas] +=random(10);
		format(Str, sizeof Str, "{48D1CC}Muda de Maconha\n{FFFFFF}Dono: %s\nTempo:{00FF00}Pronta\n{FFFFFF}Gramas:%dg",MaconhaInfo[i][Dono],MaconhaInfo[i][Gramas]);
		Update3DTextLabelText(MaconhaInfo[i][MudaMac3D], 0x1FF61F99, Str);
		MoveDynamicObject(MaconhaInfo[i][MudaMac], MaconhaInfo[i][XM],MaconhaInfo[i][YM],MaconhaInfo[i][ZM]-1.3, 5.0,0.0, 0.0, 0.0);
		MaconhaInfo[i][TempoS] = 0;
		MaconhaInfo[i][TempoM] = 0;
		new playerid = StringPID(MaconhaInfo[i][Dono]);
		MaconhaInfo[i][Pronta] = true;
		if(playerid ==-1) return 1;
		SCM(playerid, -1, "{FFFFFF}Sua Maconha Esta Pronta! Use: /colhermaconha");
		GameTextForPlayer(playerid, "~w~Maconha ~g~Pronta!", 2500, 3);
		return 1;
	}
	if(MaconhaInfo[i][TempoS] <1)
	{
		MaconhaInfo[i][TempoS] = 60;
		if(MaconhaInfo[i][TempoM] >0)
		{
			MaconhaInfo[i][TempoM] --;
		}
		MaconhaInfo[i][Gramas] +=random(10);
	}
	return  1;
}
CallBack:: colocarfogo(playerid,i)
{
	if(!ISP(playerid,1.0, MaconhaInfo[i][XM],MaconhaInfo[i][YM],MaconhaInfo[i][ZM]))
	{
		MaconhaInfo[i][Vida] = 100;
		KillTimer(MaconhaInfo[i][Timer2]);
		return 1;
	}
	MaconhaInfo[i][Vida] -=3;
	new Str[4500];format(Str, sizeof(Str), "~y~Vida: %d",MaconhaInfo[i][Vida]);
	GameTextForPlayer(playerid, Str, 1200, 3);
	if(MaconhaInfo[i][Vida] <1)
	{
	    ClearAnimations(playerid);
   		SetTimerEx("DCANIM", 500, false, "d", playerid);
		KillTimer(MaconhaInfo[i][Timer2]);
		KillTimer(MaconhaInfo[i][Timer]);
		format(Str, sizeof(Str), "~y~Maconha Apagada Com Sucesso!");
		GameTextForPlayer(playerid, Str, 2500, 3);
		DestroyDynamicObject(MaconhaInfo[i][MudaMac]);
		Delete3DTextLabel(MaconhaInfo[i][MudaMac3D]);
		MaconhaInfo[i][MaconhaUsada] = false;
		MaconhaInfo[i][Vida] = 100;
		new Dono2 = StringPID(MaconhaInfo[i][Dono]);
		MaconhaInfo[i][Pronta] = true;
		if(Dono2 ==-1) return 1;
		SendClientMessage(Dono2, -1, "{FFFFFF}Sua Maconha Foi Queimada!!");
	}
	return 1;
}
CallBack:: AttArrastar2(playerid)
{
	new Float:X123, Float:Y123, Float:Z123;
	GetPlayerPos(playerid, X123, Y123, Z123);
	for(new i; i < MAX_PLAYERS; i++)
	{
	    if(Pp[i][Logado] == true)
	    {
			if(Pp[i][IDF] == ArrastadoID[playerid])
	  		{
	 			GameTextForPlayer(i, "~r~Arrastado!", 2000, 3);
				SetPlayerPos(i, X123, Y123, Z123+1);
				ApplyAnimation(i, "DEALER", "DEALER_IDLE", 4.0, 0, 1, 1, 1, -1);
			}
		}
	}
	return 1;
}

CallBack:: TempoPegarGrana(playerid)
{
    if(ISP(playerid, 3.0, 947.8974,-1506.0883,10.6979))
	{
	    if(AssantandoBanco[playerid] == 1)
	    {
	        if(BancoDisp == 1)
	        {
				if(BancoDinheiro >= 1000000)
				{
				    new string[450];
    				format(string, sizeof(string), "{FFD700}Info-Banco: {FFFFFF}Voce Roubou! cerca de {00FF00}R$%d {FFFFFF}Do Banco Central do {FFD700}Gold City Roleplay", BancoDinheiro);
					SCM(playerid, -1, string);
					Pp[playerid][DinheiroSujo] += BancoDinheiro;
					BancoDinheiro = 0;
					format(string, sizeof(string), "~g~+$[%d]", BancoDinheiro);
					GameTextForPlayer(playerid, string, 3000, 1);
					Controle(playerid, 1);
					KillTimer(ProtecaoAlgemas[playerid]);
					KillTimer(TimerPegarGrana[playerid]);
					SetTimerEx("DCANIM", 200, false, "i", playerid);
				}
			}
		}
	}
	return 1;
}
