CallBack:: FinalizarGuerraGuetto()
{
	new string[450];
    new vencedorpontosGuetto = 0;
    if(GuettoInfo[Guerra] >= 1)
	{
	    for(new o=0; o<MAX_ORGS; o++)
		{
		    if(GuettoPontos[o] >= vencedorpontosGuetto)
		    {
                vencedorpontosGuetto = GuettoPontos[o];
		    }
		}
        for(new opt=0; opt<MAX_ORGS; opt++)
		{
		    if(GuettoPontos[opt] == vencedorpontosGuetto)
		    {
				GuettoInfo[Dono] = opt;
                SendClientMessageToAll(-1, "{FFD700}=-=-=-=-=-=-=-=-=-=-=-= {FFFFFF}Guerra do {FFD700}Guetto[Finalizada] =-=-=-=-=-=-=-=-=-=-=-=");
                SendClientMessageToAll(-1, "{FFFFFF}A guerra do guetto foi finalizada com sucesso!");
				if(GuettoInfo[Dono] == 2 || GuettoInfo[Dono] == 3 || GuettoInfo[Dono] == 8 || GuettoInfo[Dono] == 27 || GuettoInfo[Dono] == 29 || GuettoInfo[Dono] == 36)
                {
                    SendClientMessageToAll(0xFF8080AA,"{FFD700}[GUERRA] Os Policiais estao Controlando o Trafico no Guetto, nao Havera Drogas ? Venda!");
					format(string, sizeof(string), "{FFD700}[GUERRA] Os Policais venceram a Guerra, e Pelo Controle Recebera uma Bonificacao de R$12000 assim como a prefeitura.");
					SendClientMessageToAll(0xFF9DFFFF, string);
                    for(new i; i < MAX_PLAYERS; i++)
                    {
                        if(Pp[i][Logado] == true)
                        {
                            if(Pp[i][OrgMembro] == GuettoInfo[Dono] || Pp[i][OrgMembro] == GuettoInfo[Dono])
                            {
                                GivePlayerCash(i, 12000);
                                GameTextForPlayer(i, "~g~+R$12000", 1200, 1);
                            }
                        }
                    }
                }
                if(GuettoInfo[Dono] == 11 || GuettoInfo[Dono] == 12
                || GuettoInfo[Dono] == 17 || GuettoInfo[Dono] == 18
                || GuettoInfo[Dono] == 19 || GuettoInfo[Dono] == 20
                || GuettoInfo[Dono] == 21 || GuettoInfo[Dono] == 30
                || GuettoInfo[Dono] == 31 || GuettoInfo[Dono] == 35)
                {
					format(string, sizeof(string), "{FFD700}[GUERRA] A gang %s venceu a guerra, e pelo controle recebera uma bonificacao de R$12000 na conta dos membros.", OrgInfo[opt][OrgNome]);
					SendClientMessageToAll(0xFF9DFFFF, string);
                    for(new i; i < MAX_PLAYERS; i++)
                    {
                        if(Pp[i][Logado] == true)
                        {
                            if(Pp[i][OrgMembro] == GuettoInfo[Dono] || Pp[i][OrgMembro] == GuettoInfo[Dono])
                            {
                                GivePlayerCash(i, 12000);
                                GameTextForPlayer(i, "~g~+R$12000", 1200, 1);
                            }
                        }
                    }
                }
                if(GuettoInfo[Dono] == 0)
                {
                    SendClientMessageToAll(-1, "{FFFFFF}Ninguem ganhou a guerra do Guetto...");
                }
				SendClientMessageToAll(-1," ");
				GuettoInfo[Guerra] = 0;
				GuettoShowForAll();
				SalvarGuetto();
				for(new o2; o2 < MAX_ORGS; o2++)
				{
					GuettoPontos[o2] = 0;
				}
				for(new i=0; i<MAX_PLAYERS; i++)
				{
	    			new Float:x,Float:y,Float:z;
	    			GetPlayerPos(i,x,y,z);
    				PlayerPlaySound(i, 1159, x, y, z);
    				PlayerPlaySound(i, 1159, x, y, z);
    				PlayerPlaySound(i, 1159, x, y, z);
				}
				return 1;
		    }
		}
	}
	return 1;
}
