				portacofre = CreateDynamicObject(2634, 2144.18823, 1627.06653, 994.26477,   0.00000, 0.00000, -180.00000);
                for(new i; i < 4; i++)
                {
                    DestroyDynamicPickup(PickDinheiro[i]);
                }
                // Dinheiro no Chao
                PickDinheiro[0] = CreateDynamicPickup(1550, 1, 2145.1687, 1640.3270, 993.5761, 2);
                PickDinheiro[1] = CreateDynamicPickup(1550, 1, 2146.1750, 1630.0837, 993.5761, 2);
                PickDinheiro[2] = CreateDynamicPickup(1550, 1, 2144.4607, 1634.4076, 993.5761, 2);
                PickDinheiro[3] = CreateDynamicPickup(1550, 1, 2142.1033, 1637.1849, 993.5761, 2);
			}
			else
			{
			    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}O Banco nao foi assaltado");
			}
