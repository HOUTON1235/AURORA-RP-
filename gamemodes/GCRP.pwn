            if(modele == 477) price = 130000;
            if(modele == 559) price = 150000;

			Controle(playerid, 0);
			LimparChat(playerid, 10);

			format(string, sizeof(string), "%s", VehicleNames[modele-400]);
			PlayerTextDrawSetString(playerid, TextDrawConce[playerid][4], string);

			format(string, sizeof(string), "~y~R$%d", price);
			PlayerTextDrawSetString(playerid, TextDrawConce[playerid][3], string);
    	}
    	else if(playertextid == CLCancelar[playerid])
    	{
            for(new i; i < 5; i++)
			{
				PlayerTextDrawHide(playerid, TextDrawConce[playerid][i]);
			}
            PlayerTextDrawHide(playerid, CLIR[playerid]);
            PlayerTextDrawHide(playerid, CLVoltar[playerid]);
            PlayerTextDrawHide(playerid, CLComprar[playerid]);
            PlayerTextDrawHide(playerid, CLCancelar[playerid]);
    		Controle(playerid, 1);
    		SetPlayerVirtualWorld(playerid, 0);
    		DestroyVehicle(ConceVehicle[playerid]);
    		ConceVehicleID[playerid] = 0;
    		CancelSelectTextDraw(playerid);
			SetCameraBehindPlayer(playerid);
    	}
    	else if(playertextid == CLComprar[playerid])
    	{
    		new string[5500];
			new modele;
			new price = 0;
			new rand666 = random(sizeof(SpawnConce));
			modele = GetVehicleModel(ConceVehicle[playerid]);

			if(modele == 400) price = 80000; // Carro Normal
			if(modele == 401) price = 70000;
			if(modele == 405) price = 85000;
			if(modele == 410) price = 50000;
			if(modele == 412) price = 100000;
			if(modele == 419) price = 130000;
			if(modele == 424) price = 110000;
			if(modele == 426) price = 98000;
			if(modele == 436) price = 60000;
			if(modele == 439) price = 100000;
			if(modele == 445) price = 90000;
			if(modele == 458) price = 80000;
			if(modele == 466) price = 95000;
			if(modele == 467) price = 90000;
			if(modele == 474) price = 97000;
			if(modele == 475) price = 120000;
   			if(modele == 479) price = 70000;
      		if(modele == 483) price = 105000;
        	if(modele == 489) price = 110000;
         	if(modele == 491) price = 95000;
         	if(modele == 492) price = 96000;
          	if(modele == 496) price = 100000;
           	if(modele == 500) price = 100000;
            if(modele == 505) price = 110000;
            if(modele == 516) price = 85000;
            if(modele == 517) price = 87000;
            if(modele == 526) price = 87000;
            if(modele == 527) price = 57000;
            if(modele == 529) price = 78000;
            if(modele == 533) price = 140000;
            if(modele == 534) price = 139000;
            if(modele == 540) price = 89000;
            if(modele == 542) price = 75000;
            if(modele == 545) price = 95000;
            if(modele == 550) price = 100000;
            if(modele == 554) price = 110000;
            if(modele == 555) price = 100000;
            if(modele == 560) price = 450000;
            if(modele == 409) price = 3500000;

            if(modele == 562) price = 600000;
            if(modele == 567) price = 700000;
            if(modele == 536) price = 750000;
            if(modele == 602) price = 300000;
            if(modele == 600) price = 100000;
            if(modele == 508) price = 70000;
            if(modele == 415) price = 750000;
            if(modele == 418) price = 50000;
            if(modele == 413) price = 40000;
            if(modele == 404) price = 35000;
            if(modele == 402) price = 300000;

			if(modele == 411) price = 2000000; // Carro Luxo
			if(modele == 451) price = 700000;
			if(modele == 541) price = 550000;
			if(modele == 567) price = 1000000;
			if(modele == 575) price = 900000;
			if(modele == 429) price = 500000;
			if(modele == 603) price = 950000;
			if(modele == 535) price = 900000;
			if(modele == 506) price = 700000;
			if(modele == 502) price = 2000000;
			if(modele == 503) price = 2500000;

			if(modele == 509) price = 5000; // Motos
			if(modele == 462) price = 15000;
			if(modele == 586) price = 70000;
			if(modele == 468) price = 90000;
			if(modele == 581) price = 95000;
			if(modele == 463) price = 50000;
			if(modele == 522) price = 2000000;
			if(modele == 521) price = 100000;
            if(modele == 461) price = 150000;

            if(modele == 551) price = 110000;//Carros Comuns 2
            if(modele == 477) price = 130000;
            if(modele == 559) price = 150000;

    		if(GetPlayerCash(playerid) >= price)
    		{
                if(Pp[playerid][TemCarro2] == 0)
                {
                	VehConce[playerid] = CreateVehicle(modele, SpawnConce[rand666][0], SpawnConce[rand666][1], SpawnConce[rand666][2], SpawnConce[rand666][3], 6, 6, false);
	                IfCarro[playerid][Cor] = 1;
					ChangeVehicleColor(VehConce[playerid], IfCarro[playerid][Cor], IfCarro[playerid][Cor]);

					format(string, sizeof(string), "{FFDC33}: {FFFFFF}Voce comprou o veiculo [{FFDC33}%s{FFFFFF}] e pagou: {00FF00}(R$%d)", VehicleNames[modele-400], price);
					SCM(playerid, -1, string);
					SCM(playerid, -1, "{FFDC33}: {FFFFFF}Voce Comprou um Veiculo, Voce ja pode usar: /mv Para ver os Status do Veiculo");
                    GameTextForPlayer(playerid, "~w~Veiculo ~g~Comprado! ~n~ ~r~Use: /mv!", 3500, 4);
	                GivePlayerCash(playerid, -price);
	                IfCarro[playerid][TemCarro] = 1; Pp[playerid][TemCarro2] = 1;
	                VeiculoSpawnado[playerid] = 1;

				    format(arquivo, sizeof(arquivo), PASTA_CONCESSIONARIA, PlayerName(playerid)); //Formatamos o arquivo de acordo com o nome do player (Contas/NOME)
				    if(!DOF2_FileExists(arquivo)) { DOF2_CreateFile(arquivo); }
					new Float:VPosX, Float:VPosY, Float:VPosZ, Float:VPosR;
					GetVehiclePos(VehConce[playerid], Float:VPosX, Float:VPosY, Float:VPosZ);
					GetVehicleZAngle(VehConce[playerid], Float:VPosR);
					DOF2_SetInt(arquivo,"VeiculoID",modele);
					DOF2_SetInt(arquivo, "VeiculoPreco", price);
					DOF2_SetFloat(arquivo,"VehPosX", VPosX);
					DOF2_SetFloat(arquivo,"VehPosY", VPosY);
					DOF2_SetFloat(arquivo,"VehPosZ", VPosZ);
					DOF2_SetFloat(arquivo,"VehPosR", VPosR);
					DOF2_SetFloat(arquivo, "VidaC", 1000.00000000);
					DOF2_SaveFile();

					SalvarVeiculo(playerid);
			 		DestroyVehicle(VehConce[playerid]);
					IfCarro[playerid][TemCarro] = 1; Pp[playerid][TemCarro2] = 1;
					VeiculoSpawnado[playerid] = 0;

	                for(new i; i < 5; i++)
		    		{
		    			PlayerTextDrawHide(playerid, TextDrawConce[playerid][i]);
		    		}
                    PlayerTextDrawHide(playerid, CLIR[playerid]);
                    PlayerTextDrawHide(playerid, CLVoltar[playerid]);
                    PlayerTextDrawHide(playerid, CLComprar[playerid]);
                    PlayerTextDrawHide(playerid, CLCancelar[playerid]);

		    		Controle(playerid, 1);
		    		SetPlayerVirtualWorld(playerid, 0);
		    		DestroyVehicle(ConceVehicle[playerid]);
		    		ConceVehicleID[playerid] = 0;
		    		CancelSelectTextDraw(playerid);
					SetCameraBehindPlayer(playerid);
	           	}
	           	else
	           	{
           	 		SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce so pode ter apenas 1 veiculo.");
                }
    		}
    		else
    		{
    			SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao possui dinheiro pra comprar este veiculo.");
    		}
    	}
    }
    return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    switch(dialogid)
    {
        case DIALOG_MODIFICAR:
        {
            if(response)
            {
                if(listitem == 0)
                {
                    if(OrgConfigID[playerid] >= 1)
                    {
                        new strmar[550], mercada[550];
                        format(mercada, sizeof(mercada), "{0000FF}-> {FFFFFF}Voce deseja mudar o nome da org: {FFDC33}%s\n{FFFFFF}Digite abaixo o novo nome desta organizacao.", OrgInfo[OrgConfigID[playerid]][OrgNome]);
                        strcat(strmar, mercada);
                        ShowPlayerDialog(playerid, DIALOG_MODIFICAR1, DIALOG_STYLE_INPUT, "{FFFFFF}Modificar org", strmar, "X", "");
                    }
                }
                if(listitem == 1)
                {
                    if(OrgConfigID[playerid] >= 1)
                    {
                        new Float:XX, Float:YY, Float:ZZ, Float:RR, string[550];
                        GetPlayerPos(playerid, XX, YY, ZZ);
                        GetPlayerFacingAngle(playerid, RR);

                        OrgInfo[OrgConfigID[playerid]][SpawnX] = XX;
                        OrgInfo[OrgConfigID[playerid]][SpawnY] = YY;
                        OrgInfo[OrgConfigID[playerid]][SpawnZ] = ZZ;
                        OrgInfo[OrgConfigID[playerid]][SpawnR] = RR;

                        SendClientMessageEx(playerid, -1, "{00CED1}[Aviso ConFig] Voce modificou o spawn da org %s", OrgInfo[OrgConfigID[playerid]][OrgNome]);
                        SalvarOrg(OrgConfigID[playerid]);
                        AtualizarOrg(OrgConfigID[playerid]);
                        OrgConfigID[playerid] = 0;
                    }
                }
                if(listitem == 2)
                {
                    if(OrgConfigID[playerid] >= 1)
                    {
                        new Float:XX, Float:YY, Float:ZZ, string[550];
                        GetPlayerPos(playerid, XX, YY, ZZ);

                        OrgInfo[OrgConfigID[playerid]][PickupX] = XX;
                        OrgInfo[OrgConfigID[playerid]][PickupY] = YY;
                        OrgInfo[OrgConfigID[playerid]][PickupZ] = ZZ;

                        SendClientMessageEx(playerid, -1, "{00CED1}[Aviso ConFig] Voce modificou o equipamento da org %s", OrgInfo[OrgConfigID[playerid]][OrgNome]);
                        SalvarOrg(OrgConfigID[playerid]);
                        AtualizarOrg(OrgConfigID[playerid]);
                        OrgConfigID[playerid] = 0;
                    }
                }
                if(listitem == 3)
                {
                    new strmar[550], mercada[550];
                    format(mercada, sizeof(mercada), "{FFFFFF}: {FFFFFF}Digite o ID da skin para a %s\nCuidado nos ID's correspondentes..", OrgInfo[OrgConfigID[playerid]][OrgNome]);
                    strcat(strmar, mercada);
                    ShowPlayerDialog(playerid, DIALOG_MODIFICAR2, DIALOG_STYLE_INPUT, "{FFFFFF}Modificar org", strmar, "Selecionar", "X");
                }
                if(listitem == 4)
                {
                    new strmar[550], mercada[550];
                    format(mercada, sizeof(mercada), "{FFFFFF}: {FFFFFF}Digite o ID da skin Feminina para a %s\nCuidado nos ID's correspondentes..", OrgInfo[OrgConfigID[playerid]][OrgNome]);
                    strcat(strmar, mercada);
                    ShowPlayerDialog(playerid, DIALOG_MODIFICAR3, DIALOG_STYLE_INPUT, "{FFFFFF}Modificar org", strmar, "Selecionar", "X");
                }
            }
            else
            {
                OrgConfigID[playerid] = 0;
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce fechou o menu de modificacoes de orgs.");
            }
        }
        case DIALOG_MODIFICAR1:
        {
            if(response)
            {
                if((MIN_CARAC <= strlen(inputtext) <= MAX_CARAC))
                {
                    new string[128], nomeantigo[30];
                    format(nomeantigo,30,"%s",OrgInfo[OrgConfigID[playerid]][OrgNome]);

                    format(OrgInfo[OrgConfigID[playerid]][OrgNome],30, "%s", inputtext);
                    format(string,sizeof(string),"{00FFFF}[INFO] O Admin %s[%d] mudou o nome da org %s para %s", PlayerName(playerid), Pp[playerid][IDF], nomeantigo, inputtext);
                    SendClientMessageToAll(0x00ff48FF,string);
                    SalvarOrg(OrgConfigID[playerid]);
                    MenuModificarOrg(playerid);

                    OrgConfigID[playerid] = 0;
                }
                else
                {
                    new strmar[550], mercada[550];
                    format(mercada, sizeof(mercada), "{0000FF}-> {FFFFFF}Voce deseja mudar o nome da org: {FFDC33}%s\n{FFFFFF}Digite abaixo o novo nome desta organizacao.", OrgInfo[OrgConfigID[playerid]][OrgNome]);
                    strcat(strmar, mercada);
                    ShowPlayerDialog(playerid, DIALOG_MODIFICAR1, DIALOG_STYLE_INPUT, "{FFFFFF}Menu Org {FFD700}LastRP", strmar, "X", "");

                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce precisa colocar um numero minino de caracteres.");
                }
            }
            else
            {
                MenuModificarOrg(playerid);
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce fechou o menu de modificacoes de orgs.");
            }
        }
        case DIALOG_MODIFICAR2:
        {
            if(response)
            {
                if(IsNumeric(inputtext))
				{
	                new string[128];
                 	format(string,sizeof(string),"{00FFFF}[INFO] O admin %s[%d] mudou a skin Masculina da org %s para %d", PlayerName(playerid), Pp[playerid][IDF], OrgInfo[OrgConfigID[playerid]][OrgNome], inputtext);
                  	SendClientMessageToAll(0x00ff48FF,string);
                  	OrgInfo[OrgConfigID[playerid]][OrgSkin] = strval(inputtext);
                  	SalvarOrg(OrgConfigID[playerid]);

					OrgConfigID[playerid] = 0;
				}
				else
				{
				    new strmar[550], mercada[550];
        			format(mercada, sizeof(mercada), "{FFD700}* {FFFFFF}ID Invalido, digite um id valido\npara alterar o id da skin do(a) %s", OrgInfo[OrgConfigID[playerid]][OrgNome]);
           			strcat(strmar, mercada);
           			ShowPlayerDialog(playerid, DIALOG_MODIFICAR2, DIALOG_STYLE_INPUT, "{FFFFFF}Menu Org {FFD700}LastRP", strmar, "Selecionar", "X");

					SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Digite apenas numeros.");
				}
            }
            else
            {
                MenuModificarOrg(playerid);
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce fechou o menu de modificacoes de orgs.");
            }
        }
    }
	if(dialogid == DIALOG_SENHA)
	{
		if(response)
		{
            if((MIN_PASSWORD <= strlen(inputtext) <= MAX_PASSWORD))
            {
                if(Registrado[playerid] == true)
    	        {
    	            format(arquivo, sizeof(arquivo), PASTA_CONTAS, PlayerName(playerid));
    	            if(DOF2_FileExists(arquivo))
    	            {
    	            	new SenhaP[90 + 1], ss[90 + 1];
                        format(ss, 90, DOF2_GetString(arquivo, "Senha"));
                        if(isnull(ss)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Senha corrompida!"), GameTextForPlayer(playerid, "~w~Redefina a ~r~senha", 1200, 1), MostrarNewSenha(playerid), KillTimer(TempoColocarSenha[playerid]);
    	            	SHA256_PassHash(inputtext, "78sdjs86d2h", SenhaP, 90);
                        if(new_strcmp(DOF2_GetString(arquivo, "Senha"), SenhaP))
    	            	{
    	            		SetPlayerCash(playerid, DOF2_GetInt(arquivo, "Dinheiro"));
    	            		SetPlayerScore(playerid, DOF2_GetInt(arquivo, "Level"));
    	            		SetPlayerWantedLevel(playerid, DOF2_GetInt(arquivo, "Estrelas"));
    	            		SetPlayerFightingStyle(playerid, DOF2_GetInt(arquivo, "PlayerLuta"));
    	            		SetPlayerWantedLevel(playerid, DOF2_GetInt(arquivo, "Estrelas"));
    	            		Pp[playerid][Sexo] = DOF2_GetInt(arquivo, "Sexo");
    	            		Pp[playerid][Skin] = DOF2_GetInt(arquivo, "Skin");
    	            		Pp[playerid][Admin] = DOF2_GetInt(arquivo, "Admin");
    	            		Pp[playerid][Vip] = DOF2_GetInt(arquivo, "Vip");
    	            		Pp[playerid][TempoVip] = DOF2_GetInt(arquivo, "TempoVip");
                            Pp[playerid][Socio] = DOF2_GetInt(arquivo, "Socio");
    	            		Pp[playerid][TempoSocio] = DOF2_GetInt(arquivo, "TempoSocio");
                            Pp[playerid][Patrocinador] = DOF2_GetInt(arquivo, "Patrocinador");
    						Pp[playerid][ChapelN] = DOF2_GetInt(arquivo, "ChapelN");
    						Pp[playerid][Guitarra] = DOF2_GetInt(arquivo, "Guitarra");
                            Pp[playerid][PcBruxa] = DOF2_GetInt(arquivo, "PcBruxa");
                            Pp[playerid][CabecaBru] = DOF2_GetInt(arquivo, "CabecaBru");
                            Pp[playerid][CjCabeca] = DOF2_GetInt(arquivo, "CjCabeca");
    	            		Pp[playerid][Youtuber] = DOF2_GetInt(arquivo, "Youtuber");
    	            		Pp[playerid][Profissao] = DOF2_GetInt(arquivo, "Profissao");
                            Pp[playerid][TemTagCab] = DOF2_GetInt(arquivo, "TemTagCab");
    	            		Pp[playerid][HabilitacaoA] = DOF2_GetInt(arquivo, "HabilitacaoA");
