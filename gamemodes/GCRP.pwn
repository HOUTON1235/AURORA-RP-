		Impostos[IluminacaoG] = DOF2_GetInt(arquivo, "IluminacaoGerais");
		Impostos[ImpostoDeRendaG] = DOF2_GetInt(arquivo, "ImpostoDeRendaGerais");
		Impostos[SalarioCorpsG] = DOF2_GetInt(arquivo, "SalarioCorpsGerais");
		Impostos[DinheiroDispGov] = DOF2_GetInt(arquivo, "DinheiroDispGov");
	}
	return 1;
}

