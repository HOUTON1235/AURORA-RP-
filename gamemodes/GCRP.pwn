                    new NomeOrg18[MAX_ORG_NAME];
					OrgTNome(18, NomeOrg18, MAX_ORG_NAME);
                    new NomeOrg19[MAX_ORG_NAME];
					OrgTNome(19, NomeOrg19, MAX_ORG_NAME);
                    new NomeOrg20[MAX_ORG_NAME];
