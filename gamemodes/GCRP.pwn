	if(dialogid == DIALOG_ABASTECER)
	{
		if(response)
		{
		    new vid = GetPlayerVehicleID(playerid);
			new quant = strval(inputtext);
			if(quant < 1)
			{
				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Quantidade de Litros Invalida (1L - 60L).");
				new stg[5000];
				format(gstring, 128, "{FFDC33}B{00FF00}R{FFFFFF} - Gasolina:\t{00FF00}R$%d\n", Impostos[CombustivelG]);
				strcat(stg, gstring);
				format(gstring, 128, "{FFDC33}B{00FF00}R{FFFFFF} - Digite a quantidade de gasolina que deseja abastecer");
				strcat(stg, gstring);
				ShowPlayerDialog(playerid, DIALOG_ABASTECER, DIALOG_STYLE_INPUT, "Posto de Combustivel {FFDC33}B{00FF00}R", stg, "Abastecer", "X");
				return 1;
			}
		 	if(Combustivel[vid] + quant > 60)
			{
				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}O Tanque deste Veiculo nao suporta esta quantidade de gasolina");
				new stg[5000];
				format(gstring, 128, "{FFDC33}B{00FF00}R{FFFFFF} - Gasolina:\t{00FF00}R$%d\n", Impostos[CombustivelG]);
				strcat(stg, gstring);
				format(gstring, 128, "{FFDC33}B{00FF00}R{FFFFFF} - Digite a quantidade de gasolina que deseja abastecer");
				strcat(stg, gstring);
				ShowPlayerDialog(playerid, DIALOG_ABASTECER, DIALOG_STYLE_INPUT, "Posto de Combustivel {FFDC33}B{00FF00}R", stg, "Abastecer", "X");
				return 1;
			}
			if(GetPlayerCash(playerid) < quant*Impostos[CombustivelG])
			{
				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao possui Dinheiro suficiente.");
				return 1;
			}
			else
			{
                for(new i; i < MAX_POSTO; i++)
            	{
            		if(ISP(playerid, 3.0, PostoInfo[i][PostoPosX], PostoInfo[i][PostoPosY], PostoInfo[i][PostoPosZ]))
            		{
                        if(PostoInfo[i][PostoGas] >= quant)
                        {
                            GameTextForPlayer(playerid, "~w~Abastecendo...", 5000, 4);
                            SetTimerEx("TimerAbastecerV", 5000, false, "i", playerid);
                			TogglePlayerControllable(playerid, 0);
                			ProtecaoAlgemas[playerid] = SetTimerEx("k", 500, true, "d", playerid);
            				new string[450];
            			    Combustivel[vid] = Combustivel[vid] + quant;
                            PostoInfo[i][PostoGas] -= quant;
            				GivePlayerCash(playerid, -quant*Impostos[CombustivelG]);
                            format(arquivo, sizeof(arquivo), PASTA_POSTO, i);
                        	if(DOF2_FileExists(arquivo))
                        	{
                                DOF2_SetInt(arquivo, "PostoGas", PostoInfo[i][PostoGas]);
                            }
            				Impostos[DinheiroDispGov] += quant*Impostos[CombustivelG];
                            format(string, sizeof(string), "{FFFFFF}Posto de Gasolina : %d\n\nUtilize: /abastecer\nPara Abastecer seu Veiculo!\nUse: /abastecergalao\nPara abastecer seu {FFD700}Galao de Gasolina\n{FFFFFF}Litros Disponiveis: {FFDC33}%dL\n{FFFFFF}Reabastecedores, Use: /descarregargasolina", PostoInfo[i][PostoID], PostoInfo[i][PostoGas]);
                            UpdateDynamic3DTextLabelText(TextoPosto[i], 0x1FF61F99, string);
                            format(string, sizeof(string), "{FFD700}(( Posto de Combustivel )): {FFFFFF}Voce abasteceu [%d] litro(s) de Gasolina, Por: {00FF00}[R$%d]", quant, quant*Impostos[CombustivelG]);
            				SCM(playerid, -1, string);
                        }
                        else
                        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este posto nao tem combustivel, procure outro.");
                            return 1;
                        }
                    }
                }
			}
		}
	}

