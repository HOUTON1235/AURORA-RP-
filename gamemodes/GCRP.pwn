				szFont,
				GRAFITE_size[iPlayerID],
				szColor,
				szBold
			);
			ShowPlayerDialog(iPlayerID, GRAFITE_CREATE_MAIN, DIALOG_STYLE_LIST, "{F7EC6F}Grafite Tag - {469BF0}Customizacao", szDialog, "Selecionar", "X");
		}
		case TYPE_LIST_EDIT:
		{
			switch(GRAFITE_bold[iPlayerID])
			{
				case 0: szBold = "Nao";
				case 1: szBold = "Sim";
			}
