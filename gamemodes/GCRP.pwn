CMD:celular(playerid)
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
	if(Pp[playerid][Celular] == true)
	{
		new HoraRoYal, MinutoRoYal, SegundoRoYal, string[500];
		gettime(HoraRoYal, MinutoRoYal, SegundoRoYal);

		format(string, sizeof(string), "%02d:%02d", HoraRoYal, MinutoRoYal);
		PlayerTextDrawSetString(playerid, TextdrawCelular[playerid][20], string);

		for(new i; i < 21; i++)
		{
			PlayerTextDrawShow(playerid, TextdrawCelular[playerid][i]);
		}
		SelectTextDraw(playerid, 0xFF0000FF);
		format(string, sizeof(string), "* O ID:[%d] Pegou Seu Celular do Bolso", Pp[playerid][IDF]);
	    ProxDetector(30.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
	    SetPlayerSpecialAction(playerid,SPECIAL_ACTION_USECELLPHONE);
	    SetPlayerAttachedObject(playerid, 3, 18872, 6, 0.0960, 0.0000, 0.0000, 89.3000, -177.9000, 0.0000, 1.0000, 1.0000, 1.0000);
		EstaUsandoCelular[playerid] = true;
	}
	else
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao possui um celular compre em uma 24/7.");
	}
	return 1;
}
CMD:mv(playerid)
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
	if(Pp[playerid][TemCarro2] == 1)
	{
	    if(IfCarro[playerid][VehAp] == 0)
	    {
			new StrConce[5000];
			strcat(StrConce,  "{FFD700}1. {FFFFFF}Estacionar Veiculo\n");
			strcat(StrConce,  "{FFD700}2. {FFFFFF}Spawnar Veiculo\n");
			strcat(StrConce,  "{FFD700}3. {FFFFFF}Localizar Veiculo\n");
			strcat(StrConce,  "{FFD700}4. {FFFFFF}Remover Veiculo\n");
			strcat(StrConce,  "{FFD700}5. {FFFFFF}Trancar Veiculo\n");
			strcat(StrConce,  "{FFD700}6. {FFFFFF}Destrancar Veiculo\n");
			strcat(StrConce,  "{FFD700}7. {FFFFFF}Capo do Veiculo\n");
			strcat(StrConce,  "{FFD700}8. {FFFFFF}Porta Malas do Veiculo\n");
			strcat(StrConce,  "{FFD700}9. {FFFFFF}Mecher no Porta Malas\n");
			ShowPlayerDialog(playerid, DIALOG_MENUCARRO, DIALOG_STYLE_LIST, "{FFFFFF}Menu do {FFD700}Veiculo", StrConce, "Confirmar ","Fechar");
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Seu Veiculo esta Apreendido!!");
		}
	}
	return 1;
}
CMD:capacete(playerid)
{
	if(Pp[playerid][Capacete] == true)
	{
		if(Pp[playerid][ColocouCapacete] == false)
		{
			if(SegurandoMaoDireita[playerid] == 2)
			{
				SegurandoMaoDireita[playerid] = 0;
				RemovePlayerAttachedObject(playerid, 9);

				SCM(playerid, COR_BRANCO, "{FFFFFF}[ {FFD700}CAPACETE {FFFFFF}]: Voce colocou seu seu capacete, Use /Capacete para retirar-lo");
				SetPlayerAttachedObject(playerid, 8, 18645, 2, 0.07, 0, 0, 88, 75, 0 );
				new string[450];
				format(string, sizeof(string), "* O ID [%d] Colocou o Capacete e Agora esta Seguro!", Pp[playerid][IDF]);
   				ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
				Pp[playerid][ColocouCapacete] = true;
				ApplyAnimation(playerid, "GOGGLES", "GOGGLES_PUT_ON", 4.1, 0, 0, 0, 0, 0);
				return 1;
			}
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta segurando um capacete.");
		}
		else if(Pp[playerid][ColocouCapacete] == true)
		{
			if(SegurandoMaoDireita[playerid] == 0)
			{
				SegurandoMaoDireita[playerid] = 2;
				RemovePlayerAttachedObject(playerid, 8);

				SetPlayerAttachedObject(playerid, 9, 18645, 6, 0.0279, 0.0280, 0.0000, -81.9000, -173.6000, 104.4000, 0.8220, 0.8630, 0.7470); //Mão Direita

				SCM(playerid, COR_BRANCO, "{FFFFFF}[ {FFD700}CAPACETE {FFFFFF}]: Voce retirou seu seu capacete, Use /Capacete para colocar-lo");
				new string[450];
				format(string, sizeof(string), "* O ID [%d] Retirou o Capacete e Agora esta Inseguro!", Pp[playerid][IDF]);
   				ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
				Pp[playerid][ColocouCapacete] = false;
				ApplyAnimation(playerid, "GOGGLES", "GOGGLES_PUT_ON", 4.1, 0, 0, 0, 0, 0);
				return 1;
			}
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce esta com as maos ocupadas.");
		}
	}
	return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao possui um capacete.");
}

CMD:mochila(playerid)
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(Pp[playerid][Ferido] == false)
    {
        if(Pp[playerid][Preso] == false)
        {
            if(EntrouArea[playerid] == 0)
            {
                if(Pp[playerid][Mochila] == 1)
            	{
                    MostrarMochilaP(playerid);
            	}
            	else
            	{
            		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao possui uma mochila.");
            	}
            }
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este Comando na Arena");
            }
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este Comando Preso");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este Comando Morto");
    }
	return 1;
}

CMD:guardaritem(playerid)
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
	if(Pp[playerid][Mochila] == 1)
	{
		if(SegurandoMaoDireita[playerid] != 0)
		{
			for(new i; i < 10; i++)
			{
				if(SlotMochila[playerid][i] == 0)
				{
					SlotMochila[playerid][i] = SegurandoMaoDireita[playerid];
					RemovePlayerAttachedObject(playerid, 9);
					SegurandoMaoDireita[playerid] = 0;

					SCM(playerid, -1, "{FFD700}[ MOCHILA ]: {FFFFFF}Voce guardou um item em sua mochila.");
					return 1;
				}
			}
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao possui espaco sufiente na mochila.");
        }
	}
    return 1;
}

CMD:plantarexplosivo(playerid)
{
	if(ISP(playerid, 10.0, 2144.1882, 1627.0665, 994.2648))
	{
	    if(BancoDisp == 0)
	    {
	        if(SegurandoMaoDireita[playerid] == 1)
			{
			    GetPlayerPos(playerid, BancoX, BancoY, BancoZ);
				ObjectDinamite[playerid] = CreateDynamicObject(1654, BancoX, BancoY, BancoZ-0.9, 332.49572754,269.99450684,180.00042725);
				ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 1, 1, 0, 0, 1);
				new LevelHT[MAX_PLAYERS];
				LevelHT[playerid] = GetPlayerWantedLevel(playerid);
				LevelHT[playerid] += 3;
				SetPlayerWantedLevel(playerid, LevelHT[playerid]);
				Controle(playerid, 0);
				ProtecaoAlgemas[playerid] = SetTimerEx("k", 500, true, "d", playerid);
				TimerDyna[playerid] = SetTimerEx("AttDyna2", 1000, true, "i", playerid);
			    SegurandoMaoDireita[playerid] = 0;
			    RemovePlayerAttachedObject(playerid, 9);
			    Pp[playerid][Explosivo1] --;
			    SCM(playerid, COR_BRANCO, "{FFD700}[ EXPLOSIVO ]: {FFFFFF}Voce plantou um explosivo Perto da Porta do Cofre ele ira explodir em 2 Minutose..");
			}
	    }
	    else
	    {
	        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}O Banco nao esta disponivel para Roubos");
	    }
	}
	for(new i = 1; i < MAX_CAIXAS; i++)
	{
		if(ISP(playerid, 10.0, CaixaInfo[i][CaixaPosX], CaixaInfo[i][CaixaPosY], CaixaInfo[i][CaixaPosZ]))
		{
			if(CaixaInfo[i][CaixaExplodido] == false)
			{
				if(SegurandoMaoDireita[playerid] == 1)
				{
				    new orgid = GetPlayerOrg(playerid), zone[MAX_ZONE_NAME], string[450], LevelHT[MAX_PLAYERS], MsgOc[5000];
				    GetPlayer2DZone(playerid, zone, MAX_ZONE_NAME);
					GetPlayerPos(playerid, ExplosivoX[playerid], ExplosivoY[playerid], ExplosivoZ[playerid]);
					CaixaExplodir[playerid] = CaixaInfo[i][CaixaID];

					ObjectDinamite[playerid] = CreateDynamicObject(1654, ExplosivoX[playerid], ExplosivoY[playerid], ExplosivoZ[playerid]-0.9, 332.49572754,269.99450684,180.00042725);
					ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 0, 0, 0, 0, 0);
					TempoDinamite[playerid] = SetTimerEx("ExplodirDinamite", 60000, false, "i", playerid);
					LevelHT[playerid] = GetPlayerWantedLevel(playerid);
					LevelHT[playerid] += 4;
					SetPlayerWantedLevel(playerid, LevelHT[playerid]);

					ContagemTelaB[playerid] += 1;
		       		format(string, sizeof(string), "~w~Explodindo: ~r~%d/60", ContagemTelaB[playerid]);
					GameTextForPlayer(playerid, string, 1000, 3);
					TimerContagemB[playerid] = SetTimerEx("ContagemTelaB2", 1000, true, "i", playerid);

					GameTextForPlayer(playerid, "~w~Caixa sera Explodido ~r~Em Breve!", 3000, 3);

					format(gstring, sizeof(gstring), "[INFO] A Org: (%s) Esta Tentando Explodir um Caixa nas Proximidades de: %s", OrgInfo[orgid][OrgNome], zone);
					SendClientMessageToAll(COLOR_LIGHTRED, gstring);

					SegurandoMaoDireita[playerid] = 0;
				    RemovePlayerAttachedObject(playerid, 9);
				    Pp[playerid][Explosivo1] --;
				    SCM(playerid, COR_BRANCO, "{FFD700}[ EXPLOSIVO ]: {FFFFFF}Voce plantou um explosivo ele ira explodir em 10 segundos..");

					for(new ip; ip < MAX_PLAYERS; ip++)
					{
						if(IsPolicial(ip))
                        {
						   	new Float:x,Float:y,Float:z;
							GetPlayerPos(playerid, x,y,z);
							SetPlayerCheckpoint(ip, x,y,z, 6);
							GameTextForPlayer(ip, "~w~Ocorrencia ~r~Marcada!", 3000, 1);
                            CheckPointProfissao[ip] = 1;
						}
					}
					format(MsgOc, sizeof(MsgOc), "OCORRENCIA!! A Faccao %s Esta Tentando Roubar um Caixa nas Proximidades de: %s", OrgInfo[orgid][OrgNome], zone);
					MsgOcorrencia(MsgOc);
				    return 1;
				}
				else
				{
			 		SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta segurando um explosivo.");
			 	}
			}
			else
			{
				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}O caixa eletronico proximo a voce ja foi explodido.");
			}
		}
	}
	if(SegurandoMaoDireita[playerid] == 1)
	{
		GetPlayerPos(playerid, ExplosivoX[playerid], ExplosivoY[playerid], ExplosivoZ[playerid]);

		CaixaExplodir[playerid] = 0;

		ObjectDinamite[playerid] = CreateDynamicObject(1654, ExplosivoX[playerid], ExplosivoY[playerid], ExplosivoZ[playerid]-0.9, 332.49572754,269.99450684,180.00042725);
		ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 0, 0, 0, 0, 0);
		TempoDinamite[playerid] = SetTimerEx("ExplodirDinamite", 10000, false, "i", playerid);
		new LevelHT[MAX_PLAYERS];
		LevelHT[playerid] = GetPlayerWantedLevel(playerid);
		LevelHT[playerid] += 2;
		SetPlayerWantedLevel(playerid, LevelHT[playerid]);

		SegurandoMaoDireita[playerid] = 0;
		RemovePlayerAttachedObject(playerid, 9);
		Pp[playerid][Explosivo1] --;

		SCM(playerid, COR_BRANCO, "{FFD700}[ EXPLOSIVO ]: {FFFFFF}Voce plantou um explosivo ele ira explodir em 10 segundos..");
		return 1;
	}
	return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta segurando um explosivo.");
}

CMD:reparo(playerid)
{
	new Float:Heath;
	idvehicle[playerid] = VeiculoProximo(playerid);

	GetVehicleHealth(idvehicle[playerid], Float:Heath);

	if(SegurandoMaoDireita[playerid] != 3)
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta segurando um kit de reparos.");
	}
	else if(IsPlayerInAnyVehicle(playerid))
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce precisa estar fora de um veiculo.");
	}
	else if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 509 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 481 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 510)
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este veiculo nao possui motor.");
	}
	else if(Heath == 1000)
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este Veiculo nao esta danificado.");
	}
	else if(idvehicle[playerid] > -1)
	{
		PlayerTextDrawShow(playerid, TextdrawKitReparo[0][playerid]);

		ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 0, 0, 0, 0);
		SCM(playerid, -1, "{00FF00}Reparo: {FFFFFF}Voce pegou seu kit de reparo e esta reparando um veiculo..");

		VeiculoReparoKit[playerid] = SetTimerEx("ReparandoVeiculo", 1000, true, "i", playerid);
		return 1;
	}
	else if(idvehicle[playerid] == -1)
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo de nenhum veiculo.");
	}
	return 1;
}

CMD:usargalao(playerid)
{
	idvehicle[playerid] = VeiculoProximo(playerid);
	if(SegurandoMaoDireita[playerid] != 4)
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta segurando um Galao de Gasolina");
	}
	else if(IsPlayerInAnyVehicle(playerid))
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce precisa estar fora de um veiculo.");
	}
	else if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 509 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 481 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 510)
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este veiculo nao possui tanque de combustivel.");
	}
	if(idvehicle[playerid] > -1)
	{
		PlayerTextDrawShow(playerid, TextdrawGalaoGas[0][playerid]);

		ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 0, 0, 0, 0);
		SCM(playerid, -1, "{00FF00}Galao: {FFFFFF}Voce pegou um Galao de Gasolina e esta abastecendo um veiculo proximo.."), GameTextForPlayer(playerid, "~r~Abastecendo", 1200, 1);

		VeiculoGalaoGas[playerid] = SetTimerEx("AbastecendoVeiculoG", 1000, true, "i", playerid);
		return 1;
	}
	else if(idvehicle[playerid] == -1)
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo de nenhum veiculo.");
	}
	return 1;
}

CMD:pegararma(playerid)
{
    if(Pp[playerid][Ferido] == false)
    {
    	new f = MAX_ARMAS+1;
       	for(new a = 0; a < sizeof(ObjCoords); a++)
       	{
       		if(ISP(playerid, 10.0, ObjCoords[a][0], ObjCoords[a][1], ObjCoords[a][2]))
       		{
       			f = a;
       			break;
       		}
       	}
        if(f > MAX_ARMAS) return SCM(playerid, 0x33AA3300, "{FFD700}INFO: {FFFFFF}Voce nao esta Perto de uma Arma!");
       	else
       	{
       		new gunname[25];
       		ObjCoords[f][0] = 0.0;
       		ObjCoords[f][1] = 0.0;
       		ObjCoords[f][2] = 0.0;
       		DestroyDynamicObject(Object[f]);
       		DestroyDynamic3DTextLabel(TextoArma[f]);
       		GivePlayerWeapon(playerid, ObjectID[f][0], ObjectID[f][1]);
       		GetWeaponNameEx(ObjectID[f][0], gunname, sizeof(gunname));
       		new String[220];
       		format(String, sizeof(String), "* O ID: [%d] Pegou %s Do Chao", Pp[playerid][IDF], gunname);
       		ProxDetector(30.0, playerid, String, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
       		ApplyAnimation(playerid, "CARRY", "liftup", 3.0, 0, 0, 0, 0, 0);
       	}
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este Comando Morto");
    }
	return 1;
}

CMD:jogararma(playerid)
{
   	new gunID = GetPlayerWeapon(playerid);
   	new gunAmmo = GetPlayerAmmo(playerid);
   	if(gunID != 0 && gunAmmo != 0)
   	{
   		new f = MAX_ARMAS+1;
   		for(new a = 0; a < sizeof(ObjCoords); a++)
   		{
   			if(ObjCoords[a][0] == 0.0)
   			{
   				f = a;
   				break;
   			}
   		}
   		if(f > MAX_ARMAS) return SCM(playerid, 0x33AA3300, "{FFD700}INFO: {FFFFFF}Voce nao pode jogar esta arma no chao."); // Éste mensaje aparece si se superó el límite [MAX_ARMAS]
   		new gunname[25];
   	    GetWeaponNameEx(gunID, gunname, sizeof(gunname));
   	    //JOGANDO A ARMA NO CHAO
   	    new String[220];
   		format(String, sizeof(String), "* O ID: [%d] Jogou %s No Chao", Pp[playerid][IDF], gunname);
   		ProxDetector(30.0, playerid, String, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
   		ApplyAnimation(playerid, "CARRY", "putdwn", 3.0, 0, 0, 0, 0, 0);
   		//CRIANDO O OBJETO
   		RemovePlayerWeapon(playerid, gunID);
   		ObjectID[f][0] = gunID;
   		ObjectID[f][1] = gunAmmo;
   	    GetPlayerPos(playerid, ObjCoords[f][0], ObjCoords[f][1], ObjCoords[f][2]);
   	    Object[f] = CreateDynamicObject(GunObjects[gunID][0],ObjCoords[f][0],ObjCoords[f][1],ObjCoords[f][2]-1,93.7,120.0,120.0);
   	    new string[450];
		format(string, sizeof(string), "{FFFFFF}(%s)\n/pegararma", gunname);
		TextoArma[f] = CreateDynamic3DTextLabel(string, -1, ObjCoords[f][0],ObjCoords[f][1],ObjCoords[f][2]-1, 15.0);
   	}
    return 1;
}

CMD:verplaca(playerid)
{
    for(new v; v < MAX_VEHICLES; ++v)
    {
        new Float:X, Float:Y, Float:Z;
        GetVehiclePos(v, X, Y, Z);
        if(ISP(playerid, 3.0, X, Y, Z))
        {
            new stg[5000], modelo;
    		format(gstring, sizeof(gstring), "{F5DEB3}: {FFFFFF}Numero da Placa:{FFFFFF} [%d]\n", PlacaVeiculoGCRP[v]);
    		strcat(stg, gstring);
    		modelo = GetVehicleModel(v);
    		format(gstring, sizeof(gstring), "{F5DEB3}: {FFFFFF}Nome do Veiculo: (%s)\n", VehicleNames[modelo-400]);
    		strcat(stg, gstring);
    		ShowPlayerDialog(playerid, 5000, DIALOG_STYLE_MSGBOX, "{FFFFFF}Placa {F5DEB3}Gold City", stg, "Ok", "");
        }
	}
	return 1;
}

CMD:placa(playerid)
{
	if(Pp[playerid][TemCarro2] == 1)
	{
	    if(IfCarro[playerid][TemPlaca] == 1)
	    {
	        if(VeiculoSpawnado[playerid] == 1)
	        {
		        new Float:CarregarVeh[3];
	         	GetVehiclePos(VehConce[playerid], CarregarVeh[0], CarregarVeh[1], CarregarVeh[2]);
	         	if(ISP(playerid, 3.0, CarregarVeh[0], CarregarVeh[1], CarregarVeh[2]))
		    	{
		        	new string[450];
		        	SendClientMessageEx(playerid, -1, "{FFFF00}> {FFFFFF}Id da Sua Placa: {FFDC33}%d {00FF00}Anotado!", IfCarro[playerid][Placa]);
		        }
		        else
			    {
			        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Perto de Seu Veiculo");
			    }
			}
			else
			{
			    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao Spawnou seu Veiculo!");
			}
	    }
	    else
	    {
	        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem Placa");
	    }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem um Veiculo");
    }
    return 1;
}
CMD:venderv(playerid, params[])
{
    if(Pp[playerid][TemCarro2] < 1) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce Nao Tem Nenhum Veiculo!");
    {
	    new id, preco;
	   	if(sscanf(params, "ii", id, preco)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /venderv [IDF] [PRECO]");
	   	{
	   	    if(!IsPlayerInAnyVehicle(playerid)) return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce Nao Esta Em Um Veiculo");
	   	    {
	            for(new i; i < MAX_PLAYERS; i++)
				{
					if(Pp[i][Logado] == true)
					{
					    if(Pp[i][IDF] == id)
					    {
				   	        if(id == Pp[playerid][IDF])
							{
								SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Vender o Veiculo!");
						 		return 1;
							}
					   	    if(Pp[i][TemCarro2] == 0)
					   	    {
					   	        if(GetPlayerCash(i) >= preco)
								{
                                    if(VeiculoSpawnado[playerid] == 1)
                                    {
                                        IDVenda[i] = playerid;
                                        ValorVenda[i] = preco;
                                        new string[1000], mercada[1000];

                                        strcat(string, "Produtos\tPreco\n");
                                        format(mercada, sizeof(mercada), "{FFFF00}> {FFFFFF}O Jogador: %s[%d] ofereceu um veiculo a voce\n", PlayerName(playerid), Pp[playerid][IDF]);
                                        strcat(string, mercada);
                                        format(mercada, sizeof(mercada), "{FFFF00}> {FFFFFF}O Valor do veiculo e de: {00FF00}R$%d\n", preco);
                                        strcat(string, mercada);
                                        format(mercada, sizeof(mercada), "{FFFF00}> {FFFFFF}Voce deseja {00FF00}Aceitar{FFFFFF} ou {FFD700}Recusar{FFFFFF}?\n");
                                        strcat(string, mercada);

                                        return ShowPlayerDialog(i, DIALOG_ACEITARC, DIALOG_STYLE_MSGBOX, "Venda de {00FF00}Veiculo", string, "Aceitar", "Recusar");
                                    }
                                    else
                                    {
                                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta com seu veiculo spawnado para vender-lo");
                                    }
                                }
					   	        else
					   	        {
					   	            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este player nao tem o dinheiro que voce esta pedindo");
					   	        }
					   	    }
					   	    else
					   	    {
					   	        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este player ja tem um Veiculo");
					   	    }
						}
					}
				}
			}
	   	}
	}
	return 1;
}
CMD:perfil(playerid)
{
    if(Pp[playerid][Logado] == true)
    {
        if(Pp[playerid][FezRg] == 1)
        {
    		new stg[15000];
    		format(gstring, sizeof(gstring), "{FFFFFF}Nome:{B22222} [%s]\n", PlayerName(playerid));
    		strcat(stg, gstring);
    		format(gstring, sizeof(gstring), "{FFFFFF}Grana na Mao:{B22222} R$%d\n", GetPlayerCash(playerid));
    		strcat(stg, gstring);
    		format(gstring, sizeof(gstring), "{FFFFFF}Grana no Banco:{B22222} R$%d\n", Pp[playerid][SaldoBancario]);
    		strcat(stg, gstring);
            format(gstring, sizeof(gstring), "{FFFFFF}Avisos Staff:{B22222} [%d/03]\n", Pp[playerid][AvisosP]);
    		strcat(stg, gstring);
