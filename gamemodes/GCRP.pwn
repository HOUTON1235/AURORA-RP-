CMD:ejetar(playerid,params[])
{
	new id, String[220];
	if(sscanf(params, "i", id))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /ejetar [IDF]");
    if(!IsPlayerInAnyVehicle(playerid)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um Veiculo");
    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
    {
     	for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
			        if(id == Pp[playerid][IDF])
			        {
						SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Ejetar");
			        }
           			RemovePlayerFromVehicle(i);
    				format(String,sizeof(String),"{FFD700}[Eject]: {FFFFFF}Voce Ejetou o Player: %s de seu veiculo",PlayerName(i));
		    		SCM(playerid,-1,String);
		    	}
		    }
    	}
    	return 1;
    }
    else
	{
 		SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao e Motorista");
	}
	return 1;
}
