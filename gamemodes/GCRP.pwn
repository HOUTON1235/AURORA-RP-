CallBack:: SegurancaAlgemas(playerid)
{
	if(Pp[playerid][Algemado] == true)
	{
		Controle(playerid, 0);
	}
	else if(Pp[playerid][Algemado] == false)
	{
		Controle(playerid, 1);
		KillTimer(ProtecaoAlgemas[playerid]);
	}
	return 1;
}

