                    SCM(playerid, -1, "{FFD700}> [Cassino]: Enquanto isso, se prepare para ficar devendo ou perder grana ilegalmente.");
                    SCM(playerid, -1, "{FFD700}> [Cassino]: Nao nos responsabilizamos pelas suas escolhas.");
