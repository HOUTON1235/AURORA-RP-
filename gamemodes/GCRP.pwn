CMD:admins(playerid)
{
	new stg[5000];
	strcat(stg, "Admin\tNivel\tStatus\n");
	for(new i; i < MAX_PLAYERS; i++)
	{
	    if(IsPlayerConnected(i))
	   	{
            if(Pp[i][Logado] == true)
            {
    			if(Pp[i][Admin] >= 1)
    			{
    			    if(Trabalhando[i] == true)
    			    {
    					format(gstring, sizeof(gstring), "\n{FFD700}Admin: {FFFFFF}%s[%d]\t{FFD700}Level: {FFFFFF}[%d]\t{00FF00}Trabalhando\n", PlayerName(i), Pp[i][IDF], Pp[i][Admin]);
    					strcat(stg, gstring);
    				}
    				else if(Trabalhando[i] == false)
    				{
    				    format(gstring, sizeof(gstring), "\n{FFD700}Admin: {FFFFFF}%s[%d]\t{FFD700}Level: {FFFFFF}[%d]\t{C0C0C0}Jogando\n", PlayerName(i), Pp[i][IDF], Pp[i][Admin]);
    					strcat(stg, gstring);
    				}
    				ShowPlayerDialog(playerid, 5000, DIALOG_STYLE_TABLIST_HEADERS, "Admins {FFD700}Gold City Roleplay", stg, "Ok", "");
    			}
            }
		}
	}
	return 1;
}

