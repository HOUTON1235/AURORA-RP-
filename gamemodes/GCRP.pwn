CMD:roubarcelular(playerid, params[])
{
	if(IsBandido(playerid))
	{
		new id, string[450];
		if(sscanf(params, "i", id))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /roubarcelular [IDF]");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
                {
                    new Float:X, Float:Y, Float:Z;
                    GetPlayerPos(i, X, Y, Z);
					if(ISP(playerid, 3.0, X, Y, Z))
					{
    			        if(id == Pp[playerid][IDF])
    			        {
    						SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Roubar");
    			        }
                        else if(Pp[i][Celular] == false)
                        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player nao tem um Celular!");
                            return 1;
                        }
                        else if(Pp[i][Celular] == true)
                        {
                            Pp[i][Celular] = false;
                            Pp[playerid][Celulares] += 1;
                            GameTextForPlayer(playerid, "~w~Voce Roubou um ~g~celular", 3000, 4);
                            GameTextForPlayer(i, "~w~Alguem Roubou seu Celular", 3000, 4);
                            SCM(playerid, -1, "{FFFFFF}Voce Roubou um celular de alguem");
                            SCM(i, -1, "{FFFFFF}Voce teve seu celular roubado");
        	                format(string, sizeof(string), "* O ID:[%d] Robou o Celular do ID:[%d]", Pp[playerid][IDF], Pp[i][IDF]);
                            ProxDetector(20.0, playerid, string, COR_PURPLE, COR_PURPLE, COR_PURPLE,COR_PURPLE,COR_PURPLE);
                        }
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a este player");
                    }
                }
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Criminoso");
    }
    return 1;
}
CMD:passarcelular(playerid, params[])
{
	if(Pp[playerid][Celular] == true)
	{
		new id, string[450];
		if(sscanf(params, "i", id))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /passarcelular [IDF]");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
                {
                    new Float:X, Float:Y, Float:Z;
                    GetPlayerPos(i, X, Y, Z);
					if(ISP(playerid, 3.0, X, Y, Z))
					{
    			        if(id == Pp[playerid][IDF])
    			        {
    						SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode passar seu celular a voce mesmo.");
    			        }
                        else if(Pp[i][Celular] == true)
                        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player ja tem um Celular!");
                            return 1;
                        }
                        else if(Pp[i][Celular] == false)
                        {
                            Pp[playerid][Celular] = false;
                            Pp[i][Celular] = true;
                            GameTextForPlayer(playerid, "~w~Voce entregou seu ~g~celular", 3000, 4);
                            GameTextForPlayer(playerid, "~w~Alguem deu um Celular a Voce!", 3000, 4);
                            SCM(playerid, -1, "{FFFFFF}Voce entregou seu celular a Alguem");
                            SCM(i, -1, "{FFFFFF}Voce recebeu um celular em suas maos");
        	                format(string, sizeof(string), "* O ID:[%d] entregou um celular ao ID:[%d]", Pp[playerid][IDF], Pp[i][IDF]);
                            ProxDetector(20.0, playerid, string, COR_PURPLE, COR_PURPLE, COR_PURPLE,COR_PURPLE,COR_PURPLE);
                        }
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a este player");
                    }
                }
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem um celular");
    }
    return 1;
}
