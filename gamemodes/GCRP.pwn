    if(dialogid == DIALOG_NIZAROEMP)
	{
		if(response)
		{
			if(listitem == 0)
			{
                SCM(playerid, -1, "{FFDC33}GRN-Empresas: {FFFFFF}Voce alterou para lider da Uber[Transporte de Passageiros]");
                GameTextForPlayer(playerid, "~w~Agora voce e lider da ~r~Uber", 1200, 4);
                Pp[playerid][EmpLider] = 1;
                Pp[playerid][EmpMembro] = 1;
                Pp[playerid][EmpCargo] = 4;
            }
            if(listitem == 1)
			{
                SCM(playerid, -1, "{FFDC33}GRN-Empresas: {FFFFFF}Voce alterou para lider da Petroleiros[Transporte de Combustivel]");
                GameTextForPlayer(playerid, "~w~Agora voce e lider da ~r~Petroleiro", 1200, 4);
                Pp[playerid][EmpLider] = 2;
                Pp[playerid][EmpMembro] = 2;
                Pp[playerid][EmpCargo] = 4;
            }
        }
    }
    if(dialogid == DIALOG_MUDARORGJ)
	{
		if(response)
		{
			if(listitem == 0)
			{
                SCM(playerid, -1, "{FFDC33}Juan: {FFFFFF}Voce alterou para lider da Org[Tropa do Juan Principal]");
                GameTextForPlayer(playerid, "~w~Agora voce e lider da ~r~Tropa do Juan Principal", 1200, 4);
                Pp[playerid][OrgLider] = 35;
                Pp[playerid][EmpCargo] = 5;
            }
            if(listitem == 1)
			{
                SCM(playerid, -1, "{FFDC33}Juan: {FFFFFF}Voce alterou para lider da Org[Tropa do Juan Secundaria]");
                GameTextForPlayer(playerid, "~w~Agora voce e lider da ~r~Tropa do Juan Secundaria", 1200, 4);
                Pp[playerid][OrgLider] = 15;
                Pp[playerid][EmpCargo] = 5;
            }
        }
    }
	if(dialogid == DIALOG_LOJINHA)
	{
		if(response)
		{
			if(listitem == 0)
			{
				if(GetPlayerCash(playerid) >= 2000)
				{
					if(SegurandoMaoDireita[playerid] == 0)
				    {
				    	SetPlayerAttachedObject(playerid, 9, 18645, 6, 0.0279, 0.0280, 0.0000, -81.9000, -173.6000, 104.4000, 0.8220, 0.8630, 0.7470); //Mão Direita
				    	SegurandoMaoDireita[playerid] = 2; // Capacete
				    	GivePlayerCash(playerid, -2000);
						Pp[playerid][Capacete] = true;

						SCM(playerid, COR_GRAD1, "{FFDC33}Lojinha: {FFFFFF}Voce comprou um capacete, use /capacete para colocar-lo.");
						SCM(playerid, COR_GRAD1, "{FFDC33}Lojinha: {FFFFFF}Para Guarda-lo, Aperte a Tecla Y ou use: /guardaritem.");
                        GameTextForPlayer(playerid, "~w~Aperte Y ~n~ ~w~Para guardar o item ~n~ ~y~na mochila", 1200, 4);
					}
					else if(SegurandoMaoDireita[playerid] > 0)
					{
						return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce esta com as maos cheias.");
					}
				}
				else
				{
					return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao possui dinheiro suficiente.");
				}
			}
			if(listitem == 1)
			{
				if(GetPlayerCash(playerid) >= 3000)
				{
					if(SegurandoMaoDireita[playerid] == 0)
				    {
				    	SetPlayerAttachedObject(playerid, 9, 19921, 6, 0.0279, 0.0280, 0.0000, -81.9000, -173.6000, 104.4000, 0.8220, 0.8630, 0.7470, 0xFFFFFFFF, 0xFFFFFFFF); //Mão Direita
				    	SegurandoMaoDireita[playerid] = 3; // Kit Reparo
				    	GivePlayerCash(playerid, -3000);
				    	Pp[playerid][KitReparo] ++;

						SCM(playerid, COR_GRAD1, "{FFDC33}Lojinha: {FFFFFF}Voce comprou um kit de reparos, use /Reparo para reparar um veiculo.");
						SCM(playerid, COR_GRAD1, "{FFDC33}Lojinha: {FFFFFF}Para Guarda-lo, Aperte a Tecla Y ou use: /guardaritem.");
						GameTextForPlayer(playerid, "~w~Aperte Y ~n~ ~w~Para guardar o item ~n~ ~y~na mochila", 1200, 4);
					}
					else if(SegurandoMaoDireita[playerid] > 0)
					{
						return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce esta com as maos cheias.");
					}
				}
				else
				{
					return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao possui dinheiro suficiente.");
				}
			}
			if(listitem == 2)
			{
				if(Pp[playerid][Celular] == false)
				{
					if(GetPlayerCash(playerid) >= 5000)
					{
				    	GivePlayerCash(playerid, -5000);
				    	Pp[playerid][Celular] = true;

						SCM(playerid, COR_GRAD1, "{FFDC33}Lojinha: {FFFFFF}Voce comprou um celular, use /celular para abrir seu celular.");
                        GameTextForPlayer(playerid, "~w~Use: /celular ~n~ ~w~Para acessar o ~b~Celular", 1200, 4);
					}
					else
					{
						return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao possui dinheiro suficiente.");
					}
				}
				else
				{
					return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce ja possui um celular.");
				}
			}
            if(listitem == 3)
			{
				if(GetPlayerCash(playerid) >= 500)
				{
                    if(SegurandoMaoDireita[playerid] == 0)
                    {
    				    SetPlayerAttachedObject(playerid, 9, 1650, 6, 0.0279, 0.0280, 0.0000, -81.9000, -173.6000, 104.4000, 0.8220, 0.8630, 0.7470, 0xFFFFFFFF, 0xFFFFFFFF); //Mão Direita
    				    SegurandoMaoDireita[playerid] = 4; // Galao de Gasolina
    				    GivePlayerCash(playerid, -500);
                        Pp[playerid][GasGalao] = 0;

    					SCM(playerid, COR_GRAD1, "{FFDC33}Lojinha: {FFFFFF}Voce comprou um Galao de Gasolina, use /usargalao para reparar um veiculo.");
    					SCM(playerid, COR_GRAD1, "{FFDC33}Lojinha: {FFFFFF}Para Guarda-lo, Aperte a Tecla Y ou use: /guardaritem.");
    					GameTextForPlayer(playerid, "~w~Aperte Y ~n~ ~w~Para guardar o item ~n~ ~y~na mochila", 1200, 4);
    				}
    				else if(SegurandoMaoDireita[playerid] > 0)
    				{
    					return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce esta com as maos cheias.");
    				}
				}
				else
				{
					return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao possui dinheiro suficiente.");
				}
			}
		}
	}
    if(dialogid == DIALOG_ACEITARC)
    {
        if(response)
        {
            if(VeiculoSpawnado[IDVenda[playerid]] == 1)
            {
                VeiculoSpawnado[playerid] = VeiculoSpawnado[IDVenda[playerid]];
                new aquivoconce[5000], comprador[5000];
			    format(aquivoconce, sizeof(aquivoconce), PASTA_CONCESSIONARIA, PlayerName(IDVenda[playerid]));
			    if(DOF2_FileExists(aquivoconce))
			    {
					new string[450];
					format(comprador, sizeof(comprador), PASTA_CONCESSIONARIA, PlayerName(playerid));
					DOF2_CreateFile(comprador);
				    VehConce[playerid] = VehConce[IDVenda[playerid]];
					VehConce[IDVenda[playerid]] = 0;
					IfCarro[IDVenda[playerid]][TemCarro] = 0;
					Pp[IDVenda[playerid]][TemCarro2] = 0;
					Pp[IDVenda[playerid]][SpoilerV] = IfCarro[IDVenda[playerid]][Spoiler];
					Pp[playerid][TemCarro2] = 1;
					IfCarro[playerid][TemCarro] = 1;
					GivePlayerCash(IDVenda[playerid], ValorVenda[playerid]);
					GivePlayerCash(playerid, -ValorVenda[playerid]);

				    SendClientMessageEx(IDVenda[playerid], -1, "{48D1CC}Info Venda. {FFFFFF}Voce Vendeu Seu Veiculo: {48D1CC}%s{FFFFFF} Por: {00FF00}R$%d{FFFFFF} Boa Venda!", VehicleNames[DOF2_GetInt(aquivoconce,"VeiculoID")-400], ValorVenda[playerid]);
					SendClientMessageEx(playerid, -1, "{48D1CC}Info Venda. {FFFFFF}Voce Comprou o Veiculo: {48D1CC}%s{FFFFFF} Por: {00FF00}R$%d{FFFFFF} Boa Compra!", VehicleNames[DOF2_GetInt(aquivoconce,"VeiculoID")-400], ValorVenda[playerid]);

                    DOF2_SetInt(comprador, "Cor", IfCarro[IDVenda[playerid]][Cor]);
					DOF2_SetInt(comprador, "Nitro", IfCarro[IDVenda[playerid]][Nitro]);
					DOF2_SetInt(comprador, "Hidraulica", IfCarro[IDVenda[playerid]][Hidraulica]);
					DOF2_SetInt(comprador, "Roda", IfCarro[IDVenda[playerid]][Roda]);
					DOF2_SetInt(comprador, "Spoiler", Pp[IDVenda[playerid]][SpoilerV]);
					DOF2_SetInt(comprador, "Placa", IfCarro[IDVenda[playerid]][Placa]);
					DOF2_SetInt(comprador, "ArmaM4", IfCarro[IDVenda[playerid]][ArmaM4]);
					DOF2_SetInt(comprador, "MunM4", IfCarro[IDVenda[playerid]][MunM4]);
					DOF2_SetInt(comprador, "ArmaMP5", IfCarro[IDVenda[playerid]][ArmaMP5]);
					DOF2_SetInt(comprador, "MunMP5", IfCarro[IDVenda[playerid]][MunMP5]);
					DOF2_SetInt(comprador, "ArmaDesert", IfCarro[IDVenda[playerid]][ArmaDesert]);
					DOF2_SetInt(comprador, "MunDesert", IfCarro[IDVenda[playerid]][MunDesert]);
					DOF2_SetInt(comprador, "Shotgun", IfCarro[IDVenda[playerid]][Shotgun]);
					DOF2_SetInt(comprador, "MunShot", IfCarro[IDVenda[playerid]][MunShot]);
					DOF2_SetInt(comprador, "ArmaAk", IfCarro[IDVenda[playerid]][ArmaAk]);
					DOF2_SetInt(comprador, "MunAk", IfCarro[IDVenda[playerid]][MunAk]);
					DOF2_SetInt(comprador, "GasVeh", IfCarro[IDVenda[playerid]][GasVeh]);
					DOF2_SetFloat(comprador, "VidaC", DOF2_GetFloat(aquivoconce, "VidaC"));
					DOF2_SetInt(comprador, "TemPlaca", IfCarro[IDVenda[playerid]][TemPlaca]);
				    DOF2_SetInt(comprador, "VehAp", IfCarro[IDVenda[playerid]][VehAp]);
					DOF2_SetInt(comprador, "TemCarro", IfCarro[IDVenda[playerid]][TemCarro]);
					DOF2_SetInt(comprador, "VeiculoID", DOF2_GetInt(aquivoconce,"VeiculoID"));

                    new Float:PosVeh[4],Float:RotVeh;
					GetVehiclePos(VehConce[playerid],PosVeh[0],PosVeh[1],PosVeh[2]);
					GetVehicleZAngle(VehConce[playerid],RotVeh);

                    DOF2_SetFloat(comprador,"VehPosX",PosVeh[0]);
				    DOF2_SetFloat(comprador,"VehPosY",PosVeh[1]);
					DOF2_SetFloat(comprador,"VehPosZ",PosVeh[2]);
					DOF2_SetFloat(comprador,"VehPosR",RotVeh);
					DOF2_SaveFile();

					IfCarro[IDVenda[playerid]][Cor] = 0;
					IfCarro[IDVenda[playerid]][Nitro] = 0;
					IfCarro[IDVenda[playerid]][Hidraulica] = 0;
					IfCarro[IDVenda[playerid]][Roda] = 0;
					IfCarro[IDVenda[playerid]][Spoiler] = 0;
					IfCarro[IDVenda[playerid]][Placa] = 0;
					IfCarro[IDVenda[playerid]][ArmaM4] = 0;
					IfCarro[IDVenda[playerid]][MunM4] = 0;
					IfCarro[IDVenda[playerid]][ArmaMP5] = 0;
					IfCarro[IDVenda[playerid]][MunMP5] = 0;
					IfCarro[IDVenda[playerid]][ArmaDesert] = 0;
					IfCarro[IDVenda[playerid]][MunDesert] = 0;
					IfCarro[IDVenda[playerid]][Shotgun] = 0;
					IfCarro[IDVenda[playerid]][MunShot] = 0;
					IfCarro[IDVenda[playerid]][ArmaAk] = 0;
					IfCarro[IDVenda[playerid]][MunAk] = 0;
					IfCarro[IDVenda[playerid]][GasVeh] = 0;
					IfCarro[IDVenda[playerid]][TemPlaca] = 0;
				    IfCarro[IDVenda[playerid]][VehAp] = 0;
					DOF2_RemoveFile(aquivoconce);
				}
            }
        }
        else
        {
            SCM(IDVenda[playerid], -1, "{FFFFFF}O jogador recusou seu veiculo.");
            IDVenda[playerid] = 0;
            ValorVenda[playerid] = 0;
            SCM(playerid, -1, "{FFFFFF}Voce recusou a venda do veiculo.");
        }
    }
    if(dialogid == DIALOG_MENUBOT)
	{
		if(response)
		{
			if(listitem == 0)
			{
			    if(Pp[playerid][DinheiroSujo] >= 1000)
				{
				    GameTextForPlayer(playerid, "~w~Lavando Dinheiro ~r~Sujo..", 8000, 3);
					SetTimerEx("TempoLavagem", 8000, 0, "i", playerid);
					ValorLava[playerid] = Pp[playerid][DinheiroSujo];
					Controle(playerid, 0);
					ApplyAnimation(playerid, "GANGS", "DEALER_DEAL", 4.1, 1, 1, 1, 0, 0, 1);
				    new String[220];
					SCM(playerid, COR_GRAD1, "{FFDC33}Biqueira: {FFFFFF}Lavando Dinheiro Aguarde....");
					format(String,sizeof(String),"* O ID:[%d] Esta Lavando Dinheiro Sujo...",Pp[playerid][IDF]);
					ProxDetector(15.0, playerid, String, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
				}
				else
				{
					return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao possui o Minimo de R$1000 de dinheiro sujo para lavar.");
				}
			}
            if(listitem == 1)
