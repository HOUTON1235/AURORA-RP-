CMD:mostrarrg(playerid, params[])
{
    if(Pp[playerid][Logado] == true)
	{
        if(Pp[playerid][FezRg] == 1)
        {
    		new id;
    		if(sscanf(params, "ii", id))
    		{
    			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /mostrarrg [IDF]");
    		}
      		for(new i; i < MAX_PLAYERS; i++)
    		{
    			if(Pp[i][Logado] == true)
    			{
    			    if(Pp[i][IDF] == id)
    			    {
                        new Float:X, Float:Y, Float:Z;
                        GetPlayerPos(i, X, Y, Z);
    					if(ISP(playerid, 3.0, X, Y, Z))
    					{
        					new stg[15000];
        					format(gstring, sizeof(gstring), "{FFFFFF}Nome da conta:{FFFFFF} %s.\n", PlayerName(playerid));
        					strcat(stg, gstring);
        					format(gstring, sizeof(gstring), "{FFFFFF}Saldo Banco:{00FF00} R$%d.\n", Pp[playerid][SaldoBancario]);
        					strcat(stg, gstring);
        					format(gstring, sizeof(gstring), "{FFFFFF}Dinheiro:{00FF00} R$%d.\n", GetPlayerCash(playerid));
        					strcat(stg, gstring);
                            format(gstring, sizeof(gstring), "{FFFFFF}Avisos Admin:{FFDC33} %d/03.\n", Pp[playerid][AvisosP]);
        					strcat(stg, gstring);
        					format(gstring, sizeof(gstring), "{FFFFFF}Dinheiro Sujo:{FFD700} R$%d.\n", Pp[playerid][DinheiroSujo]);
        					strcat(stg, gstring);
        					format(gstring, sizeof(gstring), "{FFFFFF}Drogas:{FFFFFF} %dg\n", Pp[playerid][Droga]);
        					strcat(stg, gstring);
                            format(gstring, sizeof(gstring), "{FFFFFF}Multas:{FFFFFF} %d\n", Pp[playerid][Multas]);
    		                strcat(stg, gstring);
                            format(gstring, sizeof(gstring), "{FFFFFF}Celulares Roubados:{FFFFFF} %d\n", Pp[playerid][Celulares]);
    		                strcat(stg, gstring);
        					format(gstring, sizeof(gstring), "{FFFFFF}Sementes:{FFFFFF} %d\n", Pp[playerid][Sementes]);
        					strcat(stg, gstring);
        					format(gstring, sizeof(gstring), "{FFFFFF}Pecas de AK:{FFFFFF} %d\n", Pp[playerid][PecasAk47]);
        					strcat(stg, gstring);
        					format(gstring, sizeof(gstring), "{FFFFFF}Pecas de MP5:{FFFFFF} %d\n", Pp[playerid][PecasMP5]);
        					strcat(stg, gstring);
        					format(gstring, sizeof(gstring), "{FFFFFF}Pecas de Desert:{FFFFFF} %d\n", Pp[playerid][PecasDesert]);
        					strcat(stg, gstring);
        					format(gstring, sizeof(gstring), "{FFFFFF}Genero{FFFFFF} %d.\n", Pp[playerid][Sexo]);
        					strcat(stg, gstring);
                            if(Pp[playerid][HabilitacaoA] == 1)
                            {
                        	    strcat(stg, "{FFFFFF}Habilitacao A:{00FF00} Sim.\n");
                            }
                            else
                            {
                        	    strcat(stg, "{FFFFFF}Habilitacao A:{FFD700} Nao.\n");
                            }
                            if(Pp[playerid][HabilitacaoB] == 1)
                            {
                        	    strcat(stg, "{FFFFFF}Habilitacao B:{00FF00} Sim.\n");
                            }
                            else
                            {
                        	    strcat(stg, "{FFD700}Habilitacao B:{FFD700} Nao.\n");
                            }
                            if(Pp[playerid][HabilitacaoC] == 1)
                            {
