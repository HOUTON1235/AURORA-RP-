    }
	return 0;
}
stock strtok(const string[], &index)
{
	new length = strlen(string);
	while ((index < length) && (string[index] <= ' '))
	{
		index++;
	}

	new offset = index;
	new result[20];
	while ((index < length) && (string[index] > ' ') && ((index - offset) < (sizeof(result) - 1)))
	{
		result[index - offset] = string[index];
		index++;
	}
	result[index - offset] = EOS;
	return result;
}

stock split(const strsrc[], strdest[][], delimiter)
{
	new i, li;
	new aNum;
	new len;
	while(i <= strlen(strsrc)){
		if(strsrc[i]==delimiter || i==strlen(strsrc)){
			len = strmid(strdest[aNum], strsrc, li, i, 128);
			strdest[aNum][len] = 0;
			li = i+1;
			aNum++;
		}
		i++;
	}
	return 1;
}
stock StringPID(const nick[])
{
	for(new i = 0 ;i<MAX_PLAYERS;i++)
	{
		if(Pp[i][Logado] == true)
		{
			if(new_strcmp(nick,PlayerName(i)))
			{
				return i;
			}
		}
	}
	return -1;
}
stock GetNumberOfPlayersOnThisIP(const testip[])
{
    new against_ip[32+1];
    new x = 0;
    new ip_count = 0;
    for(x=0; x<MAX_PLAYERS; x++)
    {
        if(IsPlayerConnected(x))
        {
            GetPlayerIp(x,against_ip,32);
            if(!strcmp(against_ip,testip)) ip_count++;
        }
    }
    return ip_count;
}

stock SCMAdm(COLOR,const string[],level)
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(Pp[i][Logado] == true)
        {
            if (Pp[i][Admin] >= level)
            {
                SendClientMessage(i, COLOR, string);
            }
        }
    }
    return 1;
}

stock SCMAdmDono(COLOR,const string[],level)
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(Pp[i][Logado] == true)
        {
            if (Pp[i][Admin] >= level)
            {
                if(Trabalhando[i] == true)
                {
                	SendClientMessage(i, COLOR, string);
                }
            }
        }
    }
    return 1;
}

