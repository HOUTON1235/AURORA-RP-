CMD:revistar(playerid, params[])
{
	if(IsPolicial(playerid))
	{
	    new id, Float:X, Float:Y, Float:Z;
	    if(sscanf(params,"d",id))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /revistar [IDF]");
		{
      		for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
					    if(id == Pp[playerid][IDF])
						{
							SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Revistar!");
					 		return 1;
						}
					    GetPlayerPos(i, X, Y, Z);
						if(ISP(playerid, 3.0, X, Y, Z))
						{
						    new linha[50], folha[500], string[450];
							if(Pp[i][Mochila] == 1)
							{
								for(new i2; i2 < 10; i2++)
								{
									if(SlotMochila[i][i2] == 1)
									{
										format(linha, sizeof(linha), "{FFFFFF}Dinamite\n");
										strcat(folha, linha);
									}
									if(SlotMochila[i][i2] == 2)
									{
										format(linha, sizeof(linha), "{FFFFFF}Capacete\n");
										strcat(folha, linha);
									}
									if(SlotMochila[i][i2] == 3)
									{
										format(linha, sizeof(linha), "{FFFFFF}Kit Reparo\n");
										strcat(folha, linha);
									}
                                    if(SlotMochila[i][i2] == 4)
									{
										format(linha, sizeof(linha), "{FFFFFF}Galao de Gasolina\n");
										strcat(folha, linha);
									}
                                    if(SlotMochila[i][i2] == 5)
									{
										format(linha, sizeof(linha), "{FFFFFF}Pizza\n");
										strcat(folha, linha);
									}
                                    if(SlotMochila[i][i2] == 6)
									{
										format(linha, sizeof(linha), "{FFFFFF}Hamburguer\n");
										strcat(folha, linha);
									}
                                    if(SlotMochila[i][i2] == 7)
									{
										format(linha, sizeof(linha), "{FFFFFF}Suco\n");
										strcat(folha, linha);
									}
                                    if(SlotMochila[i][i2] == 8)
									{
										format(linha, sizeof(linha), "{FFFFFF}Refrigerante\n");
										strcat(folha, linha);
									}
									else if(SlotMochila[i][i2] == 0)
									{
										format(linha, sizeof(linha), "{FFD700}N/A\n");
										strcat(folha, linha);
									}
								}
								ShowPlayerDialog(playerid, 5000, DIALOG_STYLE_MSGBOX, "Mochila do Player", folha, "Ok", "");
							}
					    	GameTextForPlayer(i, "~r~Revistado!", 1500, 3);
					    	GameTextForPlayer(playerid, "~r~Revistando...!", 1500, 1);
					    	SetTimerEx("DCANIM", 4000, false, "i", i);
					    	SetTimerEx("DCANIM", 4001, false, "i", playerid);
					    	ApplyAnimation(i, "PED", "handsup", 4.1, 0, 0, 1, 1, 0, 0);
					    	ApplyAnimation(playerid, "GANGS", "DEALER_DEAL", 4.1, 1, 1, 1, 0, 0, 1);
							format(string, sizeof(string), "* O Oficial ID:[%d] Revistou o ID:[%d]", Pp[playerid][IDF], Pp[i][IDF]);
							ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
							return 1;
						}
						else
						{
						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a este Player");
						}
					}
				}
			}
			return 1;
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Policial");
	}
	return 1;
}


CMD:revistararmas(playerid, params[])
{
	if(IsPolicial(playerid))
	{
	    new id, Float:X, Float:Y, Float:Z;
	    if(sscanf(params,"d",id))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /revistararmas [IDF]");
		{
      		for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
					    if(id == Pp[playerid][IDF])
						{
							SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Revistar!");
					 		return 1;
						}
					    GetPlayerPos(i, X, Y, Z);
						if(ISP(playerid, 3.0, X, Y, Z))
						{
						    new string[450];
							if(Pp[i][Mochila] == 1)
							{
								new Inv[5000], Nick[20];
								for(new i2 = 0; i2 != 8; i2++)
								{
									GetWeaponName(InventarioArma[i2][i], Nick, 20);
									strcat(Inv, InventarioArma[i2][i] > 0 ? (InventarioArma[i2][i] == 18 ? ("Cocktail Molotov") : (Nick)) : ("{FFD700}N/A"));
									strcat(Inv, "\n");
								}
								strcat(Inv, "{FFFFFF}Mochila {48D1CC}Revistada!");
								ShowPlayerDialog(playerid, 5000, DIALOG_STYLE_MSGBOX, "Mochila do Player", Inv, "Fechar","");
							}
					    	GameTextForPlayer(i, "~r~Revistado!", 1500, 3);
					    	GameTextForPlayer(playerid, "~r~Revistando...!", 1500, 1);
					    	SetTimerEx("DCANIM", 4000, false, "i", i);
					    	SetTimerEx("DCANIM", 4001, false, "i", playerid);
					    	ApplyAnimation(i, "PED", "handsup", 4.1, 0, 0, 1, 1, 0, 0);
					    	ApplyAnimation(playerid, "GANGS", "DEALER_DEAL", 4.1, 1, 1, 1, 0, 0, 1);
							format(string, sizeof(string), "* O Oficial %s Revistou o Player %s", PlayerName(playerid), PlayerName(i));
							ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
							return 1;
						}
						else
						{
						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a este Player");
						}
					}
				}
			}
			return 1;
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Policial");
	}
	return 1;
}

CMD:limparmochila(playerid, params[])
