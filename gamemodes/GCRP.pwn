CMD:roubar(playerid)
{
	if(IsBandido(playerid))
	{
		new string[450], orgid = GetPlayerOrg(playerid);
	    if(ISP(playerid, 2.0, 1324.5962,-859.1231,39.6006))
		{
		    if(RoubandoReg[playerid] == 0)
		    {
			    if(RoubouReg[playerid] == 0)
			    {
			        if(RegLS1 == 0)
			    	{
			    	    if(GetPlayerWeapon(playerid) >= 22)
			    	    {
					        format(string, sizeof(string), "Seguranca: O %s e os %s estao roubando a caixa registradora da Loja de Vinewood", PlayerName(playerid), OrgInfo[orgid][OrgNome]);
							SendClientMessageToAll(COLOR_LIGHTRED, string);
							SCM(playerid, -1, "{FFDC33}Roubo: {FFFFFF}Voce esta roubando a Caixa Registradora, Aguarde...");
							ApplyAnimation(playerid, "BAR", "BARSERVE_BOTTLE", 4.1, 1, 1, 1, 0, 0, 1);
				 			Controle(playerid, 0);
				 			RoubandoReg[playerid] = 1;
				 			RoubouReg[playerid] = 1;
				 			RegLS1 = 1;
							GameTextForPlayer(playerid, "~w~Roubando...", 60001, 1);
							SetTimerEx("TempoRouboReg", 60000, 0, "i", playerid);
							SetTimerEx("TempoPlayerReg", 300000, 0, "i", playerid);
							new MsgOc[5000];
							format(MsgOc, sizeof(MsgOc), "Todas as Unidades, O Suspeito: %s(%d) Esta Roubando uma Loja em Vinewood -", PlayerName(playerid), Pp[playerid][IDF]);
							MsgOcorrencia(MsgOc);
							roubando[playerid] += 3;
							SetPlayerWantedLevel(playerid, roubando[playerid]);
							roubando[playerid] = 0;
                            for(new ip; ip < MAX_PLAYERS; ip++)
        					{
        						if(IsPolicial(ip))
                                {
        						   	new Float:x,Float:y,Float:z;
        							GetPlayerPos(playerid, x,y,z);
        							SetPlayerCheckpoint(ip, x,y,z, 6);
        							GameTextForPlayer(ip, "~w~Ocorrencia ~r~Marcada!", 3000, 1);
                                    CheckPointProfissao[ip] = 1;
        						}
        					}
						}
				    	else
				    	{
				    	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta com nenhuma Arma..");
				    	    return 1;
				    	}
					}
			    	else
			    	{
			    	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Mercado Ja Foi Roubado");
			    	    return 1;
			    	}
		    	}
		    	else
		    	{
		    	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja roubou Esta 24/7, Aguarde 5 Minutos Para Poder Roubar Novamente");
		    	    return 1;
		    	}
		    }
		    else
		    {
		        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja esta Roubando..");
		        return 1;
		    }
		}
		if(ISP(playerid, 10.0, 344.0612,-1796.3104,5.4106))
		{
		    if(RoubandoReg[playerid] == 0)
		    {
			    if(RoubouReg[playerid] == 0)
			    {
			    	if(RegLS2 == 0)
			    	{
			    	    if(GetPlayerWeapon(playerid) >= 22)
			    	    {
					        format(string, sizeof(string), "O %s e os %s Estao Tentando Roubar a Caixa Registradora da 24/7 da Praia LS", PlayerName(playerid), OrgInfo[orgid][OrgNome]);
