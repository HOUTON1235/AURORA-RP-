				    SCM(playerid, 0xFF0000FF, mensagem);
				    DestroyDynamicPickup(PickupPosto[id]);
        			DestroyDynamicMapIcon(PickupPosto[id]);
        			DestroyDynamic3DTextLabel(TextoPosto[id]);
				    PostoInfo[id][PostoPosX] = 0;
					PostoInfo[id][PostoPosY] = 0;
					PostoInfo[id][PostoPosZ] = 0;
                    PostoInfo[id][PostoGas] = 0;
					return 1;
				}
				else
				{
			        format(mensagem, sizeof(mensagem), "{FFD700}INFO: {FFFFFF}O Posto [%d] Nao Existe nso Arquivos do Servidor.", id);
					SCM(playerid, 0xFF0000FF, mensagem);
				}
			}
			else
			{
			    format(mensagem, sizeof(mensagem), "{FFD700}INFO: {FFFFFF}Voce nao esta Proximo do Posto Id: %d.", id);
				SCM(playerid, 0xFF0000FF, mensagem);
			}
		}
	}
	return 1;
}

CMD:criarcaixa(playerid, params[])
{
	if(Pp[playerid][Admin] >= 6)
	{
		for(new i = 1; i < MAX_CAIXAS; i++)
		{
			format(arquivo, sizeof(arquivo), PASTA_CAIXAS, i);
			if(!DOF2_FileExists(arquivo))
			{
				new Float:CaixaX, Float:CaixaY, Float:CaixaZ, Float:CaixaR;
				GetPlayerPos(playerid, Float:CaixaX, Float:CaixaY, Float:CaixaZ);
				GetPlayerFacingAngle(playerid, Float:CaixaR);

				DOF2_CreateFile(arquivo);
				DOF2_SetInt(arquivo, "CaixaID", i);
				DOF2_SetBool(arquivo, "CaixaExplodido", false);

				DOF2_SetFloat(arquivo, "CaixaPosX", CaixaX);
				DOF2_SetFloat(arquivo, "CaixaPosY", CaixaY);
				DOF2_SetFloat(arquivo, "CaixaPosZ", CaixaZ);
				DOF2_SetFloat(arquivo, "CaixaPosR", CaixaR);
				DOF2_SaveFile();

				CaixaInfo[i][CaixaID] = DOF2_GetInt(arquivo, "CaixaID");
				CaixaInfo[i][CaixaExplodido] = DOF2_GetBool(arquivo, "CaixaExplodido");

				CaixaInfo[i][CaixaPosX] = DOF2_GetFloat(arquivo, "CaixaPosX");
				CaixaInfo[i][CaixaPosY] = DOF2_GetFloat(arquivo, "CaixaPosY");
				CaixaInfo[i][CaixaPosZ] = DOF2_GetFloat(arquivo, "CaixaPosZ");
				CaixaInfo[i][CaixaPosR] = DOF2_GetFloat(arquivo, "CaixaPosR");

				ObjetoCaixa[i] = CreateDynamicObject(19324, CaixaInfo[i][CaixaPosX], CaixaInfo[i][CaixaPosY], CaixaInfo[i][CaixaPosZ]-0.3, 0.0, 0.0, CaixaInfo[i][CaixaPosR]);

                MapIconCaixa[i] = CreateDynamicMapIcon(CaixaInfo[i][CaixaPosX], CaixaInfo[i][CaixaPosY], CaixaInfo[i][CaixaPosZ], 52, 0, -1, -1, -1, 100.0, MAPICON_LOCAL);

                new string[450];
				format(string, sizeof(string), "{FFD700}Caixinha Gold City\nCaixa: ({FFD700}%d{FFFFFF})\nPressione '{FFD700}F{FFFFFF}'", CaixaInfo[i][CaixaID]);
				TextoCaixa[i] = CreateDynamic3DTextLabel(string, -1, CaixaInfo[i][CaixaPosX], CaixaInfo[i][CaixaPosY], CaixaInfo[i][CaixaPosZ], 15.0);
				return 1;
			}
		}
	}
	else
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando.");
	}
	return 1;
}

CMD:repararcaixa(playerid, params[])
{
	if(IsPolicial(playerid))
	{
	    new id, mensagem[5000], orgid = GetPlayerOrg(playerid), zone[MAX_ZONE_NAME], String[220];
		if(sscanf(params, "i", id)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /repararcaixa [ID do Caixa].");
		{
		    if(ISP(playerid, 2.0, CaixaInfo[id][CaixaPosX], CaixaInfo[id][CaixaPosY], CaixaInfo[id][CaixaPosZ]))
			{
			    if(CaixaInfo[id][CaixaExplodido] == true)
			    {
			        GameTextForPlayer(playerid, "~w~Reparando Caixa ~r~Aguarde...", 30000, 3);
			        ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 1, 1, 0, 0, 1);
                    ReparandoCaixa[playerid] = 1;
					GetPlayer2DZone(playerid, zone, MAX_ZONE_NAME);
			        SetTimerEx("RepararCaixa", 30000, true, "i", playerid);
			        CaixaIdRP[playerid] = id;
			        format(String, sizeof(String), "[INFO] A Corporacao %s Esta Reparando um Caixa nas Proximidades de %s", OrgInfo[orgid][OrgNome], zone);
					SendClientMessageToAll(COLOR_LIGHTRED, String);
					Controle(playerid, 0);
					ProtecaoAlgemas[playerid] = SetTimerEx("k", 500, true, "d", playerid);
				}
				else
				{
				    format(mensagem, sizeof(mensagem), "{FFD700}INFO: {FFFFFF}O Caixa Id: %d Nao esta Explodido", id);
					SCM(playerid, 0xFF0000FF, mensagem);
				}
			    return 1;
			}
			else
			{
			    format(mensagem, sizeof(mensagem), "{FFD700}INFO: {FFFFFF}Voce nao esta Proximo do Caixa Id: %d.", id);
				SCM(playerid, 0xFF0000FF, mensagem);
			}
		}
		return 1;
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Policial");
	}
	return 1;
}

CMD:dcaixa(playerid, params[])
{
	if(Pp[playerid][Admin] >= 4)
	{
		new id, arquivoCA[5000], mensagem[128];
		if(sscanf(params, "i", id)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /dcaixa [ID do Caixa].");
		{
		    if(ISP(playerid, 2.0, CaixaInfo[id][CaixaPosX], CaixaInfo[id][CaixaPosY], CaixaInfo[id][CaixaPosZ]))
			{
				format(arquivoCA, sizeof(arquivoCA), PASTA_CAIXAS, id);
				if(DOF2_FileExists(arquivoCA))
				{
				    DOF2_RemoveFile(arquivoCA);
					format(mensagem, sizeof(mensagem), "{FFD700}[Info-Caixa]: {FFFFFF}Voce deletou o Caixa id: %d.", id);
				    SCM(playerid, 0xFF0000FF, mensagem);
				    DestroyDynamicObject(ObjetoCaixa[id]);
				    DestroyDynamic3DTextLabel(TextoCaixa[id]);
                    DestroyDynamicMapIcon(MapIconCaixa[id]);
				    CaixaInfo[id][CaixaPosX] = 0;
					CaixaInfo[id][CaixaPosY] = 0;
					CaixaInfo[id][CaixaPosZ] = 0;
					CaixaInfo[id][CaixaPosR] = 0;
					return 1;
				}
				else
				{
			        format(mensagem, sizeof(mensagem), "{FFD700}INFO: {FFFFFF}O Caixa [%d] Nao Existe nso Arquivos do Servidor.", id);
					SCM(playerid, 0xFF0000FF, mensagem);
				}
			}
			else
			{
			    format(mensagem, sizeof(mensagem), "{FFD700}INFO: {FFFFFF}Voce nao esta Proximo do Caixa Id: %d.", id);
				SCM(playerid, 0xFF0000FF, mensagem);
			}
		}
	}
	return 1;
}
CMD:criarbot(playerid, params[])
{
	if(Pp[playerid][Admin] >= 6)
	{
		new skin, anim1[64], anim2[64];
		if(sscanf(params, "dss[64]", skin, anim1, anim2))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /CriarBot [Skin], [Anim1], [Anim2].");
		}
		else
		{
			for(new i = 1; i < MAX_BOTS; i++)
			{
				format(arquivo, sizeof(arquivo), PASTA_BOTS, i);
				if(!DOF2_FileExists(arquivo))
				{
					new Float:BPosX, Float:BPosY, Float:BPosZ, Float:BPosR;
					GetPlayerPos(playerid, Float:BPosX, Float:BPosY, Float:BPosZ);
					GetPlayerFacingAngle(playerid, Float:BPosR);

					DOF2_CreateFile(arquivo);
					DOF2_SetString(arquivo, "BotAnimlib", anim1);
					DOF2_SetString(arquivo, "BotAnimname", anim2);

					DOF2_SetInt(arquivo, "BotVirtualW", GetPlayerVirtualWorld(playerid));
					DOF2_SetInt(arquivo, "BotInterior", GetPlayerInterior(playerid));

					DOF2_SetInt(arquivo, "BotID", i);
					DOF2_SetInt(arquivo, "BotSkin", skin);

					DOF2_SetFloat(arquivo, "BotPosX", BPosX);
					DOF2_SetFloat(arquivo, "BotPosY", BPosY);
					DOF2_SetFloat(arquivo, "BotPosZ", BPosZ);
					DOF2_SetFloat(arquivo, "BotPosR", BPosR);
					DOF2_SaveFile();

					BotInfo[i][BotID] = DOF2_GetInt(arquivo, "BotID");
					BotInfo[i][BotSkin] = DOF2_GetInt(arquivo, "BotSkin");

					BotInfo[i][BotVirtualW] = DOF2_GetInt(arquivo, "BotVirtualW");
					BotInfo[i][BotInterior] = DOF2_GetInt(arquivo, "BotInterior");

					BotInfo[i][BotPosX] = DOF2_GetFloat(arquivo, "BotPosX");
					BotInfo[i][BotPosY] = DOF2_GetFloat(arquivo, "BotPosY");
					BotInfo[i][BotPosZ] = DOF2_GetFloat(arquivo, "BotPosZ");
					BotInfo[i][BotPosR] = DOF2_GetFloat(arquivo, "BotPosR");

					CriarNPCS[i] = CreateDynamicActor(BotInfo[i][BotSkin], BotInfo[i][BotPosX], BotInfo[i][BotPosY], BotInfo[i][BotPosZ], BotInfo[i][BotPosR], 1, 100.0, BotInfo[i][BotVirtualW], BotInfo[i][BotInterior]);
					ApplyDynamicActorAnimation(CriarNPCS[i], BotInfo[i][BotAnimlib], BotInfo[i][BotAnimname], 4.1, 1, 0, 0, 0, 0);

     				new string[5500];
					format(string, sizeof(string), "ID:[%d]", BotInfo[i][BotID]);
					TextoBot[i] = CreateDynamic3DTextLabel(string, -1, BotInfo[i][BotPosX], BotInfo[i][BotPosY], BotInfo[i][BotPosZ], 1.0);

					format(string, sizeof(string), "{FFFFFF}[INFO] O bot de ID: %d foi criado com a skin de ID: %d", BotInfo[i][BotID], BotInfo[i][BotSkin]);
					SCM(playerid, -1, string);
					return 1;
				}
			}
		}
	}
	else
	{
		SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a executar este comando.");
	}
	return 1;
}

CMD:convidar(playerid, params[])
{
    if(Pp[playerid][Logado] == true)
    {
    	for(new i2; i2 < MAX_ORGS; i2++)
    	{
      		if(Pp[playerid][OrgLider] == i2 || Pp[playerid][OrgSubLider] == i2 || Pp[playerid][OrgSubLider] == i2)
    		{
    		    if(Pp[playerid][OrgCargo] < 4)return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao e lider ou sub para Convidar");
    			new id, orgid = GetPlayerOrg(playerid);
    			if(sscanf(params, "i", id))
    			{
    				return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /convidar [playerid].");
    			}
    			if(Pp[playerid][FezRg] == 1)
        		{
    	   			for(new i; i < MAX_PLAYERS; i++)
    				{
    					if(Pp[i][Logado] == true)
    					{
    					    if(Pp[i][IDF] == id)
    					    {
                                if(Pp[i][FezRg] != 0)
    							{
                                    if(GetPlayerScore(i) >= 0)
                                    {
            						 	if(Pp[i][OrgLider] != 0)
            							{
            								return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este Jogador ja e lider de uma organizacao.");
            							}
            							else if(Pp[i][OrgMembro] != 0)
            							{
            								return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este Jogador ja e membro de uma organizacao.");
            							}
            							else if(TemVaga(orgid) == 0)
            					    	{
            								return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}nao ha mais vagas na lista use /limparvaga primeiro.");
            					    	}
            							format(arquivo, sizeof(arquivo), PASTA_ORGS, orgid);

            							format(gstring, sizeof(gstring), "{DAA520}InfoOrg: {FFFFFF}Voce convidou o Jogador: (({DAA520}%s{FFFFFF})) para sua organizacao.", PlayerName(i));
            					        SCM(playerid, COR_AZUL, gstring);

            							format(gstring, sizeof(gstring), "{DAA520}InfoOrg: {FFFFFF}O Lider ((%s)) te convidou para organizacao << {DAA520}%s {FFFFFF}>>, Use /AceitarConvite.", PlayerName(playerid), OrgInfo[orgid][OrgNome]);
            					        SendClientMessage(i, COR_AZUL, gstring);

                                        GameTextForPlayer(i, "~w~Voce Foi ~g~Convidado(a) ~n~ ~w~ Use: /aceitarconvite", 5000, 3);

            					        PedidoConvite[i] = orgid;
            			        		return 1;
                                    }
                                    else
                                    {
                                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode convidar jogadores de nivel menor que 3");
                                    }
                                }
                                else
                                {
                                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Jogador nao tem Documento RG Registrado");
                                }
    			        	}
    			        }
    				}
    			}
    			else
    			{
    			    SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao tem RG");
    			}
    			return 1;
    		}
    		else
    		{
    			SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao faz parte de nenhuma org/corp.");
    			return 1;
    		}
    	}
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    }
	return 1;
}
CMD:aceitarconvite(playerid)
{
    if(Pp[playerid][Logado] == true)
    {
    	if(PedidoConvite[playerid] >= 1)
    	{
    		Pp[playerid][OrgMembro] = PedidoConvite[playerid];
    		ConviteOrgInfo(PlayerName(playerid), PedidoConvite[playerid], 1);
    		Pp[playerid][OrgCargo] = 1;

            //Carregamento
    		SetTimerEx("CarregandoObjetos", 5000, false, "d", playerid);
            for(new i = 1; i < 3; i++){PlayerTextDrawShow(playerid, TdCarregarINT[playerid][i]);}
    	    Controle(playerid, 0);

    		SCM(playerid, COR_AZUL, "{FFFFFF}[INFO] Pedido Aceito com Sucesso, Voce foi spawnado em sua HQ.");
    		SpawnPlayer(playerid);
    		return 1;
    	}
    	else
    	{
     		SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao recebeu nenhum convite.");
    	}
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    }
	return 1;
}

CMD:promover(playerid,params[])
{
    new id,cargo, String[220], orgid = GetPlayerOrg(playerid);
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	if(Pp[playerid][OrgCargo] < 4)return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao e lider ou sub para promover");
	if(sscanf(params,"ii",id,cargo))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /promover [IDF] [Cargo 1-4]");
	{
     	for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
			        if(id == Pp[playerid][IDF])
			    	{
			    	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Promover");
			    	}
			    	if(cargo < 5)
			    	{
						if(Pp[i][OrgMembro] != orgid)return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Esse player nao faz parte da sua org/corp");
						{
							Pp[i][OrgCargo] = cargo;
                            Pp[i][OrgSubLider] = 0;
							format(String,sizeof(String),"{FFFF00}[INFO] Voce promoveu o %s[%d] Para o Cargo de: (%s)",PlayerName(i), Pp[i][IDF], NomeCargo(i));
							SCM(playerid,-1,String);
							format(String,sizeof(String),"{FFFF00}[INFO] O %s[%d] esta lhe promovendo para o Cargo de: (%s)",PlayerName(playerid), Pp[playerid][IDF], NomeCargo(i));
							SendClientMessage(i,-1,String);
							return 1;
						}
					}
					if(cargo == 4)
					{
					    Pp[i][OrgSubLider] = orgid;
					    Pp[i][OrgCargo] = cargo;
                        format(OrgInfo[orgid][SubLider], 64, PlayerName(i));
						format(String,sizeof(String),"{FFFF00}[INFO] Voce promoveu o %s[%d] Para o Cargo de: (%s) Como Sub-Lider",PlayerName(i), Pp[i][IDF], NomeCargo(i));
						SCM(playerid,-1,String);
						format(String,sizeof(String),"{FFFF00}[INFO] O %s[%d] esta lhe promovendo para o Cargo de: (%s) Como Sub-Lider",PlayerName(playerid), Pp[playerid][IDF], NomeCargo(i));
						SendClientMessage(i,-1,String);
					}
					else
					{
					    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode setar Cargo maior que 4");
					}
				}
			}
		}
		return 1;
	}
}

CMD:demitir(playerid, params[])
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	if(Pp[playerid][OrgLider] != 0 || Pp[playerid][OrgSubLider] != 0 || Pp[playerid][OrgMembro] != 0)
	{
		new id, motivo[30 + 1];
		if(Pp[playerid][OrgCargo] < 4)return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao e lider ou sub para Demitir");
		if(sscanf(params, "ds[30]", id, motivo))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /demitir [IDF] [motivo]");
		}
 	 	for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
					new string[256];
					DemitirInfoOrg(PlayerName(i));
					format(string, sizeof(string), "{FFFFFF}[INFO] Voce foi demitido pelo Lider %s Motivo: %s.", PlayerName(playerid), motivo);
					SendClientMessage(i, COR_VERMELHO, string);

					Pp[i][OrgSubLider] = 0;
					Pp[i][OrgMembro] = 0;
					Pp[i][OrgCargo] = 0;
                    new rand666 = random(sizeof(SpawnDePlayers));//Spawn de Players Aleatorio
			        if(Pp[i][Regiao] == 0)
                    {
                        SetSpawnInfo(playerid, NO_TEAM, GetPlayerSkin(playerid), SpawnDePlayers[rand666][0], SpawnDePlayers[rand666][1], SpawnDePlayers[rand666][2], SpawnDePlayers[rand666][3], 0, 0, 0, 0, 0, 0), SetPlayerFacingAngle(playerid, SpawnDePlayers[rand666][3]);
                    }
                    else if(Pp[i][Regiao] == 1)
                    {
                        SetSpawnInfo(playerid, NO_TEAM, GetPlayerSkin(playerid), -29.6821,1011.1244,21.9481,0.1901, 0, 0, 0, 0, 0, 0);
                    }
					SpawnPlayer(i);

            		SetTimerEx("CarregandoObjetos", 5000, false, "i", i);
            		GameTextForPlayer(i, "Carregando", 5000, 1);
            	    Controle(i, 0);

					format(string, sizeof(string), "{FFFFFF}[INFO] Voce demitiu o membro ({FFFFFF}%s{FFFFFF}), Motivo: << {FFD700}%s {FFFFFF}>>.", PlayerName(i), motivo);
					SCM(playerid, COR_VERMELHO, string);
					return 1;
				}
			}
		}
		return 1;
	}
	return 1;
}
CMD:ang(playerid, params[])
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	if(IsBandido(playerid))
	{
		new msg[5000], string[1500], org = GetPlayerOrg(playerid);
		if(sscanf(params, "s[5000]", msg))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /ang [mensagem]");
		}
		else
		{
			format(string,sizeof(string),"%s ANUNCIA: (%s) Org: (%s)", PlayerName(playerid), msg, OrgInfo[org][OrgNome]);
			SendClientMessageToAll(COLOR_LIGHTRED,string);
		}
	}
	else SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	return 1;
}
CMD:ga(playerid,params[])
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	if(IsBandido(playerid))
	{
		new msg[5000];
		new org = GetPlayerOrg(playerid), string[450];
 		if(sscanf(params,"s[5000]",msg)) return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /ga [MENSAGEM] para falar com sua Org");
 		{
		 	for(new i; i < MAX_PLAYERS; i++)
			{
			    if(Pp[i][Logado] == true)
				{
	 		    	if(Pp[i][OrgLider] == org || Pp[i][OrgSubLider] == org || Pp[i][OrgMembro] == org)
					{
				 		format(string, sizeof(string), "> @[Radinho](%s)%s: %s", NomeCargo(playerid), PlayerName(playerid), msg);
				 		SendClientMessage(i, COLOR_LIGHTRED, string);
					}
				}
			}
			format(string, sizeof(string), "* O ID:[%d] falou alguma coisa no radio.", Pp[playerid][IDF]);
 			ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
	    	return 1;
	    }
  	}
  	else
  	{
   		SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e de Corp");
  	}
  	return 1;
}
CMD:d(playerid, params[])
{
