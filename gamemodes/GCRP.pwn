CMD:gbrinquedo(playerid)
{
    if(Pp[playerid][Vip] >= 3)
    {
        if(AcessouMenuCar[playerid] == 1)
		{
            new Float:XC, Float:YC, Float:ZC;
            GetVehiclePos(CarroEvento[playerid], XC, YC, ZC);

            SetPlayerPos(playerid, XC, YC, ZC+2);
            TogglePlayerSpectating(playerid, 0);
		    PlayerSpectatePlayer(playerid, playerid);

			AcessouMenuCar[playerid] = 0;

			SCM(playerid, -1, "{FFDC33}InfoVIP: {FFFFFF}Voce Guardou seu Brinquedo");
            GameTextForPlayer(playerid, "~w~Brinquedo ~r~Guardado", 1200, 3);
            DestroyVehicle(CarroEvento[playerid]);
		}
		else
		{
		    SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao spawnou nenhum Veiculo.");
		}
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Vip Platina +");
    }
    return 1;
}
CMD:brinquedos(playerid)
{
    if(Pp[playerid][Vip] >= 3)
    {
        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode criar um carro estando dentro de um.");
        {
            if(AcessouMenuCar[playerid] == 0)
            {
                if(GetPlayerInterior(playerid) == 0)
                {
                    new string[1000], mercada[100];
        			strcat(string, "Brinquedo\tHaridade\n");
        	  		format(mercada, sizeof(mercada), "{FFD700}1. {FFFFFF}Carrinho RC\t{00FF00}3+\n");
        			strcat(string, mercada);
        	  		format(mercada, sizeof(mercada), "{FFD700}2. {FFFFFF}Aviaozinho\t{00FF00}3+\n");
        			strcat(string, mercada);
                    format(mercada, sizeof(mercada), "{FFD700}3. {FFFFFF}Tanque\t{00FF00}4+\n");
        			strcat(string, mercada);
                    format(mercada, sizeof(mercada), "{FFD700}4. {FFFFFF}Kart\t{00FF00}+6\n");
        			strcat(string, mercada);
        	  		return ShowPlayerDialog(playerid, DIALOG_RCAR, DIALOG_STYLE_TABLIST_HEADERS, "Brinquedos {FFDC33}Vip", string, "Pegar", "Sair");
                }
                else
                {
                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode spawnar veiculos aqui!");
                }
            }
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja tem um Veiculo de INV-Vip Spawnado");
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Vip Platina +");
    }
    return 1;
}
