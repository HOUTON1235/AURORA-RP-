CMD:tadm(playerid)
{
	if(Pp[playerid][Admin] >= 1)
	{
		new string[256];
		if(Trabalhando[playerid] == true)
		{
			Trabalhando[playerid] = false;
			SetPlayerSkin(playerid, Pp[playerid][Skin]);
			SetPlayerHealth(playerid, 100);
            RemovePlayerAttachedObject(playerid, 9);

			if(Pp[playerid][Sexo] == 1)
			{
				format(string, sizeof(string), "{FFFF00}[ADMIN] O admin %s[%d] acaba de desativar o modo admin.", PlayerName(playerid), Pp[playerid][IDF]);
				SendClientMessageToAll(COLOR_LIGHTRED, string);
				SetPlayerColor(playerid, 0xFFFFFFFF);
                printf("LogGame: O Jogador: %s[%d] Saiu do Modo Admin", PlayerName(playerid), Pp[playerid][IDF]);
			}
			else if(Pp[playerid][Sexo] == 2)
			{
				format(string, sizeof(string), "{FFFF00}[ADMIN] A admin %s[%d] acaba de desativar o modo admin.", PlayerName(playerid), Pp[playerid][IDF]);
				SendClientMessageToAll(COLOR_LIGHTRED, string);
				SetPlayerColor(playerid, 0xFFFFFFFF);
                printf("LogGame: A Jogadora: %s[%d] Saiu do Modo Admin", PlayerName(playerid), Pp[playerid][IDF]);
			}
		}
		else if(Trabalhando[playerid] == false)
		{
			Trabalhando[playerid] = true;
			SetPlayerHealth(playerid, 999999);
            SetPlayerAttachedObject(playerid, 9, 18638, 2, 0.148999, 0.031000, 0.000000, 0.000000, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000);

			if(Pp[playerid][Sexo] == 1)
			{
				format(string, sizeof(string), "{FFFF00}[ADMIN] O admin %s[%d] acaba de ativar o modo trabalho.", PlayerName(playerid), Pp[playerid][IDF]);
				SendClientMessageToAll(COLOR_LIGHTRED, string);
				SetPlayerColor(playerid, 0xFFFFFFFF);
                SetPlayerSkin(playerid, 217);
                printf("LogGame: O Jogador: %s[%d] Entrou do Modo Admin", PlayerName(playerid), Pp[playerid][IDF]);
            }
			else if(Pp[playerid][Sexo] == 2)
			{
				format(string, sizeof(string), "{FFFF00}[ADMIN] A admin %s[%d] acaba de ativar o modo trabalho.", PlayerName(playerid), Pp[playerid][IDF]);
				SendClientMessageToAll(COLOR_LIGHTRED, string);
				SetPlayerColor(playerid, 0xFFFFFFFF);
                SetPlayerSkin(playerid, 211);
                printf("LogGame: A Jogadora: %s[%d] Entrou do Modo Admin", PlayerName(playerid), Pp[playerid][IDF]);
			}
		}
	}
	else SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	return 1;
}

CMD:tv(playerid, params[])
{
	if(Pp[playerid][Admin] >= 1)
	{
		new id, string[450];
		if(sscanf(params, "i", id))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /tv [IDF]");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
			        if(id == Pp[playerid][IDF])
			        {
               			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se dar Tv");
			        }
                    else
                    {
                        format(string, sizeof(string), "{FFFFFF}Voce esta observando o Jogador %s[%d]", PlayerName(i), Pp[i][IDF]);
    					SCM(playerid, COR_VERMELHO, string);

                        TogglePlayerSpectating(playerid, 1);
    					PlayerSpectatePlayer(playerid, i);
    					PlayerSpectateVehicle(playerid, GetPlayerVehicleID(i));
                    }
                }
			}
		}
	}
	else
    {
        SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
    }
    return 1;
}

