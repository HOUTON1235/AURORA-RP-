				{F7EC6F}Texto: %s\n\
				{F7EC6F}Fonte: %s\n\
				{F7EC6F}Tamanho: %d\n\
				{F7EC6F}Cor: %s\n\
				{F7EC6F}Negrito: %s\n\
				{1EAAD9}Editar Tag",
				GRAFITE_text[iPlayerID],
				GRAFITE_font[iPlayerID],
				GRAFITE_size[iPlayerID],
				szColor,
				szBold
			);
			ShowPlayerDialog(iPlayerID, GRAFITE_EDIT_LIST, DIALOG_STYLE_LIST, "{F7EC6F}Grafite Tag - {469BF0}Customizacao", szDialog, "Selecionar", "X");
		}
		case TYPE_LIST_TAGS:
		{
			new
				szName[MAX_PLAYER_NAME]
			;

			GetPlayerName(iPlayerID, szName, sizeof szName);
			for(new i; i < MAX_PLAYERS_TAGS; i++)
