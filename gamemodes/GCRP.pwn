forward moveportao(p);
public moveportao(p)
{
    MoveDynamicObject(InfoPortao[p][porT], InfoPortao[p][XP], InfoPortao[p][YP], InfoPortao[p][ZP], 5.0, InfoPortao[p][RXP],InfoPortao[p][RYP],InfoPortao[p][RZP]);
