			format(OrgInfo[orgid][Membro13], 30, DOF2_GetString(arquivo, "Membro13"));
			format(OrgInfo[orgid][Membro14], 30, DOF2_GetString(arquivo, "Membro14"));
			format(OrgInfo[orgid][Membro15], 30, DOF2_GetString(arquivo, "Membro15"));
            format(OrgInfo[orgid][Membro16], 30, DOF2_GetString(arquivo, "Membro16"));
            format(OrgInfo[orgid][Membro17], 30, DOF2_GetString(arquivo, "Membro17"));
            format(OrgInfo[orgid][Membro18], 30, DOF2_GetString(arquivo, "Membro18"));
            format(OrgInfo[orgid][Membro19], 30, DOF2_GetString(arquivo, "Membro19"));
            format(OrgInfo[orgid][Membro20], 30, DOF2_GetString(arquivo, "Membro20"));

			format(gstring, sizeof(gstring), "[INFO] O Staff %s limpou a vaga do lider do(a): (%s)", PlayerName(playerid), OrgInfo[orgid][OrgNome]);
	        SendClientMessageToAll(COLOR_LIGHTRED, gstring);

			format(string, sizeof(string), "\n{FFD700}Organizacao:{FFFFFF} %s\n\n{FFD700}Lider:{FFFFFF} %s\n{FFFFFF}Aperte {FFD700}Y{FFFFFF} Para Acessar!\n", OrgInfo[orgid][OrgNome], OrgInfo[orgid][Lider]);
			UpdateDynamic3DTextLabelText(PTextoORG[orgid], -1, string);
		}
	}
	return 1;
}

CMD:limparvaga(playerid, params[])
{
	if(Pp[playerid][OrgLider] >= 1 || Pp[playerid][OrgSubLider] >= 1)
	{
	    new nickle[30 + 1], string[450], orgid = GetPlayerOrg(playerid);
	    if(sscanf(params,"s[30]",nickle))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /limparvaga [Nome Do Jogador]");
		{
            new ss[90 + 1];
            format(ss, 90, nickle);
            if(OrgInfo[orgid][Lider] != ss[90])
            {
    		    format(string, sizeof(string), "[INFO] O Jogador %s[%d] limpou a vaga de: %s da org: %s", PlayerName(playerid), Pp[playerid][IDF], nickle, OrgInfo[orgid][OrgNome]);
    			SendClientMessageToAll(COLOR_LIGHTRED, string);
    			DemitirInfoOrg(nickle);
                new id = GetPlayerID(nickle);
    			if(IsPlayerOnline(nickle))
    			{
                    Pp[id][OrgMembro] = 0;
            		Pp[id][OrgSubLider] = 0;
            		Pp[id][OrgCargo] = 0;
            		Pp[id][OrgLider] = 0;
            		SpawnPlayer(id);
            		SalvarDados(id);
    			}
                format(arquivo, sizeof(arquivo), PASTA_CONTAS, nickle);
    	        if(DOF2_FileExists(arquivo))
    	        {
                    DOF2_SetInt(arquivo, "OrgMembro", 0);
                    DOF2_SetInt(arquivo, "OrgLider", 0);
                    DOF2_SetInt(arquivo, "OrgSubLider", 0);
                    DOF2_SetInt(arquivo, "OrgCargo", 0);
                    DOF2_SaveFile();
                }
            }
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode demitir o lider de sua org.");
            }
            return 1;
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Lider ou Sub lider");
	}
	return 1;
}

CMD:multar(playerid,params[])
{
	new id,valor, String[220], string[450];
	if(IsPolicial(playerid))
	{
		if(sscanf(params,"dd",id,valor))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /multar [IDF] [PRECO DA MULTA]");
		{
      		for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
                        if(id != Pp[playerid][IDF])
                        {
                            new Float:X, Float:Y, Float:Z;
                            GetPlayerPos(i, X, Y, Z);
        					if(ISP(playerid, 3.0, X, Y, Z))
        					{
        				        if(valor >= 1000 && valor < 10000)
        				        {
                                    if(GetPlayerCash(i) >= valor)
                                    {
            							GivePlayerCash(i, -valor);
            							Impostos[DinheiroDispGov] += valor;
            							Pp[i][Multas] += 1;
            							SendClientMessageEx(playerid, -1, "{FFDC33}[ GOVERNO ]: {FFFFFF}Voce Multou o Jogador: [%s] Por {00FF00}R$%d {FFFFFF}E Foi Creditado Nos Cofres do Governo!", PlayerName(i), valor);
            							format(String,sizeof(String),"* O ID:[%d] Aplicou Uma Multa no ID:[%d] De R$%d",Pp[playerid][IDF],Pp[i][IDF],valor);
            							ProxDetector(20.0, playerid, String, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
            							return 1;
                                    }
                                    else
                                    {
                                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Jogador nao tem essa quantia.");
                                    }
        						}
        						else
        						{
        						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}O Valor da Multa tem que ser maior que R$1000 e menor que R$10000");
        						}
                            }
                            else
                            {
                                SCM(playerid, -1, "{FFD700}[ERRO]: {FFFFFF}Voce nao esta proximo a este jogador.");
                            }
                        }
                        else
                        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se auto-multar"), printf("LogGame: O Jogador: %s[%d] tentou se auto-Multar", PlayerName(playerid), Pp[playerid][IDF]);
                        }
					}
				}
			}
			return 1;
		}
	}
	else
	{
	    SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce Nao faz parte de nenhuma corp");
	}
	return 1;
}

CMD:funcional(playerid,params[])
{
    if(IsPolicial(playerid))
	{
        new id, Float:x, Float:y, Float:z, String[220], orgid = GetPlayerOrg(playerid), stg[15000];
        if(sscanf(params,"i",id))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /funcional [IDF]");
        {
            for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
			            GetPlayerPos(i, x, y, z);
			            if(!ISP(playerid, 2.0, x, y, z)) return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao esta proximo deste jogador!");
			            {
			                MostrouF[i] = 1;
			                ShowTextDrawF(i);
			                SendClientMessage(i,-1,"{FFFFFF}Para Retirar o Dinstintivo de Sua Tela Use: {FFDC33}[ '/tf' ]");
			                format(String, sizeof(String), "* O ID:[%d] Mostrou o Documento Dinstintivo Para o ID:[%d]", Pp[playerid][IDF], Pp[i][IDF]);
			            	ProxDetector(30.0, playerid, String, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);

                            format(gstring, sizeof(gstring), "{FFDC33}Nome da Corp:{FFFFFF} %s\n",OrgInfo[orgid][OrgNome]);
                            strcat(stg, gstring);
                            format(gstring, sizeof(gstring), "{FFDC33}Nome:{FFFFFF} %s\n",PlayerName(playerid));
                            strcat(stg, gstring);
                            format(gstring, sizeof(gstring), "{FFDC33}Nome do Cargo:{FFFFFF} %s\n",NomeCargo(playerid));
                            strcat(stg, gstring);

                            ShowPlayerDialog(i, 5000, DIALOG_STYLE_LIST, "{FFFFFF}Funcional {FFDC33}Gold City", stg, "Ok", "");
			                return 1;
			            }
					}
				}
			}
			return 1;
        }
    }
    else
    {
        SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao de Corp");
    }
    return 1;
}

CMD:pedircontas(playerid, params[])
{
    new string[2000], orgid = GetPlayerOrg(playerid);
	if(Pp[playerid][OrgMembro] >= 1)
	{
		format(string, sizeof(string), "AVISO: O Player %s[%d] Se demitiu da Org %s ID Org: [%d]", PlayerName(playerid), playerid, OrgInfo[orgid][OrgNome], orgid);
		SendClientMessageToAll(COLOR_LIGHTRED, string);
		Pp[playerid][OrgMembro] = 0;
		Pp[playerid][OrgSubLider] = 0;
		Pp[playerid][OrgCargo] = 0;
		Pp[playerid][OrgLider] = 0;
		DemitirInfoOrg(PlayerName(playerid));
		SpawnPlayer(playerid);
		SalvarDados(playerid);
	}
	else if(Pp[playerid][OrgLider] >= 1)
	{
        SCM(playerid, -1, "{FFD700}Voce nao pode se demitir da org, chame um admin.");
	}
	else if(Pp[playerid][OrgSubLider] >= 1)
	{
		format(string, sizeof(string), "AVISO: O Player %s[%d] Se demitiu da Org %s ID Org: [%d]", PlayerName(playerid), playerid, OrgInfo[orgid][OrgNome], orgid);
		SendClientMessageToAll(COLOR_LIGHTRED, string);
		Pp[playerid][OrgMembro] = 0;
		Pp[playerid][OrgSubLider] = 0;
		Pp[playerid][OrgCargo] = 0;
		Pp[playerid][OrgLider] = 0;
		DemitirInfoOrg(PlayerName(playerid));
		SpawnPlayer(playerid);
		SalvarDados(playerid);
	}
	return 1;
}

CMD:irbase(playerid, params[])
{
    if(Pp[playerid][Admin] >= 1)
    {
    	new orgid;
    	if(sscanf(params, "i", orgid))
    	{
    		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /irbase [org-id]");
    	}
    	else if(orgid < 1 || orgid > 50)
    	{
    		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Organizacao Invalida.");
    	}
    	else
    	{
    	    //Carregamento
       		SetTimerEx("CarregandoObjetos", 5000, false, "d", playerid);
            for(new i = 1; i < 3; i++){PlayerTextDrawShow(playerid, TdCarregarINT[playerid][i]);}
       		Controle(playerid, 0);

            GameTextForPlayer(playerid, "~w~TP!", 1200, 6);

    		SetPlayerPos(playerid, OrgInfo[orgid][SpawnX], OrgInfo[orgid][SpawnY], OrgInfo[orgid][SpawnZ]);

    		new string[2000];
    		format(string, sizeof(string), "{FFFFFF}Voce foi levado a base do(a) %s.", OrgInfo[orgid][OrgNome]);
    		SCM(playerid, COR_VERMELHO, string);
    	}
    }
	return 1;
}

