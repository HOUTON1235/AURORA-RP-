CMD:cassino(playerid)
{
    for(new ii; ii < 4; ii++)
    {
        if(ISP(playerid, 2.0, LocaisApostas[ii][0], LocaisApostas[ii][1], LocaisApostas[ii][2]))
        {
            if(AcessoCassino[playerid] == 0)
            {
                for(new i; i < 34; i++)
                {
                    PlayerTextDrawSetString(playerid, TdCassino[playerid][6], "Valor Apostado: ~g~R$0000");
                    PlayerTextDrawShow(playerid, TdCassino[playerid][i]);
                }
                SelectTextDraw(playerid, 0xFFDC33FF);
                AcessoCassino[playerid] = 1;
            }
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce so pode usar esse comando se n tiver acessado o cassino.");
            }
        }
    }
    return 1;
}
CMD:entregarveiculos(playerid)
{
    if(VeiculoSpawnado[playerid] == 1)
