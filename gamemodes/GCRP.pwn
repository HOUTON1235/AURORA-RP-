  	}
  	return 1;
}
CMD:algemar(playerid, params[])
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	if(IsPolicial(playerid))
	{
		if(Uniforme[playerid] == true)
		{
			new id, Float:p1, Float:p2, Float:p3;
			if(sscanf(params, "i", id))
			{
				return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /algemar [IDF]");
			}
			if(IsPlayerInAnyVehicle(playerid))
			{
				return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pode algemar dentro de um veiculo.");
			}
   			for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
						if(IsPlayerInAnyVehicle(i))
						{
							return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pode algemar dentro de um veiculo.");
						}
				 	    GetPlayerPos(i, p1, p2, p3);
						if(!ISP(playerid, 15.0, p1, p2, p3))
						{
							return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce esta muito longe deste jogador.");
						}
						if(id == Pp[playerid][IDF])
						{
						    return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pode algemar a si mesmo.");
						}
						if(Pp[i][Admin] >= 1)
						{
							if(Trabalhando[i] == true)
						    {
						    	return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pode algemar um membro da admistracao em servico.");
						    }
						}
						if(GetPlayerState(i) == PLAYER_STATE_DRIVER)
						{
							return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pode algemar um(a) jogador(a) que esta dirigindo");
						}
						else
						{
       						new String[500];
							GameTextForPlayer(i, "~b~Algemado", 1500, 0);
							format(String, sizeof(String), "{FFD700}>> Algema: {FFFFFF}Voce algemou o(a) jogador(a) %d", Pp[i][IDF]);
							SCM(playerid, COR_AZUL, String);

							format(String, sizeof(String), "{FFD700}>> Algema: {FFFFFF}Voce foi algemado(a) pelo(a) policial %d", Pp[playerid][IDF]);
							SendClientMessage(i, COR_AZUL, String);

							format(String, sizeof(String), "* O ID:[%d] algemou O ID:[%d].", Pp[playerid][IDF], Pp[i][IDF]);
					    	ProxDetector(20.0, playerid, String, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);

							Pp[i][Algemado] = true;
						 	SetPlayerAttachedObject(i, 5, 19418, 6, -0.031999, 0.024000, -0.024000, -7.900000, -32.000011, -72.299987, 1.115998, 1.322000, 1.406000);
				    		SetPlayerSpecialAction(i, SPECIAL_ACTION_CUFFED);
							TogglePlayerControllable(i, 0);

							ProtecaoAlgemas[i] = SetTimerEx("k", 500, true, "d", i);
							return 1;
						}
					}
				}
			}
			return 1;
		}
		else
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta fardado.");
		}
	}
	else
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao e um policial.");
	}
}

CMD:desalgemar(playerid, params[])
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	if(IsPolicial(playerid))
	{
		if(Uniforme[playerid] == true)
		{
			new id, String[500], Float:p1, Float:p2, Float: p3;
			if(sscanf(params, "i", id))
			{
				return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /desalgemar [IDF]");
			}
			else if(IsPlayerInAnyVehicle(playerid))
			{
				return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pode desalgemar dentro de um veiculo.");
			}
   			for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
					 	if(IsPlayerInAnyVehicle(i))
						{
							return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pode desalgemar dentro de um veiculo.");
						}
						else if(id == Pp[playerid][IDF])
						{
						    return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pode desalgemar a si mesmo.");
						}
						else if(GetPlayerState(i) == PLAYER_STATE_DRIVER)
						{
							return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pode algemar um(a) jogador(a) que esta dirigindo");
						}
						else
						{
						    GetPlayerPos(i, p1, p2, p3);
			   				if(ISP(playerid, 15.0, p1, p2, p3))
			   				{
								if(Pp[i][Algemado] == true)
								{
									format(String, sizeof(String), "{FFD700}>> Algema: {FFFFFF}Voce retirou as algemas o(a) jogador(a) %d", Pp[i][IDF]);
									SCM(playerid, COR_AZUL, String);

									format(String, sizeof(String), "{FFD700}>> Algema: {FFFFFF}O(A) Policial %d te desalgemou", Pp[i][IDF]);
									SendClientMessage(i, COR_AZUL, String);

									format(String, sizeof(String), "* O ID:[%d] desalgemou O ID:[%d]", Pp[playerid][IDF], Pp[i][IDF]);
						    		ProxDetector(20.0, playerid, String, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);

									ClearAnimations(i);
									RemovePlayerAttachedObject(i,5);
									SetPlayerSpecialAction(i, SPECIAL_ACTION_NONE);
									Pp[i][Algemado] = false;
									KillTimer(ProtecaoAlgemas[i]);
									TogglePlayerControllable(i, 1);
									SetTimerEx("DCANIM", 500, false, "d", i);
									return 1;
								}
								else
								{
				    				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Esse jogador(a) ja esta desalgemado");
								}
							}
							else
							{
							    SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce esta muito longe deste jogador.");
							}
						}
					}
				}
			}
			return 1;
		}
		else
		{
			SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta fardado.");
		}
	}
	else
	{
		SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao e um policial.");
	}
	return 1;
}
CMD:barreira(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(IsPolicial(playerid) || Pp[playerid][Admin] > 0)
    {
        if(Uniforme[playerid] == false)
	   	{
	 		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta fardado(a)");
       	}
        if ( GetPlayerInterior ( playerid ) != 0 || ISP(playerid, 25.0, -1060.3335,713.5262,630.3128))
  		{
        	return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Nao e permitido usar esse comando em interiores");
        }
		if(IsPlayerInAnyVehicle(playerid))
		{
		    return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pode usar esse comando em um veiculo");
		}
        if(ColocouBarreira[playerid] == false)
        {
        	new String[220];
			GetPlayerPos(playerid, BX[playerid], BY[playerid], BZ[playerid]);
			GetPlayerFacingAngle(playerid, BR[playerid]);

            GameTextForPlayer(playerid, "~r~Barreira ~w~Criada", 1500, 3);
            ColocouBarreira[playerid] = true;
			ObjetoBarreira[playerid] = CreateDynamicObject(981, BX[playerid]-3, BY[playerid], BZ[playerid], 0.0, 0.0, BR[playerid]+180);
			format(String, sizeof(String), "{FFD700}(( Barreira ))\n{FFFFFF}Barreira de Bloqueio\nProibido Passar\nDono: %s", PlayerName(playerid));
   			TextoBarreira[playerid] = Create3DTextLabel(String, -1, BX[playerid], BY[playerid], BZ[playerid], 15, 0);

   			format(String, sizeof(String), "* O ID:[%d] instalou uma barreira em sua posicao.", Pp[playerid][IDF]);
		    ProxDetector(20.0, playerid, String, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
        }
        else
        {
            return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce ja colocou uma barreira");
        }
	}
	else
   	{
   	    return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao tem permissso");
   	}
   	return 1;
}

CMD:removerbarreira(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(IsPolicial(playerid) || Pp[playerid][Admin] > 1)
	{
        if(ColocouBarreira[playerid] == true)
        {
        	new string[100], Float:PX, Float:PY, Float:PZ;
        	GetPlayerPos(playerid, Float:PX, Float:PY, Float:PZ);

            if(ISP(playerid, 7.0, BX[playerid], BY[playerid], BZ[playerid]))
            {
	            ColocouBarreira[playerid] = false;
	            DestroyDynamicObject(ObjetoBarreira[playerid]);
	    		Delete3DTextLabel(TextoBarreira[playerid]);
	    		GameTextForPlayer(playerid, "~r~Barreira ~w~Removida", 1500, 3);

	    		format(string, sizeof(string), "* O ID:[%d] removeu uma barreira de sua posicao.", Pp[playerid][IDF]);
		    	ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
			}
			else
			{
			    return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a sua barreira");
			}
        }
        else
        {
            return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao colocou nenhuma barreira");
        }
	}
	else
   	{
   	    return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao tem permissao");
   	}
   	return 1;
}
