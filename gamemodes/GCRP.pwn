CMD:roubardinheiro(playerid)
{
    if(ISP(playerid, 3.0, 947.8974,-1506.0883,10.6979))
	{
	    if(AssantandoBanco[playerid] == 1)
	    {
	        if(BancoDisp == 1)
	        {
				if(BancoDinheiro >= 1000000)
				{
				    if(Pp[playerid][MochilaBA] == 1)
				    {
				        new string[450];
					    format(string, sizeof(string), "{FFD700}Info-Banco: {FFFFFF}Voce esta roubando cerca de {00FF00}R$%d {FFFFFF}Do Banco Central do {FFD700}Gold City Roleplay", BancoDinheiro);
						SCM(playerid, -1, string);
						format(string, sizeof(string), "{FFD700}Info-Banco: {FFFFFF}Voce Usou sua Mochila Para Pegar  Dinheiro do Cofre, Aguarde 3 Minutos...");
						SCM(playerid, -1, string);
						GameTextForPlayer(playerid, "~r~Aguarde ~n~ ~w~Voce esta roubando o Cofre", 180001, 3);
						TimerPegarGrana[playerid] = SetTimerEx("TempoPegarGrana", 180000, false, "i", playerid);
						Controle(playerid, 0);
						ProtecaoAlgemas[playerid] = SetTimerEx("k", 500, true, "d", playerid);
						Pp[playerid][MochilaBA] = 0;
						ApplyAnimation(playerid, "BAR", "BARSERVE_BOTTLE", 4.1, 1, 1, 1, 0, 0, 1);
                        return 1;
					}
					else
					{
					    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem uma Mochila de Assalto");
					}
				}
				else
				{
				    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}O Banco Esta Sem Dinheiro");
				}
			}
			else
			{
			    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}O Banco nao pode ser assaltado");
			}
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta assaltando o Banco");
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta no Cofre do Banco");
	}
	return 1;
}
CMD:arrastarp(playerid, params[])
{
	if(IsPolicial(playerid))
	{
	    new id, string[1200], Float:X123, Float:Y123, Float:Z123;
	    if(sscanf(params,"d",id))return SCM(playerid, -1,"{FFD700}INFO: {FFFFFF}Use: /arrastar [IDF].");
	    {
         	for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
				        if(id == Pp[playerid][IDF])
						{
					 		SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Arrastar!");
						 	return 1;
						}
				        if(ArrastadoID[playerid] == 0)
				        {
				            GetPlayerPos(i, X123, Y123, Z123);
							if(ISP(playerid, 10.0, X123, Y123, Z123))
							{
							    format(string, sizeof(string), "* O ID: [%d] Comecou a Arrastar o Jogador ID:[%d].", Pp[playerid][IDF], Pp[i][IDF]);
					    		ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
							    SCM(playerid, 0xFFFF00FF, "{FFFFFF}Voce esta Arrastando um Player");
				        		GameTextForPlayer(i, "~r~Arrastado!", 2000, 3);
				        		ApplyAnimation(i, "DEALER", "DEALER_IDLE", 4.0, 0, 1, 1, 1, -1);
				        		ApplyAnimation(i, "DEALER", "DEALER_IDLE", 4.0, 0, 1, 1, 1, -1);
				        		ArrastadoID[playerid] = Pp[i][IDF];
				        		ProtecaoAlgemas[i] = SetTimerEx("k", 500, true, "d", i);
				        		AttArrastar[playerid] = SetTimerEx("AttArrastar2", 100, true, "i", playerid);
				        		return 1;
							}
							else
							{
							    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a Este Player!");
							}
				        }
						else
						{
						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja esta arrastando Alguem, Use (/soltarp)!");
						}
					}
				}
			}
			return 1;
		}
    }
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Policial!");
	}
	return 1;
}
CMD:soltarp(playerid, params[])
{
	if(IsPolicial(playerid))
	{
	    for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == ArrastadoID[playerid])
			    {
			    	new Float:X123, Float:Y123, Float:Z123, string[450];
		 	    	GetPlayerPos(i, X123, Y123, Z123);
					if(ISP(playerid, 10.0, X123, Y123, Z123))
					{
		   				format(string, sizeof(string), "* O ID: [%d] Soltou o Jogador ID:[%d].", Pp[playerid][IDF], Pp[i][IDF]);
						ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
		    			SCM(playerid, 0xFFFF00FF, "{FFFFFF}Voce Soltou o Player!");
			       		GameTextForPlayer(i, "~w~Solto!", 2000, 0);
		    			KillTimer(ProtecaoAlgemas[i]);
		    			ClearAnimations(i);
						SetTimerEx("DCANIM", 200, false, "d", i);
					   	KillTimer(AttArrastar[playerid]);
					   	Arrastado[i] = 0;
					   	ArrastadoID[playerid] = 0;
		 			}
		 			else
		 			{
		    			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a Este Player!");
		 			}
		    	}
		    }
		}
		return 1;
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Policial");
	}
	return 1;
}
CMD:ativarvoip(playerid)
{
	if(VoipAtvDstv[playerid] == 1)
	{
        SCM(playerid, 0xFFFF00FF, "{FFFFFF}Voce Ativou seu {00FF00}SAMP-Voice");
        GameTextForPlayer(playerid, "~w~VOIP ~g~Ativado!", 2000, 3);
        VoipOn[playerid] = 1;
        VoipOff[playerid] = 0;
        VoipAtvDstv[playerid] = 0;
        SvAddKey(playerid, 0x42);
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Seu Voip ja Esta Ativo!");
	}
	return 1;
}

CMD:desativarvoip(playerid)
{
    if(VoipAtvDstv[playerid] == 0)
	{
        SCM(playerid, 0xFFFF00FF, "{FFFFFF}Voce Desativou seu {00FF00}SAMP-Voice");
        GameTextForPlayer(playerid, "~w~VOIP ~r~Desativado!", 2000, 3);
        VoipOn[playerid] = 0;
        VoipOff[playerid] = 1;
        VoipAtvDstv[playerid] = 1;
        SvRemoveAllKeys(playerid);
