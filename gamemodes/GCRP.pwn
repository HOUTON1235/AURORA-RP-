        {
        	new id, Float:p1, Float:p2, Float:p3;
 			if(sscanf(params, "i", id))
 			{
 				return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /arrastarplayer [IDF]");
 			}
    		for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
						GetPlayerPos(i, Float:p1, Float:p2, Float:p3);
						if(!ISP(playerid, 40.0, p1, p2, p3))
						{
							return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce esta muito longe deste jogador.");
						}
						if(id == Pp[playerid][IDF])
						{
						    return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pode colocar a si no Veiculo");
						}
						if(Pp[i][Algemado] == false)
						{
						    return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}O Jogador precisa estar algemado");
						}
						if(!IsPlayerInAnyVehicle(playerid))
						{
							return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta em um veiculo.");
						}
						if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
						{
							return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta dirigindo.");
						}
						else
						{
                            new carid = GetPlayerVehicleID(playerid);
						    if(Colocado[i] == false)
							{
                                Colocado[i] = true;

					       		new string[150];
					       		format(string,sizeof(string), "{FFFFFF}Voce colocou o jogador ID:[%d] No Porta Malas", Pp[i][IDF]);
								SCM(playerid, COR_AZUL, string);

                                new str[6000];
                                format(str,sizeof(str),"O ID:[%d] esta no Porta Malas", Pp[i][IDF]);
                                PlayerTextDrawSetString(playerid, TextDrawCNN[playerid][1], str);
                                PlayerTextDrawShow(playerid, TextDrawCNN[playerid][1]);

                                TogglePlayerSpectating(i, 1);
            					PlayerSpectatePlayer(i, playerid);
            					PlayerSpectateVehicle(i, carid);

                                GameTextForPlayer(i, "~w~Colocado No ~r~Porta Malas!", 3000, 3);

								format(string, sizeof(string), "* O ID:[%d] colocou o jogador ID:[%d] No Porta Malas.", Pp[playerid][IDF], Pp[i][IDF]);
					    		ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
					    		return 1;
							}
						}
					}
				}
			}
			return 1;
		}
	}
	else
	{
	    return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao tem permissao");
	}
	return 1;
}

CMD:prender(playerid, params[])
{
	new id, motivo[30 + 1], String[220], tempo;
    if(IsPolicial(playerid))
    {
        if(sscanf(params, "ds[30]", id, tempo, motivo)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /prender [IDF] [MOTIVO]");

        for(new i; i < MAX_PLAYERS; i++) {
    		if(Pp[i][Logado] == false) continue;
    		if(Pp[i][IDF] != id) continue;
    		if(id == Pp[playerid][IDF]) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Prender!");

            if(Pp[i][Algemado] == false)
    		{
    			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Esse jogador nao esta Algemado.");
    		}
    		if(ISP(playerid, 30.0, 1536.0768, -1673.0958, 13.3738))//DP LS
    		{
    			new Float:p1, Float:p2, Float: p3;
    			GetPlayerPos(playerid, p1, p2, p3);
    			if(!IsPlayerInRangeOfPoint(i, 10.0, p1, p2, p3))
    			{
    				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Esse jogador esta muito longe de voce.");
    				return 1;
    			}
    			if(VelocidadeDoVeiculo(GetPlayerVehicleID(playerid)) >= 5)
    			{
    				return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Pare a viatura para prender o procurado");
    			}
    			else
    		    {
    				if(GetPlayerWantedLevel(i) >= 1)
    				{
    					TogglePlayerControllable(i, 1);
    					ClearAnimations(i);
    					RemovePlayerAttachedObject(i,5);
    					SetPlayerSpecialAction(i, SPECIAL_ACTION_NONE);

    					Pp[i][Algemado] = false;

    					SetPlayerPos(i, 948.7023,2106.0054,1011.0234);
    					SetPlayerFacingAngle(i, 359.4802);
    					SetPlayerInterior(i, 1);
    					SetCameraBehindPlayer(i);
    					SetPlayerHealth(i, 1000000);
    					GameTextForPlayer(i, "~w~PRESO", 1500, 0);
    					ResetPlayerWeapons ( i ) ;
    					Pp[i][Preso] = true;

    					new wantedlevel = GetPlayerWantedLevel (i);
    					if(wantedlevel == 1)
    					{
    						Pp[i][PresoMinutos] = Pp[i][PresoMinutos] + 5;
    						SetPlayerWantedLevel(i, 0);
    						Pp[i][Mutado] = 1;
    						Pp[i][MinutosMutado] = 5 * 60;
    						SvMutePlayerEnable(i);
    					}
    				    else if(wantedlevel == 2)
    					{
    					    Pp[i][PresoMinutos] = Pp[i][PresoMinutos] + 10;
    						SetPlayerWantedLevel(i, 0);
    						Pp[i][Mutado] = 1;
    						Pp[i][MinutosMutado] = 10 * 60;
    						SvMutePlayerEnable(i);
    					}
    					else if(wantedlevel == 3)
    					{
    						Pp[i][PresoMinutos] = Pp[i][PresoMinutos] + 15;
    						SetPlayerWantedLevel(i, 0);
    						Pp[i][Mutado] = 1;
    						Pp[i][MinutosMutado] = 20 * 60;
    						SvMutePlayerEnable(i);
    					}
    					else if(wantedlevel == 4)
    					{
    						Pp[i][PresoMinutos] = Pp[i][PresoMinutos] + 20;
    						SetPlayerWantedLevel(i, 0);
    						Pp[i][Mutado] = 1;
    						Pp[i][MinutosMutado] = 25 * 60;
    						SvMutePlayerEnable(i);
    					}
    					else if(wantedlevel == 5)
    					{
    						Pp[i][PresoMinutos] = Pp[i][PresoMinutos] + 25;
    						SetPlayerWantedLevel(i, 0);
    						Pp[i][Mutado] = 1;
    						Pp[i][MinutosMutado] = 30 * 60;
    						SvMutePlayerEnable(i);
    					}
    					else if(wantedlevel >= 6)
    					{
    						Pp[i][PresoMinutos] = Pp[i][PresoMinutos] + 30;
    						SetPlayerWantedLevel(i, 0);
    					    Pp[i][Mutado] = 1;
    						Pp[i][MinutosMutado] = 40 * 60;
    						SvMutePlayerEnable(i);
    					}
    					SalvarDados(i);

    					format(String, sizeof(String), "{FFDC33}Prisao: {FFFFFF}Voce prendeu o jogador %s (Motivo: %s)", PlayerName(i), motivo);
    					SCM(playerid, COR_AZUL, String);
    					SCM(playerid, COR_AZUL, "{FFDC33}Prisao: {FFFFFF}Voce recebeu R$1000 por essa prisao");

    					format(String, sizeof(String), "O Policial %s prendeu Voce (Motivo: %s)", PlayerName(playerid), motivo);
    					SendClientMessage(i, COR_AZUL, String);

    					format(String,sizeof(String),"<< O Oficial ID:[%d] Efetuou a Prisao do Suspeito %s[%d] >>", Pp[playerid][IDF], PlayerName(i), Pp[i][IDF]);
    					SendClientMessageToAll(COLOR_LIGHTRED,String);

    					GameTextForPlayer(playerid, "~g~+R$[1000]", 3000, 1);

    					GivePlayerCash(playerid, 1000);
    					Impostos[DinheiroDispGov] += 1000;
    					return 1;
    				}
    				else
    				{
    					return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este Player Nao tem Crimes, Use: /su nele...");
    				}
                }
    		}
    		else
    		{
    			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce precisa estar em uma delegacia de policia.");
    		}
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um policial.");
    }
	return 1;
}

CMD:b(playerid, params[])
{
    if(Pp[playerid][Mutado] == 1)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce esta calado, e nao pode usar estecomando.");
    if(Pp[playerid][Logado] == true)
    {
        if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
        new text[5000], string[450];
        if(sscanf(params, "s[5000]", text))
        {
        	return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}/b [Chat-Baixinho].");
        }
        else
        {
        	format(string, sizeof(string), "(( ID:[%d]: %s ))", Pp[playerid][IDF], text);
        	ProxDetector(15.0, playerid, string, 0xB3B3B3FF, 0xB3B3B3FF, 0xB3B3B3FF,0xB3B3B3FF,0xB3B3B3FF);
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    }
    return 1;
}

CMD:oocl(playerid, params[])
{
    if(Pp[playerid][Preso] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(Pp[playerid][Mutado] == 1)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce esta calado, e nao pode usar estecomando.");
    new text[5000], string[450];
    if(sscanf(params, "s[5000]", text))
    {
    	return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}/oocl [Chat-OOC].");
    }
    else
    {
    	format(string, sizeof(string), "{C0C0C0}Baixinho(Local): (( O ID:[%d] diz: %s ))", Pp[playerid][IDF], text);
    	ProxDetector(20.0, playerid, string, 0xB3B3B3FF, 0xB3B3B3FF, 0xB3B3B3FF,0xB3B3B3FF,0xB3B3B3FF);
    }
    return 1;
}

CMD:dis(playerid, params[])
{
    if(Pp[playerid][Preso] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(Pp[playerid][Mutado] == 1)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce esta calado, e nao pode usar estecomando.");
    if(MandouMensagem[playerid] == 1)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode falar agora, aguarde 20 segundos.");
    if(Pp[playerid][Logado] == true)
    {
        if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
        new text[5000], string[450];
        if(sscanf(params, "s[5000]", text))
        {
        	return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}/dis [Chat discord].");
        }
        else
        {
            if(floodChat[playerid] > gettime())
            {
            	if(Pp[playerid][Admin] == 0)
            	{
            		SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}AntFlood: Pare de Floodar mensagems e proibido.");
            		return 0;
            	}
            }
            floodChat[playerid] = gettime() + 7;
            if(Pp[playerid][ConfigOOC] == 1)
    		{
          		for(new i; i < MAX_PLAYERS; i++)
    			{
    				if(IsPlayerConnected(i))
    				{
    				    if(Pp[i][ConfigOOC] == 1)
    					{
    				    	format(string, sizeof(string), "{FFD700}> {00BFFF}[DISCORD]{778899}%s[%d] diz: {F0F8FF}%s", PlayerName(playerid), Pp[playerid][IDF], text);
                            SendClientMessage(i, -1, string);
    				    }
    			    }
    		    }
                MandouMensagem[playerid] = 1;
                SetTimerEx("TempoSairDis", 20000, 0, "i", playerid);
    		}
    		else
    		{
    		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta com o Chat discord Ativado!");
    		}
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    }
    return 1;
}

CMD:eu(playerid, params[])
{
    if(Pp[playerid][Mutado] == 1)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce esta calado, e nao pode usar estecomando.");
    if(Pp[playerid][Logado] == true)
    {
        if(isnull(params))
        {
        	return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /eu [acao]");
        }
        else
        {
    	    new string[1200];
    	    format(string, sizeof(string), "* O ID:[%d]: %s", Pp[playerid][IDF], params);
            ProxDetector(20.0, playerid, string, COR_PURPLE, COR_PURPLE, COR_PURPLE,COR_PURPLE,COR_PURPLE);
    	}
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    }
    return 1;
}

CMD:n(playerid, params[])
{
    if(Pp[playerid][Preso] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(Pp[playerid][Mutado] == 1)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce esta calado, e nao pode usar estecomando.");
    if(Pp[playerid][Logado] == true)
    {
        if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    	new HoraRoYal, MinutoRoYal, SegundoRoYal;
    	gettime(HoraRoYal, MinutoRoYal, SegundoRoYal);
    	if(isnull(params))
        {
        	return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /n [duvida].");
        }
        if(Pp[playerid][Preso] == true)
        {
        	return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pode falar no chat duvidas preso.");
        }
        if(Pp[playerid][Ferido] == true)
        {
        	return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pode falar no chat duvidas ferido.");
        }
        else
        {
            if(floodChat[playerid] > gettime())
            {
            	if(Pp[playerid][Admin] == 0)
            	{
            		SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}AntFlood: Pare de Floodar mensagems e proibido.");
            		return 0;
            	}
            }
            floodChat[playerid] = gettime() + 3;
    		if(Pp[playerid][ConfigN] == 1)
    		{
          		for(new i; i < MAX_PLAYERS; i++)
    			{
    				if(IsPlayerConnected(i))
    				{
    				    if(Pp[i][ConfigN] == 1)
    					{
                            if(Pp[playerid][Admin] == 0)
                            {
                                new string[2000];
        						format(string, sizeof(string), "{20B2AA}@Canal Duvidas[/n][{FFD700}Player{20B2AA}]%s[%d] diz: %s", PlayerName(playerid), Pp[playerid][IDF], params);
        						SendClientMessage(i, -1, string);
                            }
                            else if(Pp[playerid][Admin] >= 1)
                            {
                                if(Trabalhando[i] == false)
        					    {
        						    new string[2000];
        						    format(string, sizeof(string), "{20B2AA}@Canal Duvidas[/n][{FFD700}Player{20B2AA}]%s[%d] diz: %s", PlayerName(playerid), Pp[playerid][IDF], params);
        						    SendClientMessage(i, -1, string);
        					    }
        					    else if(Trabalhando[i] == true)
        					    {
        					        new string[2000];
        					    	format(string, sizeof(string), "{20B2AA}@Canal Duvidas[/n][{FF1493}Admin{20B2AA}]%s[%d] diz: %s", PlayerName(playerid), Pp[playerid][IDF], params);
        					    	SendClientMessage(i, -1, string);
        					    }
                            }
    					}
    				}
    			}
    	    }
    	    else
    	    {
    	        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta com o Chat [/n] Ativado, Use: /configs");
    	    }
    	}
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    }
	return 1;
}

