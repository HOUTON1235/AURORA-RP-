CMD:entrarorg(playerid, params[])
{
    if(Pp[playerid][Admin] >= 1)
    {
        new idorg;
		if(sscanf(params, "i", idorg))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /entrarorg [Id da Org]");
		}
        format(gstring, sizeof(gstring), "OrgsGCRP: Voce entrou na organizacao: %s.", OrgInfo[idorg][OrgNome]);
		SCM(playerid, COLOR_LIGHTRED, gstring);
        Pp[playerid][OrgMembro] = idorg;
		Pp[playerid][OrgCargo] = 1;
		SpawnPlayer(playerid);
        //Carregamento
		SetTimerEx("CarregandoObjetos", 5000, false, "d", playerid);
        for(new i = 1; i < 3; i++){PlayerTextDrawShow(playerid, TdCarregarINT[playerid][i]);}
		Controle(playerid, 0);
        return 1;
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Admin");
    }
    return 1;
}
CMD:prefeitura(playerid)
{
    if(ISP(playerid, 2.0, -192.4820, 1338.4084, 1500.9823))
	{
        if(Pp[playerid][FezRg] == 1)
	    {
		    if(Pp[playerid][FezCarteira] == 1)
		    {
    			return ShowPlayerDialog(playerid, DIALOG_PREFEITURA, DIALOG_STYLE_LIST, "{FFFFFF}INFORMACAO", "{FFFFFF}Empregos\n{FFFFFF}Solicitar demissao\n{FFFFFF}Solicitar mudanca de Genero", "Selecionar", "X");
			}
			else
			{
			    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem Carteira de Trabalho no servidor, {FFFFFF}Faca sua Carteira no Cartorio!");
			}
		}
		else
		{
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem o seu Documento RG, Faca-o no Prefeitura. /gps - Locais Gerais - Prefeitura"), GameTextForPlayer(playerid, "~w~Voce nao tem ~r~RG", 3000, 1);
		}
    }
    else if(ISP(playerid, 2.0, -2033.2089, -117.3673, 1035.1667))
	{
        if(Pp[playerid][FezRg] == 1)
	    {
		    if(Pp[playerid][FezCarteira] == 1)
		    {
    			return ShowPlayerDialog(playerid, DIALOG_PREFEITURA2, DIALOG_STYLE_LIST, "{FFFFFF}INFORMACAO", "{FFFFFF}Empregos\n{FFFFFF}Solicitar demissao\n{FFFFFF}Solicitar mudanca de Genero", "Selecionar", "X");
			}
			else
			{
			    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem Carteira de Trabalho no servidor, {FFFFFF}Faca sua Carteira no Cartorio!");
			}
		}
		else
		{
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem o seu Documento RG, Faca-o no Prefeitura. /gps - Locais Gerais - Prefeitura"), GameTextForPlayer(playerid, "~w~Voce nao tem ~r~RG", 3000, 1);
		}
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta na Prefeitura");
    }
    return 1;
}
CMD:lanches(playerid)
{
    for(new i; i < 4; i++)
    {
        if(ISP(playerid, 5.0, MenuComida[i][0], MenuComida[i][1], MenuComida[i][2]))
    	{
            MostrarMenuComida(playerid);
    	}
    }
    return 1;
}
CMD:lockpick(playerid)
{
	if(IsPlayerInAnyVehicle(playerid)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar esse comando dentro de um Veiculo!");
    if(Pp[playerid][LockPK] < 1 ) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem uma Lockpick!");
	for(new s;s < MAX_VEHICLES;s++)
	{
        new Float:cx,Float:cy,Float:cz;
		GetVehiclePos(s,cx,cy,cz);
		if(IsPlayerInRangeOfPoint(playerid,3.0,cx,cy,cz))
		{
            if(CarroTrank[s] == 1)
      		{
                if(Pp[playerid][LockPK] > 0)
    		    {
                    Pp[playerid][LockPK] --;
                	SendClientMessage(playerid,-1,"{FFFFFF}LockPick: {FFFFFF}Voce esta usando uma Lockpick!");
                	ApplyAnimation(playerid, "INT_HOUSE", "WASH_UP", 4.1, 1, 0, 0, 0, 60000, 1);
                    SetPlayerAttachedObject(playerid, 9, 18634, 6, 0.0880, 0.0469, 0.0000, 99.1999, -92.5999, 0.0000, 1.0000, 0.6349, 0.7549); // LockPk na mao
                	GameTextForPlayer(playerid,"~w~Roubando ~r~Veiculo...", 10001, 6);
                	SetTimerEx("lockP", 10000, false, "i", playerid);
    		    }
            }
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}O Veiculo nao esta trancado");
            }
        }
	}
	return 1;
}
CMD:pegarentrega(playerid)
{
    if(Pp[playerid][Profissao] == PROF_UBERETS)
	{
        if(BcUberEts[playerid] == 1)
        {
    	    if(ISP(playerid, 15.0, 1841.1349,-1386.3767,13.5625))
            {
                new vehicleid = GetPlayerVehicleID(playerid);
				if(vehicleid == CarroEventoProfs[playerid])
				{
        			if(UberMarcado[playerid] == 0)
        			{
        				new indx2 = random(sizeof(EntregasUber));
            			SetPlayerCheckpoint(playerid, EntregasUber[indx2][0], EntregasUber[indx2][1], EntregasUber[indx2][2], 1.0);
            			SCM(playerid, -1, "{FFFFFF}[GCRP] Voce pegou um lanche, e seu Cliente foi Marcado no Mapa.");
            			GameTextForPlayer(playerid, "~w~Marcado!", 2000, 1);
        				UberMarcado[playerid] = 1;
        				return 1;
        			}
        			else
        			{
        		    	SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja esta com uma entrega");
        			}
        		}
        		else
        		{
        		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um Veiculo da Uber Eats");
        		}
            }
        }
	}
    return 1;
}

CMD:pegarcoleta(playerid,params[])
{
    if(Pp[playerid][Profissao] == PROF_LIXEIRO)
	{
        if(BcLixeiro[playerid] == 1)
        {
            if(ISP(playerid, 15.0, 2197.3044,-1977.4719,14.0898))
            {
                new vehicleid = GetPlayerVehicleID(playerid);
				if(vehicleid == CarroEventoProfs[playerid])
				{
            		if(LixoMarcado[playerid] == 0)
            		{
            			new indx2 = random(sizeof(ColetasLixo));
                		SetPlayerCheckpoint(playerid, ColetasLixo[indx2][0], ColetasLixo[indx2][1], ColetasLixo[indx2][2], 6.0);
                		SCM(playerid, -1, "{FFFFFF}[GCRP] Voce Localizou uma Coleta, Siga o Checkpoint para Pega-la.");
                		GameTextForPlayer(playerid, "~w~Coleta Marcada!", 2000, 1);
            			LixoMarcado[playerid] = 1;
            			return 1;
            		}
            		else
            		{
            	    	SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja esta em Servico");
            		}
            	}
            	else
            	{
            	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um Veiculo da Lixeira");
            	}
            }
            else
            {
                SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao esta no Local de Pegar Coletas");
            }
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao bateu Cartao");
        }
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Lixeiro!");
	}
    return 1;
}
CMD:procurarantena(playerid)
{
	if(Pp[playerid][Profissao] == PROF_ELETRICISTA)
	{
        if(IsPlayerInRangeOfPoint(playerid, 10.0, 1219.6281,-978.8286,43.1662))
		{
            new vehicleid = GetPlayerVehicleID(playerid);
			if(vehicleid == CarroEventoProfs[playerid])
			{
         		if(BcEletricista[playerid] == 0) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta com seu uniforme");
          		{
                    if(AntenaConserto[playerid] == 0)
                    {
           				new indx = random(sizeof(Antenas));
            			SetPlayerCheckpoint(playerid, Antenas[indx][0], Antenas[indx][1], Antenas[indx][2], 1.0);
            			SCM(playerid, -1, "{FFFFFF}[GCRP] A Casa de Um Cliente foi Marcada em Seu Mapa");
                        GameTextForPlayer(playerid, "~w~Antena ~g~Localizada!", 3000, 1);
        				AntenaConserto[playerid] = 1;
        				return 1;
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja pegou um Servico");
                    }
    			}
    		}
    		else
    		{
    	 		SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce Precisa esta no Veiculo da Empresa");
    			return 1;
    		}
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta no Seu HQ");
    		return 1;
        }
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Eletricista!");
	   	return 1;
	}
    return 1;
}
