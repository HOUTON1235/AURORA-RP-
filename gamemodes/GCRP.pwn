public OnPlayerPickUpPickup(playerid, pickupid)
{
    for(new i; i < MAX_CAIXAS; i++)
	{
	    if(!CaixaInfo[i][CaixaExplodido])continue;
        for(new p; p < MAX_PICKUPS_ROUBO; p++)
	    {
	       	if(pickupid == Pickups_Roubo[i][p])
			{
    			if(IsPolicial(playerid))
				{
					GameTextForPlayer(playerid, "~r~!! Conserto de Caixa !! ~n~ ~w~Utilize: /repararcaixa", 1000, 3);
					continue;
				}
                if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
                {
    				new keys, ud, lr;
    			    GetPlayerKeys(playerid, keys, ud, lr);
    			    if(keys & KEY_CTRL_BACK)
    			    {
    					GranaRoubo(playerid);
    					DestroyPickup(pickupid);
    					Pickups_Roubo[i][p] = -1;
    				}
    				else
    				{
    					GameTextForPlayer(playerid, "~r~Aperte | ~w~H ~r~| Para Roubar", 6000, 4);
    				}
                }
			}
		}
	}
	return 1;
}

