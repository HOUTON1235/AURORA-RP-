CMD:ir(playerid, params[])
{
	if(Pp[playerid][Admin] >= 1)
	{
		new Float:IX, Float:IY, Float:IZ, id, string[450];
		if(sscanf(params, "i", id))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /ir [IDF]");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
			        if(id == Pp[playerid][IDF])
			        {
						SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Dar TP");
			        }
				    SenhaAt[i] = 0;
				    Fila--;
					GetPlayerPos(i, Float:IX, Float:IY, Float:IZ);

					if (GetPlayerState(playerid) == 2)
     				{
         				new tmpcar = GetPlayerVehicleID(playerid);
             			SetVehiclePos(tmpcar, IX, IY+4, IZ);
				 		LinkVehicleToInterior(tmpcar, 0);
             			TelePos[playerid][0] = 0.0;
				 		TelePos[playerid][1] = 0.0;
             		}
             		else
             		{
             		    SetPlayerPos(playerid, IX, IY, IZ);
             		}

             		if(GetPlayerInterior(i) > 0)
               		{
                 		SetPlayerInterior(playerid, GetPlayerInterior(i));
                 		Pp[playerid][Interior] = GetPlayerInterior(i);
                        Pp[playerid][VirtualW] = GetPlayerVirtualWorld(i);
                   	}
                   	SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(i));

                    GameTextForPlayer(playerid, "~w~TP", 3000, 1);

                    GameTextForPlayer(i, "~w~TP", 3000, 1);

					format(string, sizeof(string), "{FFFFFF}O Staff %s teleportou ate sua posicao", PlayerName(playerid));
					SendClientMessage(i, COR_BLUE, string);

					format(string, sizeof(string), "{FFFFFF}Voce teleportou ate a posicao do jogador %s.", PlayerName(i));
					SCM(playerid, COR_BLUE, string);
					return 1;
				}
			}
		}
		return 1;
	}
	else
	{
		SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	}
	return 1;
}

CMD:trazer(playerid, params[])
{
	if(Pp[playerid][Admin] >= 1)
