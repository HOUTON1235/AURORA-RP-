CMD:granatodos(playerid, params[])
{
    if(Pp[playerid][Admin] >= 5)
    {
        new grana, string[450], String[220];
		if(sscanf(params, "i", grana))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /granatodos [Grana]");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
                format(String,sizeof(String),"~w~O Admin: ~p~%s ~w~Setou ~g~R$%d ~w~de dinheiro para todos os jogadores.", PlayerName(playerid), grana);
                PlayerTextDrawSetString(i, TextDrawAviso2[i][0], String);
                PlayerTextDrawShow(i, TextDrawAviso2[i][0]);
                SetTimerEx("TirarTD2", 5000, false, "i", i);
                GivePlayerCash(i, grana);
            }
        }
        format(string, sizeof(string), "{00FF00}Grana: O Admin: %s[%d] setou R$%d de dinheiro para todos os jogadores do servidor.", PlayerName(playerid), Pp[playerid][IDF], grana);
		SendClientMessageToAll(-1, string);
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem autorizacao para usar este comando.");
    }
    return 1;
}
CMD:dararma(playerid, params[])
{
    if(Pp[playerid][Admin] >= 5)
    {
        new id, gun, ammo, string[450];
		if(sscanf(params, "iii", id, gun, ammo))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /dararma [IDF] [id da arma] [municao]");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
			        if(id == Pp[playerid][IDF])
			        {
						SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se setar armas");
			        }
                    else
                    {
                        if(gun < 1 || gun > 46 || gun==38 || gun==35 || gun==37 || gun==44 || gun==45 || gun==9  || gun==26 || gun==27 || gun==28 || gun==32)
    			        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}O id da arma digitada esta proibido!");
                            return 1;
                        }
            			if(ammo < 1 || ammo > 999)
            			{
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}O minimo de municao e 1 e o maximo e 999!");
                            return 1;
                        }
        			    GivePlayerWeapon(i, gun, ammo);
                        SendClientMessageEx(playerid, -1, "{FFFFFF}Voce setou a arma id: %d com %d municoes para o jogador: %s[%d]", gun, ammo, PlayerName(i), Pp[i][IDF]);
                        SendClientMessageEx(playerid, -1, "{FFFFFF}Voce recebeu a arma id: %d com %d municoes do admin: %s[%d]", gun, ammo, PlayerName(playerid), Pp[playerid][IDF]);
                        GameTextForPlayer(i, "~w~Arma ~g~recebida", 1200, 1);
                        GameTextForPlayer(playerid, "~w~Arma ~r~setada", 1200, 1);
                    }
                }
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem autorizacao para usar este comando.");
    }
    return 1;
}
CMD:rank(playerid)
{
    new stg[5000];
    strcat(stg, "Nome\tNivel\tDinheiro\n");
    for(new i; i < MAX_PLAYERS; i++)
    {
        if(GetPlayerCash(i) >= 1)
        {
            new RankNome[5000];
            if(GetPlayerCash(i) >= 1)
            {
                RankNome = "{808080}Pobre";
            }
            if(GetPlayerCash(i) >= 1000000)
            {
              	RankNome = "{FFDC33}Milionario";
            }
            if(GetPlayerCash(i) >= 10000000)
            {
              	RankNome = "{FFD700}Super Milionario";
            }
            if(GetPlayerCash(i) >= 50000000)
            {
              	RankNome = "{00FF00}Hyper Milionario";
            }
            format(gstring, sizeof(gstring), "\n{FFFFFF}%s[%d]\t%s\t{00FF00}R$%d\n", PlayerName(i), Pp[i][IDF], RankNome, GetPlayerCash(i));
            strcat(stg, gstring);
            ShowPlayerDialog(playerid, 5000, DIALOG_STYLE_TABLIST_HEADERS, "Top 100 {00FF00}Ricos e Pobres", stg, "Ok", "");
        }
    }
    return 1;
}
CMD:pegarcc(playerid)
{
    if(Pp[playerid][Profissao] == PROF_DESCARREGADOR)
	{
        if(BcDescarregador[playerid] == 1)
        {
            for(new i; i < 4; i++)
            {
                if(ISP(playerid, 2.0, CarregarCaixas[i][0], CarregarCaixas[i][1], CarregarCaixas[i][2]))
        		{
                    if(PegouCaixaP[playerid] == 0)
                    {
                        new DesCA = random(sizeof(DescarregarCaixas));
                		SetPlayerCheckpoint(playerid, DescarregarCaixas[DesCA][0], DescarregarCaixas[DesCA][1], DescarregarCaixas[DesCA][2], 2.0);
            			CheckPointProfissao[playerid] = 1;
                        ApplyAnimation(playerid, "CARRY", "CRRY_PRTIAL", 4.1, 0, 0, 0, 1, 1, 1);
                        SetPlayerAttachedObject(playerid, 6, 1271, 1, 0.3689, 0.5740, 0.0000, 0.0000, 0.0000, 0.0000, 1.0000, 1.0000, 1.0000);//caixa - box
                    	GameTextForPlayer(playerid, "~w~Caixa ~g~Pega!", 1300, 1);
                        PegouCaixaP[playerid] = 1;
                        PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "~w~Voce pegou uma ~y~Caixa ~w~entregue-a no checkpoint usando: ~g~/descarregarcc");
                        PlayerTextDrawShow(playerid, TextDrawAviso3[playerid][0]);
                        SetTimerEx("TirarTD22", 3000, false, "i", playerid);
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja pegou uma caixa.");
                    }
                }
            }
        }
    }
    return 1;
}
CMD:descarregarcc(playerid)
{
    if(Pp[playerid][Profissao] == PROF_DESCARREGADOR)
	{
        if(BcDescarregador[playerid] == 1)
        {
            for(new i; i < 2; i++)
            {
                if(ISP(playerid, 2.0, DescarregarCaixas[i][0], DescarregarCaixas[i][1], DescarregarCaixas[i][2]))
        		{
                    if(PegouCaixaP[playerid] == 1)
                    {
                        new DinheiroGanho = 300 + random(200), string[450], DesCA = random(sizeof(CarregarCaixas));
                		SetPlayerCheckpoint(playerid, CarregarCaixas[DesCA][0], CarregarCaixas[DesCA][1], CarregarCaixas[DesCA][2], 2.0);
                        SendClientMessageEx(playerid, -1, "{98FB98}Info-Porto: {FFFFFF}Voce descarregou uma caixa do navio e voce ganhou: {00FF00}R$%d", DinheiroGanho);
                        RemovePlayerAttachedObject(playerid, 6);
                        GivePlayerCash(playerid, DinheiroGanho);
                        GameTextForPlayer(playerid, "~w~Caixa ~r~Entregue!", 1300, 1);
                        PegouCaixaP[playerid] = 0;
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pegou nenhuma caixa.");
                    }
                }
            }
        }
    }
    return 1;
}
CMD:cobraruber(playerid, params[])
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(Pp[playerid][EmpLider] == 1 || Pp[playerid][EmpMembro] == 1)
    {
        if(BcUberV[playerid] == 1)
	    {
            new id, valor, vehicleid = GetPlayerVehicleID(playerid), Float:X, Float:Y, Float:Z, string[450], zone[MAX_ZONE_NAME];
			GetPlayer2DZone(playerid, zone, MAX_ZONE_NAME);
            if(AcessouMenuCarUber[playerid] == 1)
            {
                if(vehicleid == CarroEventoUber[playerid])
                {
                    if(sscanf(params, "ii", id, valor))
            		{
            			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /cobraruber [IDF] [valor]");
            		}
                    for(new i; i < MAX_PLAYERS; i++)
            		{
            			if(Pp[i][Logado] == true)
            			{
            			    if(Pp[i][IDF] == id)
            			    {
            			        if(id == Pp[playerid][IDF])
            			        {
            						SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se cobrar Corridas");
            			        }
                                else
                                {
                                    if(valor <= 1500)
                                    {
                                        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
                                        {
                                            if(InCorridaUber[i] == Pp[playerid][IDF])
                                            {
                                                GetPlayerPos(i, X, Y, Z);
                                				if(ISP(playerid, 15.0, X, Y, Z))
                                				{
                                                    GivePlayerCash(playerid, valor);
                                                    GivePlayerCash(i, -valor);
                                                    GameTextForPlayer(playerid, "~w~Corrida ~g~Cobrada!", 3000, 1);
                                                    GameTextForPlayer(i, "~w~Corrida ~r~Paga!", 3000, 1);
                                                    InCorridaUber[i] = 0;
                                                    SendClientMessageEx(playerid, -1, "{FFDC33}Cobranca-Info: {FFFFFF}Voce cobrou do ID:{FFDC33}%d{FFFFFF} O Valor de {00FF00}R$%d {FFFFFF}Pela corrida ate {FFD700}%s", Pp[i][IDF], valor, zone);
                                                    SendClientMessageEx(i, -1, "{FFD700}Cobranca-Info: {FFFFFF}Foi cobrado de voce o Valor de {00FF00}R$%d{FFFFFF} Pela viagem ate {FFD700}%s", valor, zone);
                            	                    format(string, sizeof(string), "* O ID:[%d] Cobrou a corrida de R$%d ao Jogador ID:[%d]", Pp[playerid][IDF], valor, Pp[i][IDF]);
                                                    ProxDetector(20.0, playerid, string, COR_PURPLE, COR_PURPLE, COR_PURPLE,COR_PURPLE,COR_PURPLE);
                                                }
                                                else
                                                {
                                                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a este Jogador");
                                                }
                                            }
                                            else
                                            {
                                                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Passageiro nao iniciou nenhuma corrida com voce.");
                                            }
                                        }
                                        else
                                        {
                                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta no banco do motorista");
                                        }
                                    }
                                    else
                                    {
                                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode cobrar mais do que R$1500 do jogador.");
                                    }
                                }
                            }
                        }
                    }
                }
                else
                {
                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um veiculo Uber");
                }
            }
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao spawnou um veiculo Uber");
            }
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao bateu o cartao no Menu da Empresa");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Uber");
    }
    return 1;
}
CMD:atempresa(playerid)
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    new car[MAX_PLAYER_NAME];
    GetPlayerName(playerid, car, sizeof(car));
    if(!strcmp(car,"Apxgui_Staff", false))
    {
        new string[1000], mercada[100];
        strcat(string, "Nome\tFuncao\n");
        format(mercada, sizeof(mercada), "{FFFFFF}Uber\t{FFDC33}Transportadora de Passageiros\n");
        strcat(string, mercada);
        format(mercada, sizeof(mercada), "{FFFFFF}Petroleiro\t{FFDC33}Transportador de Combustivel\n");
        strcat(string, mercada);

        return ShowPlayerDialog(playerid, DIALOG_NIZAROEMP, DIALOG_STYLE_TABLIST_HEADERS, "Empresas {FFD700}Gold City", string, "Alternar", "X");
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e lider do Grupo Guerreiros RN");
    }
    return 1;
}
CMD:pontuarcnh(playerid, params[])
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
	if(IsPolicial(playerid))
	{
		new id, string[450], String[220];
		if(sscanf(params, "i", id))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /pontuarcnh [IDF]");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
			        if(id == Pp[playerid][IDF])
			        {
						SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se dar Pontos na Carteira");
			        }
                    else
                    {
                        if(Pp[i][HabilitacaoA] == 1 || Pp[i][HabilitacaoB] == 1 || Pp[i][HabilitacaoC] == 1 || Pp[i][HabilitacaoD] == 1)
                        {
                            if(Pp[i][PontosCNH] < 30)
                            {
                                Pp[i][PontosCNH] += 1;
                                SendClientMessageEx(playerid, -1, "{FFD700}Info-Pontos: Voce aplicou: %02d/30 pontos na carteira do jogador: %s[%d]", Pp[i][PontosCNH], PlayerName(i), Pp[i][IDF]);
                                SendClientMessageEx(i, -1, "{FFD700}Info-Pontos: O oficial: %s[%d] aplicou %02d/30 na sua Carteira, Cuidado!", PlayerName(playerid), Pp[playerid][IDF], Pp[i][PontosCNH]);
                                GameTextForPlayer(playerid, "~w~Ponto ~g~Aplicado.", 5000, 1);
                                GameTextForPlayer(i, "~w~Ponto na Carteira ~g~Aplicado.", 5000, 1);
                                format(String,sizeof(String),"* O ID:[%d] Aplicou uma Pontuacao na Carteira do Jogador ID:[%d]",Pp[playerid][IDF]);
                				ProxDetector(20.0, playerid, String, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                            }
                            else
                            {
                                SendClientMessageEx(playerid, -1, "{FFD700}Info-Pontos: Voce aplicou: %02d/30 pontos na carteira do jogador: %s[%d] {FFD700}e as Carteiras foram apreendidas", Pp[i][PontosCNH], PlayerName(i), Pp[i][IDF]);
                                SendClientMessageEx(i, -1, "{FFD700}Info-Pontos: O oficial: %s[%d] aplicou %02d/30 na sua Carteira, {FFD700}e foram apreendidas!", PlayerName(playerid), Pp[playerid][IDF], Pp[i][PontosCNH]);
                                GameTextForPlayer(playerid, "~w~Ponto ~g~Aplicado.", 5000, 1);
                                GameTextForPlayer(i, "~w~Suas Carteiras Foram ~r~Apreendidas.", 5000, 1);
                                format(String,sizeof(String),"* O ID:[%d] Aplicou uma Pontuacao na Carteira do Jogador ID:[%d]",Pp[playerid][IDF]);
                				ProxDetector(20.0, playerid, String, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                                Pp[i][PontosCNH] = 0;
                                Pp[i][HabilitacaoA] = 0;
                                Pp[i][HabilitacaoB] = 0;
                                Pp[i][HabilitacaoC] = 0;
                                Pp[i][HabilitacaoD] = 0;
                            }
                        }
                        else
                        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este jogador nao possui nenhum tipo de licenca");
                        }
                    }
                }
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Policial");
    }
    return 1;
}
CMD:svuber(playerid)
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    new string[450];
    for(new i; i < MAX_PLAYERS; i++)
	{
		if(Pp[i][Logado] == true)
		{
            if(Pp[i][EmpLider] == 1 || Pp[i][EmpMembro] == 1)
			{
                if(BcUberV[i] == 1)
                {
    			    ServicoUberV[playerid] = 1;
                    CheckPointProfissao[playerid] = 1;
    				format(string, sizeof(string), "{48D1CC}AvisoUber: O Jogador %s[%d] Esta Precisando de um Uber, Use: /aceitarcorrida %d.", PlayerName(playerid), Pp[playerid][IDF], Pp[playerid][IDF]);
    				SendClientMessage(i, -1, string);
                    GameTextForPlayer(i, "~w~Viagem ~p~Solicitada!", 2000, 1);
    				format(string, sizeof(string), "{48D1CC}AvisoUber: Voce chamou um Uber, Aguarde a Resposta....");
    				SCM(playerid, -1, string);
    			}
                else
                {
                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Nao ha Ubers Online!");
                }
            }
		}
	}
	return 1;
}
CMD:aceitarcorrida(playerid, params[])
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(Pp[playerid][EmpLider] == 1 || Pp[playerid][EmpMembro] == 1)
	{
	    if(BcUberV[playerid] == 1)
	    {
			new id, Float:p[3], String[220];
			if(sscanf(params, "i", id))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /aceitarcorrida [IDF]");
		    {
          		for(new i; i < MAX_PLAYERS; i++)
				{
					if(Pp[i][Logado] == true)
					{
					    if(Pp[i][IDF] == id)
					    {
				            if(ServicoUberV[i] != 1)return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Essa pessoa nao Solicitou servico de Taxi");
				            ServicoUberV[i] = 0;
				            GetPlayerPos(i,p[0],p[1],p[2]);
				            SetPlayerCheckpoint(playerid,p[0],p[1],p[2],5);
				            SCM(playerid,-1,"{FFD700}> {FFFFFF}Cliente marcado com sucesso, dirija-se a ele, [Ninguem espera demais.]");
				            format(String,sizeof(String),"{FFD700}> {FFFFFF}O [UBER]%s aceitou seu chamado e esta a caminho, aguarde no local.",PlayerName(playerid));
				            SendClientMessage(i, -1, String);
				            GameTextForPlayer(i, "~b~Uber Aceito ~n~ ~w~Aguarde no Local", 5000, 4);
				            GameTextForPlayer(playerid, "~b~Uber ~g~Aceito", 5000, 1);
				            return 1;
						}
					}
				}
				return 1;
	        }
        }
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao Bateu seu Cartao no Menu da Empresa");
		}
    }
    else
    {
    	SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao e um Uber");
    }
	return 1;
}
CMD:anuber(playerid, params[])
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(Pp[playerid][EmpLider] == 1 || Pp[playerid][EmpMembro] == 1)
	{
	    if(BcUberV[playerid] == 1)
	    {
            new vehicleid = GetPlayerVehicleID(playerid);
            if(AcessouMenuCarUber[playerid] == 1)
            {
                if(vehicleid == CarroEventoUber[playerid])
                {
        	        new preco, String[220];
        	        if(sscanf(params,"i",preco))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /anuber [PRECO]");
        	        format(String,sizeof(String),"{48D1CC}O [UBER]%s esta anunciando suas corridas no valor de: R$%d, chame-o usando: /svuber", PlayerName(playerid), preco);
        	        SendClientMessageToAll(-1,String);
                }
                else
                {
                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um veiculo Uber");
                }
            }
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao spawnou um Veiculo Uber");
            }
        }
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao Bateu seu Cartao no Menu da Empresa");
		}
    }
    else
    {
        SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao e um Uber");
    }
    return 1;
}
CMD:comprarpecas(playerid)
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    for(new i; i < 4; i++)
    {
        if(ISP(playerid, 2.0, LocaisPecas[i][0], LocaisPecas[i][1], LocaisPecas[i][2]))
    	{
            if(IsBandido(playerid))
	        {
	        	new stg[5000];
				strcat(stg,  "{FFD700}1. {FFFFFF}Pecas de AK-47\t{00FF00}R$2200[Cada Uma]\n");
				strcat(stg,  "{FFD700}2. {FFFFFF}Pecas de MP5\t{00FF00}R$1200[Cada Uma]\n");
				strcat(stg,  "{FFD700}3. {FFFFFF}Pecas de Desert Eagle\t{00FF00}R$1000[Cada Uma]\n");
				ShowPlayerDialog(playerid, DIALOG_COMPRAPECAS, DIALOG_STYLE_LIST, "Compra de {00FF00}Pecas", stg, "Comprar", "X");
			}
			else
			{
			    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Criminoso");
			}
        }
    }
    return 1;
}
CMD:iniciartrajeto(playerid)
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(Pp[playerid][Profissao] == PROF_MAQUINISTA)
    {
        new vehicleid = GetPlayerVehicleID(playerid);
    	if(VehProfMaq(vehicleid))
		{
	        if(ISP(playerid, 20.0, -160.9914,1281.5933,22.3388))
			{
			    if(PassageirosMaq[vehicleid] == 0)
			    {
                    if(BcMaquinista[playerid] == 1)
        			{
    					DisablePlayerRaceCheckpoint(playerid);
    				    DisablePlayerCheckpoint(playerid);
    					CheckpointMaquinista[playerid] = 1;
    					PassageirosMaq[vehicleid] = 1;

    					SCM(playerid, COR_VERDE, "{FFFFFF}Checkpoints iniciados, siga a rota para ganhar a recompensa");
                        SCM(playerid, COR_VERDE, "{FFFFFF}Nao ultrapasse o limite de: {FFFFFF}160KM/H{FF7F50} Pois pode aver um Descarrilamento");
    					GameTextForPlayer(playerid, "~w~Embarque Iniciado! ~n~ ~r~Siga os CheckPoints!", 20001, 3);

    					SetPlayerRaceCheckpoint(playerid, 6, MaqPosicao[0][0], MaqPosicao[0][1], MaqPosicao[0][2], MaqPosicao[1][0], MaqPosicao[1][1], MaqPosicao[1][2], 7);
    				    return 1;
    				}
    				else
    				{
    					SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao bateu seu Cartao!!");
    				}
				}
				else
				{
				    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este trem ja esta lotado de passageiros!");
				}
			}
			else
			{
			    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um Lugar de Embarque");
			}
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um trem");
		}
        return 1;
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um(a) Maquinista");
    }
	return 1;
}
CMD:descarregargasolina(playerid)
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    new vehicleid = GetPlayerVehicleID(playerid), zone[MAX_ZONE_NAME], DinheiroGanho = 1900 + random(200), string[450], trailer = GetVehicleTrailer(vehicleid);
    if(Pp[playerid][EmpMembro] == 2 || Pp[playerid][EmpLider] == 2)
	{
    	for(new i; i < MAX_POSTO; i++)
    	{
    		if(ISP(playerid, 5.0, PostoInfo[i][PostoPosX], PostoInfo[i][PostoPosY], PostoInfo[i][PostoPosZ]))
    		{
                if(PostoInfo[i][PostoGas] < 500)
                {
                    if(BcPetroleiro[playerid] == 1)
                    {
                        if(trailer >= 1)
                        {
                            if(CaminhaoGASA[trailer] >= 100)
                            {
                                DisablePlayerRaceCheckpoint(playerid);
                                GetPlayer2DZone(playerid, zone, MAX_ZONE_NAME);
                                PostoInfo[i][PostoGas] += 100;
                                format(arquivo, sizeof(arquivo), PASTA_POSTO, i);
                                if(DOF2_FileExists(arquivo))
                                {
                                    DOF2_SetInt(arquivo, "PostoGas", PostoInfo[i][PostoGas]);
                                }
                                format(string, sizeof(string), "{FFFFFF}Posto de Gasolina : %d\n\nUtilize: /abastecer\nPara Abastecer seu Veiculo!\nUse: /abastecergalao\nPara abastecer seu {FFD700}Galao de Gasolina\n{FFFFFF}Litros Disponiveis: {FFDC33}%dL\n{FFFFFF}Reabastecedores, Use: /descarregargasolina", PostoInfo[i][PostoID], PostoInfo[i][PostoGas]);
                                UpdateDynamic3DTextLabelText(TextoPosto[i], 0x1FF61F99, string);
                                format(gstring, sizeof(gstring), "Postos-GAS: O Petroleiro: %s[%d] reabasteceu um Posto da Petrobras nas proximidades de: (%s)", PlayerName(playerid), Pp[playerid][IDF], zone);
                        		SendClientMessageToAll(COLOR_LIGHTRED, gstring);
                                SendClientMessageEx(playerid, -1, "{FFDC33}Info-Posto: {FFFFFF}Voce abasteceu 100L em um Posto nas proximidades de: ({00FF00}%s{FFFFFF}), voce ganhou: {00FF00}R$%d", zone, DinheiroGanho);
                                GameTextForPlayer(playerid, "~w~Caminhao ~r~Descarregado!", 1200, 1);
                                GivePlayerCash(playerid, DinheiroGanho);
                                CaminhaoGASA[trailer] = 0;
                            }
                            else
                            {
                                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Esta Carga nao esta carregada.");
                            }
                        }
                        else
                        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Seu caminhao esta sem o reboque para Descarregar Gas");
                        }
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Uniformizado.");
                    }
                }
                else
                {
                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este posto ja esta cheio, procure outro para reabastece-lo.");
                }
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Petroleiro");
    }
    return 1;
}
CMD:carregargasolina(playerid)
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    new vehicleid = GetPlayerVehicleID(playerid), trailer = GetVehicleTrailer(vehicleid);
    if(Pp[playerid][EmpMembro] == 2 || Pp[playerid][EmpLider] == 2)
	{
        if(ISP(playerid, 5.0, 150.6626,1412.8817,11.2119) || ISP(playerid, 5.0, 151.2554,1378.3826,11.2100))
    	{
            if(BcPetroleiro[playerid] == 1)
            {
                if(trailer >= 1)
                {
                    if(CaminhaoGASA[trailer] == 0)
                    {
                        new indx = random(40);
                        format(arquivo, sizeof(arquivo), PASTA_POSTO, indx);
                    	if(DOF2_FileExists(arquivo))
                    	{
                            if(PostoInfo[indx][PostoGas] < 500)
                            {
                                SetPlayerRaceCheckpoint(playerid, 1, PostoInfo[indx][PostoPosX], PostoInfo[indx][PostoPosY], PostoInfo[indx][PostoPosZ], PostoInfo[indx][PostoPosX], PostoInfo[indx][PostoPosY], PostoInfo[indx][PostoPosZ], 5);
                            	SCM(playerid, -1, "{FFDC33}Info-Postos: {FFFFFF}Ouve a necessidade de reabastecimento no posto marcado no mapa.");
                                SCM(playerid, -1, "{FFDC33}Info-Postos: {FFFFFF}Este Posto Marcado esta necessitando de Abastecimento.");
                                SCM(playerid, -1, "{FFDC33}Info-Postos: {FFFFFF}Va ate la, e carregue-o novamente usando /descarregargasolina.");
                                GameTextForPlayer(playerid, "~w~Posto ~g~Localizado!", 3000, 1);
                        		CaminhaoGASA[trailer] = 100;
                                CheckPointProfissao[playerid] = 1;
                                return 1;
                            }
                            else
                            {
                                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}O posto Localizado ja esta cheio! - /carregargasolina");
                                GameTextForPlayer(playerid, "~w~Posto ~r~Cheio!", 1200, 1);
                            }
                        }
                        else
                        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este posto ainda nao e cadastrado na Petrobras, Use: /carregargasolina Novamente.");
                            GameTextForPlayer(playerid, "~w~Posto ~r~Invalido!", 1200, 1);
                        }
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este caminhao ja esta carregado.");
                    }
                }
                else
                {
                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Seu caminhao esta sem o reboque para abastecer Gas.");
                }
            }
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Uniformizado.");
            }
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em uma das areas de carregamento.");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Petroleiro");
    }
    return 1;
}
CMD:menuempresa(playerid)
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    new vehicleid = GetPlayerVehicleID(playerid);
	if(ISP(playerid, 5.0, 256.0765,1480.0436,11.2102))
	{
		if(Pp[playerid][EmpMembro] == 2 || Pp[playerid][EmpLider] == 2)
		{
            if(VehEmpPetro(vehicleid))
		    {
                new stg[5000];
            	strcat(stg, "Funcao\tFuncional\n");
            	format(gstring, 128, "{FF7F50}> {FFFFFF}Bater o Cartao na empresa\t{FFDC33}[Obrigatorio]\n");
            	strcat(stg, gstring);
                format(gstring, 128, "{FF7F50}> {FFFFFF}Retirar Cartao\t{00FF00}Opcional\n");
            	strcat(stg, gstring);

            	ShowPlayerDialog(playerid, DIALOG_EMPRESAS, DIALOG_STYLE_TABLIST_HEADERS, "Menu da {FF7F50}Empresa", stg, "Selecionar", "Fechar");
            }
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um veiculo da empresa.");
            }
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e desta empresa.");
        }
    }
    else if(ISP(playerid, 5.0, 1653.0973,-1655.1871,22.5156) || ISP(playerid, 5.0, 1395.6587,-1701.1471,13.5982))
	{
		if(Pp[playerid][EmpMembro] == 1 || Pp[playerid][EmpLider] == 1)
		{
            new stg[5000];
            strcat(stg, "Funcao\tFuncional\n");
            format(gstring, 128, "{FF7F50}> {FFFFFF}Bater o Cartao na empresa\t{FFDC33}[Obrigatorio]\n");
            strcat(stg, gstring);
            format(gstring, 128, "{FF7F50}> {FFFFFF}Retirar Cartao\t{00FF00}Opcional\n");
            strcat(stg, gstring);

            ShowPlayerDialog(playerid, DIALOG_EMPRESASUBER, DIALOG_STYLE_TABLIST_HEADERS, "Menu da {FF7F50}Empresa", stg, "Selecionar", "Fechar");
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e desta empresa.");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta no Hq da empresa.");
    }
    return 1;
}
CMD:cemp(playerid,params[])
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(Pp[playerid][EmpMembro] >= 1 || Pp[playerid][EmpLider] >= 1)
	{
		new msg[5000], string[450];
 		if(sscanf(params,"s[5000]",msg)) return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /cemp [MENSAGEM] para falar com sua empresa");
 		{
       		for(new i; i < MAX_PLAYERS; i++)
			{
			    if(Pp[i][Logado] == true)
				{
                    if(Pp[i][EmpMembro] == Pp[playerid][EmpMembro])
					{
				 		format(string, sizeof(string), "{7FFFD4}> @[Chat-Empresa]({FFFFFF}%s{7FFFD4})%s[%d]: %s", NomeCargoEmp(playerid), PlayerName(playerid), Pp[playerid][IDF], msg);
				 		SendClientMessage(i, COLOR_LIGHTRED, string);
					}
				}
			}
			format(string, sizeof(string), "* O ID:[%d] falou alguma coisa no radio da empresa.", Pp[playerid][IDF]);
 			ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
	    	return 1;
	    }
  	}
  	else
  	{
   		SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e de uma Empresa");
  	}
  	return 1;
}

CMD:promoveremp(playerid,params[])
{
    new id,cargo, String[220];
	if(Pp[playerid][EmpLider] >= 1 || Pp[playerid][EmpCargo] == 3)
    {
        if(sscanf(params,"ii",id,cargo))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /promoveremp [IDF] [Cargo: 1[Funcionario], 2[Gerente], 3[Sub-Lider]]");
    	{
         	for(new i; i < MAX_PLAYERS; i++)
    		{
    			if(Pp[i][Logado] == true)
    			{
    			    if(Pp[i][IDF] == id)
    			    {
    			        if(id == Pp[playerid][IDF])
    			    	{
    			    	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Promover");
    			    	}
    			    	else
                        {
                            if(cargo < 4)
        			    	{
        						Pp[i][EmpCargo] = cargo;
        						format(String,sizeof(String),"{FFFF00}[INFO] Voce promoveu o %s[%d] Para o Cargo de: (%s)",PlayerName(i), Pp[i][IDF], NomeCargoEmp(i));
        						SCM(playerid,-1,String);
        						format(String,sizeof(String),"{FFFF00}[INFO] O %s[%d] esta lhe promovendo para o Cargo de: (%s)",PlayerName(playerid), Pp[playerid][IDF], NomeCargoEmp(i));
        						SendClientMessage(i,-1,String);
        						return 1;
        					}
        					else
        					{
        					    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode setar Cargo maior que 3");
        					}
                        }
    				}
    			}
    		}
    	}
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e lider e nem sub desta empresa");
    }
    return 1;
}

CMD:demitiremp(playerid, params[])
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	if(Pp[playerid][EmpLider] >= 1 || Pp[playerid][EmpCargo] == 3)
	{
		new id, motivo[30 + 1];
		if(sscanf(params, "ds[30]", id, motivo))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /demitiremp [IDF] [motivo]");
		}
 	 	for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
					new string[256];
					DemitirInfoOrg(PlayerName(i));
					format(string, sizeof(string), "{FFFFFF}Info-Empresa: Voce foi demitido pelo Lider %s Motivo: %s.", PlayerName(playerid), motivo);
					SendClientMessage(i, COR_VERMELHO, string);
					Pp[i][EmpMembro] = 0;
					Pp[i][EmpLider] = 0;

					format(string, sizeof(string), "{FFFFFF}Info-Empresa: Voce demitiu o membro ({FFFFFF}%s{FFFFFF}), Motivo: << {FFD700}%s {FFFFFF}>>.", PlayerName(i), motivo);
					SCM(playerid, COR_VERMELHO, string);
					return 1;
				}
			}
		}
		return 1;
	}
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e lider de nenhuma empresa.");
    }
	return 1;
}
CMD:abastecerpostos(playerid)
{
    if(Pp[playerid][Admin] >= 4)
    {
        new string[450];
        for(new i; i < MAX_POSTO; i++)
        {
            PostoInfo[i][PostoGas] = 1000;
            format(arquivo, sizeof(arquivo), PASTA_POSTO, i);
            if(DOF2_FileExists(arquivo))
            {
                DOF2_SetInt(arquivo, "PostoGas", PostoInfo[i][PostoGas]);
            }
            format(string, sizeof(string), "{FFFFFF}Posto de Gasolina : %d\n\nUtilize: /abastecer\nPara Abastecer seu Veiculo!\nUse: /abastecergalao\nPara abastecer seu {FFD700}Galao de Gasolina\n{FFFFFF}Litros Disponiveis: {FFDC33}%dL\n{FFFFFF}Reabastecedores, Use: /descarregargasolina", PostoInfo[i][PostoID], PostoInfo[i][PostoGas]);
            UpdateDynamic3DTextLabelText(TextoPosto[i], 0x1FF61F99, string);
        }
        format(gstring, sizeof(gstring), "Postos-GAS: O Staff %s reabasteceu todos os Postos de Gasolina do Servidor", PlayerName(playerid));
		SendClientMessageToAll(COLOR_LIGHTRED, gstring);
        SCM(playerid, -1, "{FFDC33}Info-Postos: {FFFFFF}Todos os Postos foram reabasteceidos por voce");
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem autorizacao para usar este comando");
    }
    return 1;
}
CMD:empresas(playerid)
{
    if(Pp[playerid][Logado] == true)
	{
        new StrEmpresas[15000];
        strcat(StrEmpresas,  "{FFD700}1. {FFFFFF}Empresa: Uber\t\t{00FF00}(( Empresa a venda ))\n");
        strcat(StrEmpresas,  "{FFD700}2. {FFFFFF}Empresa: PetroBras\t\t{00FF00}(( Empresa a venda ))\n");
    	ShowPlayerDialog(playerid, 5000, DIALOG_STYLE_LIST, "{FFFFFF}Empresas", StrEmpresas, "Ok ","");
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    }
    return 1;
}
CMD:retiraremp(playerid, params[])
{
	if(Pp[playerid][Admin] >= 6)
	{
		new id;
		if(sscanf(params, "i", id))return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /retiraremp [IDF].");
		{
      		for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
					    format(gstring, sizeof(gstring), "EmpresasGCRP: O Staff %s retirou o jogador: %s[%d] da empresa: (%s)", PlayerName(playerid), PlayerName(i), Pp[i][IDF], NomeEmpresas(Pp[playerid][EmpMembro]));
				        SendClientMessageToAll(COLOR_LIGHTRED, gstring);
                        Pp[i][EmpLider] = 0;
					    Pp[i][EmpMembro] = 0;
                        SalvarDados(i);
				        return 1;
					}
				}
			}
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem permissao para usar este Comando");
	}
	return 1;
}
CMD:sairempresa(playerid, params[])
{
    new string[450];
    if(Pp[playerid][EmpLider] >= 1)
	{
		format(string, sizeof(string), "AVISO: O Player %s[%d] Se demitiu da Lideranca da Empresa %s", PlayerName(playerid), Pp[playerid][IDF], NomeEmpresas(Pp[playerid][EmpLider]));
		SendClientMessageToAll(COLOR_LIGHTRED, string);
		Pp[playerid][EmpLider] = 0;
		Pp[playerid][EmpMembro] = 0;
	}
    else if(Pp[playerid][EmpMembro] >= 1)
	{
		format(string, sizeof(string), "AVISO: O Player %s[%d] Se demitiu da Empresa %s", PlayerName(playerid), Pp[playerid][IDF], NomeEmpresas(Pp[playerid][EmpMembro]));
		SendClientMessageToAll(COLOR_LIGHTRED, string);
        Pp[playerid][EmpLider] = 0;
		Pp[playerid][EmpMembro] = 0;
	}
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e membro e nem lider de nenhuma empresa.");
    }
	return 1;
}

CMD:convidaremp(playerid, params[])
{
    if(Pp[playerid][Logado] == true)
    {
    	if(Pp[playerid][EmpLider] >= 1)
    	{
    		new id;
    		if(sscanf(params, "i", id))
    		{
    			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /convidaremp [IDF].");
    		}
    		if(Pp[playerid][FezRg] == 1)
        	{
    	   		for(new i; i < MAX_PLAYERS; i++)
    			{
    				if(Pp[i][Logado] == true)
    				{
    				    if(Pp[i][IDF] == id)
    				    {
                            if(Pp[i][FezRg] != 0)
    						{
                                if(GetPlayerScore(i) >= 0)
                                {
            					 	if(Pp[i][EmpLider] != 0)
            						{
            							return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este Jogador ja e lider de uma Empresa.");
            						}
            						else if(Pp[i][EmpMembro] != 0)
            						{
            							return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este Jogador ja e membro de uma Empresa.");
            						}
                                    format(gstring, sizeof(gstring), "{DAA520}Info-Empresa: {FFFFFF}Voce convidou o Jogador: (({DAA520}%s{FFFFFF})) para sua empresa.", PlayerName(i));
            					    SCM(playerid, COR_AZUL, gstring);

            						format(gstring, sizeof(gstring), "{DAA520}Info-Empresa: {FFFFFF}O Lider ((%s)) te convidou para uma empresa: {FFDC33}%s{FFFFFF}, Use /aceitarconviteemp.", PlayerName(playerid), NomeEmpresas(Pp[playerid][EmpMembro]));
            					    SendClientMessage(i, COR_AZUL, gstring);

                                    GameTextForPlayer(i, "~w~Voce Foi ~g~Convidado(a) ~n~ ~w~ Use: /aceitarconviteemp", 5000, 3);

            					    PedidoConviteEmp[i] = Pp[playerid][EmpLider];
                                }
                                else
                                {
                                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode convidar jogadores de nivel menor que 3");
                                }
                            }
                            else
                            {
                                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Jogador nao tem Documento RG Registrado");
                            }
    			        }
    				}
                }
    		}
    		else
    		{
    			SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao tem RG");
    		}
    	}
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao faz parte da lideranca de nenhuma empresa.");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    }
	return 1;
}
CMD:aceitarconviteemp(playerid)
{
    new string[450];
    if(Pp[playerid][Logado] == true)
    {
    	if(PedidoConviteEmp[playerid] >= 1)
    	{
    		Pp[playerid][EmpMembro] = PedidoConviteEmp[playerid];
            Pp[playerid][EmpCargo] = 1;
            for(new i; i < MAX_PLAYERS; i++)
            {
                if(Pp[i][EmpLider] == PedidoConviteEmp[playerid] || Pp[i][EmpMembro] == PedidoConviteEmp[playerid])
                {
                    SendClientMessageEx(i, -1, "{FFFFFF}Info-Empresa: O Jogador: {FFFFFF}%s[%d] {FFFFFF}e o novo Funcionario da Empresa! bem vindo! >> /cemp", PlayerName(playerid), Pp[playerid][IDF]);
                }
            }
            PedidoConviteEmp[playerid] = 0;

    		SCM(playerid, COR_AZUL, "{FFFFFF}Info-Empresa: Pedido para entrar na empresa foi aceito, use: /ajuda - ajuda empresarial");
            SCM(playerid, COR_AZUL, "{FFFFFF}Info-Empresa: Para descobrir de qual empresa voce e agora, use: /gps - Hqs de Empregos.");
    	}
    	else
    	{
     		SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao recebeu nenhum convite para empresas.");
    	}
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    }
	return 1;
}
CMD:setlideremp(playerid, params[])
{
	if(Pp[playerid][Admin] >= 6)
	{
		new id, empid;
		if(sscanf(params, "ii", id, empid))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /setlideremp [IDF] [0 Remove]."), SCM(playerid, COR_VERMELHO, "{FFD700}>> {FFFFFF}[Empresa 1[Uber] - 2[Petrobras] - 3[Mecanico-Ex]].");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
       				if(Pp[i][EmpLider] != 0)
					{
						return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este Jogador ja e lider de uma Empresa.");
					}
					else if(Pp[i][EmpMembro] != 0)
					{
						return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este Jogador ja e membro de uma Empresa.");
					}
					else
					{
                        if(empid == 0)
                        {
    						format(gstring, sizeof(gstring), "Empresas: O Staff %s retirou o jogador %s da lideranca de uma empresa.", PlayerName(playerid), PlayerName(i));
    				        SendClientMessageToAll(COLOR_LIGHTRED, gstring);

                            Pp[i][EmpLider] = 0;
    						Pp[i][EmpMembro] = 0;
                            Pp[i][EmpCargo] = 0;
    						return 1;
                        }
                        if(empid == 1)
                        {
    						format(gstring, sizeof(gstring), "Empresas: O Staff %s setou o jogador %s como lider da empresa: UBER.", PlayerName(playerid), PlayerName(i));
    				        SendClientMessageToAll(COLOR_LIGHTRED, gstring);

                            Pp[i][EmpLider] = 1;
    						Pp[i][EmpMembro] = 1;
                            Pp[i][EmpCargo] = 4;
    						return 1;
                        }
                        else if(empid == 2)
                        {
                            format(gstring, sizeof(gstring), "Empresas: O Staff %s setou o jogador %s como lider da empresa: Petrobras.", PlayerName(playerid), PlayerName(i));
    				        SendClientMessageToAll(COLOR_LIGHTRED, gstring);

                            Pp[i][EmpLider] = 2;
    						Pp[i][EmpMembro] = 2;
                            Pp[i][EmpCargo] = 4;
    						return 1;
                        }
                        else if(empid == 3)
                        {
                            format(gstring, sizeof(gstring), "Empresas: O Staff %s setou o jogador %s como lider da empresa: Mecanico-Ex.", PlayerName(playerid), PlayerName(i));
    				        SendClientMessageToAll(COLOR_LIGHTRED, gstring);

                            Pp[i][EmpLider] = 3;
    						Pp[i][EmpMembro] = 3;
                            Pp[i][EmpCargo] = 4;
    						return 1;
                        }
                        else
                        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Empresa Invalida! - 1[Uber - 2[Petrobras]");
                        }
					}
				}
			}
		}
		return 1;
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e autorizado a usar este Comando");
	}
	return 1;
}
CMD:pegaranuncio(playerid,params[])
{
    if(Pp[playerid][Profissao] == PROF_ANUNCIANTE)
	{
        if(BcAnunciante[playerid] == 1)
        {
    	    if(ISP(playerid, 15.0, 311.7900,1972.1318,18.1029))
            {
        	    new vehicleid = GetPlayerVehicleID(playerid);
        		if(VehProfAnunciante(vehicleid))
        		{
        			if(AnuncioMarcado[playerid] == 0)
        			{
        				new indx2 = random(sizeof(LocalAnuncios));
                        SetPlayerRaceCheckpoint(playerid, 3, LocalAnuncios[indx2][0], LocalAnuncios[indx2][1], LocalAnuncios[indx2][2], LocalAnuncios[indx2][0], LocalAnuncios[indx2][1], LocalAnuncios[indx2][2], 7);
            			SCM(playerid, -1, "{FFDC33}Anunciante: {FFFFFF}Voce acaba de receber um anuncio aero para fazer");
                        SCM(playerid, -1, "{FFDC33}Anunciante: {FFFFFF}Decole sua aeronave e va ate o checkpoint");
                        SCM(playerid, -1, "{FFDC33}Anunciante: {FFFFFF}Por favor, nao derrube-a, somos pobres :[");
            			GameTextForPlayer(playerid, "~w~Local de Anuncio ~g~Marcado!", 2000, 1);
        				AnuncioMarcado[playerid] = 1;
        				return 1;
        			}
        			else
        			{
        		    	SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja esta em Servico");
        			}
        		}
        		else
        		{
        		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em uma Aeronave dos Anunciantes");
        		}
            }
            else
            {
                SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao esta no Local de Pegar Anuncios");
            }
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao bateu Cartao");
        }
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um(a) Anunciante!");
	}
    return 1;
}
CMD:comer(playerid)
{
    if(ISP(playerid, 3.0, 1134.0685, -1759.7291, 13.6636))
    {
        if(GetPlayerCash(playerid) >= 120)
        {
            new Float:vida;
    	    GetPlayerHealth(playerid, Float:vida);
    		if(vida < 100)
    		{
    			new string[10000], Float:VidaP[MAX_PLAYERS];
    			VidaP[playerid] = vida;
    			VidaP[playerid] += 5;
                GivePlayerCash(playerid, -120);
                GameTextForPlayer(playerid, "~r~-R$120", 1200, 1);
                SCM(playerid, -1, "{FFA07A}Info-Bar: {FFFFFF}Voce comeu algo em nossa loja e teve {FFD700}+3 de Hp{FFFFFF} e pagou {00FF00}R$120");
    		    format(string, sizeof(string), "* O ID:[%d] Comeu 300g de alguma Comida", Pp[playerid][IDF]);
    			ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
    		    Pp[playerid][Fome] += 3;
    			SetPlayerHealth(playerid, VidaP[playerid]);
                ApplyAnimation(playerid,"VENDING","vend_eat1_P",4.1,0,1,1,1,1);
    		    SetTimerEx("DCANIM", 5000, false, "d", playerid);
    		}
    		else
    		{
    		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja esta muito Louco, e com isso nao pode comer ou beber mais...");
    		}
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem R$120 para comer ou beber aqui");
        }
    }
    else
    {
        new string[450];
        if(SegurandoMaoDireita[playerid] == 5)
        {
            SegurandoMaoDireita[playerid] = 0;
            SCM(playerid, -1, "{FFFFFF}Lanche: Voce comeu uma {FFDC33}Pizza{FFFFFF} de sua mao, e abaixou sua fome."), GameTextForPlayer(playerid, "~y~Comendo...", 1200, 1);
            format(string, sizeof(string), "* O ID:[%d] comeu algo..", Pp[playerid][IDF]);
    		ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
            Pp[playerid][Fome] += 10;
            RemovePlayerAttachedObject(playerid, 9);
            ApplyAnimation(playerid,"VENDING","vend_eat1_P",4.1,0,1,1,1,1);
            SetTimerEx("DCANIM", 5000, false, "d", playerid);
        }
        if(SegurandoMaoDireita[playerid] == 6)
        {
            SegurandoMaoDireita[playerid] = 0;
            SCM(playerid, -1, "{FFFFFF}Lanche: Voce comeu um {FFDC33}Hamburguer{FFFFFF} de sua mao, e abaixou sua fome."), GameTextForPlayer(playerid, "~y~Comendo...", 1200, 1);
            format(string, sizeof(string), "* O ID:[%d] comeu algo..", Pp[playerid][IDF]);
    		ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
            Pp[playerid][Fome] += 12;
            RemovePlayerAttachedObject(playerid, 9);
            ApplyAnimation(playerid,"VENDING","vend_eat1_P",4.1,0,1,1,1,1);
            SetTimerEx("DCANIM", 5000, false, "d", playerid);
        }
    }
    return 1;
}
CMD:beber(playerid)
{
    if(ISP(playerid, 3.0, 1139.2288, -1755.7461, 13.6636))
    {
        if(GetPlayerCash(playerid) >= 120)
        {
            new Float:vida;
    	    GetPlayerHealth(playerid, Float:vida);
    		if(vida < 100)
    		{
    			new string[10000], Float:VidaP[MAX_PLAYERS];
    			VidaP[playerid] = vida;
    			VidaP[playerid] += 5;
                GivePlayerCash(playerid, -120);
                GameTextForPlayer(playerid, "~r~-R$120", 1200, 1);
                SCM(playerid, -1, "{FFA07A}Info-Bar: {FFFFFF}Voce bebeu algo em nossa loja e teve {FFD700}+3 de Hp{FFFFFF} e pagou {00FF00}R$120");
    		    format(string, sizeof(string), "* O ID:[%d] Bebeu 300ml de alguma Comida", Pp[playerid][IDF]);
    			ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
    		    Pp[playerid][Sede] += 3;
                Pp[playerid][Bexiga] -= 3;
    			SetPlayerHealth(playerid, VidaP[playerid]);
                ApplyAnimation(playerid,"VENDING","VEND_Drink2_P",4.1,0,1,1,1,1);
    		    SetTimerEx("DCANIM", 5000, false, "d", playerid);
    		}
    		else
    		{
    		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja esta muito Louco, e com isso nao pode comer ou beber mais...");
    		}
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem R$120 para comer ou beber aqui");
        }
    }
    else
    {
        new string[450];
        if(SegurandoMaoDireita[playerid] == 7)
        {
            SegurandoMaoDireita[playerid] = 0;
            SCM(playerid, -1, "{FFFFFF}Lanche: Voce bebeu um {FFD700}Suco{FFFFFF} de sua mao, e abaixou sua sede."), GameTextForPlayer(playerid, "~b~Bebendo...", 1200, 1);
            format(string, sizeof(string), "* O ID:[%d] bebeu algo..", Pp[playerid][IDF]);
    		ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
            Pp[playerid][Sede] += 10;
            Pp[playerid][Bexiga] -= 5;
            RemovePlayerAttachedObject(playerid, 9);
            ApplyAnimation(playerid,"VENDING","VEND_Drink2_P",4.1,0,1,1,1,1);
    		SetTimerEx("DCANIM", 5000, false, "d", playerid);
        }
        if(SegurandoMaoDireita[playerid] == 8)
        {
            SegurandoMaoDireita[playerid] = 0;
            SCM(playerid, -1, "{FFFFFF}Lanche: Voce bebeu um {FFD700}Refrigerante{FFFFFF} de sua mao, e abaixou sua sede."), GameTextForPlayer(playerid, "~b~Bebendo...", 1200, 1);
            format(string, sizeof(string), "* O ID:[%d] bebeu algo..", Pp[playerid][IDF]);
    		ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
            Pp[playerid][Sede] += 12;
            Pp[playerid][Bexiga] -= 7;
            RemovePlayerAttachedObject(playerid, 9);
        }
    }
    return 1;
}

CMD:avisarp(playerid, params[])
{
	new id, r[30 + 1], String[220];
    if(Pp[playerid][Admin] < 2) return false;
    if(sscanf(params, "ds[30]", id, r)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /avisarp [IDF] [MOTIVO]");

    for(new i; i < MAX_PLAYERS; i++) {
		if(Pp[i][Logado] == false) continue;
		if(Pp[i][IDF] != id) continue;
		if(id == Pp[playerid][IDF]) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se avisar!");

        if(Pp[i][AvisosP] < 3)
        {
            Pp[i][AvisosP] += 1;
            format(String,sizeof(String),"{FFD700}Info-Staff: {FFFFFF}Voce levou um aviso do Admin: [%s] pelo motivo: (( %s )) e agora voce esta com (%02d/03)", PlayerName(playerid), r, Pp[i][AvisosP]);
            SendClientMessage(i,COLOR_LIGHTRED,String);

            format(String,sizeof(String),"[INFO] O Jogador: %s[%d] Levou um aviso pelo motivo: (%s) e agora esta com: (%02d/03)",PlayerName(i), Pp[i][IDF], r, Pp[i][AvisosP]);
            SendClientMessageToAll(COLOR_LIGHTRED,String);

            format(String,sizeof(String),"{00FF00}Info-Staff: {FFFFFF}Aviso setado com sucesso no Jogador: [%s] pelo motivo: (( %s )) e agora ele esta com (%02d/03)", PlayerName(i), r, Pp[i][AvisosP]);
            SendClientMessage(playerid, COLOR_LIGHTRED, String);
        }
        else if(Pp[i][AvisosP] >= 3)
        {
            format(String,sizeof(String),"Banidos/%s.ini",PlayerName(i));
        	DOF2_CreateFile(String);
        	DOF2_SetString(String,"Admin",PlayerName(playerid));
        	DOF2_SetString(String,"Motivo","Muitos Avisos");
        	DOF2_SaveFile();

        	format(String,sizeof(String),"[INFO] O Jogador: %s Foi Banido por muitos avisos: (( %02d/03 ))", PlayerName(i), Pp[i][AvisosP]);
        	SendClientMessageToAll(COLOR_LIGHTRED,String);

            new strmoch[5000];
        	format(strmoch, sizeof(strmoch),"{FFFFFF}Voce foi Banido Pelo Admin: {FFD700}%s\n{FFFFFF}Pelo Motivo: {FFD700}Muitos Avisos\n\n{FFFFFF}Tchau, e Parabens por Ter Sido Banido!!", PlayerName(playerid));
        	ShowPlayerDialog(i, 5000, DIALOG_STYLE_MSGBOX, "{FFFFFF}Status do {FFD700}Banimento", strmoch, "Ok", "");

            new ip[128];
        	GetPlayerIp(i,ip,128);
        	format(gstring, sizeof(gstring), "IP STAFF - O Ip Do Player Banido: %s e: %s", PlayerName(i),ip);
        	SCM(playerid, COLOR_LIGHTRED, gstring);
            Pp[i][AvisosP] = 0;
        	SetTimerEx("KickPlayer", 100, false, "i", i);
        }
    }
	return 1;
}

CMD:rtavisop(playerid, params[])
{
	new id, r[30 + 1], String[220];
    if(Pp[playerid][Admin] < 2) return false;
    if(sscanf(params, "ds[30]", id, r)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /rtavisop [IDF] [MOTIVO]");

    for(new i; i < MAX_PLAYERS; i++) {
		if(Pp[i][Logado] == false) continue;
		if(Pp[i][IDF] != id) continue;

        if(Pp[i][AvisosP] >= 1)
    	{
            Pp[i][AvisosP] = 0;
            format(String,sizeof(String),"{FFD700}Info-Staff: {FFFFFF}Voce teve seus avisos retirados pelo Admin: [%s] pelo motivo: (( %s ))", PlayerName(playerid), r);
            SendClientMessage(i,COLOR_LIGHTRED,String);

            format(String,sizeof(String),"[INFO] O Jogador: %s[%d] teve seus avisos retirados pelo motivo %s",PlayerName(i), Pp[i][IDF], r);
            SendClientMessageToAll(COLOR_LIGHTRED,String);

            format(String,sizeof(String),"{00FF00}Info-Staff: {FFFFFF}Aviso retirado com sucesso do Jogador: [%s] pelo motivo: (( %s ))", PlayerName(i), r);
            SendClientMessage(playerid, COLOR_LIGHTRED, String);
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este jogador nao tem avisos.");
        }
    }
    return 1;
}
CMD:central(playerid)
{
    if(Pp[playerid][FezRg] == 1)
    {
        if(ISP(playerid, 3.0, 338.6977, 163.3123, 1019.9976) || ISP(playerid, 3.0, 341.6977, 163.3123, 1019.9976))
        {
            new StrBancoC[15000];
            strcat(StrBancoC,  "{FFDC33}1. {FFFFFF}Abrir uma Conta no Banco\t\t{00FF00}Disponivel\n");
            ShowPlayerDialog(playerid, DIALOG_CENTRALB, DIALOG_STYLE_LIST, "{FFFFFF}Central {FFDC33}Banco do Brasil", StrBancoC, "Selecionar ","X");
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta no banco central");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao fez seu Documento RG");
    }
    return 1;
}
CMD:acessarbanco(playerid)
{
    if(Pp[playerid][FezRg] == 1)
    {
        if(Pp[playerid][FezBanco] == 1)
        {
        	if(ISP(playerid, 10.0, 1103.7688,1047.3889,-19.9389) || ISP(playerid, 10.0, 1103.7703,1049.2257,-19.9389) || ISP(playerid, 10.0, 1103.7699,1051.0447,-19.9389)
            || ISP(playerid, 10.0, 1103.7697,1052.9148,-19.9389) || ISP(playerid, 10.0, 1103.7710,1055.2539,-19.9389)  || ISP(playerid, 10.0, 217.7926, 185.8191, 1003.0259)
            || ISP(playerid, 10.0, 215.8953, 185.9318, 1003.0259) || ISP(playerid, 10.0, 832.7274,-1425.1676,13.6611))
        	{
        		if(BancoDinheiro >= 1000000)
           		{
                    new str[5000];
                    //Nome da Conta
                    format(str,sizeof(str),"Nome da Conta: %s", PlayerName(playerid));
                    PlayerTextDrawSetString(playerid, TextDrawCaixaL[playerid][6], str); //ok
                    //Saldo
                    format(str,sizeof(str),"Saldo: %d", Pp[playerid][SaldoBancario]);
                    PlayerTextDrawSetString(playerid, TextDrawCaixaL[playerid][7], str); //ok
                    for(new i2; i2 < 57; i2++)
            		{
            			PlayerTextDrawShow(playerid, TextDrawCaixaL[playerid][i2]);
            		}
                    SelectTextDraw(playerid, 0x8B008BFF);
        			return 1;
        		}
        		else
        		{
        			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Os Servicos do Caixa ou Banco Central Estao Indisponiveis");
        		}
        	}
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem uma conta no banco, va ao banco central");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao fez seu Documento RG");
    }
    return 1;
}
