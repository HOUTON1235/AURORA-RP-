CMD:dcasa(playerid, params[])
{
	if(Pp[playerid][Admin] >= 4)
	{
		new id, arquivoCA[5000], mensagem[128];
		if(sscanf(params, "i", id)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /dcasa [ID da casa].");
		{
		    if(ISP(playerid, 2.0, CasaInfo[id][CasaX], CasaInfo[id][CasaY], CasaInfo[id][CasaZ]))
			{
				format(arquivoCA, sizeof(arquivoCA), PASTA_CASAS, id);
				if(DOF2_FileExists(arquivoCA))
				{
				    DOF2_RemoveFile(arquivoCA);
					format(mensagem, sizeof(mensagem), "{BC8F8F}Info-Casa: {FFFFFF}Voce deletou a Casa id: %d.", id);
				    SCM(playerid, 0xFF0000FF, mensagem);
                    DestroyDynamicPickup(PickupCasa[id]);
        			DestroyDynamicMapIcon(MapIconCasa[id]);
                    UpdateDynamic3DTextLabelText(TextoCasa[id], 0x1FF61F99, " ");
        			DestroyDynamic3DTextLabel(TextoCasa[id]);
				    CasaInfo[id][CasaX] = 0;
					CasaInfo[id][CasaY] = 0;
					CasaInfo[id][CasaZ] = 0;
					CasaInfo[id][CasaInteriorX] = 0;
					CasaInfo[id][CasaInteriorY] = 0;
					CasaInfo[id][CasaInteriorZ] = 0;
					return 1;
				}
				else
				{
			        format(mensagem, sizeof(mensagem), "{FFD700}INFO: {FFFFFF}A Casa [%d] Nao Existe nso Arquivos do Servidor.", id);
					SCM(playerid, 0xFF0000FF, mensagem);
				}
			}
			else
			{
			    format(mensagem, sizeof(mensagem), "{FFD700}INFO: {FFFFFF}Voce nao esta Proximo da Casa Id: %d.", id);
				SCM(playerid, 0xFF0000FF, mensagem);
			}
		}
	}
	return 1;
}

// Comandos Organizacoes
CMD:setlider(playerid, params[])
{
	if(Pp[playerid][Admin] >= 4)
	{
		new id, orgid;
		if(sscanf(params, "ii", id, orgid))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /setlider [IDF] [organicao-ID].");
		}
		else if(strcmp(OrgInfo[orgid][Lider], "Nenhum", true))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Esta Organicao ja possui um lider use /limparlider.");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
       				if(Pp[i][OrgLider] != 0)
					{
						return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este Jogador ja e lider de uma organizacao.");
					}
					else if(Pp[i][OrgMembro] != 0)
					{
						return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este Jogador ja e membro de uma organizacao.");
					}
					else
					{
						format(arquivo, sizeof(arquivo), PASTA_ORGS, orgid);

						format(gstring, sizeof(gstring), "OrgsGCRP: O Staff %s setou o jogador %s como lider da organizacao %s.", PlayerName(playerid), PlayerName(i), OrgInfo[orgid][OrgNome]);
				        SendClientMessageToAll(COLOR_LIGHTRED, gstring);
				        SpawnPlayer(i);

						DOF2_SetString(arquivo, "Lider", PlayerName(i));
						DOF2_SaveFile();

						Pp[i][OrgLider] = orgid;
						Pp[i][OrgCargo] = 5;

						//Carregamento
				   		SetTimerEx("CarregandoObjetos", 5000, false, "i", i);
				   		GameTextForPlayer(i, "Carregando", 5000, 1);
				   		Controle(i, 0);

						format(OrgInfo[orgid][Lider], MAX_PLAYER_NAME, DOF2_GetString(arquivo, "Lider"));

						new string[2000];
						format(string, sizeof(string), "\n{FFD700}Organizacao:{FFFFFF} %s\n\n{FFD700}Lider:{FFFFFF} %s\n{FFFFFF}Aperte {FFD700}Y{FFFFFF} Para Acessar!\n", OrgInfo[orgid][OrgNome], OrgInfo[orgid][Lider]);
						UpdateDynamic3DTextLabelText(PTextoORG[orgid], -1, string);
						return 1;
					}
				}
			}
		}
		return 1;
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e autorizado a usar este Comando");
	}
	return 1;
}
CMD:rtlider(playerid, params[])
{
	if(Pp[playerid][Admin] >= 4)
	{
		new id;
		if(sscanf(params, "i", id))return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /rtlider [IDF].");
		{
      		for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
					    new orgid = GetPlayerOrg(i);
					    Pp[i][OrgLider] = 0;
					    Pp[i][OrgSubLider] = 0;
					    Pp[i][OrgCargo] = 0;
					    Pp[i][OrgMembro] = 0;
					    DemitirLider(i);
					    DemitirInfoOrg(PlayerName(i));
					    format(arquivo, sizeof(arquivo), PASTA_ORGS, orgid);
						DOF2_SetString(arquivo, "Lider", "Nenhum");
						DOF2_SaveFile();

					    format(gstring, sizeof(gstring), "OrgsGCRP: O Staff %s limpou a vaga do lider do(a): %s[%d] da: (%s)", PlayerName(playerid), PlayerName(i), Pp[i][IDF], OrgInfo[orgid][OrgNome]);
				        SendClientMessageToAll(COLOR_LIGHTRED, gstring);
				        return 1;
					}
				}
			}
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem permissao para usar este Comando");
	}
	return 1;
}

CMD:rtmembro(playerid, params[])
{
	if(Pp[playerid][Admin] >= 4)
	{
		new id;
		if(sscanf(params, "i", id))return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /rtmembro [IDF].");
		{
      		for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
					    new orgid = GetPlayerOrg(i);
					    Pp[i][OrgLider] = 0;
					    Pp[i][OrgSubLider] = 0;
					    Pp[i][OrgMembro] = 0;
					    Pp[i][OrgCargo] = 0;

                        DemitirInfoOrg(PlayerName(i));
						SpawnPlayer(i);

					    format(gstring, sizeof(gstring), "OrgsGCRP: O Staff %s limpou a vaga de Membro do: %s[%d] da: (%s)", PlayerName(playerid), PlayerName(i), Pp[i][IDF], OrgInfo[orgid][OrgNome]);
				        SendClientMessageToAll(COLOR_LIGHTRED, gstring);
				        return 1;
					}
				}
			}
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem permissao para usar este Comando");
	}
	return 1;
}
