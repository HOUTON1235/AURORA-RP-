CMD:sacargov(playerid, params[])
{
    if(Pp[playerid][OrgLider] == 1 || Pp[playerid][OrgSubLider] == 1 || Pp[playerid][OrgMembro] == 1)
	{
	    if(Pp[playerid][OrgCargo] >= 4)
	    {
		    new grana, string[450];
		    if(sscanf(params,"d",grana))return SCM(playerid, -1,"{FFD700}INFO: {FFFFFF}Use: /sacargov [IDF].");
		    {
				if(ISP(playerid, 5.0, 1490.0449, 1305.7039, 1093.2858))
				{
				    if(grana < 500000)
				    {
				        if(Impostos[DinheiroDispGov] >= grana)
				        {
				            SendClientMessageEx(playerid, -1, "{FFFFFF}[GCRP] Voce sacou dos Cofres Publicos: {00FF00}R$%d {FFFFFF}Cuidado com o que voce vai gastar!", grana);
				            format(gstring,sizeof(gstring),"{FFFFFF}[GCRP] O Governo Federal Acaba de Sacar o Valor de: {00FF00}R$%d {FF8C00}Dos Cofres Publicos!", grana);
							SendClientMessageToAll(COLOR_LIGHTRED,gstring);
				            Impostos[DinheiroDispGov] -= grana;
				            GivePlayerCash(playerid, grana);
				            return 1;
				        }
				        else
				        {
				            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}O Cofre Publico nao tem Tudo Isso que voce deseja Retirar!");
				        }
				    }
				    else
				    {
				        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode tirar mais de 500 mil dos Cofres Publicos");
				    }
				}
				else
				{
				    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Esta no Setup do Governo");
				}
			}
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e Lider ou Sub Lider do Governo");
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e do Governo");
	}
	return 1;
}
CMD:depositargov(playerid, params[])
{
    if(Pp[playerid][OrgLider] == 1 || Pp[playerid][OrgSubLider] == 1 || Pp[playerid][OrgMembro] == 1)
	{
	    new grana, string[450];
	    if(sscanf(params,"d",grana))return SCM(playerid, -1,"{FFD700}INFO: {FFFFFF}Use: /depositargov [IDF].");
	    {
			if(ISP(playerid, 5.0, 1490.0449, 1305.7039, 1093.2858))
			{
			    if(GetPlayerCash(playerid) >= grana)
			    {
			        SendClientMessageEx(playerid, -1, "{FFFFFF}[GCRP] Voce Depositou no Cofre Publico: {00FF00}R$%d {FFFFFF}Cuidado com o que voce vai gastar!", grana);
           			format(gstring,sizeof(gstring),"{FFFFFF}[GCRP] O Governo Federal Acaba de Depositar o Valor de: {00FF00}R$%d {FF8C00}Dos Cofres Publicos!", grana);
					SendClientMessageToAll(COLOR_LIGHTRED,gstring);
   					Impostos[DinheiroDispGov] += grana;
   					GivePlayerCash(playerid, -grana);
   					return 1;
			    }
			    else
			    {
			        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem Tudo Isso!");
			    }
			}
			else
			{
			    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Esta no Setup do Governo");
			}
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e do Governo");
	}
	return 1;
}
CMD:motor(playerid)
{
    if(!IsPlayerInAnyVehicle(playerid))
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta em um veiculo.");
	}
	else if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		new Float:Heath;
  		new carroa = GetPlayerVehicleID(playerid);
    	new
			lu,
			alar,
			por,
			cap,
			porma,
			ob
		;
		GetVehicleHealth(carroa, Float:Heath);
  		if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 509 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 481 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 510)
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este veiculo nao possui motor.");
		}
		else if(Heath <= 251)
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}O Veiculo esta quebrado.");
		}
		else if(Combustivel[carroa] == 0)
		{
		    return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}O Veiculo esta Sem Gasolina.");
		}
		else
		{
       		if(motor[carroa] == false)
       		{
       		    motor[carroa] = true;
                PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "Ligado.");
                PlayerTextDrawShow(playerid, TextDrawAviso3[playerid][0]);
                SetTimerEx("TirarTD22", 2000, false, "i", playerid);
				new string[1200];
				format(string, sizeof(string), "* O ID: [%d] Gira a chave e liga o motor de seu veiculo.", Pp[playerid][IDF]);
	    		ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
   				SetVehicleParamsEx( carroa, VEHICLE_PARAMS_ON, lu, alar, por, cap, porma, ob );
   				new engine, lights, alarm, doors, bonnet, boot, objective;
				GetVehicleParamsEx(carroa, engine, lights, alarm, doors, bonnet, boot, objective);
				if(luzes[carroa] == true)
				{
					SetVehicleParamsEx(carroa, engine, VEHICLE_PARAMS_OFF, alarm, doors, bonnet, boot, objective);
					luzes[carroa] = false;
				}
				else if(luzes[carroa] == false)
				{
					SetVehicleParamsEx(carroa, engine, VEHICLE_PARAMS_ON, alarm, doors, bonnet, boot, objective);
					luzes[carroa] = true;
				}
       		}
       		else
       		{
       		    motor[carroa] = false;
                PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "Desligado.");
                PlayerTextDrawShow(playerid, TextDrawAviso3[playerid][0]);
                SetTimerEx("TirarTD22", 2000, false, "i", playerid);
				new string[1200];
				format(string, sizeof(string), "* O ID: [%d] Girou a chave e desligou o motor de seu veiculo.", Pp[playerid][IDF]);
	    		ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
   				SetVehicleParamsEx(carroa, VEHICLE_PARAMS_OFF, lu, alar, por, cap, porma, ob);
       			new engine, lights, alarm, doors, bonnet, boot, objective;
				GetVehicleParamsEx(carroa, engine, lights, alarm, doors, bonnet, boot, objective);
				SetVehicleParamsEx(carroa, engine, VEHICLE_PARAMS_OFF, alarm, doors, bonnet, boot, objective);
				luzes[carroa] = false;
  			}
     	}
   	}
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e o motorista.");
    }
   	return 1;
}
CMD:pegarpa(playerid)
{
	if(Pp[playerid][Profissao] == PROF_MINERADOR)
	{
	    if(BcMinerador[playerid] == 1)
	    {
	        if(PegouPa[playerid] == 0)
	        {
	            if(IsPlayerInRangeOfPoint(playerid, 3.0, 589.7626,876.4470,-42.4973))
				{
				    if(GetPlayerCash(playerid) >= 25)
				    {
					    GameTextForPlayer(playerid, "~w~Voce Pegou a ~y~PA", 1200, 6);
					    SCM(playerid, -1, "{FFFFFF}[GCRP] Voce pegou uma Pa, Use: /cavar nas Areas de Mineracao");
					    GivePlayerWeapon(playerid, 6, 300);
					    PegouPa[playerid] = 1;
					    CavandoMinerador[playerid] = 0;
					    MinerioMao[playerid] = 0;
					    GivePlayerCash(playerid, -25);
					}
					else
					{
					    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem dinheiro para comprar uma Pa, R$(25)");
					}
				}
				else
				{
				    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta no local de pegar uma Pa");
				}
	        }
	        else
	        {
	            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja pegou sua PA");
	        }
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao bateu seu Cartao");
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Minerador");
	}
	return 1;
}
CMD:cavar(playerid)
{
    if(Pp[playerid][Profissao] == PROF_MINERADOR)
	{
	    if(BcMinerador[playerid] == 1)
	    {
		    if(MinerioMao[playerid] == 4) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja possui o maximo de Minerios!");
			{
			    if(CavandoMinerador[playerid] == 0)
			    {
			        if(PegouPa[playerid] == 1)
			        {
			            if(GetPlayerWeapon(playerid) == WEAPON_SHOVEL)
			            {
						    if(IsPlayerInRangeOfPoint(playerid, 3.0, 607.4472,871.9578,-41.9849))
							{
						        CavandoMinerador[playerid] = 1;
					            ApplyAnimation(playerid,"BASEBALL","BAT_4",4.1,1,1,1,1,0,1);
					            TimerMinerador[playerid] = SetTimerEx("TimerMineradorF", 1000, true, "i", playerid);
						    	TogglePlayerControllable(playerid, 0);
								ProtecaoAlgemas[playerid] = SetTimerEx("k", 500, true, "d", playerid);
						    }
						    if(IsPlayerInRangeOfPoint(playerid, 3.0, 636.7669,858.3895,-40.7802))
							{
						        CavandoMinerador[playerid] = 1;
					            ApplyAnimation(playerid,"BASEBALL","BAT_4",4.1,1,1,1,1,0,1);
					            TimerMinerador[playerid] = SetTimerEx("TimerMineradorF", 1000, true, "i", playerid);
						    	TogglePlayerControllable(playerid, 0);
								ProtecaoAlgemas[playerid] = SetTimerEx("k", 500, true, "d", playerid);
						    }
						    if(IsPlayerInRangeOfPoint(playerid, 3.0, 634.9982,824.8788,-41.0494))
							{
       							MinerioMao[playerid] += 1;
						        CavandoMinerador[playerid] = 1;
					            ApplyAnimation(playerid,"BASEBALL","BAT_4",4.1,1,1,1,1,0,1);
					            TimerMinerador[playerid] = SetTimerEx("TimerMineradorF", 1000, true, "i", playerid);
						    	TogglePlayerControllable(playerid, 0);
								ProtecaoAlgemas[playerid] = SetTimerEx("k", 500, true, "d", playerid);
						    }
						    if(IsPlayerInRangeOfPoint(playerid, 3.0, 600.6653,927.3137,-39.9690))
							{
						        CavandoMinerador[playerid] = 1;
		            			ApplyAnimation(playerid,"BASEBALL","BAT_4",4.1,1,1,1,1,0,1);
		            			TimerMinerador[playerid] = SetTimerEx("TimerMineradorF", 1000, true, "i", playerid);
		    					TogglePlayerControllable(playerid, 0);
								ProtecaoAlgemas[playerid] = SetTimerEx("k", 500, true, "d", playerid);
						    }
						}
						else
						{
						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce Nao Esta Com a Pa em Mao");
						}
	    			}
					else
					{
					    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce Nao pegou sua Pa");
					}
				}
				else
				{
				    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja esta Cavando");
				}
			}
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao bateu seu Cartao");
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Minerador");
	}
    return 1;
}
CMD:venderminerios(playerid)
{
    if(Pp[playerid][Profissao] == PROF_MINERADOR)
	{
		if(IsPlayerInRangeOfPoint(playerid, 3.0, 589.9833,887.6249,-44.1768))
		{
		    if(BcMinerador[playerid] == 1)
