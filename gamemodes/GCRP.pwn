// Guetto
CallBack:: CarregarGuetto()
{
	format(arquivo, sizeof(arquivo), PASTA_GUETTO);
	GuettoInfo[Dono] = DOF2_GetInt(arquivo,"Dono");
	DefinirCorGuetto();
	printf("=-=-=-=-= Dono do Guetto = ID: %d =-=-=-=-=", GuettoInfo[Dono]);
	return 1;
}
CallBack:: SalvarGuetto()
{
	format(arquivo, sizeof(arquivo), PASTA_GUETTO);
 	DOF2_SetInt(arquivo,"Dono",GuettoInfo[Dono]);
    DOF2_SaveFile();
	DefinirCorGuetto();
	printf("[Guetto]: Dono do Guetto = ID: %d", GuettoInfo[Dono]);
	return 1;
}
CallBack:: DefinirCorGuetto()
{
    if(GuettoInfo[Dono] == 0)
	{
		GuettoInfo[Cor] = 0xC0C0C0AA;
	}
    if(GuettoInfo[Dono] >= 1 && GuettoInfo[Dono] <= 10)
	{
		GuettoInfo[Cor] = COR_AZUL;
	}
    if(GuettoInfo[Dono] >= 11 && GuettoInfo[Dono] <= 45)
	{
		GuettoInfo[Cor] = COR_VERMELHO;
	}
}
CallBack:: GuettoP()
{
	new TRString[220];
	for(new i=0; i<MAX_PLAYERS; i++)
	{
		if(IsPlayerConnected(i))
		{
            if(IsPlayerInGangZone(i, GangZoneTRG[0]))
