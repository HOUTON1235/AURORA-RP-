CMD:acalmaratendente(playerid)
{
	if(IsPolicial(playerid))
	{
	    if(ISP(playerid, 2.0, 2142.9478,1605.9424,993.5684))
		{
		    if(BancoDisp == 1)
		    {
			    new Str[5000];
			    format(Str, sizeof(Str), "{FFD700}Seguranca Nascimento{FFFFFF}\nOla, Aqui e Local Restrito\n\nMire no personagem para Abrir a Porta do Setor N?1.");
				UpdateDynamic3DTextLabelText(TextBotAtendente, 0x1FF61F99, Str);
				format(Str, sizeof(Str), "{FFD700}Porta do Cofre{FFFFFF}\nSecurity Door\n\nPorta Setor N?1 {FFD700}Fechada!");
				UpdateDynamic3DTextLabelText(TextPortaCofre, 0x1FF61F99, Str);
