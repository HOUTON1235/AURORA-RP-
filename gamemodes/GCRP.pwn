	if(Pp[playerid][OrgMembro] > 0)
	{
		porg = Pp[playerid][OrgMembro];
	}
	if(Pp[playerid][OrgLider] > 0)
	{
		porg = Pp[playerid][OrgLider];
	}
    if(org == 13) { if(porg == org) { return 1; } }
    if(org == 32) { if(porg == org) { return 1; } }
    if(org == 41) { if(porg == org) { return 1; } }
    if(org == 23) { if(porg == org) { return 1; } }
    if(org == 39) { if(porg == org) { return 1; } }
    if(org == 10) { if(porg == org) { return 1; } }
    return 0;
}
