		    SCM(playerid, -1,"{48D1CC}[ RADIO ]: {FFFFFF}Voce Guardou seu Radio, Use: /pradio Para Pegar Novamente");
			for(new s = 0; s < sizeof(RadVoipInbf); s++) TextDrawHideForPlayer(playerid, RadVoipInbf[s]);
			FrequenciaConectada[playerid] = 0;
