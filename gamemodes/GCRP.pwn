public OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
    if(pickupid == PickDinheiroJO[0])
	{
    	if(!IsPolicial(playerid))
		{
            if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
            {
        		GranaRoubo3(playerid);
                DestroyDynamicPickup(PickDinheiroJO[0]);
                PickDinheiroJO[0] = CreateDynamicPickup(1550, 1, 1856.9838,-1595.7874,13.6703, 2);
                GameTextForPlayer(playerid, "~w~Pegando o Dinheiro!", 6000, 1);
            }
        }
        else
        {
            GameTextForPlayer(playerid, "~r~Voce nao pode pegar essa grana!", 1000, 3);
        }
        return 1;
	}
    if(pickupid == PickDinheiroJO[1])
	{
    	if(!IsPolicial(playerid))
		{
            if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
            {
        		GranaRoubo3(playerid);
                DestroyDynamicPickup(PickDinheiroJO[1]);
                PickDinheiroJO[1] = CreateDynamicPickup(1550, 1, 1856.9806,-1590.1964,13.6703, 2);
                GameTextForPlayer(playerid, "~w~Pegando o Dinheiro!", 6000, 1);
            }
        }
        else
        {
            GameTextForPlayer(playerid, "~r~Voce nao pode pegar essa grana!", 1000, 3);
        }
        return 1;
	}
    if(pickupid == PickDinheiroJO[2])
	{
    	if(!IsPolicial(playerid))
		{
            if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
            {
        		GranaRoubo3(playerid);
                DestroyDynamicPickup(PickDinheiroJO[2]);
                PickDinheiroJO[2] = CreateDynamicPickup(1550, 1, 1870.3042,-1590.4778,13.6703, 2);
