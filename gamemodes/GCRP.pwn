CMD:roubarammu(playerid)
{
    if(IsBandido(playerid))
    {
        if(ISP(playerid, 2.0, 1789.1332,-1921.5308,14.2875))
	    {
            new string[450], orgid = GetPlayerOrg(playerid);
	        if(RoubandoReg[playerid] == 0)
		    {
			    if(RoubouReg2[playerid] == 0)
			    {
			        if(RegLS6 == 0)
			    	{
			    	    format(string, sizeof(string), "Seguranca: O %s e os %s estao roubando o cofre da Ammunation LS", PlayerName(playerid), OrgInfo[orgid][OrgNome]);
						SendClientMessageToAll(COLOR_LIGHTRED, string);
						SCM(playerid, -1, "{FFDC33}Roubo: {FFFFFF}Voce esta roubando a Caixa Registradora, Aguarde...");
						ApplyAnimation(playerid, "BAR", "BARSERVE_BOTTLE", 4.1, 1, 1, 1, 0, 0, 1);
				 		Controle(playerid, 0);
				 		RoubandoReg[playerid] = 1;
				 		RoubouReg2[playerid] = 1;
				 		RegLS6 = 1;
						GameTextForPlayer(playerid, "~w~Procurando ~b~pecas", 10000, 1);
						SetTimerEx("TempoRouboReg2", 10000, 0, "i", playerid);
						SetTimerEx("TempoPlayerReg2", 300000, 0, "i", playerid);
						new MsgOc[5000];
						format(MsgOc, sizeof(MsgOc), "Todas as Unidades, O Suspeito: %s(%d) Esta Roubando a Ammunation de LS-", PlayerName(playerid), Pp[playerid][IDF]);
						MsgOcorrencia(MsgOc);
						roubando[playerid] += 3;
						SetPlayerWantedLevel(playerid, roubando[playerid]);
						roubando[playerid] = 0;
                        for(new ip; ip < MAX_PLAYERS; ip++)
        				{
        					if(IsPolicial(ip))
                            {
        						new Float:x,Float:y,Float:z;
        						GetPlayerPos(playerid, x,y,z);
        						SetPlayerCheckpoint(ip, x,y,z, 6);
        						GameTextForPlayer(ip, "~w~Ocorrencia ~r~Marcada!", 3000, 1);
                                CheckPointProfissao[ip] = 1;
        					}
						}
					}
			    	else
			    	{
			    	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Cofre da Ammunation Ja Foi Roubado");
			    	}
		    	}
		    	else
		    	{
		    	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja roubou esta Ammunation, Aguarde 5 Minutos Para Poder Roubar Novamente");
		    	}
		    }
		    else
		    {
		        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja esta Roubando..");
		    }
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta no cofre da ammunation");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um criminoso.");
    }
    return 1;
}
CMD:ammunation(playerid)
{
    if(ISP(playerid, 2.0, 1785.6082,-1916.0927,14.2875))
	{
        if(Pp[playerid][FezRg] == 1)
    	{
    	    if(Pp[playerid][FezPorte] == 1)
    	    {
    	    	ShowPlayerDialog(playerid, DIALOG_AMMUNATION, DIALOG_STYLE_LIST, "Ammunation", "{FFFFFF}Armas brancas", "Selecionar", "X");
    		}
    		else
    		{
    			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem Porte de Armas, Faca seu Porte na DP-LS!");
    		}
    	}
    	else
    	{
    		SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e Registrado Como Cidadao, Faca sua Rg no Cartorio!");
    	}
    }
    return 1;
}
CMD:entrarc(playerid)
{
    if(ISP(playerid, 20.0, 2476.4463,-1851.6560,2.9672))
	{
		if(!IsPlayerInAnyVehicle(playerid))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta em um veiculo.");
		}
		else
		{
			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
			{
                if(EntrouCorrida[playerid] == 0)
                {
                    if(PlayersCorrida[CtPlayers] <= 3)
                    {
                        new string[450];
                        PlayersCorrida[CtPlayers] += 1;
                        EntrouCorrida[playerid] = 1;
                        SendClientMessageEx(playerid, -1, "{FFDC33}Corrida: {FFFFFF}Voce entrou na corrida e agora ela tem {FFDC33}[%02d/04] {FFFFFF}participantes.", PlayersCorrida[CtPlayers]);
                        SCM(playerid, -1, "{FFDC33}Corrida: {FFFFFF}Aguarde a corrida se iniciar automaticamente.."), GameTextForPlayer(playerid, "~w~Entrou!", 2000, 1);
                        SCM(playerid, -1, "{FFDC33}Corrida: {FFFFFF}Para sair da corrida, use: {FFD700}/sairc");
                        return 1;
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode mais entrar nesta rodada.");
                    }
                }
                else
                {
                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja entrou na corrida.");
