CMD:rclocal(playerid, params[])
{
    new dist;
    if(Pp[playerid][Admin] >= 1)
    {
		if(sscanf(params, "i", dist))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /rclocal [Metros]");
		}
        for(new v; v < MAX_VEHICLES; v++)
        {
            new Float:X, Float:Y, Float:Z;
            GetVehiclePos(v, X, Y, Z);
            if(ISP(playerid, 3.0, X, Y, Z))
            {
                SetVehicleToRespawn(v);
			    GameTextForPlayer(playerid, "~w~Veiculos ~r~Respawnados..", 1200, 1);
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando.");
    }
    return 1;
}
CMD:abastecervip(playerid)
{
    if(Pp[playerid][Vip] >= 3 || Pp[playerid][Socio] >= 1 || Pp[playerid][Patrocinador] >= 1)
    {
        if(AbateceuVehVip[playerid] == 0)
        {
            new vehicleid = GetPlayerVehicleID(playerid);
            if(!IsPlayerInAnyVehicle(playerid))
        	{
        		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta em um veiculo.");
        	}
        	else
        	{
                TimerAbastecerVip[playerid] = SetTimerEx("TimerAbastecerVV", 600000, true, "i", playerid);
                AbateceuVehVip[playerid] = 1;
                Combustivel[vehicleid] = 60;
                SCM(playerid, -1, "{FFFF00}> {FFFFFF}Veiculo abastecido com sucesso.");
                GameTextForPlayer(playerid, "~w~Abastecido", 1200, 1);
            }
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode abastecer novamente, so depois de 10 minutos");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um VIP.");
    }
    return 1;
}
