		DOF2::SetFloat(arquivo, "SpawnX", OrgInfo[idorg][SpawnX]);
		DOF2::SetFloat(arquivo, "SpawnY", OrgInfo[idorg][SpawnY]);
		DOF2::SetFloat(arquivo, "SpawnZ", OrgInfo[idorg][SpawnZ]);
		DOF2::SetFloat(arquivo, "SpawnR", OrgInfo[idorg][SpawnR]);

		DOF2::SetFloat(arquivo, "PickupX", OrgInfo[idorg][PickupX]);
		DOF2::SetFloat(arquivo, "PickupY", OrgInfo[idorg][PickupY]);
		DOF2::SetFloat(arquivo, "PickupZ", OrgInfo[idorg][PickupZ]);
	}
    return 1;
}

