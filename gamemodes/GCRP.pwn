CallBack:: TempoPlayerReg2(playerid)
{
    if(RoubouReg2[playerid] == 1)
    {
	    new string[1200];
	    format(string, sizeof(string), "INFO: Voce ja Pode Roubar um Cofre de Ammunation Novamente!");
		SCM(playerid, COLOR_LIGHTRED, string);
	    RoubouReg2[playerid] = 0;
	}
	return 1;
}
CallBack:: TempoRouboReg2(playerid)
{
	new orgid = GetPlayerOrg(playerid);
	if(RoubandoReg[playerid] == 1)
	{
	    if(ISP(playerid, 2.0, 1789.1332,-1921.5308,14.2875))
		{
		    new string[450], MsgOc[5000];
			GameTextForPlayer(playerid, "~w~Pecas ~r~Roubadas", 2000, 1);
		    Controle(playerid, 1);
		    SetTimerEx("DCANIM", 500, false, "d", playerid);
		    format(string, sizeof(string), "O %s e os %s com sucesso o cofre da Ammunation LS", PlayerName(playerid), OrgInfo[orgid][OrgNome]);
			SendClientMessageToAll(COLOR_LIGHTRED, string);
            SCM(playerid, -1, "{FFDC33}Roubo: {FFFFFF}Voce robou: {FFDC33}10 pecas de AK-47");
            SCM(playerid, -1, "{FFDC33}Roubo: {FFFFFF}: {FFDC33}10 pecas de Desert Eagle");
            SCM(playerid, -1, "{FFDC33}Roubo: {FFFFFF}: {FFDC33}10 pecas de MP5");
            Pp[playerid][PecasAk47] += 10;
            Pp[playerid][PecasDesert] += 10;
            Pp[playerid][PecasMP5] += 10;
			format(MsgOc, sizeof(MsgOc), "Todas as Unidades, O Suspeito: %s(%d) robou com sucesso o cofre da Ammunation LS", PlayerName(playerid), Pp[playerid][IDF]);
			MsgOcorrencia(MsgOc);
		    RoubandoReg[playerid] = 0;
			ClearAnimations(playerid);
		}
    }
    return 1;
}
