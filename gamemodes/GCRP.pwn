                        Pp[i][VirtualW] = GetPlayerVirtualWorld(playerid);
                   	}
                   	SetPlayerVirtualWorld(i, GetPlayerVirtualWorld(playerid));

                    GameTextForPlayer(playerid, "~w~TP", 3000, 1);

                    GameTextForPlayer(i, "~w~TP", 3000, 1);

					format(string, sizeof(string), "{FFFFFF}O Staff %s trouxe voce ate a posicao dele.", PlayerName(playerid));
					SendClientMessage(i, COR_BLUE, string);

					format(string, sizeof(string), "{FFFFFF}Voce trouxe o jogador %s ate sua posicao", PlayerName(i));
					SCM(playerid, COR_BLUE, string);
					return 1;
				}
			}
		}
		return 1;
	}
	else SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	return 1;
}

