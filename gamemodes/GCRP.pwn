CMD:spvprof(playerid)
{
    for(new i; i < MAX_SPAWNS; i++)
    {
        if(ISP(playerid, 2.0, SpawnVEMPInfo[i][SpPosXX], SpawnVEMPInfo[i][SpPosYY], SpawnVEMPInfo[i][SpPosZZ]))
    	{
            if(Pp[playerid][Profissao] == SpawnVEMPInfo[i][SpProf])
            {
                if(AcessouMenuCarProfs[playerid] == 0)
                {
                    new string[1200];
                    CarroEventoProfs[playerid] = CreateVehicle(SpawnVEMPInfo[i][SpIDVEH], SpawnVEMPInfo[i][SpPosXX], SpawnVEMPInfo[i][SpPosYY], SpawnVEMPInfo[i][SpPosZZ], SpawnVEMPInfo[i][SpPosRR], 6, 1, false);
                    PutPlayerInVehicle(playerid, CarroEventoProfs[playerid], 0);

                    cmd_trancar(playerid);
                    AcessouMenuCarProfs[playerid] = 1;
                    GameTextForPlayer(playerid, "~w~Veiculo ~g~Spawnado!", 3000, 1);

                    SCM(playerid, -1, "{FFDC33}SpawnV: {FFFFFF}Voce spawnou um veiculo, para entregar, use: /entregarvsp");

                	format(string, sizeof(string), "* O ID:[%d]: Spawnou um Veiculo", Pp[playerid][IDF]);
                    ProxDetector(20.0, playerid, string, COR_PURPLE, COR_PURPLE, COR_PURPLE,COR_PURPLE,COR_PURPLE);
                }
            }
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e desta profissao.");
            }
        }
    }
    return 1;
}

