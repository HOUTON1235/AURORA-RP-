CMD:capuz(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	if(IsBandido(playerid))
	{
	    if(UsouMascara[playerid] == 0)
	    {
	        SetPlayerAttachedObject( playerid, 9, 18917, 2, 0.078534, 0.041857, -0.001727, 268.970458, 1.533374, 269.223754);
            UsouMascara[playerid] = 1;
		    SCM(playerid, -1, "{FFD700}Capuz: {FFFFFF}Voce colocou seu capuz");
		    GameTextForPlayer(playerid, "~r~!! Encapuzado !!", 1200, 1);
            ApplyAnimation(playerid, "GOGGLES", "GOGGLES_PUT_ON", 4.1, 0, 0, 0, 0, 0);
		    return 1;
	    }
	    else if(UsouMascara[playerid] == 1)
	    {
	        RemovePlayerAttachedObject(playerid, 9);
	        UsouMascara[playerid] = 0;
	        SCM(playerid, -1, "{FFD700}Capuz: {FFFFFF}Voce retirou seu capuz");
	        GameTextForPlayer(playerid, "~w~Capuz ~r~Retirado!", 1200, 1);
            ApplyAnimation(playerid, "GOGGLES", "GOGGLES_PUT_ON", 4.1, 0, 0, 0, 0, 0);
	        return 1;
	    }
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e de Org");
	    return 1;
	}
	return 1;
}
CMD:lmc(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	LimparChat(playerid, 30);
	GameTextForPlayer(playerid, "~w~Chat ~g~Limpo..", 1200, 3);
	return 1;
}
CMD:rtc(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	if(Pp[playerid][Admin] >= 1)
	{
		if(!IsPlayerInAnyVehicle(playerid)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um Veiculo");
		{
			SetVehicleToRespawn(GetPlayerVehicleID(playerid));
			SCM(playerid, -1, "{7CFC00}[INFO] Veiculo Respawnado...");
			GameTextForPlayer(playerid, "~w~Respawnado..", 1200, 3);
			return 1;
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem autorizacao para usar este comando");
	}
	return 1;
}
CMD:dtc(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	if(Pp[playerid][Admin] >= 1)
	{
		if(!IsPlayerInAnyVehicle(playerid)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um Veiculo");
		{
            CarroTrank[GetPlayerVehicleID(playerid)] = 0;
            CarroInfo[GetPlayerVehicleID(playerid)][ChaveCarro] = 0;
            PassageirosMt[GetPlayerVehicleID(playerid)] = 0;
            PassageirosMaq[GetPlayerVehicleID(playerid)] = 0;
            ProdutosCA[GetPlayerVehicleID(playerid)] = 0;
            CorpoMV[GetPlayerVehicleID(playerid)] = 0;
            DestroyObject(ObjGiroF[GetPlayerVehicleID(playerid)]);
            GiroFV[GetPlayerVehicleID(playerid)] = 0;
            ProdutosVeh[GetPlayerVehicleID(playerid)] = 0;
            DrugsVeh[GetPlayerVehicleID(playerid)] = 0;
            MalotesCr[GetPlayerVehicleID(playerid)] = 0;
            CaminhaoGASA[GetPlayerVehicleID(playerid)] = 0;
			DestroyVehicle(GetPlayerVehicleID(playerid));
			SCM(playerid, -1, "{7CFC00}[INFO] Veiculo Deletado...");
			GameTextForPlayer(playerid, "~w~Deletado..", 1200, 3);
			return 1;
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem autorizacao para usar este comando");
	}
	return 1;
}
CMD:limparficha(playerid, params[])
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	if(IsPolicial(playerid))
	{
	    new id, Float:X, Float:Y, Float:Z;
	    if(sscanf(params,"i",id))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /limparficha [IDF]");
		{
      		for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
					    if(id == Pp[playerid][IDF])
						{
							SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Limpar Ficha!");
					 		return 1;
						}
						if(GetPlayerWantedLevel(i) >= 1)
						{
						    GetPlayerPos(i, X, Y, Z);
							if(ISP(playerid, 3.0, X, Y, Z))
							{
							    Pp[i][Estrelas] = 0;
							    SetPlayerWantedLevel(i, Pp[i][Estrelas]);
						    	GameTextForPlayer(i, "~w~Limpo!!", 1500, 3);
						    	GameTextForPlayer(playerid, "~r~Player Limpo...", 1500, 1);
								format(gstring, sizeof(gstring), "* O Oficial ID:[%d] Limpou a Ficha do Player ID:[%d]", Pp[playerid][IDF], Pp[i][IDF]);
								ProxDetector(5.0, playerid, gstring, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
								return 1;
							}
							else
							{
							    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a este Player");
							}
						}
						else
						{
						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Nao esta Procurado.");
						}
					}
				}
			}
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Policial");
	}
 	return 1;
}

CMD:par(playerid, params[])
{
	new id, r[30 + 1], String[220];
    if(sscanf(params, "ds[30]", id, r)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /par [IDF] [MENSAGEM]");

    for(new i; i < MAX_PLAYERS; i++) {
		if(Pp[i][Logado] == false) continue;
		if(Pp[i][IDF] != id) continue;
		if(id == Pp[playerid][IDF]) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Mandar Particular!");

        if(Pp[playerid][Admin] >= 1)
		{
            GameTextForPlayer(i, "~w~Particular - Chat ~p~Admin", 3000, 4);
			format(String,sizeof(String),"{FFD700}Par[Admin] - {FFFFFF}%s[%d] diz: %s", PlayerName(playerid), Pp[playerid][IDF], r);
			SendClientMessage(i,-1,String);
            format(String,sizeof(String),"{00FF00}Mensagem: {FFFFFF}Voce Enviou Um Particular Para: %s[%d]", PlayerName(i), Pp[i][IDF], r);
			SCM(playerid,-1,String);
		}
		else
		{
            new car[MAX_PLAYER_NAME];
            GetPlayerName(i, car, sizeof(car));
            if(!strcmp(car,"Scoffield_K", false))
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode mandar um Particular para um dono.");
            }
            else if(!strcmp(car,"Neves_samp", false))
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode mandar um Particular para um dono.");
            }
            else if(!strcmp(car,"Red_Cookie", false))
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode mandar um Particular para um dono.");
            }
            else if(!strcmp(car,"Apxgui_Staff", false))
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode mandar um Particular para um dono.");
            }
            else
            {
                GameTextForPlayer(i, "~y~Mensagem", 3000, 1);
                format(String,sizeof(String),"{00FF00}Par: {FFFFFF}%s[%d] diz: %s", PlayerName(playerid), Pp[playerid][IDF], r);
				SendClientMessage(i,-1,String);
                format(String,sizeof(String),"{00FF00}Mensagem: {FFFFFF}Voce Enviou Um Particular Para: %s[%d]", PlayerName(i), Pp[i][IDF], r);
				SCM(playerid,-1,String);
            }
		}
    }
    return 1;
}
CMD:pms(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    new StrON[5000], PM, Gangs, total;
	for(new i = 0; i < MAX_PLAYERS; i++)
	{
		if(IsPlayerConnected(i))
		{
            if(Pp[i][Logado] == true)
            {
    		    if(!IsPolicial(i) && Pp[i][OrgMembro] != 0){Gangs++;}
    		    if(IsPolicial(i) && Uniforme[i] == true){PM++;}
          		total++;
            }
        }
	}
	format(StrON, sizeof(StrON),"{48D1CC}Jogadores Online: {FFFFFF}[%i] [{0099FF}Policial Trabalhando: %d / {FF0000}Criminoso: %d]", total, PM, Gangs);
	SendClientMessage(playerid,0xFFFF00FF,StrON);
	return 1;
}
CMD:online(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	new stg[5000];
 	for(new i; i < MAX_PLAYERS; i++)
	{
 		if(IsPlayerConnected(i))
	   	{
	   	    format(gstring, sizeof(gstring), "\n{FF00FF}: {FFFFFF}%s[%d]\tNivel: [%d]\tPing: [%d]\n", PlayerName(i), Pp[i][IDF], GetPlayerScore(i), GetPlayerPing(i));
			strcat(stg, gstring);
			ShowPlayerDialog(playerid, 5000, DIALOG_STYLE_LIST, "Jogadores", stg, "Ok", "");
		}
	}
    new StrON[5000], PM, Gangs, total;
    for(new i = 0; i < MAX_PLAYERS; i++)
	{
        if(IsPlayerConnected(i))
		{
            if(Pp[i][Logado] == true)
            {
    		    if(!IsPolicial(i) && Pp[i][OrgMembro] != 0){Gangs++;}
    		    if(IsPolicial(i) && Uniforme[i] == true){PM++;}
          		total++;
            }
		}
	}
	format(StrON, sizeof(StrON),"{48D1CC}Jogadores Online: {FFFFFF}[%i] [{0099FF}Policial Trabalhando: %d / {FF0000}Criminoso: %d]", total, PM, Gangs);
	SendClientMessage(playerid,0xFFFF00FF,StrON);
	return 1;
}
CMD:boquete(playerid, params[])
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    new id, string[450];
    if(sscanf(params, "d", id)) return SCM(playerid, -1, "{FFDC33}� {FFFFFF}USE /boquete [ID]");
    {
    	for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
                    if(id != Pp[playerid][IDF])
                    {
    				    new Float:Pos[3], Float:distance;
    				    GetPlayerPos(i, Pos[0], Pos[1], Pos[2]);
    				    distance = GetPlayerDistanceFromPoint(playerid, Pos[0], Pos[1], Pos[2]);
    				    if(distance > 1) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta perto do jogador");
    				    {
    					    SetPVarInt(i, "OtherIdz", playerid);
    					    MEGAString[0]=EOS;
    					    SCM(playerid, -1, "{FFD700}[ BOQUETE ]: {FFFFFF}Voce Enviou um Pedido de Boquete para o Player");
    					    format(string, sizeof(string), "{FFFFFF}[%s Esta Querendo Te Mamar]\n\n", PlayerName(playerid));
    					    strcat(MEGAString, string);
    					    strcat(MEGAString, "{F5DEB3}: {FFFFFF}Se Voce Deseja Aceitar, Aperte Aceitar\n");
    					    strcat(MEGAString, "{F5DEB3}: {FFFFFF}Se Voce Deseja Recusar, Aperte Recusar\n");
    					    ShowPlayerDialog(i, D_BOQ_OFF, DIALOG_STYLE_MSGBOX,"{FFFFFF}Boquete",  MEGAString, "Aceitar", "Recusar");
    					}
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode pagar boquete para si mesmo");
                    }
				}
			}
		}
	}
	return 1;
}
CMD:deletarmotos(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	if(Pp[playerid][Admin] >= 4)
	{
	    for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(VehAlugado[i] == 1)
				{
				    if(IsPlayerInVehicle(i, VeiculoCivil[i]))
					{
					    GameTextForPlayer(i, "~w~Bike Nao ~r~Respawnada!", 1200, 4);
					}
					else
					{
			 			VehAlugado[i] = 0;
						DestroyVehicle(VeiculoCivil[i]);
					}
				}
				else
				{
				    if(IsPlayerInVehicle(i, VeiculoCivil[i]))
					{
					    GameTextForPlayer(i, "~w~Moto Nao ~r~Respawnada!", 1200, 4);
					}
					else
					{
			 			VehAlugado[i] = 0;
						DestroyVehicle(VeiculoCivil[i]);
					}
				}
			}
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem autorizacao para usar este comando");
	}
	return 1;
}
CMD:abastecertd(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(Pp[playerid][Admin] >= 4)
    {
        new String[220];
    	format(String, sizeof(String), "VeiculosGCRP: O Admin: %s[%d] Abasteceu Todos os Veiculos do Servidor", PlayerName(playerid), Pp[playerid][IDF]);
		SendClientMessageToAll(COLOR_LIGHTRED, String);
		for(new i = 0; i < MAX_VEHICLES; i++)
		{
			Combustivel[i] = 60;
		}
		return 1;
	}
	else
	{
	    SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao tem autorizacao para usar este Comando");
	}
	return 1;
}
CMD:rsmoney(playerid, params[])
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(Pp[playerid][Admin] >= 4)
	{
	    new id, string[450];
		if(sscanf(params, "i", id))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /rsmoney [IDF]");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
			        ResetPlayerCash(i);
			        printf("\nSERVER: O Admin %s Resetou o Dinheiro do Player: %s.\n", PlayerName(playerid), PlayerName(i));
					format(string,sizeof(string),"AdmCMD: O Staff %s Resetou o Dinheiro do Player: %s Para 0.", PlayerName(playerid), PlayerName(i));
		            SendClientMessageToAll(COLOR_LIGHTRED, string);
 					return 1;
				}
			}
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem permissao para este Comando");
	}
	return 1;
}
CMD:configs(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    new stg[5000];
    if(Pp[playerid][ConfigN] == 0)
    {
		strcat(stg,  "{FFD700}1. {FFFFFF}[CHAT] Canal [/n]\t{FFD700}Desativado\n");
	}
	else if(Pp[playerid][ConfigN] >= 1)
    {
        strcat(stg,  "{FFD700}1. {FFFFFF}[CHAT] Canal [/n]\t{00FF00}Ativado\n");
    }
    if(Pp[playerid][ConfigNV] == 0)
    {
		strcat(stg,  "{FFD700}2. {FFFFFF}[CHAT] Dicas para Novatos\t{FFD700}Desativado\n");
	}
	else if(Pp[playerid][ConfigNV] >= 1)
    {
        strcat(stg,  "{FFD700}2. {FFFFFF}[CHAT] Dicas para Novatos\t{00FF00}Ativado\n");
    }
    if(Pp[playerid][ConfigOOC] == 0)
    {
		strcat(stg,  "{FFD700}3. {FFFFFF}[CHAT] Discord\t{FFD700}Desativado\n");
	}
	else if(Pp[playerid][ConfigOOC] >= 1)
    {
        strcat(stg,  "{FFD700}3. {FFFFFF}[CHAT] Discord\t{00FF00}Ativado\n");
    }
    if(Pp[playerid][Admin] >= 6)
    {
        if(MensagensHack[playerid] == 0)
        {
    		strcat(stg,  "{FFD700}4. {FFFFFF}Mensagens do Ant-Cheat\t{FFD700}Desativado\n");
    	}
    	else if(MensagensHack[playerid] >= 1)
        {
            strcat(stg,  "{FFD700}4. {FFFFFF}Mensagens do Ant_Cheat\t{00FF00}Ativado\n");
        }
    }
	ShowPlayerDialog(playerid, DIALOG_CONFIGS, DIALOG_STYLE_LIST, "Configuracoes", stg, "Selecionar", "X");
	return 1;
}
CMD:veridf(playerid, params[])
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	if(Pp[playerid][Admin] >= 1)
	{
	    new nome[90 + 1], string[5000];
		if(sscanf(params, "s[90]", nome))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /veridf [Nome]");
		}
        format(arquivo, sizeof(arquivo), PASTA_CONTAS, nome);
		if(DOF2_FileExists(arquivo))
		{
            SendClientMessageEx(playerid, -1, "{FFDC33}Contas: {FFFFFF}O IDF da conta: %s e : IDF:[%d]", nome, DOF2_GetInt(arquivo, "IDF"));
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Esta conta nao existe.");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem autorizacao para usar este comando.");
    }
    return 1;
}
CMD:vernome(playerid, params[])
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	if(Pp[playerid][Admin] >= 1)
	{
