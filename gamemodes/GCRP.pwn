	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem autorizacao para usar este comando");
	}
	return 1;
}
CMD:darlicencas(playerid, params[])
{
	if(Pp[playerid][Admin] >= 6)
 	{
	    new id, string[450];
	   	if(sscanf(params, "i", id)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /darlicencas [IDF]");
	   	{
   			for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
				        Pp[i][FezPorte] = 1;

				        Pp[i][HabilitacaoA] = 1;
				        Pp[i][HabilitacaoB] = 1;
				        Pp[i][HabilitacaoC] = 1;
				        Pp[i][HabilitacaoD] = 1;

				        Pp[i][FezRg] = 1;
				        Pp[i][FezCarteira] = 1;

				        SendClientMessageEx(i, -1, "{FFD700}[ LICENCAS ]: {FFFFFF}O Admin: (%s)%s[%d] Setou Todas as Suas Licencas.", NomeAdm(Pp[playerid][Admin]), PlayerName(playerid), Pp[playerid][IDF]);
				        SendClientMessageEx(playerid, -1, "{FFD700}[ LICENCAS ]: {FFFFFF}Voce Setou Todas as Licencas Para o Player: %s[%d].", PlayerName(i), Pp[i][IDF]);
				        format(string,sizeof(string),"O Admin: (%s)%s[%d] Setou Todas as Licencas Para o Jogador %s", NomeAdm(Pp[playerid][Admin]), PlayerName(playerid), Pp[playerid][IDF], PlayerName(i));
						SendClientMessageToAll(COLOR_LIGHTRED,string);
				        return 1;
				    }
				}
			}
			return 1;
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem autorizacao para usar este comando");
	}
	return 1;
}

CMD:resetlicencas(playerid, params[])
{
	if(Pp[playerid][Admin] >= 6)
 	{
	    new id, string[450];
	   	if(sscanf(params, "i", id)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /resetlicencas [IDF]");
	   	{
   			for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
				        Pp[i][HabilitacaoA] = 0;
				        Pp[i][HabilitacaoB] = 0;
				        Pp[i][HabilitacaoC] = 0;
				        Pp[i][HabilitacaoD] = 0;

				        SendClientMessageEx(i, -1, "{FFD700}[ LICENCAS ]: {FFFFFF}O Admin: (%s)%s[%d] Resetou Todas as Suas Licencas.", NomeAdm(Pp[playerid][Admin]), PlayerName(playerid), Pp[playerid][IDF]);
				        SendClientMessageEx(playerid, -1, "{FFD700}[ LICENCAS ]: {FFFFFF}Voce Resetou Todas as Licencas do Player: %s[%d].", PlayerName(i), Pp[i][IDF]);
				        format(string,sizeof(string),"O Admin: (%s)%s[%d] Resetou Todas as Licencas do Jogador %s", NomeAdm(Pp[playerid][Admin]), PlayerName(playerid), Pp[playerid][IDF], PlayerName(i));
						SendClientMessageToAll(COLOR_LIGHTRED,string);
				        return 1;
				    }
				}
			}
			return 1;
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem autorizacao para usar este comando");
	}
	return 1;
}
CMD:setidf(playerid, params[])
{
	if(Pp[playerid][Admin] >= 6)
 	{
	    new id, idf, string[450];
	   	if(sscanf(params, "ii", id, idf)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /setidf [IDF] [NOVO IDF]");
	   	{
         	for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
                    if(Pp[i][IDF] == id)
				    {
                        SalvarDados(i);
    				    Pp[i][IDF] = idf;
    				    SendClientMessageEx(playerid, -1, "{FFD700}[ Gold City-IDF ]: {FFFFFF}Voce Mudoi o IDF do Player %s Para o ID:[%d]", PlayerName(i), idf);
    				    format(string,sizeof(string),"O Admin: (%s)%s[%d] Mudou o IDF Do Player: %s Para o ID:[%d]", NomeAdm(Pp[playerid][Admin]), PlayerName(playerid), Pp[playerid][IDF], PlayerName(i), idf);
    					SendClientMessageToAll(COLOR_LIGHTRED,string);
    					return 1;
				    }
				}
			}
			return 1;
	   	}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem autorizacao para usar este comando");
	}
	return 1;
}

CMD:ferramentas(playerid)
{
	if(Pp[playerid][Profissao] == PROF_MECANICO)
	{
        if(ISP(playerid, 5.0, 1274.1329,-1236.0348,13.5912))
        {
    	    if(BcMecanico[playerid] == 1)
    	    {
    	        if(Pp[playerid][Ferramentas] < 3)
    	        {
    	            if(GetPlayerCash(playerid) >= 25)
    	            {
    		            new string[450];
    		            GameTextForPlayer(playerid, "~w~Ferramenta ~g~Adquirida!", 3000, 3);
    		            Pp[playerid][Ferramentas] += 1;
    		            SendClientMessageEx(playerid, -1, "{00FF00}[ Mecanica ]: {FFFFFF}Voce Comprou 1 Ferramenta Por: {00FF00}R$25 {FFFFFF}E Agora Possui {FFDC33}[%d] {FFFFFF}Ferramentas, Use: /reparar", Pp[playerid][Ferramentas]);
    		            GivePlayerCash(playerid, -25);
    		            format(string, sizeof(string), "* O ID [%d] Comprou Uma Ferramenta no Menu dos Mecanicos ", Pp[playerid][IDF]);
    					ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
    					return 1;
    	            }
    	            else
    	            {
    	                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem Dinheiro Suficiente. R$[25]");
    	            }
    	        }
    	        else
    	        {
    	            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja tem 3 Ferramentas");
    	        }
    	    }
    	    else
    		{
    		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao Bateu seu Cartao");
    		}
        }
        else
    	{
    		SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta no menu de ferramentas");
    	}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Mecanico");
	}
	return 1;
}
CMD:reparar(playerid, params[])
{
	new Float:Heath;
	idvehicle[playerid] = VeiculoProximo(playerid);
	GetVehicleHealth(idvehicle[playerid], Float:Heath);
	if(Pp[playerid][Profissao] == PROF_MECANICO)
	{
	    new id, preco;
		if(sscanf(params, "ii", id, preco))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /reparar [IDF] [Preco]");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
			        if(id == Pp[playerid][IDF])
			        {
						SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se alto oferecer servicos");
			        }
					if(BcMecanico[playerid] == 1)
					{
						if(Pp[playerid][Ferramentas] >= 1)
						{
						    if(ReparandoVeiculo2[playerid] == 0)
						    {
						        if(BlindandoVeiculo2[playerid] == 0)
						    	{
                                    if(preco >= 15000)
                                    {
    									if(GetPlayerCash(playerid) >= preco)
    									{
    										if(IsPlayerInAnyVehicle(playerid))
    										{
    											return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce precisa estar fora de um veiculo.");
    										}
    										else if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 509 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 481 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 510)
    										{
    											return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este veiculo nao possui motor.");
    										}
    										else if(Heath == 1000)
    										{
    											return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este Veiculo nao esta danificado.");
    										}
    										else if(idvehicle[playerid] > -1)
    										{
    										    new string[450];
    											PlayerTextDrawShow(playerid, TextdrawReparo[0][playerid]);
    											ReparandoVeiculo2[playerid] = 1;
    											GivePlayerCash(playerid, -preco);
    											Pp[playerid][SaldoBancario] += preco;
    											Controle(playerid, 0);
    											ProtecaoAlgemas[playerid] = SetTimerEx("k", 500, true, "d", playerid);
    											Pp[playerid][ExpMec] += 1;

    											ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 1, 1, 0, 0, 1);
    											SCM(playerid, -1, "{00FF00}Reparo: {FFFFFF}Voce pegou uma Ferramenta e esta reparando um veiculo..");
    											SendClientMessageEx(playerid, -1, "{00FF00}Reparo: {FFFFFF}Foi Debitado {00FF00}R$%d {FFFFFF}na sua Conta do Banco", preco);
    											GameTextForPlayer(playerid, "~w~Reparando ~g~Veiculo!", 20001, 3);
    											format(string, sizeof(string), "* O ID [%d] Esta Reparando um Veiculo", Pp[playerid][IDF]);
    											ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);

    											VeiculoReparoKit[playerid] = SetTimerEx("ReparandoVeiculoMec", 20000, true, "i", playerid);
    											return 1;
    										}
    										else if(idvehicle[playerid] == -1)
    										{
    											return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo de nenhum veiculo.");
    										}
    									}
    									else
    									{
    							    		SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player nao tem esse Dinheiro");
    									}
                                    }
                                    else
    								{
    						    		SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce so pode cobrar apartir dos R$15000");
    								}
								}
								else
								{
						    		SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja esta Ocupado");
								}
							}
							else
							{
						    	SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja esta reparando um Veiculo");
							}
						}
						else
						{
						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem Ferramentas o Suficiente");
						}

					}
					else
					{
					    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao Bateu seu Cartao");
					}
				}
			}
		}
		return 1;
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Mecanico");
	}
	return 1;
}
CMD:blindar(playerid, params[])
{
	new Float:Heath;
	idvehicle[playerid] = VeiculoProximo(playerid);
	GetVehicleHealth(idvehicle[playerid], Float:Heath);
	if(Pp[playerid][Profissao] == PROF_MECANICO)
	{
	    new id, blindagem, string[450];
		if(sscanf(params, "ii", id, blindagem))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /blindar [IDF] [Categoria da Blindagem, 1(R$15,000) ou 2(R$50,000)]");
		}
		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
			        if(id == Pp[playerid][IDF])
			        {
						SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se alto oferecer servicos");
			        }
			        if(blindagem == 1)
			        {
						if(BcMecanico[playerid] == 1)
						{
							if(Pp[playerid][Ferramentas] >= 1)
							{
							    if(BlindandoVeiculo2[playerid] == 0)
							    {
							        if(ReparandoVeiculo2[playerid] == 0)
							    	{
							    	    if(Pp[playerid][ExpMec] >= 5)
										{
								    	    if(GetPlayerCash(i) >= 15000)
								    	    {
												if(IsPlayerInAnyVehicle(playerid))
												{
													return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce precisa estar fora de um veiculo.");
												}
												else if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 509 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 481 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 510)
												{
													return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este veiculo nao possui motor.");
												}
												else if(idvehicle[playerid] > -1)
												{
													PlayerTextDrawShow(playerid, TextdrawBlindagem[0][playerid]);
													BlindandoVeiculo2[playerid] = 1;
													GivePlayerCash(i, -15000);
													Pp[playerid][SaldoBancario] += 15000;
													Controle(playerid, 0);
													ProtecaoAlgemas[playerid] = SetTimerEx("k", 500, true, "d", playerid);
													Pp[playerid][ExpMec] += 2;

													ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 1, 1, 0, 0, 1);
													SCM(playerid, -1, "{00FF00}[ BLINDAGEM ]: {FFFFFF}Voce pegou uma Ferramenta e esta reparando um veiculo..");
													SCM(playerid, -1, "{00FF00}[ BLINDAGEM ]: {FFFFFF}Foi Debitado {00FF00}R$15,000 {FFFFFF}Em sua conta bancaria");
													GameTextForPlayer(playerid, "~w~Blindando ~g~Veiculo!", 20001, 3);
													format(string, sizeof(string), "* O ID [%d] Esta Blindando um Veiculo", Pp[playerid][IDF]);
													ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);

													VeiculoReparoKit[playerid] = SetTimerEx("BlindandoVeiculo", 20000, true, "i", playerid);
													return 1;
												}
												else if(idvehicle[playerid] == -1)
												{
													return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo de nenhum veiculo.");
												}
											}
											else
											{
											    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player nao tem Dinheiro para este Servico");
											}
										}
										else
										{
										    SendClientMessageEx(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce tem (%d/5) e por isso Nao pode blindar veiculos.", Pp[playerid][ExpMec]);
										}
									}
									else
									{
							    		SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja esta Ocupado");
									}
								}
								else
								{
							    	SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja esta blindando um Veiculo");
								}
							}
							else
							{
							    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem Ferramentas o Suficiente");
							}

						}
						else
						{
						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao Bateu seu Cartao");
						}
					}
					if(blindagem == 2)
					{
					    if(BcMecanico[playerid] == 1)
						{
							if(Pp[playerid][Ferramentas] >= 1)
							{
							    if(BlindandoVeiculo2[playerid] == 0)
