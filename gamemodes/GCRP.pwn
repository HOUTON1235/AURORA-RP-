stock CarregarMorteP(playerid)
{
    if(Pp[playerid][Ferido] == false)
    {
	    Pp[playerid][Ferido] = true;
	    Pp[playerid][MinutosFerido] = 4;
	    Pp[playerid][SegundosFerido] = 59;
	    Pp[playerid][Mutado] = 1;
	    Pp[playerid][Interior] = GetPlayerInterior(playerid);
	    Pp[playerid][MinutosMutado] = 4 * 60;
	    SvMutePlayerEnable(playerid);
	    new Float:posX, Float:posY, Float:posZ;
	    GetPlayerPos(playerid, Float:posX, Float:posY, Float:posZ);
	    Pp[playerid][FeridoPosX] = posX;
	    Pp[playerid][FeridoPosY] = posY;
	    Pp[playerid][FeridoPosZ] = posZ;
    }
    else
    {
        for(new i; i < 4; i++)
        {
            PlayerTextDrawHide(playerid, TextDrawMorte[playerid][i]);
        }
        Pp[playerid][Ferido] = false;
	    Pp[playerid][MinutosFerido] = 0;
	    Pp[playerid][SegundosFerido] = 0;
	    Pp[playerid][Mutado] = 0;
	    Pp[playerid][Interior] = GetPlayerInterior(playerid);
	    Pp[playerid][MinutosMutado] = 0;
	    SvMutePlayerDisable(playerid);
    }
    return 1;
}
