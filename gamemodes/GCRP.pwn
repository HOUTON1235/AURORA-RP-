CallBack:: DCANIM(playerid)
{
    ClearAnimations(playerid) ;
    ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 0, 0);
    return 1;
}

CallBack:: DCANIM2(playerid)
{
    RemovePlayerAttachedObject(playerid, 4);
    SetPlayerSpecialAction(playerid,SPECIAL_ACTION_STOPUSECELLPHONE);
    ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 0, 0);
    ClearAnimations(playerid) ;
    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE) ;
    return 1;
}

CallBack:: TempoLavagem(playerid)
{
	if(Pp[playerid][DinheiroSujo] >= 1 && Pp[playerid][DinheiroSujo] < 1000000)
	{
	    new string[450];
		format(string, sizeof(string), "~w~Voce Lavou: ~r~R$%d ~n~ ~w~de dinheiro Sujo", Pp[playerid][DinheiroSujo]);
		GameTextForPlayer(playerid, string, 5000, 3);
		format(string, sizeof(string), "- Voce Lavou: R$%d De Dinheiro Sujo..", Pp[playerid][DinheiroSujo]);
		SCM(playerid, COLOR_LIGHTRED, string);
		Controle(playerid, 1);
		GivePlayerCash(playerid, Pp[playerid][DinheiroSujo]/2);
		Pp[playerid][DinheiroSujo] = 0;
		SetTimerEx("DCANIM", 500, false, "d", playerid);
	}
	if(Pp[playerid][DinheiroSujo] >= 1000000)
	{
	    new string[450];
		format(string, sizeof(string), "~w~Voce Lavou: ~r~R$%d ~n~ ~w~e foi retirado Metade desse Valor", Pp[playerid][DinheiroSujo]);
		GameTextForPlayer(playerid, string, 5000, 3);
		format(string, sizeof(string), "- Voce Lavou: R$%d De Dinheiro Sujo e foi retirado metade desse valor..", Pp[playerid][DinheiroSujo]);
		SCM(playerid, COLOR_LIGHTRED, string);
		Controle(playerid, 1);
		GivePlayerCash(playerid, Pp[playerid][DinheiroSujo]/2);
		Pp[playerid][DinheiroSujo] = 0;
		SetTimerEx("DCANIM", 500, false, "d", playerid);
	}
	return 1;
}

CallBack:: TempoRouboReg(playerid)
{
	new orgid = GetPlayerOrg(playerid);
	if(RoubandoReg[playerid] == 1)
	{
	    if(ISP(playerid, 2.0, 2521.1106, -1544.1344, 24.2189))
		{
		    new string[128], DinheiroReg = 2000 + random(3000);
			format(string, sizeof(string), "~w~Voce roubou: ~r~R$%d ~n~ ~w~de dinheiro ~r~Sujo, ~w~Lave-o", DinheiroReg);
			GameTextForPlayer(playerid, string, 5000, 3);
