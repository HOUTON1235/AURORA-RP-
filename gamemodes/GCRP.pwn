public OnVehicleDamageStatusUpdate(vehicleid, playerid)
{
    new Float:hp;
    new carid = GetPlayerVehicleID(playerid);
    GetVehicleHealth(carid, hp);
    if (hp <= 300)
    {
        SetVehicleHealth(carid, 290.0);// Veiculos nao explodir
    }
    return 1;
}

public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
	if (weaponid == ARMA_TASER)
 	{
  		if (taser[playerid])
  		{
   			GiveTaserAgainTimer[playerid] = SetTimerEx("GiveTaserAgain", TEMPO_RECARREGAR, 0, "i", playerid);
   			ApplyAnimation(playerid, "SWORD", "sword_block", 50.0, 0, 1, 0, 1, 1, 1);
   			SetPlayerAttachedObject(playerid, 0, OBJETO_TASER, 6);
   			SetPlayerArmedWeapon(playerid, 0);

   			if (hittype == BULLET_HIT_TYPE_PLAYER)
			{
    			new Float:x, Float:y, Float:z;
    			GetPlayerPos(hitid, x, y, z);
    			foreach(Player, i) if(IsPlayerInRangeOfPoint(i, 30.0, x, y, z)) PlayAudioStreamForPlayer(i, "https://a.clyp.it/b0w3dcsr.mp3", x, y, z, 30.0, 1);
    			ApplyAnimation(hitid, "CRACK", "cGCRPdeth2", 4.1, 0, 1, 1, 1, TEMPO_EFEITO, 1);
    			SetPlayerDrunkLevel(hitid, 5000);
    			SetTimerEx("EndTaserEffect", TEMPO_EFEITO, 0, "i", hitid);
   			}
  		}
	}
	switch(weaponid){ case 0..18, 39..54: return 1;}//invalid weapons

	if(hittype == BULLET_HIT_TYPE_PLAYER && IsPlayerConnected(hitid) && !IsPlayerNPC(hitid))
 	{
  		new Float:Shot[3], Float:Hit[3];
  		GetPlayerLastShotVectors(playerid, Shot[0], Shot[1], Shot[2], Hit[0], Hit[1], Hit[2]);
		new playersurf = GetPlayerSurfingVehicleID(playerid);
		new hitsurf = GetPlayerSurfingVehicleID(hitid);
		new Float:targetpackets = NetStats_PacketLossPercent(hitid);
		new Float:playerpackets = NetStats_PacketLossPercent(playerid);
		if(~(playersurf) && ~(hitsurf) && !IsPlayerInAnyVehicle(playerid) && !IsPlayerInAnyVehicle(hitid))
		{
  			if(!IsPlayerAimingAtPlayer(playerid, hitid) && !IsPlayerInRangeOfPoint(hitid, 5.0, Hit[0], Hit[1], Hit[2]))
     		{
       			new string[450];
       			AimbotWarnings[playerid] ++;
       			format(string, sizeof(string), "Ant-AimBot: O Jogador: %s[%d] Esta de Aimbot ou LAG [Target PL: %f | Shooter PL:%f]!", PlayerName(playerid), Pp[playerid][IDF], targetpackets, playerpackets);
                SCMAdmDono(COLOR_LIGHTRED,gstring,7);

				if(AimbotWarnings[playerid] > 10)
				{
					if(targetpackets < 1.2 && playerpackets < 1.2) return Kick(playerid);
					else
					{
						format(string, sizeof(string), "Ant-AimBot: O Jogador: %s[%d] Provavelmente Esta Usando AimBot! [Target PL: %f | Shooter PL:%f]!", PlayerName(playerid), Pp[playerid][IDF], targetpackets, playerpackets);
                        SCMAdmDono(COLOR_LIGHTRED,gstring,7);
					}
				}
				return 0;
			}
			else return 1;
		}
		else return 1;
	}
	return 1;
}

forward ProxDetectorS(Float:radi, playerid, targetid);
public ProxDetectorS(Float:radi, playerid, targetid)
{
    if(IsPlayerConnected(playerid)&&IsPlayerConnected(targetid))
	{
		new Float:posx, Float:posy, Float:posz;
		new Float:oldposx, Float:oldposy, Float:oldposz;
		new Float:tempposx, Float:tempposy, Float:tempposz;
		GetPlayerPos(playerid, oldposx, oldposy, oldposz);
		GetPlayerPos(targetid, posx, posy, posz);
		tempposx = (oldposx -posx);
		tempposy = (oldposy -posy);
		tempposz = (oldposz -posz);
		if (((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)) && ((tempposz < radi) && (tempposz > -radi)))
		{
			return 1;
		}
	}
	return 0;
}

CallBack:: UpChat()
{
    for(new i = 0; i < MAX_PLAYERS; i++)
        LimparChat(i, 1);
}
CallBack:: ProxDetector(Float:radi, playerid, string[],col1,col2,col3,col4,col5)
{
	if(IsPlayerConnected(playerid))
	{
		new Float:posx, Float:posy, Float:posz;
		new Float:oldposx, Float:oldposy, Float:oldposz;
		new Float:tempposx, Float:tempposy, Float:tempposz;
		GetPlayerPos(playerid, oldposx, oldposy, oldposz);
		for(new i = 0; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
				if(!BigEar[i])
				{
					GetPlayerPos(i, posx, posy, posz);
					tempposx = (oldposx -posx);
					tempposy = (oldposy -posy);
					tempposz = (oldposz -posz);
					if (((tempposx < radi/16) && (tempposx > -radi/16)) && ((tempposy < radi/16) && (tempposy > -radi/16)) && ((tempposz < radi/16) && (tempposz > -radi/16)))
					{
						SendClientMessage(i, col1, string);
					}
					else if (((tempposx < radi/8) && (tempposx > -radi/8)) && ((tempposy < radi/8) && (tempposy > -radi/8)) && ((tempposz < radi/8) && (tempposz > -radi/8)))
					{
						SendClientMessage(i, col2, string);
					}
					else if (((tempposx < radi/4) && (tempposx > -radi/4)) && ((tempposy < radi/4) && (tempposy > -radi/4)) && ((tempposz < radi/4) && (tempposz > -radi/4)))
					{
						SendClientMessage(i, col3, string);
					}
					else if (((tempposx < radi/2) && (tempposx > -radi/2)) && ((tempposy < radi/2) && (tempposy > -radi/2)) && ((tempposz < radi/2) && (tempposz > -radi/2)))
					{
						SendClientMessage(i, col4, string);
					}
					else if (((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)) && ((tempposz < radi) && (tempposz > -radi)))
					{
						SendClientMessage(i, col5, string);
					}
				}
				else
				{
					SendClientMessage(i, col1, string);
				}
			}
		}
	}
	return 1;
}

CallBack:: CarregandoObjetos(playerid)
{
	Controle(playerid, 1);
    GameTextForPlayer(playerid, "~w~Servidor ~g~Carregado!", 2000, 4);
    for(new i; i < 4; i++){PlayerTextDrawHide(playerid, TdCarregarINT[playerid][i]);}
	return 1;
}
CallBack:: Tempo()
{
	new HoraRoYal, MinutoRoYal, SegundoRoYal;
	gettime(HoraRoYal, MinutoRoYal, SegundoRoYal);
 	switch(HoraRoYal)
	{
		case 0: SetWorldTime(0);
	 	case 1: SetWorldTime(0);
	  	case 2: SetWorldTime(1);
	   	case 3: SetWorldTime(2);
	    case 4: SetWorldTime(4);
	    case 5: SetWorldTime(5);
	    case 6: SetWorldTime(6);
	    case 7: SetWorldTime(7);
	    case 8: SetWorldTime(8);
	    case 9: SetWorldTime(9);
	    case 10: SetWorldTime(10);
	    case 11: SetWorldTime(11);
	    case 12: SetWorldTime(12);
	    case 13: SetWorldTime(13);
	    case 14: SetWorldTime(14);
	    case 15: SetWorldTime(15);
	    case 16: SetWorldTime(16);
	    case 17: SetWorldTime(20);
	    case 18:
        {
            if(MinutoRoYal == 0 && SegundoRoYal == 0)
	    	{
                SetWorldTime(0);
                IniciarGuerraGuetto();
            }
            if(MinutoRoYal == 30 && SegundoRoYal == 0)
	    	{
                SetWorldTime(0);
                FinalizarGuerraGuetto();
            }
        }
	    case 19: SetWorldTime(0);
        case 20:
        {
            if(MinutoRoYal == 0 && SegundoRoYal == 0)
	    	{
                SetWorldTime(0);
                IniciarGuerraFAB();
            }
            if(MinutoRoYal == 30 && SegundoRoYal == 0)
	    	{
                SetWorldTime(0);
                FinalizarGuerraFAB();
            }
        }
	    case 21: SetWorldTime(0);
	    case 22:
        {
            if(MinutoRoYal == 0 && SegundoRoYal == 0)
	    	{
                SetWorldTime(0);
                IniciarGuerraMorro();
            }
            if(MinutoRoYal == 30 && SegundoRoYal == 0)
	    	{
                SetWorldTime(0);
                FinalizarGuerraMorro();
            }
        }
	    case 23: SetWorldTime(0);
    }
    for(new i; i < MAX_ORGS; i++)
    {
        SalvarCofre(i);
    }
    for(new i; i < MAX_PLAYERS; i++)
    {
    	if(Pp[i][Logado] == true)
    	{
    		if(Pp[i][Logado] == true)
    		{
    			new str[5000], Dia, Mes, Ano;
                getdate(Ano, Mes, Dia);
    			format(str, sizeof(str), "%02d/%02d/%02d - %02d:%02d:%02d", Dia, Mes, Ano, HoraRoYal, MinutoRoYal, SegundoRoYal);
    			PlayerTextDrawSetString(i, TdFMHud[i][5], str);
                PlayerTextDrawShow(i, TdFMHud[i][5]);
    		}
    	}
        if(GetPlayerCash(i) != GetPlayerMoney(i))
		{
			ResetMoneyBar(i);
			UpdateMoneyBar(i, GetPlayerCash(i));
		}
        if(!IsPlayerNPC(i))
        {
            if(Pp[i][Logado] == true)
            {
                if(GetPlayerState(i) == PLAYER_STATE_DRIVER)
                {
    				if(GetPlayerSpeed(i) > 300)
        			{
        			    if(Pp[i][Admin] == 0)
        			    {
    	       				new string[1200];
    	           			format(string,sizeof(string), "AntCheat: O Player %s(%d) Foi Kickado por Suspeita de Speed Hack", PlayerName(i), i);
    	              		SendClientMessageToAll(COLOR_LIGHTRED, string);
    	                    ShowPlayerDialog(i,5000,DIALOG_STYLE_MSGBOX,"{FFFFFF}Kick {FFD700}Gold City","{FF00FF}: {FFFFFF}Voce foi Kickado por Suspeita de Speed Hack\n{FF00FF}: {FFFFFF}Prox.Vez Sera Banido.","Sair","");
               				SetTimerEx("KickPlayer", 100, false, "i", i);
                        }
                        return 1;
                    }
                }
                else
                {
                    if(GetPlayerState(i) == PLAYER_STATE_ONFOOT)
                    {
    	                if(GetPlayerSpeed(i) > 100)
    	    			{
    	    			    if(Pp[i][Admin] == 0)
    	    			    {
    		       				new string[1200];
    		           			format(string,sizeof(string), "AntCheat: O Player %s(%d) Foi Kickado por Suspeita de Fly Hack ou Surf", PlayerName(i), i);
                                if(Pp[i][Admin] >= 1)
                                {
                                    if(Trabalhando[i] == true)
                                    {
                                        SendClientMessage(i, COLOR_LIGHTRED, string);
                                    }
                                }
    		              		ShowPlayerDialog(i,5000,DIALOG_STYLE_MSGBOX,"{FFFFFF}Kick {FFD700}Gold City","{FF00FF}: {FFFFFF}Voce foi Kickado por Suspeita de Fly Hack ou Surf\n{FF00FF}: {FFFFFF}Voce nao pode Praticar Surf em Nosso Servidor, Prox.Vez Sera Banido.","Sair","");
                				SetTimerEx("KickPlayer", 100, false, "i", i);
    		                }
    	                    return 1;
    	                }
    				}
                }
    		}
    		if(Pp[i][Logado] == true)
    		{
    	   		if(IsPlayerInAnyVehicle(i))
    	   		{
    	   			new vid = GetPlayerVehicleID(i);
    		   		if(GetVehicleModel(vid) != 481 && GetVehicleModel(vid) != 509 && GetVehicleModel(vid) != 510)
    			  	{
    			        if (GetPlayerVehicleSeat(i) == 0)
    					{
    						new Float:health;
    						GetVehicleHealth(GetPlayerVehicleID(i), health);
    						if(health <= 300 && health > 0)
    						{
    							SetVehicleHealth(GetPlayerVehicleID(i), 300);
    							motor[vid] = false;

    							new engine, farol, alarme, portas, capo, portamalas, objetivo;
    							GetVehicleParamsEx(vid, engine, farol, alarme, portas, capo, portamalas, objetivo);
    							SetVehicleParamsEx(vid, VEHICLE_PARAMS_OFF, farol, alarme, portas, capo, portamalas, objetivo);

    							GameTextForPlayer(i, "~w~Veiculo ~r~Quebrado", 1000, 0);
    						}
    			        }
    			    }
    			}
    		}
        }
        new string[450];
        if(Pp[i][Logado] == true)
		{
            new strff[5000];
            format(strff, sizeof(strff), "%d", Pp[i][Fome]);
	  	    PlayerTextDrawSetString(i, TdFMHud[i][23], strff);
            PlayerTextDrawShow(i, TdFMHud[i][23]);

            format(strff, sizeof(strff), "%d", Pp[i][Sede]);
	  	    PlayerTextDrawSetString(i, TdFMHud[i][24], strff);
            PlayerTextDrawShow(i, TdFMHud[i][24]);

            format(strff, sizeof(strff), "%d", Pp[i][Bexiga]);
	  	    PlayerTextDrawSetString(i, TdFMHud[i][25], strff);
            PlayerTextDrawShow(i, TdFMHud[i][25]);

            format(strff, sizeof(strff), "%d", Pp[i][Sono]);
	  	    PlayerTextDrawSetString(i, TdFMHud[i][26], strff);
            PlayerTextDrawShow(i, TdFMHud[i][26]);

    		if(Pp[i][Fome] > 100)
    		{
    			Pp[i][Fome] = 100;
    		}
    		else if(Pp[i][Sede] > 100)
    		{
    			Pp[i][Sede] = 100;
    		}
    		else if(Pp[i][Bexiga] > 100)
    		{
    			Pp[i][Bexiga] = 100;
    		}
            else if(Pp[i][Sono] > 100)
    		{
    			Pp[i][Sono] = 100;
    		}
        }
		if(Pp[i][Logado] == true)
		{
			if(dmsafe[i] == 3)
			{
				dmsafe[i] = 0;

				format(string, sizeof(string), "[INFO] O Jogador %s foi kickado automaticamente, Motivo: Matando em Area-Safe.", PlayerName(i));
				SendClientMessageToAll(COLOR_LIGHTRED, string);

				Kick(i);
			}
		}
		new String[220];
		if(Pp[i][Preso] == true)
		{
			for(new ii; ii < 2; ii++)
			{
				PlayerTextDrawShow(i, TextdrawPrisao[ii][i]);
			}
			if(Pp[i][PresoMinutos] > 60)
			{
				Pp[i][PresoHoras] ++;
				Pp[i][PresoMinutos] = Pp[i][PresoMinutos] - 60;
			}
			if(Pp[i][PresoSegundos] > 0)
			{
				Pp[i][PresoSegundos] -= 1;
			}
			if(Pp[i][PresoSegundos] == 0 && Pp[i][PresoMinutos] > 0)
			{
				Pp[i][PresoSegundos] = 59;
				Pp[i][PresoMinutos] --;
			}
			if(Pp[i][PresoSegundos] == 0 && Pp[i][PresoMinutos] == 0 && Pp[i][PresoHoras] > 0)
			{
				Pp[i][PresoSegundos] = 59;
				Pp[i][PresoMinutos] = 59;
				Pp[i][PresoHoras] --;
			}
			if(Pp[i][PresoSegundos] == 0 && Pp[i][PresoMinutos] == 0 && Pp[i][PresoHoras] == 0)
			{
				SendClientMessage(i, COR_BRANCO, "{FFFFFF}Voce foi solto por cumprir sua pena");
				SoltarPreso(i);
			}
			format(String, sizeof(String), "%02d:%02d:%02d", Pp[i][PresoHoras], Pp[i][PresoMinutos], Pp[i][PresoSegundos]);
			PlayerTextDrawSetString(i, TextdrawPrisao[1][i], String);
		}
        else if(Pp[i][Preso] == false)
        {
            for(new ii; ii < 2; ii++)
			{
				PlayerTextDrawHide(i, TextdrawPrisao[ii][i]);
			}
        }
		if(Pp[i][Logado] == true)
		{
			if(EstaUsandoCelular[i] == true)
			{
				gettime(HoraRoYal, MinutoRoYal, SegundoRoYal);

				format(string, sizeof(string), "%02d:%02d", HoraRoYal, MinutoRoYal);
				PlayerTextDrawSetString(i, TextdrawCelular[i][20], string);
			}
		}
	    if(Pp[i][Logado] == true)
	    {
		    if(Pp[i][Vip] >= 1)
		    {
  				if(Pp[i][TempoVip] >= 1)
				{
					Pp[i][TempoVip] = Pp[i][TempoVip] - 30;
				}
				if(Pp[i][TempoVip] <= 0)
				{
				    Pp[i][TempoVip] = 0;
					Pp[i][Vip] = 0;
                    Pp[i][SaldoBancario] = 0;
					SendClientMessage(i, -1,"{FFDC33}=-=-=-=-=-=-=-= {FFFFFF}Info Vip{FFDC33} =-=-=-=-=-=-=-=");
					SendClientMessage(i, -1,"{FFDC33}Info. {FFFFFF}Seu Vip Expirou, Renove-o com Um Staff Em Nosso Discord");
					SendClientMessage(i, -1,"{FFDC33}Info. {FFFFFF}Caso Nao Queira Renovar nao Precisa Entrar em Contato Com um Admin.");
					SendClientMessage(i, -1,"{FFDC33}=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=");
					GameTextForPlayer(i, "~w~Seu Vip ~r~Expirou!!", 10000, 1);
				}
			}
		}
        if(Pp[i][Logado] == true)
	    {
		    if(Pp[i][Socio] >= 1)
		    {
  				if(Pp[i][TempoSocio] >= 1)
				{
					Pp[i][TempoSocio] = Pp[i][TempoSocio] - 1;
				}
				if(Pp[i][TempoSocio] <= 0)
				{
				    Pp[i][TempoSocio] = 0;
					Pp[i][Socio] = 0;
                    Pp[i][SaldoBancario] = 0;
					SendClientMessage(i, -1,"{FFDC33}=-=-=-=-=-=-=-= {FFFFFF}Info Socio{FFDC33} =-=-=-=-=-=-=-=");
					SendClientMessage(i, -1,"{FFDC33}Info. {FFFFFF}Seu Socio Expirou, Renove-o com Um Staff Em Nosso Discord");
					SendClientMessage(i, -1,"{FFDC33}Info. {FFFFFF}Caso Nao Queira Renovar nao Precisa Entrar em Contato Com um Admin.");
					SendClientMessage(i, -1,"{FFDC33}=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=");
					GameTextForPlayer(i, "~w~Seu Socio ~r~Expirou!!", 10000, 1);
				}
			}
		}
	    if(Pp[i][Logado] == true)
	    {
		    if(Pp[i][Mutado] >= 1)
		    {
  				if(Pp[i][MinutosMutado] >= 1)
				{
					Pp[i][MinutosMutado] = Pp[i][MinutosMutado] - 1;
				}
				if(Pp[i][MinutosMutado] <= 0)
				{
				    Pp[i][MinutosMutado] = 0;
					Pp[i][Mutado] = 0;
					SvMutePlayerDisable(i);
					SendClientMessage(i, -1,"{00FF00}=-=-=-=-=-=-=-= {FFFFFF}Info Mute{00FF00} =-=-=-=-=-=-=-=");
					SendClientMessage(i, -1,"{00FF00}Info. {FFFFFF}Voce foi Desmutado!!! Parabens!! Agora Leia Abaixo!");
					SendClientMessage(i, -1,"{00FF00}Info. {FFFFFF}Por Favor, Nao repita o que voce fez Antes, Se nao acontecera Novamente");
					SendClientMessage(i, -1,"{00FF00}=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=");
					GameTextForPlayer(i, "~y~Desmuted!", 5000, 3);
				}
			}
		}
	}
    return 1;
}
