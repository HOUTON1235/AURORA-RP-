		ShowPlayerDialog(playerid, 5000, DIALOG_STYLE_MSGBOX,"{FFFFFF}Voce Esta {FFD700}Banido",String,"Sair","");

		SetTimerEx("KickPlayer", 100, false, "i", playerid);
		return 1;
	}
	//Banidos Ip
    new ip[25], StrBanIp[1500];
	GetPlayerIp(playerid,ip,sizeof(ip));
	format(StrBanIp,sizeof(StrBanIp),"BanidosIp/%s.ini",ip);
	if(DOF2_FileExists(StrBanIp))
	{
		format(String,sizeof(String),"{FFFFFF}Voce foi banido por: %s\n{FFFFFF}Pelo motivo de: %s",DOF2_GetString(StrBanIp,"Admin"),DOF2_GetString(StrBanIp,"Motivo"));
		ShowPlayerDialog(playerid, 5000, DIALOG_STYLE_MSGBOX,"{FFFFFF}Voce Esta {FFD700}Banido",String,"Sair","");
		SetTimerEx("KickPlayer", 100, false, "i", playerid);
		return 1;
	}
    if (SvGetVersion(playerid) == SV_NULL)
    {
        VoipOff[playerid] = 1;
        VoipOn[playerid] = 0;
    }
    else if (SvHasMicro(playerid) == SV_FALSE)
    {
        VoipOff[playerid] = 0;
        VoipOn[playerid] = 1;
    }
    else if ((lstream[playerid] = SvCreateDLStreamAtPlayer(15.0, SV_INFINITY, playerid, 0x8B008BFF, "Chat de Voz")))
    {
        if (gstream) SvAttachListenerToStream(gstream, playerid);

        SvAddKey(playerid, 0x42);
        VoipOn[playerid] = 1;
        VoipOff[playerid] = 0;
    }
    if(VoipOn[playerid] == 1)
    {
        VoipOn[playerid] = 1;
        VoipOff[playerid] = 0;
    }
    if(VoipOff[playerid] == 1)
    {
        VoipOn[playerid] = 0;
        VoipOff[playerid] = 1;
    }
    LimparChat(playerid, 50);
    SCM(playerid, -1, "{FFD700}Gold City {FFFFFF}Roleplay - Aguarde o carregamento do servidor.");
    CarregarTextdraws(playerid);
	MapRemocao(playerid);
	SetPlayerColor(playerid, 0x8B008BFF);
	return 1;
}

public OnPlayerDisconnect(playerid, reason)
{
	// Variaveis
	if(Pp[playerid][Algemado] == true)
	{
        Pp[playerid][Algemado] = false;
		new string[2000];
        Pp[playerid][Preso] = true;
		Pp[playerid][PresoMinutos] = 9;
		Pp[playerid][PresoSegundos] = 59;
		format(string, sizeof(string), "[PRISAO] O Jogador %s[%d] Deslogou Algemado do Servidor e Foi Preso por 10 Minutos.", PlayerName(playerid), Pp[playerid][IDF]);
		SendClientMessageToAll(COLOR_LIGHTRED, string);
        SalvarDados(playerid);
	}
    if(Colocado[playerid] == true)
	{
        Colocado[playerid] = false;
		new string[2000];
        Pp[playerid][Preso] = true;
		Pp[playerid][PresoMinutos] = 29;
		Pp[playerid][PresoSegundos] = 59;
		format(string, sizeof(string), "[PRISAO] O Jogador %s[%d] Deslogou Em um Porta Malas do Servidor e Foi Preso por 30 Minutos.", PlayerName(playerid), Pp[playerid][IDF]);
		SendClientMessageToAll(COLOR_LIGHTRED, string);
        SalvarDados(playerid);
	}
    if(Neon[playerid] == true)
    {
        DestroyObject(GetPVarInt(playerid, "neon"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "Neon"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "neon2"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "neon3"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "neon4"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "neon5"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "neon6"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "neon7"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "neon8"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "neon9"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "Neon0"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "Neon1"));
	    DeletePVar(playerid, "Status");
	    Neon[playerid] = false;
    }
	if(IniciouTesteHabilitacaoA[playerid] == 1)
	{
		if(IsPlayerInVehicle(playerid, AutoEscolaMoto[playerid]))
		{
			RemovePlayerFromVehicle(playerid);
			DestroyVehicle(AutoEscolaMoto[playerid]);

			DisablePlayerRaceCheckpoint(playerid);
			CheckpointPontosMoto[playerid] = 0;
			KillTimer(TimerTesteMoto[playerid]);

			IniciouTesteHabilitacaoA[playerid] = 0;
		}
	}
	else if(IniciouTesteHabilitacaoB[playerid] == 1)
	{
		if(IsPlayerInVehicle(playerid, AutoEscolaVeiculo[playerid]))
		{
			RemovePlayerFromVehicle(playerid);
			DestroyVehicle(AutoEscolaVeiculo[playerid]);

			DisablePlayerRaceCheckpoint(playerid);
			CheckpointPontosVeiculo[playerid] = 0;
			KillTimer(TimerTesteVeiculo[playerid]);

			IniciouTesteHabilitacaoB[playerid] = 0;
		}
	}
	else if(IniciouTesteHabilitacaoC[playerid] == 1)
	{
		if(IsPlayerInVehicle(playerid, AutoEscolaCaminhao[playerid]))
		{
			RemovePlayerFromVehicle(playerid);
			DestroyVehicle(AutoEscolaCaminhao[playerid]);

			DisablePlayerRaceCheckpoint(playerid);
			CheckpointPontosCaminhao[playerid] = 0;
			KillTimer(TimerTesteCaminhao[playerid]);

			IniciouTesteHabilitacaoC[playerid] = 0;
		}
	}
	else if(IniciouTesteHabilitacaoD[playerid] == 1)
	{
		if(IsPlayerInVehicle(playerid, AutoEscolaAerea[playerid]))
		{
			RemovePlayerFromVehicle(playerid);
			DestroyVehicle(AutoEscolaAerea[playerid]);

			DisablePlayerRaceCheckpoint(playerid);
			CheckpointPontosAerea[playerid] = 0;
			KillTimer(TimerTesteAerea[playerid]);

			IniciouTesteHabilitacaoD[playerid] = 0;
			Controle(playerid, 0);
		}
	}
	if(VeiculoSpawnado[playerid] == 1)
	{
        SalvarVeiculo(playerid);
        IfCarro[playerid][Cor] = 0;
        IfCarro[playerid][Nitro] = 0;
        IfCarro[playerid][Hidraulica] = 0;
        IfCarro[playerid][Roda] = 0;
        IfCarro[playerid][Spoiler] = 0;
        IfCarro[playerid][Placa] = 0;
        IfCarro[playerid][ArmaM4] = 0;
        IfCarro[playerid][MunM4] = 0;
        IfCarro[playerid][ArmaMP5] = 0;
        IfCarro[playerid][MunMP5] = 0;
        IfCarro[playerid][ArmaDesert] = 0;
        IfCarro[playerid][MunDesert] = 0;
        IfCarro[playerid][Shotgun] = 0;
        IfCarro[playerid][MunShot] = 0;
        IfCarro[playerid][ArmaAk] = 0;
        IfCarro[playerid][MunAk] = 0;
        IfCarro[playerid][GasVeh] = 0;
        IfCarro[playerid][TemPlaca] = 0;
        IfCarro[playerid][VehAp] = 0;
		CarroTrank[VehConce[playerid]] = 0;
		CarroInfo[VehConce[playerid]][ChaveCarro] = 0;

	    VeiculoSpawnado[playerid] = 0;
		DestroyVehicle(VehConce[playerid]);
    }
    if(AcessouMenuCarInv[playerid] == 1)
	{
        new carid = GetVehicleModel(CarroEventoIV[playerid]);
        if(Slots[playerid][idslotiv[playerid]] == 999999)
        {
    		Slots[playerid][idslotiv[playerid]] = carid;
            PlayerTextDrawSetPreviewModel(playerid, InvCarTDP[playerid][idslotiv[playerid]], Slots[playerid][idslotiv[playerid]]);
        }
        idslotiv[playerid] = 0;
		CarroTrank[CarroEventoIV[playerid]] = 0;
	 	CarroInfo[CarroEventoIV[playerid]][ChaveCarro] = 0;
		AcessouMenuCarInv[playerid] = 0;
		DestroyVehicle(CarroEventoIV[playerid]);
        SalvarInvCars(playerid);
	}
    if(AcessouMenuCarInv[playerid] == 1)
	{
        new carid = GetVehicleModel(CarroEventoIV[playerid]);
        if(Slots[playerid][idslotiv[playerid]] == 999999)
        {
    		Slots[playerid][idslotiv[playerid]] = carid;
            PlayerTextDrawSetPreviewModel(playerid, InvCarTDP[playerid][idslotiv[playerid]], Slots[playerid][idslotiv[playerid]]);
        }
        idslotiv[playerid] = 0;
		CarroTrank[CarroEventoIV[playerid]] = 0;
	 	CarroInfo[CarroEventoIV[playerid]][ChaveCarro] = 0;
		AcessouMenuCarInv[playerid] = 0;
		DestroyVehicle(CarroEventoIV[playerid]);
        SalvarInvCars(playerid);
	}
    if(VehAlugado[playerid] == 1)
	{
	    CarroTrank[VeiculoCivil[playerid]] = 0;
		CarroInfo[VeiculoCivil[playerid]][ChaveCarro] = 0;
		VehAlugado[playerid] = 0;
		DestroyVehicle(VeiculoCivil[playerid]);
	}
 	if(Trabalhando[playerid] == true)
  	{
  		Trabalhando[playerid] = false;
  	}
   	if(Uniforme[playerid] == true)
   	{
   		Uniforme[playerid] = false;
  	}
	if(ColocouBarreira[playerid] == true)
 	{
		ColocouBarreira[playerid] = false;
		DestroyDynamicObject(ObjetoBarreira[playerid]);
		Delete3DTextLabel(TextoBarreira[playerid]);
	}
	if(ColocouTapete[playerid] == true)
	{
		ColocouTapete[playerid] = false;
		DestroyDynamicObject(ObjetoTapete[playerid]);
