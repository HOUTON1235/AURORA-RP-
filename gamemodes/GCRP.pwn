CMD:editartag(playerid, params[])
{
    if(Pp[playerid][TemTagCab] >= 1)
    {
        new tt[30 + 1], Str[5000], string[450];
	   	if(sscanf(params, "s[30]", tt)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /editartag [Nome parara a tag]");
	   	{
            format(arquivo, sizeof(arquivo), PASTA_CONTAS, PlayerName(playerid));
            if(DOF2_FileExists(arquivo))
            {
                DOF2_SetString(arquivo, "TagCabeca", tt);
                if(Pp[playerid][TemTagCab] == 1)
                {
                    Delete3DTextLabel(TagCabecaLB[playerid]);
                    format(Str, sizeof(Str), "{FFD700}%s",DOF2_GetString(arquivo, "TagCabeca"));
                    TagCabecaLB[playerid] = Create3DTextLabel(Str, 0x008080FF, 30.0, 40.0, 50.0, 15.0, 0);
                    Attach3DTextLabelToPlayer(TagCabecaLB[playerid], playerid, 0.0, 0.0, 0.5);
                }
                GameTextForPlayer(playerid, "~w~Tag ~r~mudada", 1200, 1);
                SendClientMessageEx(playerid, -1, "{FFD700}Tag: {FFFFFF}Voce mudou sua tag para: {FFDC33}%s", DOF2_GetString(arquivo, "TagCabeca"));
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem tag.");
    }
    return 1;
}
CMD:rscaixas(playerid)
{
    if(Pp[playerid][Admin] >= 4)
    {
        Pp[playerid][Caixinha] = 0;
    }
    return 1;
}
CMD:settag(playerid, params[])
{
    if(Pp[playerid][Admin] >= 4)
    {
        new id, tag[30 + 1], Str[5000], string[450];
        if(sscanf(params, "ds[30]", id, tag))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /settag [IDF] [Mensagem da Tag]");
		}
        for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
                    format(arquivo, sizeof(arquivo), PASTA_CONTAS, PlayerName(i));
                	if(DOF2_FileExists(arquivo))
                	{
                        DOF2_SetString(arquivo, "TagCabeca", tag);
                        if(Pp[i][TemTagCab] == 1)
                        {
                            format(Str, sizeof(Str), "{FFD700}%s",DOF2_GetString(arquivo, "TagCabeca"));
                            Update3DTextLabelText(TagCabecaLB[i], 0xFFFFFFFF, Str);
                        }
                        else if(Pp[i][TemTagCab] == 0)
                        {
                            Pp[playerid][TemTagCab] = 1;
                            format(Str, sizeof(Str), "{FFD700}%s",DOF2_GetString(arquivo, "TagCabeca"));
                            TagCabecaLB[i] = Create3DTextLabel(Str, 0x008080FF, 30.0, 40.0, 50.0, 15.0, 0);
                            Attach3DTextLabelToPlayer(TagCabecaLB[i], i, 0.0, 0.0, 0.5);
                        }
                    }
                    GameTextForPlayer(i, "~w~Tag ~g~recebida", 1200, 1);
                    GameTextForPlayer(playerid, "~w~Tag ~r~setada", 1200, 1);
                    SendClientMessageEx(playerid, -1, "{FFD700}Tag: {FFFFFF}Voce setou com sucesso a tag: {FFDC33}%s {FFFFFF}na cabeca do jogador: %s[%d]", DOF2_GetString(arquivo, "TagCabeca"), PlayerName(i), Pp[i][IDF]);
                    SendClientMessageEx(playerid, -1, "{FFD700}Tag: {FFFFFF}Voce recebeu a tag: {FFDC33}%s {FFFFFF}na cabeca do admin: %s[%d]", DOF2_GetString(arquivo, "TagCabeca"), PlayerName(playerid), Pp[playerid][IDF]);
                }
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e autorizado a usar este comando.");
    }
    return 1;
}
CMD:rttag(playerid, params[])
{
    if(Pp[playerid][Admin] >= 4)
    {
        new id, Str[5000], string[450];
        if(sscanf(params, "i", id))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /rttag [IDF]");
		}
        for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
                    if(Pp[i][TemTagCab] == 1)
                    {
                        format(arquivo, sizeof(arquivo), PASTA_CONTAS, PlayerName(i));
                    	if(DOF2_FileExists(arquivo))
                    	{
                            format(Str, sizeof(Str), " ",DOF2_GetString(arquivo, "TagCabeca"));
                            Update3DTextLabelText(TagCabecaLB[i], 0xFFFFFFFF, Str);
                            Delete3DTextLabel(TagCabecaLB[i]);
                        }
                    }
                    Delete3DTextLabel(TagCabecaLB[i]);
                    Pp[playerid][TemTagCab] = 0;
                    GameTextForPlayer(i, "~w~Tag ~g~Retirada", 1200, 1);
                    GameTextForPlayer(playerid, "~w~Tag ~r~Retirada", 1200, 1);
                    SendClientMessageEx(playerid, -1, "{FFD700}Tag: {FFFFFF}Voce retirou com sucesso a tagdo jogador: %s[%d]", PlayerName(i), Pp[i][IDF]);
                    SendClientMessageEx(playerid, -1, "{FFD700}Tag: {FFFFFF}Voce teve a tag resetada pelo admin: %s[%d]", PlayerName(playerid), Pp[playerid][IDF]);
                }
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e autorizado a usar este comando.");
    }
    return 1;
}
CMD:setvida(playerid, params[])
{
    if(Pp[playerid][Admin] >= 2)
	{
        new id, vida;
        if(sscanf(params, "ii", id, vida))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /setvida [IDF] [Porcentagem de Vida]");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
                    if(vida >= 1)
                    {
                        if(vida <= 100)
                        {
                            if(Pp[playerid][Admin] <= 3)
                            {
            			        if(id == Pp[playerid][IDF])
            			        {
            						SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Dar TP");
            			        }
                                else
                                {
                                    SetPlayerHealth(i, vida);
                                    GameTextForPlayer(i, "~w~Vida ~g~recebida", 1200, 1);
                                    GameTextForPlayer(playerid, "~w~Vida ~r~setada", 1200, 1);
                                    SCM(playerid, -1, "{00FF00}Vida: {FFFFFF}Voce setou vida para um jogador com sucesso!");
                                    SCM(playerid, -1, "{FFD700}Vida: {FFFFFF}Um admin setou vida para voce com sucesso");
                                }
                            }
                            else if(Pp[playerid][Admin] >= 4)
                            {
                                SetPlayerHealth(i, vida);
                                GameTextForPlayer(i, "~w~Vida ~g~recebida", 1200, 1);
                                GameTextForPlayer(playerid, "~w~Vida ~r~setada", 1200, 1);
                                SCM(playerid, -1, "{00FF00}Vida: {FFFFFF}Voce setou vida para um jogador com sucesso!");
                                SCM(playerid, -1, "{FFD700}Vida: {FFFFFF}Um admin setou vida para voce com sucesso");
                            }
                        }
                        else
                        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode setar vida menor que 1 e maior que 100.");
                        }
                    }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode setar vida menor que 1 e maior que 100.");
                    }
                }
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e autorizado a usar este comando.");
    }
    return 1;
}

