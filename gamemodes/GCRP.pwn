				{
					format(szTag, sizeof(szTag), "{F7EC6F}Grafite Tag #%i", i);
				}
				format(szDialog, sizeof(szDialog), "%s%s\n", szDialog, szTag);
			}
			ShowPlayerDialog(iPlayerID, GRAFITE_DELETE, DIALOG_STYLE_LIST, "{F7EC6F}Grafite Tag - {469BF0}Deletar suas tag's", szDialog, "Selecionar", "X");
		}
		case TYPE_LIST_TAGS_CREATE:
		{
			new
				szName[MAX_PLAYER_NAME]
			;

			GetPlayerName(iPlayerID, szName, sizeof szName);

			for(new i; i < MAX_PLAYERS_TAGS; i++)
			{
				new szTag[24];
				format(szTag, sizeof szTag, "{F7EC6F}Livre");
				if(GRAFITEs[iPlayerID][i][_spPosX] != 0.0 && GRAFITEs[iPlayerID][i][_spPosY] != 0.0)
				{
					format(szTag, sizeof(szTag), "{F7EC6F}Grafite Tag #%i", i);
				}
				format(szDialog, sizeof(szDialog), "%s%s\n", szDialog, szTag);
			}
			ShowPlayerDialog(iPlayerID, GRAFITE_CREATE, DIALOG_STYLE_LIST, "{F7EC6F}Grafite Tag - {469BF0}Selecione um slot livre", szDialog, "Selecionar", "X");
		}
		case TYPE_LIST_TAGS_FIND:
		{
			new
				szName[MAX_PLAYER_NAME]
			;

			GetPlayerName(iPlayerID, szName, sizeof szName);

			for(new i; i < MAX_PLAYERS_TAGS; i++)
			{
				new szTag[24];
				format(szTag, sizeof szTag, "{F7EC6F}Livre");
				if(GRAFITEs[iPlayerID][i][_spPosX] != 0.0 && GRAFITEs[iPlayerID][i][_spPosY] != 0.0)
				{
					format(szTag, sizeof(szTag), "{F7EC6F}Grafite Tag #%i", i);
				}
				format(szDialog, sizeof(szDialog), "%s%s\n", szDialog, szTag);
			}
			ShowPlayerDialog(iPlayerID, GRAFITE_FIND, DIALOG_STYLE_LIST, "{F7EC6F}Grafite Tag - {469BF0}Selecione a tag que voce deseja encontrar", szDialog, "Selecionar", "X");
		}
	}
	return 1;
}
forward GRAFITE(playerid, type);
public GRAFITE(playerid, type)
{
	new
		iIndex = GRAFITE_slot[playerid]
	;

	if(!IsPlayerConnected(playerid))
	{
		GRAFITE_timer_left[playerid] = 0;
		DeletePVar(playerid, "GRAFITE_EDIT");
		KillTimer(GRAFITE_timer[playerid]);
		return 1;
	}

	GRAFITE_timer_left[playerid]--;

	switch(type)
	{
		case 1:
		{
			if(GRAFITE_timer_left[playerid] == 0)
			{
				DestroyDynamicObject(GRAFITEs[playerid][iIndex][_spObject]);
				DestroyDynamicObject(GRAFITE_object[playerid]);

				format(GRAFITEs[playerid][iIndex][_spText], 50, GRAFITE_text[playerid]);
				format(GRAFITEs[playerid][iIndex][_spFont], 50, GRAFITE_font[playerid]);

				GRAFITEs[playerid][iIndex][_spPosX] = GRAFITE_positions[playerid][0];
				GRAFITEs[playerid][iIndex][_spPosY] = GRAFITE_positions[playerid][1];
				GRAFITEs[playerid][iIndex][_spPosZ] = GRAFITE_positions[playerid][2];
				GRAFITEs[playerid][iIndex][_spPosRX] = GRAFITE_positions[playerid][3];
				GRAFITEs[playerid][iIndex][_spPosRY] = GRAFITE_positions[playerid][4];
				GRAFITEs[playerid][iIndex][_spPosRZ] = GRAFITE_positions[playerid][5];
				GRAFITEs[playerid][iIndex][_spFontColor] = GRAFITE_color[playerid];
				GRAFITEs[playerid][iIndex][_spFontSize] = GRAFITE_size[playerid];
				GRAFITEs[playerid][iIndex][_spBold] = GRAFITE_bold[playerid];

				GRAFITE_Spawn(playerid, iIndex);
				Tags_Save(playerid, iIndex);

				ClearAnimations(playerid);
				ApplyAnimation(playerid, "GRAFFITI", "graffiti_Chkout", 4.0, 0, 0, 0, 0, 0, 1);
				KillTimer(GRAFITE_timer[playerid]);
			}
		}
		case 2:
		{
			if(GRAFITE_timer_left[playerid] == 0)
			{
				GRAFITE_Create(playerid, GRAFITE_slot[playerid]);
				ClearAnimations(playerid);
				ApplyAnimation(playerid, "GRAFFITI", "graffiti_Chkout", 4.0, 0, 0, 0, 0, 0, 1);
				KillTimer(GRAFITE_timer[playerid]);
			}
		}
	}
	DeletePVar(playerid, "GRAFITE_EDIT");
	return 1;
}
CallBack:: DarLoterica()
{
    OOCNews(0x33CCFFAA, "{FFFFFF}Loterica: O sorteio {FFD700}premiado {FFFFFF}comecou!");
    new rand = random(80);
    if (rand < 77)
    {
        rand += 3;
    }
    Lotto(rand);
    return 1;
}
CallBack:: PayDay(playerid)
{
    new string[450];
	if(Pp[playerid][Logado] == true)
	{
	    if(Pp[playerid][Vip] == 1)
	    {
	        GameTextForPlayer(playerid, "~y~Pagamento", 2000, 1);
	        SCM(playerid, -1, "{FFFFFF}>>>>>>>>>> Dia de Pagamentos{FFDC33}[VIP]{FFFFFF} <<<<<<<<<<");
	        SCM(playerid, -1, "{FFFFFF}Pagamento: {00FF00}R$600");
	        SCM(playerid, -1, "{FFFFFF}Imposto I.N.SS: {FFD700}-R$150");
	        SendClientMessageEx(playerid, -1, "{FFFFFF}Contribuicao de Luz: {FFD700}-R$%d", Impostos[IluminacaoG]);
	        GivePlayerCash(playerid, 600);
	        GivePlayerCash(playerid, -150);
	        GivePlayerCash(playerid, -Impostos[IluminacaoG]);
	        Impostos[DinheiroDispGov] += Impostos[IluminacaoG];
		}
		if(Pp[playerid][Vip] == 2)
	    {
	        GameTextForPlayer(playerid, "~y~Pagamento", 2000, 1);
	        SCM(playerid, -1, "{FFFFFF}>>>>>>>>>> Dia de Pagamentos{FFDC33}[VIP]{FFFFFF} <<<<<<<<<<");
	        SCM(playerid, -1, "{FFFFFF}Pagamento: {00FF00}R$650");
	        SCM(playerid, -1, "{FFFFFF}Imposto I.N.SS: {FFD700}-R$150");
	        SendClientMessageEx(playerid, -1, "{FFFFFF}Contribuicao de Luz: {FFD700}-R$%d", Impostos[IluminacaoG]);
	        GivePlayerCash(playerid, 650);
	        GivePlayerCash(playerid, -150);
	        //GivePlayerCash(i, -Impostos[ImpostoDeRendaG]);
	        GivePlayerCash(playerid, -Impostos[IluminacaoG]);
	        Impostos[DinheiroDispGov] += Impostos[IluminacaoG];
		}
		if(Pp[playerid][Vip] == 3)
	    {
	        GameTextForPlayer(playerid, "~y~Pagamento", 2000, 1);
	        SCM(playerid, -1, "{FFFFFF}>>>>>>>>>> Dia de Pagamentos{FFDC33}[VIP]{FFFFFF} <<<<<<<<<<");
	        SCM(playerid, -1, "{FFFFFF}Pagamento: {00FF00}R$760");
	        SCM(playerid, -1, "{FFFFFF}Imposto I.N.SS: {FFD700}-R$150");
	        SendClientMessageEx(playerid, -1, "{FFFFFF}Contribuicao de Luz: {FFD700}-R$%d", Impostos[IluminacaoG]);
	        GivePlayerCash(playerid, 760);
	        GivePlayerCash(playerid, -150);
	        GivePlayerCash(playerid, -Impostos[IluminacaoG]);
	        Impostos[DinheiroDispGov] += Impostos[IluminacaoG];
		}
		if(Pp[playerid][Vip] == 4)
	    {
	        GameTextForPlayer(playerid, "~y~Pagamento", 2000, 1);
	        SCM(playerid, -1, "{FFFFFF}>>>>>>>>>> Dia de Pagamentos{FFDC33}[VIP]{FFFFFF} <<<<<<<<<<");
	        SCM(playerid, -1, "{FFFFFF}Pagamento: {00FF00}R$900");
	        SCM(playerid, -1, "{FFFFFF}Imposto I.N.SS: {FFD700}-R$150");
	        SendClientMessageEx(playerid, -1, "{FFFFFF}Contribuicao de Luz: {FFD700}-R$%d", Impostos[IluminacaoG]);
	        GivePlayerCash(playerid, 900);
	        GivePlayerCash(playerid, -150);
	        GivePlayerCash(playerid, -Impostos[IluminacaoG]);
	        Impostos[DinheiroDispGov] += Impostos[IluminacaoG];
		}
		if(Pp[playerid][Vip] == 5)
	    {
	        GameTextForPlayer(playerid, "~y~Pagamento", 2000, 1);
	        SCM(playerid, -1, "{FFFFFF}>>>>>>>>>> Dia de Pagamentos{FFDC33}[VIP]{FFFFFF} <<<<<<<<<<");
	        SCM(playerid, -1, "{FFFFFF}Pagamento: {00FF00}R$1100");
	        SCM(playerid, -1, "{FFFFFF}Imposto I.N.SS: {FFD700}-R$150");
	        SendClientMessageEx(playerid, -1, "{FFFFFF}Contribuicao de Luz: {FFD700}-R$%d", Impostos[IluminacaoG]);
	        GivePlayerCash(playerid, 1100);
	        GivePlayerCash(playerid, -150);
	        //GivePlayerCash(i, -Impostos[ImpostoDeRendaG]);
	        GivePlayerCash(playerid, -Impostos[IluminacaoG]);
	        Impostos[DinheiroDispGov] += Impostos[IluminacaoG];
		}
		if(IsPolicial(playerid))
		{
            GameTextForPlayer(playerid, "~y~Pagamento", 2000, 1);
			SCM(playerid, -1, "{FFFFFF}>>>>>>>>>> Dia de Pagamentos <<<<<<<<<<");
			SendClientMessageEx(playerid, -1, "{708090}Pagamento: {00FF00}R$%d", Impostos[SalarioCorpsG]);
			SCM(playerid, -1, "{FFFFFF}Imposto I.N.SS: {FFD700}-R$50");
            SCM(playerid, -1, "{FFFFFF}Salario Extra: {00FF00}R$1200 + R$1200 No Banco");
			SendClientMessageEx(playerid, -1, "{FFFFFF}Imposto de Renda: {FFD700}-R$%d", Impostos[ImpostoDeRendaG]);
			SendClientMessageEx(playerid, -1, "{FFFFFF}Contribuicao de Luz: {FFD700}-R$%d", Impostos[IluminacaoG]);
			GivePlayerCash(playerid, Impostos[SalarioCorpsG]);
			GivePlayerCash(playerid, -50);
            GivePlayerCash(playerid, 1200);
            Pp[playerid][SaldoBancario] += 1200;
			GivePlayerCash(playerid, -Impostos[ImpostoDeRendaG]);
	        GivePlayerCash(playerid, -Impostos[IluminacaoG]);
	        Impostos[DinheiroDispGov] += Impostos[ImpostoDeRendaG];
	        Impostos[DinheiroDispGov] -= Impostos[SalarioCorpsG];
		}
		else
		{
            GameTextForPlayer(playerid, "~y~Pagamento", 2000, 1);
        	SCM(playerid, -1, "{FFFFFF}>>>>>>>>>> Dia de Pagamentos <<<<<<<<<<");
			SCM(playerid, -1, "{FFFFFF}Pagamento: {00FF00}R$500");
			SCM(playerid, -1, "{FFFFFF}Imposto I.N.SS: {FFD700}-R$150");
			SendClientMessageEx(playerid, -1, "{FFFFFF}Contribuicao de Luz: {FFD700}-R$%d", Impostos[IluminacaoG]);
			GivePlayerCash(playerid, 500);
			GivePlayerCash(playerid, -150);
		    GivePlayerCash(playerid, -Impostos[IluminacaoG]);
		    Impostos[DinheiroDispGov] += Impostos[IluminacaoG];
		}
		Pp[playerid][NumeroPayday] ++;
		Pp[playerid][Caixinha] = 0;

		format(string, sizeof(string), "{FFDC33}+XP: {FFFFFF}Voce ganhou +1 de XP e agora esta com: {FFDC33}(%02d/05)", Pp[playerid][NumeroPayday]);
		SCM(playerid, -1, string);
		format(string, sizeof(string), "{FFFFFF}{FFFFFF}Voce ja pode Pegar uma Caixinha de Presentes Na Praca do {FFD700}Gold City Roleplay");
		SCM(playerid, -1, string);
		GameTextForPlayer(playerid, "~w~+XP", 5000, 6);

		if(Pp[playerid][NumeroPayday] >= 5)
		{
			Pp[playerid][NumeroPayday] = 0;

			Score[playerid] = GetPlayerScore(playerid);
			Score[playerid] += 1;
			SetPlayerScore(playerid, Score[playerid]);

			format(string, sizeof(string), "{00FF00}+UP: {FFFFFF}Voce upou de nivel e agora esta com o nivel: {FFDC33}%d", Score[playerid]);
			SCM(playerid, COR_VERDE, string);
			GameTextForPlayer(playerid, "~p~+UP", 5000, 6);
		}
	}
	return 1;
}

