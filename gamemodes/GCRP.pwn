                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem o seu Documento RG, Faca-o no Prefeitura. /gps - Locais Gerais - Prefeitura"), GameTextForPlayer(playerid, "~w~Voce nao tem ~r~RG", 3000, 1);
        		}
            }
        }
        // Comandos com tecla F
        if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
        {
            if(Pp[playerid][FezRg] == 1)
            {
                if(Pp[playerid][FezBanco] == 1)
                {
                	for(new i = 1; i < MAX_CAIXAS; i++)
                	{
                		if(ISP(playerid, 2.0, CaixaInfo[i][CaixaPosX], CaixaInfo[i][CaixaPosY], CaixaInfo[i][CaixaPosZ]))
                		{
                			if(CaixaInfo[i][CaixaExplodido] == false)
                			{
                			    if(BancoDinheiro >= 1000000)
                	    		{
                                    new str[5000];
                                    //Nome da Conta
                                    format(str,sizeof(str),"%s", PlayerName(playerid));
                                    PlayerTextDrawSetString(playerid, TextDrawCaixaL[playerid][15], str); //ok
                                    //Saldo
                                    format(str,sizeof(str),"%d", Pp[playerid][SaldoBancario]);
                                    PlayerTextDrawSetString(playerid, TextDrawCaixaL[playerid][18], str); //ok
                                    for(new i2; i2 < 57; i2++)
                                	{
                                	   PlayerTextDrawShow(playerid, TextDrawCaixaL[playerid][i2]);
                                	}
                                    SelectTextDraw(playerid, 0x8B008BFF);
                				    return 1;
                				}
                				else
                				{
                				    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Os Servicos do Caixa ou Banco Central Estao Indisponiveis");
                				}
                			}
                			else
                			{
                			    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Caixa esta Indisponivel");
                			    return 1;
                			}
                		}
                	}
                    if(ISP(playerid, 2.0, 1103.7688,1047.3889,-19.9389) || ISP(playerid, 2.0, 1103.7703,1049.2257,-19.9389) || ISP(playerid, 2.0, 1103.7699,1051.0447,-19.9389)
                    || ISP(playerid, 2.0, 1103.7697,1052.9148,-19.9389) || ISP(playerid, 2.0, 1103.7710,1055.2539,-19.9389)  || ISP(playerid, 2.0, 217.7926, 185.8191, 1003.0259)
                    || ISP(playerid, 2.0, 215.8953, 185.9318, 1003.0259) || ISP(playerid, 2.0, 832.7274,-1425.1676,13.6611))
                	{
                		if(BancoDinheiro >= 1000000)
                   		{
                            new str[5000];
                            //Nome da Conta
                            format(str,sizeof(str),"%s", PlayerName(playerid));
                            PlayerTextDrawSetString(playerid, TextDrawCaixaL[playerid][15], str); //ok
                            //Saldo
                            format(str,sizeof(str),"%d", Pp[playerid][SaldoBancario]);
                            PlayerTextDrawSetString(playerid, TextDrawCaixaL[playerid][18], str); //ok
                            for(new i2; i2 < 57; i2++)
                        	{
                        	   PlayerTextDrawShow(playerid, TextDrawCaixaL[playerid][i2]);
                        	}
                            SelectTextDraw(playerid, 0x8B008BFF);
                			return 1;
                		}
                		else
                		{
                			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Os Servicos do Caixa ou Banco Central Estao Indisponiveis");
                		}
                	}
                }
            }
            cmd_comprarpecas(playerid);
            cmd_pegarcc(playerid);
            cmd_descarregarcc(playerid);
            cmd_spvprof(playerid);
            cmd_cassino(playerid);
            cmd_ammunation(playerid);
            cmd_lanches(playerid);
        }
	}
    if(newkeys == KEY_YES)
    {// Clicar Y
        if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	    {
            for(new i; i < MAX_ORGS; i++)
      		{
    			if(ISP(playerid, 2.0, OrgInfo[i][PickupX], OrgInfo[i][PickupY], OrgInfo[i][PickupZ]))
    			{
    				if(Pp[playerid][OrgLider] == i || Pp[playerid][OrgSubLider] == i || Pp[playerid][OrgMembro] == i)
    				{
    					if(IsPolicial(playerid))
    					{
    						dialog_orgid[playerid] = i;
    						ShowPlayerDialog(playerid, DIALOG_INFORG, DIALOG_STYLE_LIST, "Corporacao",
    						"{FFD700}1. {FFFFFF}Org-{FFD700}informacoes\n\
    						 {FFD700}2. {FFFFFF}Pegar Equipamentos\n\
    						 {FFD700}3. {FFFFFF}Entregar Equipamentos\n\
    						 {FFD700}4. {FFFFFF}Pegar {00FF00}Uniforme\n\
    						 {FFD700}5. {FFFFFF}Entregar Uniforme\n\
    						 {FFD700}6. {FFFFFF}Pegar Radio da Corp\n\
    						 {FFD700}7. {FFFFFF}Pegar Radio COPOM\n\
                             {FFD700}8. {FFFFFF}Fardas dos Batalhoes\n\
                             {FFD700}9. {FFFFFF}Armas {FFDC33}Auxiliares\n\
                             {FFD700}10. {FFFFFF}Comandos utilizaveis", "Selecionar", "X");
    					}
                        else if(Pp[playerid][OrgLider] == 43 || Pp[playerid][OrgSubLider] == 43 || Pp[playerid][OrgMembro] == 43)
    					{
                            dialog_orgid[playerid] = i;
    						ShowPlayerDialog(playerid, DIALOG_INFORG44, DIALOG_STYLE_LIST, "Corporacao",
    						"{FFD700}1. {FFFFFF}Org-informacoes\n\
    						 {FFD700}2. {FFFFFF}Pegar Equipamentos\n\
    						 {FFD700}3. {FFFFFF}Entregar Equipamentos\n\
    						 {FFD700}4. {FFFFFF}Pegar Uniforme\n\
    						 {FFD700}5. {FFFFFF}Entregar Uniforme\n\
                             {FFD700}6. {FFFFFF}Comandos utilizaveis", "Selecionar", "X");
                        }
    					else if(IsBandido(playerid))
    					{
                            if(Pp[playerid][OrgLider] == 28 || Pp[playerid][OrgSubLider] == 28 || Pp[playerid][OrgMembro] == 28)
                            {
                                dialog_orgid[playerid] = i;
    						    ShowPlayerDialog(playerid, DIALOG_INFORG7, DIALOG_STYLE_LIST, "Organizacao","{FFD700}1. {FFFFFF}Org-Membros\n{FFD700}2. {FFFFFF}Ir Para a Fazenda\n{FFD700}3. {FFFFFF}Comandos utilizaveis\n{FFD700}4. {FFFFFF}Equipar colete", "Selecionar", "X");
                            }
                            else
                            {
                                dialog_orgid[playerid] = i;
    						    ShowPlayerDialog(playerid, DIALOG_INFORG1, DIALOG_STYLE_LIST, "Organizacao","{FFD700}1. {FFFFFF}Org-Membros\n{FFD700}2. {FFFFFF}Comandos utilizaveis\n{FFD700}3. {FFFFFF}Equipar colete", "Selecionar", "X");
                            }
    					}
    					else
    					{
    						SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pertence a esta organizacao.");
    					}
    				}
    			}
    		}
            for(new i; i < MAX_EMPRESAS; i++)
    		{
    			if(ISP(playerid, 5.0, EmPp[i][EmpresaX], EmPp[i][EmpresaY], EmPp[i][EmpresaZ]))
    			{
    				if(!strcmp(EmPp[i][EmpresaDono], "Nenhum", true))
    				{
    					new stg[1100];
    					format(gstring, sizeof(gstring), "{FFD700}Empresa Numero:{FFFFFF} %d.\n", EmPp[i][EmpresaId]);
    					strcat(stg, gstring);
    					format(gstring, sizeof(gstring), "{FFD700}Dono:{FFFFFF} %s.\n", EmPp[i][EmpresaDono]);
    					strcat(stg, gstring);
    					format(gstring, sizeof(gstring), "{FFD700}Valor:{00FF00} %d.\n", EmPp[i][EmpresaValor]);
    					strcat(stg, gstring);
    					strcat(stg, "{FFD700}1. {FFFFFF}Entrar Empresa.\n");
    					strcat(stg, "{FFD700}2. {FFFFFF}Comprar Empresa.\n");

    					ShowPlayerDialog(playerid, DIALOG_EMPRESA, DIALOG_STYLE_INPUT, "{FFFFFF}Empresa", stg, "Selecionar", "X");
    					return 1;
    				}
    				else
    				{
    					new stg[1100];
    					format(gstring, sizeof(gstring), "{FFD700}Empresa Numero:{FFFFFF} %d.\n", EmPp[i][EmpresaId]);
    					strcat(stg, gstring);
    					format(gstring, sizeof(gstring), "{FFD700}Dono:{FFFFFF} %s.\n", EmPp[i][EmpresaDono]);
    					strcat(stg, gstring);
    					strcat(stg, "{FFD700}1. {FFFFFF}Entrar Empresa.\n");

    					ShowPlayerDialog(playerid, DIALOG_EMPRESA1, DIALOG_STYLE_INPUT, "{FFFFFF}Empresa", stg, "Selecionar", "X");
    					return 1;
    				}
    			}
    			if(ISP(playerid, 5.0, EmPp[i][EmpresaInteriorX], EmPp[i][EmpresaInteriorY], EmPp[i][EmpresaInteriorZ]))
    			{
    				SetPlayerInterior(playerid, 0);
    				SetPlayerVirtualWorld(playerid, 0);
    				SetPlayerPos(playerid, EmPp[Pp[playerid][Entrada]][EmpresaX], EmPp[Pp[playerid][Entrada]][EmpresaY], EmPp[Pp[playerid][Entrada]][EmpresaZ]);
    				return 1;
    			}
            }
            for(new c; c < MAX_CASAS; c++)
    		{
    			if(ISP(playerid, 5.0, CasaInfo[c][CasaX], CasaInfo[c][CasaY], CasaInfo[c][CasaZ]))
    			{
    				if(!strcmp(CasaInfo[c][CasaDono], "Nenhum", true))
    				{
    					new stg[1100];
    					format(gstring, sizeof(gstring), "{FFD700}Casa Numero:{FFFFFF} %d\n\n", CasaInfo[c][CasaId]);
    					strcat(stg, gstring);
    					format(gstring, sizeof(gstring), "{FFD700}Dono:{FFFFFF} %s\n", CasaInfo[c][CasaDono]);
    					strcat(stg, gstring);
    					format(gstring, sizeof(gstring), "{FFD700}Preco:{00FF00} %d\n\n", CasaInfo[c][CasaValor]);
    					strcat(stg, gstring);

    					strcat(stg, "{FFD700}1. {FFFFFF}Entrar Casa\n");
    					strcat(stg, "{FFD700}2. {FFFFFF}Comprar Casa\n");

    					ShowPlayerDialog(playerid, DIALOG_CASAS, DIALOG_STYLE_INPUT, "{FFFFFF}Casa", stg, "Selecionar", "X");
    					return 1;
    				}
    				else
    				{
    					new stg[1100];
    					format(gstring, sizeof(gstring), "{FFD700}Casa Numero:{FFFFFF} %d\n\n", CasaInfo[c][CasaId]);
    					strcat(stg, gstring);
    					format(gstring, sizeof(gstring), "{FFD700}Dono:{FFFFFF} %s\n", CasaInfo[c][CasaDono]);
    					strcat(stg, gstring);
    					format(gstring, sizeof(gstring), "{FFD700}Status:{00FF00} Destrancada\n\n");
    					strcat(stg, gstring);

    					strcat(stg, "{FFD700}1. {FFFFFF}Entrar Casa\n");
    					strcat(stg, "{FFD700}2. {FFFFFF}Comprar Casa\n");

    					ShowPlayerDialog(playerid, DIALOG_CASAS, DIALOG_STYLE_INPUT, "{FFFFFF}Casa", stg, "Selecionar", "X");
    					return 1;
    				}
    			}
    			if(ISP(playerid, 5.0, CasaInfo[c][CasaInteriorX], CasaInfo[c][CasaInteriorY], CasaInfo[c][CasaInteriorZ]))
    			{
    				SetPlayerInterior(playerid, 0);
    				SetPlayerVirtualWorld(playerid, 0);
    				SetPlayerPos(playerid, CasaInfo[Pp[playerid][Entrada]][CasaX], CasaInfo[Pp[playerid][Entrada]][CasaY], CasaInfo[Pp[playerid][Entrada]][CasaZ]);
                    //Carregamento
    	   		    SetTimerEx("CarregandoObjetos", 5000, false, "d", playerid);
                    for(new i = 1; i < 3; i++){PlayerTextDrawShow(playerid, TdCarregarINT[playerid][i]);}
    	   		    Controle(playerid, 0);
                    return 1;
    			}
    		}
        }
        if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	    {
            if(VeiculoSpawnado[playerid] == 1)
            {
                new Float:CarregarVeh[3];
                GetVehiclePos(VehConce[playerid], CarregarVeh[0], CarregarVeh[1], CarregarVeh[2]);
                if(ISP(playerid, 5.0, CarregarVeh[0], CarregarVeh[1], CarregarVeh[2]))
	    		{
                    new StrConce[5000];
        			strcat(StrConce,  "{FFD700}1. {FFFFFF}Estacionar Veiculo\n");
        			strcat(StrConce,  "{FFD700}2. {FFFFFF}Spawnar Veiculo\n");
        			strcat(StrConce,  "{FFD700}3. {FFFFFF}Localizar Veiculo\n");
        			strcat(StrConce,  "{FFD700}4. {FFFFFF}Remover Veiculo\n");
        			strcat(StrConce,  "{FFD700}5. {FFFFFF}Trancar Veiculo\n");
        			strcat(StrConce,  "{FFD700}6. {FFFFFF}Destrancar Veiculo\n");
        			strcat(StrConce,  "{FFD700}7. {FFFFFF}Capo do Veiculo\n");
        			strcat(StrConce,  "{FFD700}8. {FFFFFF}Porta Malas do Veiculo\n");
        			strcat(StrConce,  "{FFD700}9. {FFFFFF}Mecher no Porta Malas\n");
        			ShowPlayerDialog(playerid, DIALOG_MENUCARRO, DIALOG_STYLE_LIST, "{FFFFFF}Menu do {FFD700}Veiculo", StrConce, "Confirmar ","Fechar");
                }
                else
                {
                    cmd_guardaritem(playerid);
                }
            }
            else if(VeiculoSpawnado[playerid] == 0)
            {
                cmd_guardaritem(playerid);
            }
	    }
        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
            new Float:Heath;
            new carroa = GetPlayerVehicleID(playerid);
            new
				lu,
				alar,
				por,
				cap,
				porma,
				ob
			;
			GetVehicleHealth(carroa, Float:Heath);
            if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 509 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 481 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 510)
			{
				return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este veiculo nao possui motor.");
			}
			else if(Heath <= 251)
			{
				return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}O Veiculo esta quebrado.");
			}
			else if(Combustivel[carroa] == 0)
			{
			    return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}O Veiculo esta Sem Gasolina.");
			}
			else
			{

        		if(!IsPlayerInAnyVehicle(playerid)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um Veiculo");
        		if(motor[carroa] == false)
        		{
        		    motor[carroa] = true;

                    PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "Ligado.");
                    PlayerTextDrawShow(playerid, TextDrawAviso3[playerid][0]);
                    SetTimerEx("TirarTD22", 2000, false, "i", playerid);

					new string[1200];
					format(string, sizeof(string), "* O ID: [%d] Gira a chave e liga o motor de seu veiculo.", Pp[playerid][IDF]);
		    		ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
       				SetVehicleParamsEx( carroa, VEHICLE_PARAMS_ON, lu, alar, por, cap, porma, ob );

       				new engine, lights, alarm, doors, bonnet, boot, objective;
					GetVehicleParamsEx(carroa, engine, lights, alarm, doors, bonnet, boot, objective);

       				if(luzes[carroa] == true)
					{
						SetVehicleParamsEx(carroa, engine, VEHICLE_PARAMS_OFF, alarm, doors, bonnet, boot, objective);
						luzes[carroa] = false;
					}
					else if(luzes[carroa] == false)
					{
						SetVehicleParamsEx(carroa, engine, VEHICLE_PARAMS_ON, alarm, doors, bonnet, boot, objective);
						luzes[carroa] = true;
					}
        			return 1;
        		}
        		else
        		{
        		    motor[carroa] = false;

                    PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "Desligado.");
                    PlayerTextDrawShow(playerid, TextDrawAviso3[playerid][0]);
                    SetTimerEx("TirarTD22", 2000, false, "i", playerid);

					new string[1200];
					format(string, sizeof(string), "* O ID: [%d] Girou a chave e desligou o motor de seu veiculo.", Pp[playerid][IDF]);
		    		ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
       				SetVehicleParamsEx(carroa, VEHICLE_PARAMS_OFF, lu, alar, por, cap, porma, ob);

                    new engine, lights, alarm, doors, bonnet, boot, objective;
					GetVehicleParamsEx(carroa, engine, lights, alarm, doors, bonnet, boot, objective);

					SetVehicleParamsEx(carroa, engine, VEHICLE_PARAMS_OFF, alarm, doors, bonnet, boot, objective);
					luzes[carroa] = false;
        			return 1;
        		}
            }
    	}
        else
        {
            cmd_mercadon(playerid);
            cmd_mudarimpostos(playerid);
        }
    }
	if(newkeys == KEY_NO)
	{
		cmd_mochila(playerid);
	}
	return 1;
}

public OnRconLoginAttempt(ip[], password[], success)
{
	new name[MAX_PLAYER_NAME],pip[16];
 	for(new i=0; i<MAX_PLAYERS; i++)
  	{
   		GetPlayerIp(i, pip, sizeof(pip));
     	if(!strcmp(ip, pip, true))
      	{
       		GetPlayerName(i, name, sizeof(name));
         	if(strcmp(name,"Scoffield_K",false) || strcmp(name,"Red_Cookie",false) || strcmp(name,"Gabriel_Gaspar",false))
          	{
           		SendClientMessage(i,-1,"{FFD700}[ RCON ]: {FFFFFF}Voce nao esta autorizado a Logar na Rcon PnRp");
           		format(gstring, sizeof(gstring), "O Player %s Foi Kickado Por Apxgui_StaffAux [Motivo: Tentando Logar Rcon]", PlayerName(i));
                SendClientMessageToAll(COLOR_LIGHTRED, gstring);
             	Kick(i);
                return 1;
           	}
		}
	}
    return 1;
}
public OnPlayerUpdate(playerid)
{
    //=-=-=-=-=-=-=-=-=-=-= SISTEMA DE ARMAS NAS COSTAS =-=-=-=-=-=-=-=-=-=-=//
    if(!IsPlayerInAnyVehicle(playerid))
	{
    	new Armas[MAX_PLAYERS],Balas[MAX_PLAYERS];
    	GetPlayerWeaponData(playerid, 5, Armas[playerid], Balas[playerid]);
		if(Armas[playerid] == 30 && Balas[playerid] >= 1)//Ak-47
		{
            if(GetPlayerWeapon(playerid) == 30) RemovePlayerAttachedObject(playerid,SlotAKeFUZIL);
            else SetPlayerAttachedObject(playerid, SlotAKeFUZIL, 355, 1, -0.060921, -0.141673, 0.000000, 0.000000, 35.362735, 0.000000);
		}
		else if(Armas[playerid] == 31 && Balas[playerid] >= 1) //M4
		{
			if(GetPlayerWeapon(playerid) == 31) RemovePlayerAttachedObject(playerid,SlotAKeFUZIL);
            else SetPlayerAttachedObject(playerid, SlotAKeFUZIL, 356, 1, 0.0709, 0.1829, -0.0829, 172.1000, 144.9999, -0.9999, 1.0000, 1.0000, 1.0000);
		}
		else
		{
            RemovePlayerAttachedObject(playerid,SlotAKeFUZIL);
		}
    }
    //=-=-=-=-=-=-=-=-=-=-= SISTEMA DE ANT-CHEAT =-=-=-=-=-=-=-=-=-=-=//
    new String[220];
    for(new i; i < MAX_PLAYERS; i++)
    {
        if(Pp[i][Admin] == 0)
        {
        	switch(GetPlayerWeapon(i))
         	{
          		case 38:// 1
            	{
             		format(String,sizeof(String),"O Player: %s Foi Banido por NPC_AntHack Pelo Motivo Weapon Hack",PlayerName(i), playerid);
    				SendClientMessageToAll(COLOR_LIGHTRED, String);
    				GameTextForPlayer(i, "~w~Ant ~r~Weapon Hack", 3000, 3);
    	            ResetPlayerWeapons(i);
                 	BanEx(i,"Weapon Hack");
        		}
       			case 9:// 2
    			{
       				format(String,sizeof(String),"O Player: %s Foi Banido por NPC_AntHack Pelo Motivo Weapon Hack",PlayerName(i), playerid);
    				SendClientMessageToAll(COLOR_LIGHTRED, String);
    				GameTextForPlayer(i, "~w~Ant ~r~Weapon Hack", 3000, 3);
        			ResetPlayerWeapons(i);
           			BanEx(i,"Weapon Hack");
         		}
         		case 18:// 3
         		{
          			format(String,sizeof(String),"O Player: %s Foi Banido por NPC_AntHack Pelo Motivo Weapon Hack",PlayerName(i), playerid);
    				SendClientMessageToAll(COLOR_LIGHTRED, String);
    				GameTextForPlayer(i, "~w~Ant ~r~Weapon Hack", 3000, 3);
        			ResetPlayerWeapons(i);
        			BanEx(i,"Weapon Hack");
         		}
         		case 32:// 4
         		{
           			format(String,sizeof(String),"O Player: %s Foi Banido por NPC_AntHack Pelo Motivo Weapon Hack",PlayerName(i), playerid);
    				SendClientMessageToAll(COLOR_LIGHTRED, String);
    				GameTextForPlayer(i, "~w~Ant ~r~Weapon Hack", 3000, 3);
        			ResetPlayerWeapons(i);
        			BanEx(i,"Weapon Hack");
         		}
         		case 33:// 5
         		{
           			format(String,sizeof(String),"O Player: %s Foi Banido por NPC_AntHack Pelo Motivo Weapon Hack",PlayerName(i), playerid);
    				SendClientMessageToAll(COLOR_LIGHTRED, String);
    				GameTextForPlayer(i, "~w~Ant ~r~Weapon Hack", 3000, 3);
        			ResetPlayerWeapons(i);
        			BanEx(i,"Weapon Hack");
         		}
      		 	case 35:// 7
         		{
           			format(String,sizeof(String),"O Player: %s Foi Banido por NPC_AntHack Pelo Motivo Weapon Hack",PlayerName(i), playerid);
    				SendClientMessageToAll(COLOR_LIGHTRED, String);
    				GameTextForPlayer(i, "~w~Ant ~r~Weapon Hack", 3000, 3);
        			ResetPlayerWeapons(i);
        			BanEx(i,"Weapon Hack");
         		}
         		case 36:// 8
         		{
           			format(String,sizeof(String),"O Player: %s Foi Banido por NPC_AntHack Pelo Motivo Weapon Hack",PlayerName(i), playerid);
    				SendClientMessageToAll(COLOR_LIGHTRED, String);
    				GameTextForPlayer(i, "~w~Ant ~r~Weapon Hack", 3000, 3);
        			ResetPlayerWeapons(i);
        			BanEx(i,"Weapon Hack");
         		}
         		case 37:// 9
         		{
       				format(String,sizeof(String),"O Player: %s Foi Banido por NPC_AntHack Pelo Motivo Weapon Hack",PlayerName(i), playerid);
    				SendClientMessageToAll(COLOR_LIGHTRED, String);
    				GameTextForPlayer(i, "~w~Ant ~r~Weapon Hack", 3000, 3);
        			ResetPlayerWeapons(i);
        			BanEx(i,"Weapon Hack");
         		}
         		case 39:// 10
         		{
        		 	format(String,sizeof(String),"O Player: %s Foi Banido por NPC_AntHack Pelo Motivo Weapon Hack",PlayerName(i), playerid);
    				SendClientMessageToAll(COLOR_LIGHTRED, String);
    				GameTextForPlayer(i, "~w~Ant ~r~Weapon Hack", 3000, 3);
        			ResetPlayerWeapons(i);
        			BanEx(i,"Weapon Hack");
         		}
         		case 8:// 11
         		{
           			format(String,sizeof(String),"O Player: %s Foi Banido por NPC_AntHack Pelo Motivo Weapon Hack",PlayerName(i), playerid);
    				SendClientMessageToAll(COLOR_LIGHTRED, String);
    				GameTextForPlayer(i, "~w~Ant ~r~Weapon Hack", 3000, 3);
        			ResetPlayerWeapons(i);
        			BanEx(i,"Weapon Hack");
         		}
         		case 7:// 12
         		{
           			format(String,sizeof(String),"O Player: %s Foi Banido por NPC_AntHack Pelo Motivo Weapon Hack",PlayerName(i), playerid);
    				SendClientMessageToAll(COLOR_LIGHTRED, String);
    				GameTextForPlayer(i, "~w~Ant ~r~Weapon Hack", 3000, 3);
        			ResetPlayerWeapons(i);
        			BanEx(i,"Weapon Hack");
         		}
      		 	case 44:// 13
         		{
           			format(String,sizeof(String),"O Player: %s Foi Banido por NPC_AntHack Pelo Motivo Weapon Hack",PlayerName(i), playerid);
    				SendClientMessageToAll(COLOR_LIGHTRED, String);
    				GameTextForPlayer(i, "~w~Ant ~r~Weapon Hack", 3000, 3);
        			ResetPlayerWeapons(i);
        			BanEx(i,"Weapon Hack");
         		}
         		case 45:// 14
         		{
           			format(String,sizeof(String),"O Player: %s Foi Banido por NPC_AntHack Pelo Motivo Weapon Hack",PlayerName(i), playerid);
    				SendClientMessageToAll(COLOR_LIGHTRED, String);
    				GameTextForPlayer(i, "~w~Ant ~r~Weapon Hack", 3000, 3);
        			ResetPlayerWeapons(i);
         			BanEx(i,"Weapon Hack");
         		}
         	}
        }
	}
    //RETIRANDO ARMAS SEM PORTES
 	new h2 = GetPlayerWeapon(playerid);
 	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		if(h2 >= 16)
		{
		    if(IsPolicial(playerid))
		    {
		        return 1;
		    }
		    else if(IsBandido(playerid))
		    {
		        return 1;
		    }
		 	else if(Pp[playerid][OrgLider] == 0 || Pp[playerid][OrgSubLider] == 0 || Pp[playerid][OrgMembro] == 0)
		    {
                if(GetPlayerScore(playerid) < 15)
                {
                    SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao tem Nivel 15+ Para Pegar Armas");
    			    GameTextForPlayer(playerid, "~w~Voce Nao tem ~r~Nivel 15+", 3000, 3);
    			    ResetPlayerWeapons(playerid);
                }
                else
                {
    			    if(Pp[playerid][FezPorte] == 0)
    			    {
    			        SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao tem Porte de Armas Para Pegar Armas");
    			        GameTextForPlayer(playerid, "~w~Voce Nao tem ~r~Porte de Armas!", 3000, 3);
    			        ResetPlayerWeapons(playerid);
    			        return 1;
    			    }
                }
			}
		}
	}
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
	    for(new i = 0; i < sizeof(SpikeInfo); i++)
	  	{
	  	    if(ISP(playerid, 2.0, SpikeInfo[i][sX], SpikeInfo[i][sY], SpikeInfo[i][sZ]))
	       	{
	  	        if(SpikeInfo[i][sCreated] == 1)
	  	        {
					new panels, doors, lights, tires;
					new carid = GetPlayerVehicleID(playerid);
					GetVehicleDamageStatus(carid, panels, doors, lights, tires);
					if(tires == 0)
					{
			            GameTextForPlayer(playerid, "~w~pneus ~r~furados!", 1500, 3);
			            tires = encode_tires(1, 1, 1, 1);
			          	UpdateVehicleDamageStatus(carid, panels, doors, lights, tires);
			        }
	  	        }
	  	    }
	  	}
	}
    if(VeiculoSpawnado[playerid] == 1)
	{
	    SalvarVeiculo(playerid);
	}
	return 1;
}

