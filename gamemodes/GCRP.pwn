	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Seu Voip ja Esta Desativado!");
	}
	return 1;
}

CMD:calados(playerid)
{
    if(Pp[playerid][Admin] >= 1)
	{
		new stg[5000];
		strcat(stg, "Player Calado\tCPF\tTempo\n");
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Mutado] >= 1)
			{
				format(gstring, sizeof(gstring), "\n{FFFFFF}- %s[%d]\tCPF: [%d]\t{FFFFFF}Tempo: %d Minutos\n", PlayerName(i), Pp[i][IDF], i, Pp[i][MinutosMutado]/60);
				strcat(stg, gstring);
				ShowPlayerDialog(playerid, 5000, DIALOG_STYLE_TABLIST_HEADERS, "Calados do", stg, "Ok", "");
			}
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	}
	return 1;
}

CMD:calar(playerid, params[])
{
 	new id, motivo[30 + 1], String[220], tempo;
    if(Pp[playerid][Admin] < 1) return false;
    if(sscanf(params, "dds[30]", id, tempo, motivo)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /calar [IDF] [MINUTOS] [MOTIVO]");

    for(new i; i < MAX_PLAYERS; i++) {
		if(Pp[i][Logado] == false) continue;
		if(Pp[i][IDF] != id) continue;
		if(id == Pp[playerid][IDF]) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se descalar!");
		if(Pp[i][Mutado] == 0)
		{
			if(tempo >= 1)
			{
				format(String,sizeof(String),"Info-GCRP: O Admin %s[%d] calou o Jogador ID:[%d] por %d minutos por: %s", PlayerName(playerid), Pp[playerid][IDF], Pp[i][IDF], tempo, motivo);
				SendClientMessageToAll(COLOR_LIGHTRED,String);
			    Pp[i][Mutado] = 1;
				Pp[i][MinutosMutado] = tempo * 60;
				SvMutePlayerEnable(i);
				return 1;
			}
			else
			{
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Minutos Invalido! Voce deve colocar um Valor a mais de 1 minuto");
			}
		}
		else
		{
			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Ja Esta Mutado");
		}
	}
	return 1;
}
CMD:descalar(playerid, params[])
{
	if(Pp[playerid][Admin] >= 1)
	{
        new id, string[1200];
	    if(sscanf(params,"d",id))return SCM(playerid, -1,"{FFD700}INFO: {FFFFFF}Use: /descalar [IDF].");
	    {
         	for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
				        if(Pp[i][Mutado] == 1)
				        {
				            format(string,sizeof(string),"Info-GCRP: O Admin %s[%d] Desmutou o Jogador ID:[%d]", PlayerName(playerid), Pp[playerid][IDF], Pp[i][IDF]);
							SendClientMessageToAll(COLOR_LIGHTRED,string);
							Pp[i][Mutado] = 0;
							Pp[i][MinutosMutado] = 0;
							SvMutePlayerDisable(i);
							return 1;

				        }
				        else
				        {
				            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Nao Esta Mutado");
				        }
                    }
				}
			}
			return 1;
	    }
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	}
	return 1;
}
CMD:trancar(playerid)
{
    for(new v; v < MAX_VEHICLES; ++v)
    {
        new Float:X, Float:Y, Float:Z;
        GetVehiclePos(v, X, Y, Z);
        if(ISP(playerid, 3.0, X, Y, Z))
        {
            if(CarroTrank[v] == 1) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}O Veiculo ja esta trancado, use: (/destrancar)");
            {
                CarroTrank[v] = 1;
                CarroInfo[v][ChaveCarro] = PlayerName(playerid);
                SCM(playerid, 0xFF0080AA, "{0000FF}>> {FFFFFF}Veiculo trancado com sucesso.");
                GameTextForPlayer(playerid, "~w~Veiculo ~g~Trancado!", 2000, 3);
            }
        }
    }
    return 1;
}
CMD:destrancar(playerid)
{
    for(new v; v < MAX_VEHICLES; v++)
    {
        new Float:X, Float:Y, Float:Z;
        GetVehiclePos(v, X, Y, Z);
        if(ISP(playerid, 3.0, X, Y, Z))
        {
            if(!new_strcmp(CarroInfo[v][ChaveCarro],PlayerName(playerid)))
			{
				return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem as chaves desse veiculo");
			}
   			if(CarroTrank[v] == 0) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}O Veiculo ja esta destrancado, use (/trancar)");
      		{
       			CarroTrank[v] = 0;
         		CarroInfo[v][ChaveCarro] = 0;
          		SCM(playerid, 0xFF0080AA, "{FFD700}>> {FFFFFF}Veiculo destrancado com sucesso.");
          		GameTextForPlayer(playerid, "~w~Veiculo ~r~Destrancado!", 2000, 3);
            }
        }
    }
    return 1;
}
CMD:destrancaradm(playerid)
{
	if(Pp[playerid][Admin] >= 4)
	{
	    for(new v; v < MAX_VEHICLES; v++)
	    {
            new Float:X, Float:Y, Float:Z;
            GetVehiclePos(v, X, Y, Z);
            if(ISP(playerid, 3.0, X, Y, Z))
            {
	   			if(CarroTrank[v] == 0) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}O Veiculo ja esta destrancado, use (/trancar)");
	      		{
	       			CarroTrank[v] = 0;
	         		CarroInfo[v][ChaveCarro] = 0;
	          		SCM(playerid, 0xFF0080AA, "{FFFFFF}Veiculo destrancado");
	          		GameTextForPlayer(playerid, "~w~Veiculo ~r~Destrancado!", 2000, 3);
	            }
	        }
	    }
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	}
    return 1;
}
