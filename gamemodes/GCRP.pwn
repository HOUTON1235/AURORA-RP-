CMD:removerp(playerid,params[])
{
	new id, String[220];
	if(IsPolicial(playerid))
	{
		if(sscanf(params, "i", id)) return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /removerp [IDF]");
		{
   			for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
                        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
						{
							return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta dirigindo.");
						}
                        if(GetPlayerVehicleID(i) == GetPlayerVehicleID(playerid))
                        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Jogador nao esta em seu Veiculo!");
                        }
                        else
                        {
                            new Float:XV, Float:YV, Float:ZV;
                            GetPlayerPos(playerid, XV, YV, ZV);
                            if(Colocado[i] == true)
							{
                                Colocado[i] = false;
                                TogglePlayerSpectating(i, 0);
								RemovePlayerAttachedObject(i, 5);
								SetPlayerSpecialAction(i, SPECIAL_ACTION_NONE);
								Pp[i][Algemado] = false;
								KillTimer(ProtecaoAlgemas[i]);
								TogglePlayerControllable(i, 1);
                                PlayerTextDrawHide(playerid, TextDrawCNN[playerid][1]);
                                GameTextForPlayer(i, "~w~Voce retirado(a) do ~r~Porta Malas", 3000, 6);
						        format(String,sizeof(String),"{FFD700}[ Eject ]: {FFFFFF}Voce Ejetou o Player: %s de um Veiculo",PlayerName(i));
						        SCM(playerid,-1,String);
                                SetTimerEx("Mala_Check", 1000, 0, "ii", playerid, i);
                            }
                        }
					}
				}
                else
                {
                    PlayerTextDrawHide(playerid, TextDrawCNN[playerid][1]);
                }
			}
			return 1;
		}
	}
	else
	{
	    SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	}
	return 1;
}

CMD:arrastar(playerid, params[])
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	if(IsPolicial(playerid) || Pp[playerid][Admin] > 1)
    {
        if(Uniforme[playerid] == true)
        {
        	new id, Float:p1, Float:p2, Float:p3;
 			if(sscanf(params, "i", id))
 			{
 				return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /arrastar [IDF]");
 			}
    		for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
						GetPlayerPos(i, Float:p1, Float:p2, Float:p3);
						if(!ISP(playerid, 40.0, p1, p2, p3))
						{
							return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce esta muito longe deste jogador.");
						}
						if(id == Pp[playerid][IDF])
						{
						    return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pode colocar a si no Veiculo");
						}
						if(Pp[i][Algemado] == false)
						{
						    return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}O Jogador precisa estar algemado");
						}
						if(!IsPlayerInAnyVehicle(playerid))
						{
							return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta em um veiculo.");
						}
						if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
						{
							return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta dirigindo.");
						}
						else
						{
                            new carid = GetPlayerVehicleID(playerid);
						    if(Colocado[i] == false)
							{
							    Colocado[i] = true;

					       		new string[150];
					       		format(string,sizeof(string), "{FFFFFF}Voce colocou o jogador ID:[%d] No Porta Malas", Pp[i][IDF]);
								SCM(playerid, COR_AZUL, string);

                                new str[6000];
                                format(str,sizeof(str),"O ID:[%d] esta no Porta Malas", Pp[i][IDF]);
                                PlayerTextDrawSetString(playerid, TextDrawCNN[playerid][1], str);
                                PlayerTextDrawShow(playerid, TextDrawCNN[playerid][1]);

                                TogglePlayerSpectating(i, 1);
            					PlayerSpectatePlayer(i, playerid);
            					PlayerSpectateVehicle(i, carid);

                                GameTextForPlayer(i, "~w~Colocado No ~r~Porta Malas!", 3000, 3);

								format(string, sizeof(string), "* Policial ID:[%d] colocou o jogador ID:[%d] No Porta Malas.", Pp[playerid][IDF], Pp[i][IDF]);
					    		ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
					    		return 1;
							}
						}
					}
				}
			}
			return 1;
		}
	}
	else
	{
	    return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao tem permissao");
	}
	return 1;
}
