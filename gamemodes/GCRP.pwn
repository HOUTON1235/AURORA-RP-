CMD:removerdrogas(playerid, params[])
{
	new id, string[10000];
	if(IsPolicial(playerid))
	{
	    if(sscanf(params,"i",id))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /removerdrogas [IDF]");
	    {
         	for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
				        if(id == Pp[playerid][IDF])
						{
				 			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Remover Drogas!");
						 	return 1;
						}
				        if(Pp[i][Droga] > 1)
				        {
					        SendClientMessageEx(playerid, -1, "{FFFFFF}Voce Removeu As Drogas do Jogador: %s, Bom Trabalho", PlayerName(i));
						    format(string, sizeof(string), "* O ID:[%d] Removeu as Drogas do ID:[%d]", Pp[playerid][IDF], Pp[i][IDF]);
		    				ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
