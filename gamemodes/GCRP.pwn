				GameTextForPlayer(playerid, "~g~+$[4500]", 1000, 3);
				GivePlayerCash(playerid, 4500);
				ApplyDynamicActorAnimation(BotJO, "DEALER", "DEALER_IDLE", 4.0, 0, 1, 1, 1, -1);
				JODisp = 0;
                for(new i; i < 4; i++)
                {
                    DestroyDynamicPickup(PickDinheiroJO[i]);
                }
                // Dinheiro no Chao
                PickDinheiroJO[0] = CreateDynamicPickup(1550, 1, 1856.9838,-1595.7874,13.6703, 2);
                PickDinheiroJO[1] = CreateDynamicPickup(1550, 1, 1856.9806,-1590.1964,13.6703, 2);
                PickDinheiroJO[2] = CreateDynamicPickup(1550, 1, 1870.3042,-1590.4778,13.6703, 2);
                PickDinheiroJO[3] = CreateDynamicPickup(1550, 1, 1870.3246,-1596.9133,13.6703, 2);
			}
			else
			{
			    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Esta loja nao foi roubada");
			}
