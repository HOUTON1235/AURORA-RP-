//TASER
CMD:taser(playerid, params[])
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(IsPolicial(playerid))
	{
        if(Pp[playerid][OrgMembro] == 15 || Pp[playerid][OrgMembro] == 15)
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando sendo desta corp.");
        }
        else
        {
     		new weapon, ammo;
     		GetPlayerWeaponData(playerid, ARMA_SLOTS, weapon, ammo);
     		GivePlayerWeapon(playerid, weapon, -ammo);
     		SCM(playerid, -1, "{FFFFFF}Voce pegou uma Calibre 12 com Balas de Borracha..");

     		if (taser[playerid])
     		{
      			taser[playerid] = false;
      			if (GiveTaserAgainTimer[playerid]) KillTimer(GiveTaserAgainTimer[playerid]);
      			if (IsPlayerAttachedObjectSlotUsed(playerid, 0))
    			{
       				new skin = GetPlayerSkin(playerid);
       				SetPlayerSkin(playerid, skin);
       				ClearAnimations(playerid, 1);
       				RemovePlayerAttachedObject(playerid, 0);
      			}
     		}
     		else
     		{
      			taser[playerid] = true;
      			GivePlayerWeapon(playerid, ARMA_TASER, 1);
     		}
        }
		return 1;
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e de Uma Corporacao");
	    return 1;
	}
}
CMD:taseradm(playerid, params[])
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(Pp[playerid][Admin] >= 4)
	{
 		new weapon, ammo;
 		GetPlayerWeaponData(playerid, ARMA_SLOTS, weapon, ammo);
 		GivePlayerWeapon(playerid, weapon, -ammo);
 		SCM(playerid, -1, "{FFFFFF}Voce pegou uma Calibre 12 com Balas de Borracha..");

 		if (taser[playerid])
 		{
  			taser[playerid] = false;
  			if (GiveTaserAgainTimer[playerid]) KillTimer(GiveTaserAgainTimer[playerid]);
  			if (IsPlayerAttachedObjectSlotUsed(playerid, 0))
			{
   				new skin = GetPlayerSkin(playerid);
   				SetPlayerSkin(playerid, skin);
   				ClearAnimations(playerid, 1);
   				RemovePlayerAttachedObject(playerid, 0);
  			}
 		}
 		else
 		{
  			taser[playerid] = true;
  			GivePlayerWeapon(playerid, ARMA_TASER, 1);
 		}
		return 1;
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e Admin");
	    return 1;
	}
}

CMD:setcoins(playerid, params[])
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(Pp[playerid][Admin] >= 6)
    {
	    new id, coins, string[450], String[220];
		if(sscanf(params, "ii", id, coins))return SCM(playerid,-1,"{FFFFFF}Use /setcoins [IDF] [Coins]");
	    {
   	 		for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
					    if(Pp[i][Coins] < 1000000)
						{
						    if(coins < 500000)
						    {
						        format(String,sizeof(String),"{FFFF00}[COINS] O Admin %s Setou %d de Coins Para o Player %s", PlayerName(playerid), coins, PlayerName(i));
			    				SendClientMessageToAll(COLOR_LIGHTRED,String);
			    				SendClientMessageEx(i, -1, "{00FF00}INFO Coins. {FFFFFF}O Admin %s Setou %d Coins Para Voce, Bom Proveito", PlayerName(playerid), coins);
						 		Pp[i][Coins] += coins;
						 		return 1;
							}
							else
							{
							    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce so Pode Setar ate 100 Coins Por Vez");
							    return 1;
							}
					  	}
					  	else
					  	{
					  	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Ja tem o Maximo de Coins Possivel.");
					  	    return 1;
					  	}
					}
				}
			}
			return 1;
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	    return 1;
	}
}
CMD:resetcoins(playerid, params[])
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(Pp[playerid][Admin] >= 6)
	{
	    new id, string[450], String[220];
		if(sscanf(params, "i", id))return SCM(playerid,-1,"{FFFFFF}Use /resetcoins [IDF]");
	    {
         	for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
					    if(Pp[i][Coins] > 1)
						{
							format(String,sizeof(String),"{FFFF00}[COINS] O Admin %s Resetou os Coins Do Player %s", PlayerName(playerid), PlayerName(i));
							SendClientMessageToAll(COLOR_LIGHTRED,String);
							SendClientMessageEx(i, -1, "{00FF00}INFO Coins. {FFFFFF}O Admin %s Resetou Seus Coins", PlayerName(playerid));
				 			Pp[i][Coins] = 0;
				 			return 1;
					  	}
					  	else
					  	{
					  	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Nao tem Coins.");
					  	    return 1;
					  	}
					}
				}
			}
			return 1;
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	    return 1;
	}
}
