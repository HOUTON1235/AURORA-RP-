							SCM(playerid, COR_GRAD1, "{FFDC33}MercadoNG: {FFFFFF}Voce comprou um explosivo level 1.");
							SCM(playerid, COR_GRAD1, "{FFDC33}MercadoNG: {FFFFFF}Para Guardar Este Item em Sua Mochila, Aperte Y ou Use: /guardaritem");
						}
