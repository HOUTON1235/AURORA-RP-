			{
			    if(IsBandido(playerid))
				{
					if(GetPlayerCash(playerid) >= 2500)
					{
					    if(SegurandoMaoDireita[playerid] == 0)
					    {
					    	SetPlayerAttachedObject(playerid, 9, 1654, 6, 0.0279, 0.0280, 0.0000, -81.9000, -173.6000, 104.4000, 0.8220, 0.8630, 0.7470); //Mão Direita
