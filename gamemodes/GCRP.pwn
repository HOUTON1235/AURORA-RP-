                SetPlayerRaceCheckpoint(playerid, 0, 2058.0818, -1698.3513, 14.1172, 2058.0818, -1698.3513, 14.1172, 7);
                SCM(playerid, -1, "{FFD700}>> Pacotes: {FFFFFF}Pacotes entregues, agora va na casa do Big Smoke, seu Fracote!");
                SCM(playerid, -1, "{FFD700}>> Pacotes: {FFFFFF}Entregue a Lista para o Big Smoke!!");
                SCM(playerid, -1, "{FFD700}>> Pacotes: {FFFFFF}Oh noo, as cameras viram voce entregando pacotes, e voce ganhou estrelas de procurado");
