CMD:criarposto(playerid)
{
	if(Pp[playerid][Admin] >= 6)
	{
		for(new i; i < MAX_POSTO; i++)
		{
			format(arquivo, sizeof(arquivo), PASTA_POSTO, i);
			if(!DOF2_FileExists(arquivo))
			{
				new Float:PX, Float:PY, Float:PZ, zone[MAX_ZONE_NAME];
				GetPlayerPos(playerid, Float:PX, Float:PY, Float:PZ);
				GetPlayer2DZone(playerid, zone, MAX_ZONE_NAME);

				DOF2_CreateFile(arquivo);
				DOF2_SetInt(arquivo, "PostoID", i);
				DOF2_SetString(arquivo, "PostoNome", zone);

				DOF2_SetFloat(arquivo, "PostoPosX", PX);
				DOF2_SetFloat(arquivo, "PostoPosY", PY);
				DOF2_SetFloat(arquivo, "PostoPosZ", PZ);
				DOF2_SaveFile();

                DOF2_SetInt(arquivo, "PsotoGas", 200);

				PostoInfo[i][PostoID] = DOF2_GetInt(arquivo, "PostoID");
				format(PostoInfo[i][PostoNome], 64, DOF2_GetString(arquivo, "PostoNome"));

				PostoInfo[i][PostoPosX] = DOF2_GetFloat(arquivo, "PostoPosX");
				PostoInfo[i][PostoPosY] = DOF2_GetFloat(arquivo, "PostoPosY");
				PostoInfo[i][PostoPosZ] = DOF2_GetFloat(arquivo, "PostoPosZ");

                PostoInfo[i][PostoGas] = DOF2_GetInt(arquivo, "PostoGas");

				PickupPosto[i] = CreateDynamicPickup(1650, 1, PostoInfo[i][PostoPosX], PostoInfo[i][PostoPosY], PostoInfo[i][PostoPosZ]);
				MapIconPosto[i] = CreateDynamicMapIcon(PostoInfo[i][PostoPosX], PostoInfo[i][PostoPosY], PostoInfo[i][PostoPosZ], 55, 0, -1, -1, -1, 100.0, MAPICON_LOCAL);

    			new string[5500];
				format(string, sizeof(string), "{FFFFFF}Posto de Gasolina : %d\n\nUtilize: /abastecer\nPara Abastecer seu Veiculo!\nUse: /abastecergalao\nPara abastecer seu {FFD700}Galao de Gasolina\n{FFFFFF}Litros Disponiveis: {FFDC33}%dL\n{FFFFFF}Reabastecedores, Use: /descarregargasolina", PostoInfo[i][PostoID], PostoInfo[i][PostoGas]);
				TextoPosto[i] = CreateDynamic3DTextLabel(string, -1, PostoInfo[i][PostoPosX], PostoInfo[i][PostoPosY], PostoInfo[i][PostoPosZ]+1, 15.0);
				return 1;
			}
		}
	}
	return 1;
}

CMD:dposto(playerid, params[])
{
	if(Pp[playerid][Admin] >= 4)
	{
		new id, arquivoCA[5000], mensagem[128];
		if(sscanf(params, "i", id)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /dposto [ID do Posto].");
		{
		    if(ISP(playerid, 2.0, PostoInfo[id][PostoPosX], PostoInfo[id][PostoPosY], PostoInfo[id][PostoPosZ]))
