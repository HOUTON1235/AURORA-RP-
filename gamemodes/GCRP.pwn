					    	ApplyAnimation(playerid, "GANGS", "DEALER_DEAL", 4.1, 1, 1, 1, 0, 0, 1);
							format(string, sizeof(string), "* O Oficial %s Limpou a Mochila do Player %s", PlayerName(playerid), PlayerName(i));
							ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
