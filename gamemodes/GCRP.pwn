CallBack:: DemitirInfoOrg(nome[])
{
    for(new i = 1; i < MAX_ORGS; i++)
	{
        format(arquivo, sizeof(arquivo), PASTA_ORGS, i);
    	if(strcmp(nome,OrgInfo[i][Lider],true)==0)
    	{
    	    strmid(OrgInfo[i][Lider], "Nenhum", 0, strlen("Nenhum"), MAX_PLAYER_NAME);
