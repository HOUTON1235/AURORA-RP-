        else if(ISP(playerid, 2.0, 1856.1652,-1593.0793,13.6703))
		{
		    if(JODisp == 1)
		    {
			    new Str[5000];
			    format(Str, sizeof(Str), "{FFD700}Fiscal de Joias{FFFFFF}\n\nMire no personagem para Ameaca-lo.");
				UpdateDynamic3DTextLabelText(TextBotJO, 0x1FF61F99, Str);
