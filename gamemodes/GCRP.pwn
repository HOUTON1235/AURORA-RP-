CMD:fecharevento(playerid)
{
    if(Pp[playerid][Admin] >= 4)
    {
        for(new i; i < MAX_PLAYERS; i++)
        {
            if(Pp[i][Logado] == true)
            {
                PodeEntrarEvento[i] = 0;
            }
        }
        new string[450];
        format(string,sizeof(string),"<< O Admin: %s[%d] Fechou o Evento para Todos os Players! >>", PlayerName(playerid), Pp[playerid][IDF]);
    	SendClientMessageToAll(COLOR_LIGHTRED,string);
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem autorizacao para usar este comando");
    }
    return 1;
}

CMD:pevento(playerid)
{
	new string[450];
	if(EventoCorridaSv == 1)
	{
	    //Funcionalidade
     	SendClientMessageToAll(COLOR_LIGHTRED, "{FFD700}| =-=-=-=-=-=-=-= | {FFFFFF}Aviso Evento!{FFD700} | =-=-=-=-=-=-=-= |");
		format(string,sizeof(string),"{FFFFFF}O Evento [Corrida] foi Finalizado");
		SendClientMessageToAll(COLOR_LIGHTRED,string);
        EventoCorridaSv = 0;
        for(new i; i < 29; i++)
		{
		    DestroyDynamicObject(ObjEv[i]);
		}
		for(new i; i < 10; i++)
		{
		    DestroyVehicle(CarEvCorrida[i]);
		}
        for (new i; i < MAX_PLAYERS; i++)
		{
		    if(EventoCorrida[i] == 1)
		    {
		    	SpawnPlayer(i);
		    	EventoCorrida[i] = 0;
		    }
		}
		return 1;
	}
	else if(EventoEscondeSv == 1)
	{
	    //Funcionalidade
     	SendClientMessageToAll(COLOR_LIGHTRED, "{FFD700}| =-=-=-=-=-=-=-= | {FFFFFF}Aviso Evento!{FFD700} | =-=-=-=-=-=-=-= |");
		format(string,sizeof(string),"{FFFFFF}O Evento [Esconde-Esconde] foi Finalizado");
		SendClientMessageToAll(COLOR_LIGHTRED,string);
	    EventoEscondeSv = 0;
	    for (new i; i < MAX_PLAYERS; i++)
		{
		    if(EventoEsconde[i] == 1)
		    {
		    	SpawnPlayer(i);
		    	EventoEsconde[i] = 0;
		    }
		}
		return 1;
	}
	else if(EventoMataSv == 1)
	{
	    //Funcionalidade
     	SendClientMessageToAll(COLOR_LIGHTRED, "{FFD700}| =-=-=-=-=-=-=-= | {FFFFFF}Aviso Evento!{FFD700} | =-=-=-=-=-=-=-= |");
		format(string,sizeof(string),"{FFFFFF}O Evento [Mata-Mata] foi Finalizado");
		SendClientMessageToAll(COLOR_LIGHTRED,string);
	    EventoMataSv = 0;
	    for (new i; i < MAX_PLAYERS; i++)
		{
		    if(EventoMataMata[i] == 1)
		    {
		    	SpawnPlayer(i);
		    	EventoMataMata[i] = 0;
		    }
		}
		return 1;
	}
	else if(EventoBateSv == 1)
	{
	    //Funcionalidade
     	SendClientMessageToAll(COLOR_LIGHTRED, "{FFD700}| =-=-=-=-=-=-=-= | {FFFFFF}Aviso Evento!{FFD700} | =-=-=-=-=-=-=-= |");
		format(string,sizeof(string),"{FFFFFF}O Evento [Bate-Bate] foi Finalizado");
		SendClientMessageToAll(COLOR_LIGHTRED,string);
	    EventoBateSv = 0;
	    for(new i; i < 11; i++)
		{
		    DestroyVehicle(CarEvBate[i]);
		}
	    for (new i; i < MAX_PLAYERS; i++)
		{
		    if(EventoBateBate[i] == 1)
		    {
		    	SpawnPlayer(i);
		    	EventoBateBate[i] = 0;
		    }
		}
		return 1;
	}
	return 1;
}

