stock NotTrailerAtached( vehicle )
{
    foreach(Player, i )
    {
        new
            v = GetPlayerVehicleID( i )
        ;
        if( IsPlayerInAnyVehicle( i ) && GetVehicleModel( v ) == 515 || GetVehicleModel( v ) == 514 )
        {
            if( vehicle == GetVehicleTrailer( GetPlayerVehicleID( i )) )
            {
                return 0;
            }
        }
    }
    return 1;
}


stock IsVehicleOccupied( vehicleid )
{
    for(new i; i < MAX_PLAYERS; i++)
   	{
   		if(Pp[i][Logado] == true)
   		{
   			if( IsPlayerInVehicle( i, vehicleid ) && GetPlayerState( i ) == PLAYER_STATE_DRIVER )
   			{
   				return 1;
   			}
   		}
   	}
    return 1;
}
stock fileLog(file[], string[])
{
    new Hora, Minuto; gettime(Hora, Minuto);
	new Dia, Mes, Ano; getdate(Dia, Mes, Ano);
    new timestr[32], data[128], File:hFile, thefile[32];
    format(timestr,32,"%02d/%02d/%02d - %02d:%02d ",Ano, Mes, Dia, Hora, Minuto);
    format(data, sizeof(data), "%s%s\r\n",timestr,string);
    format(thefile, sizeof(thefile), "Logs/%s.log", file);
    hFile = fopen(thefile, io_append);
    fwrite(hFile, data);
    fclose(hFile);
    return 1;
}

stock LimparChat(playerid, limit)
{
	for(new i; i < limit; i++)
	{
		SCM(playerid, -1, "");
	}
	return 1;
}

stock GivePlayerCash(playerid, money)
{
	Cash[playerid] += money;
	ResetMoneyBar(playerid);//Resets the money in the original moneybar, Do not remove!
	UpdateMoneyBar(playerid,Cash[playerid]);//Sets the money in the moneybar to the serverside cash, Do not remove!
	return Cash[playerid];
}

stock SetPlayerCash(playerid, money)
{
	Cash[playerid] = money;
	ResetMoneyBar(playerid);
	UpdateMoneyBar(playerid,Cash[playerid]);//Sets the money in the moneybar to the serverside cash, Do not remove!
	return Cash[playerid];
}

stock ResetPlayerCash(playerid)
{
	Cash[playerid] = 0;
	ResetMoneyBar(playerid);//Resets the money in the original moneybar, Do not remove!
	UpdateMoneyBar(playerid,Cash[playerid]);//Sets the money in the moneybar to the serverside cash, Do not remove!
	return Cash[playerid];
}

stock GetPlayerCash(playerid)
{
	return Cash[playerid];
}

stock CarregarTextdraws(playerid)
{
    // Cnn Tela 3 [Aviso Admin]
    TdAvisoLogin[playerid][0] = CreatePlayerTextDraw(playerid, 311.000000, 34.000000, "Textdraw de Testes de avisos GCRP");
	PlayerTextDrawFont(playerid, TdAvisoLogin[playerid][0], 1);
	PlayerTextDrawLetterSize(playerid, TdAvisoLogin[playerid][0], 0.325000, 1.450000);
	PlayerTextDrawTextSize(playerid, TdAvisoLogin[playerid][0], 400.000000, 360.500000);
	PlayerTextDrawSetOutline(playerid, TdAvisoLogin[playerid][0], 1);
	PlayerTextDrawSetShadow(playerid, TdAvisoLogin[playerid][0], 0);
	PlayerTextDrawAlignment(playerid, TdAvisoLogin[playerid][0], 2);
	PlayerTextDrawColor(playerid, TdAvisoLogin[playerid][0], -1);
	PlayerTextDrawBackgroundColor(playerid, TdAvisoLogin[playerid][0], 255);
	PlayerTextDrawBoxColor(playerid, TdAvisoLogin[playerid][0], 50);
	PlayerTextDrawUseBox(playerid, TdAvisoLogin[playerid][0], 0);
	PlayerTextDrawSetProportional(playerid, TdAvisoLogin[playerid][0], 1);
	PlayerTextDrawSetSelectable(playerid, TdAvisoLogin[playerid][0], 0);

    // Carregamento de interiores
    TdCarregarINT[playerid][0] = CreatePlayerTextDraw(playerid, 300.000000, 155.000000, "_");
	PlayerTextDrawFont(playerid, TdCarregarINT[playerid][0], 1);
	PlayerTextDrawLetterSize(playerid, TdCarregarINT[playerid][0], 0.600000, 10.300003);
	PlayerTextDrawTextSize(playerid, TdCarregarINT[playerid][0], 298.500000, 1256.500000);
	PlayerTextDrawSetOutline(playerid, TdCarregarINT[playerid][0], 1);
	PlayerTextDrawSetShadow(playerid, TdCarregarINT[playerid][0], 0);
	PlayerTextDrawAlignment(playerid, TdCarregarINT[playerid][0], 2);
	PlayerTextDrawColor(playerid, TdCarregarINT[playerid][0], -1);
	PlayerTextDrawBackgroundColor(playerid, TdCarregarINT[playerid][0], 255);
	PlayerTextDrawBoxColor(playerid, TdCarregarINT[playerid][0], 201);
