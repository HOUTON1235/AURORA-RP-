public OnPlayerTakeDamage(playerid, issuerid, Float:amount, weaponid, bodypart)
{
 	if (weaponid == ARMA_TASER)
 	{
  		if (taser[issuerid])
  		{
   			new Float:health;
   			GetPlayerHealth(playerid, health);
   			SetPlayerHealth(playerid, health+amount);
  		}
 	}
    if(bodypart == 3)
    {
        new Atirador[MAX_PLAYER_NAME],DiiMeNoR[120];
       	GetPlayerName(issuerid, Atirador, sizeof (Atirador));
        format(DiiMeNoR, sizeof(DiiMeNoR), "> [Info-GCRP]: Voce foi atingido no peitoral por um disparo de %s[%d]", Atirador, Pp[issuerid][IDF]);
        SendClientMessage(playerid, -1, DiiMeNoR);
    }
    if(bodypart == 4)
    {
        new Atirador[MAX_PLAYER_NAME],DiiMeNoR[120];
       	GetPlayerName(issuerid, Atirador, sizeof (Atirador));
        format(DiiMeNoR, sizeof(DiiMeNoR), "> [Info-GCRP]: Voce foi atingido na virilha por um disparo de %s[%d]", Atirador, Pp[issuerid][IDF]);
        SendClientMessage(playerid, -1, DiiMeNoR);

    }
    if(bodypart == 6)
    {
        new Atirador[MAX_PLAYER_NAME],DiiMeNoR[120];
       	GetPlayerName(issuerid, Atirador, sizeof (Atirador));
        format(DiiMeNoR, sizeof(DiiMeNoR), "> [Info-GCRP]: Voce foi atingido no braco direito por um disparo de %s[%d]", Atirador, Pp[issuerid][IDF]);
        SendClientMessage(playerid, -1, DiiMeNoR);
    }
    if(bodypart == 5)
    {
        new Atirador[MAX_PLAYER_NAME],DiiMeNoR[120];
       	GetPlayerName(issuerid, Atirador, sizeof (Atirador));
        format(DiiMeNoR, sizeof(DiiMeNoR), "> [Info-GCRP]: Voce foi atingido no braco esquerdo por um disparo de %s[%d]", Atirador, Pp[issuerid][IDF]);
        SendClientMessage(playerid, -1, DiiMeNoR);
    }
    if(bodypart == 8)
    {
        new Atirador[MAX_PLAYER_NAME],DiiMeNoR[120];
       	GetPlayerName(issuerid, Atirador, sizeof (Atirador));
        format(DiiMeNoR, sizeof(DiiMeNoR), "> [Info-GCRP]: Voce foi atingido na perna direita por um disparo de %s[%d]", Atirador, Pp[issuerid][IDF]);
        SendClientMessage(playerid, -1, DiiMeNoR);
    }
    if(bodypart == 7)
    {
        new Atirador[MAX_PLAYER_NAME],DiiMeNoR[120];
       	GetPlayerName(issuerid, Atirador, sizeof (Atirador));
        format(DiiMeNoR, sizeof(DiiMeNoR), "> [Info-GCRP]: Voce foi atingido na perna esquerda por um disparo de %s[%d]", Atirador, Pp[issuerid][IDF]);
        SendClientMessage(playerid, -1, DiiMeNoR);
    }
	new DiiMeNoR[50];
    format(DiiMeNoR, 50, "DANO -%.0f", amount);
    TextDrawSetString(Atingido[0], DiiMeNoR);
    TextDrawShowForPlayer(playerid, Atingido[0]);
    SetTimerEx("RemoveTextDraw", 2000, false, "i", playerid);
 	return 1;
}
CallBack:: EndTaserEffect(playerid)
{
 	new skin = GetPlayerSkin(playerid);
 	SetPlayerSkin(playerid, skin);
 	ClearAnimations(playerid, 1);
 	SetPlayerDrunkLevel(playerid, 0);
 	return 1;
}

CallBack:: GiveTaserAgain(playerid)
{
 	RemovePlayerAttachedObject(playerid, 0);
 	GivePlayerWeapon(playerid, ARMA_TASER, 1);
 	new skin = GetPlayerSkin(playerid);
 	SetPlayerSkin(playerid, skin);
 	ClearAnimations(playerid, 1);
    return 1;
}

CallBack:: Banimento(id)
{
	format(arquivo, sizeof(arquivo), PASTA_BANIDOS, PlayerName(id));
	if(!DOF2_FileExists(arquivo))
	{
		new Hora, Minuto, Segundo, Dia, Mes, Ano;
		gettime(Hora, Minuto, Segundo);
		getdate(Ano, Mes, Dia);

		DOF2_CreateFile(arquivo);
		DOF2_SetInt(arquivo, "HoraBanimento", Hora);
		DOF2_SetInt(arquivo, "MinutoBanimento", Minuto);
		DOF2_SetInt(arquivo, "SegundoBanimento", Segundo);

		DOF2_SetInt(arquivo, "DiaBanimento", Dia);
		DOF2_SetInt(arquivo, "MesBanimento", Mes);
		DOF2_SetInt(arquivo, "AnoBanimento", Ano);
		DOF2_SaveFile();

		Ban(id);
	}
	return 1;
}
CallBack:: SendMSG()
{
    for(new i = GetPlayerPoolSize(); i != -1; --i) //Loop through all players
    {
	    if(Pp[i][ConfigNV] >= 1)
	    {
	    	SendClientMessage(i, COR_BLUE, RandomMSG[random(sizeof(RandomMSG))]);
		}
	}
    return 1;
}
CallBack:: DesmancharVeiculo(playerid)
{
	new string[450], strDes[5000];
	if(IsPlayerInVehicle(playerid, VeiculoDesmanche[playerid]))
	{
		if(TempoDesmanche[playerid] != 0)
		{
		    TempoDesmanche[playerid]--;
			TogglePlayerControllable(playerid, 0);
			format(strDes, sizeof(strDes), "~y~Desmontando: ~w~%d", TempoDesmanche[playerid]);
			GameTextForPlayer(playerid, strDes, 1000, 6);
		}
		else if(TempoDesmanche[playerid] == 0)
		{
		    GameTextForPlayer(playerid, "~w~Veiculo ~y~Desmontado!", 2000, 4);
			TogglePlayerControllable(playerid, 1);
		    DelayDesmanche[playerid] = true;
		    KillTimer(TimerDesmanche[playerid]);
		    DestroyVehicle(VeiculoDesmanche[playerid]);
		    VeiculoDesmanche[playerid] = 0;
            PecasDesmanchadas[playerid] = 10;
		    SCM(playerid, -1, "{FFDC33}Desmanche: {FFFFFF}O veiculo trazido aqui foi desmanchado, e voce pegou 10 pecas dele.");
            SCM(playerid, -1, "{FFDC33}Desmanche: {FFFFFF}Para vender-las, va ao lado do desmanche e venda usando: /venderpecasv.");
            format(string,sizeof(string),">> Desmanche: Um Veiculo foi Desmanchado no Desmanche de Las Venturas! <<");
			SendClientMessageToAll(COLOR_LIGHTRED, string);
			new MsgOc[5000];
			format(MsgOc, sizeof(MsgOc), "Todas as Unidades, O Suspeito: %s(%d) Desmanchou um Veiculo no Desmanche de LV -", PlayerName(playerid), Pp[playerid][IDF]);
			MsgOcorrencia(MsgOc);
			roubando[playerid] += 4;
			SetPlayerWantedLevel(playerid, roubando[playerid]);
			roubando[playerid] = 0;
			format(string, sizeof(string), "* O ID:[%d] Desmanchou um Veiculo!", Pp[playerid][IDF]);
			ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
            for(new ip; ip < MAX_PLAYERS; ip++)
            {
            	if(IsPolicial(ip))
                {
                	new Float:x,Float:y,Float:z;
                	GetPlayerPos(playerid, x,y,z);
                	SetPlayerCheckpoint(ip, x,y,z, 6);
                	GameTextForPlayer(ip, "~w~Ocorrencia[Desmanche] ~r~Marcada!", 3000, 1);
                    CheckPointProfissao[ip] = 1;
                }
            }
			SetTimerEx("MudarDelayDesmanche", 60000 * 3, false, "i", playerid);

		}
	}
	else
    {
		SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce saiu do veiculo que estava desmanchando!"), PecasDesmanchadas[playerid] = 0;
		KillTimer(TimerDesmanche[playerid]);
	}
	return 1;
}
CallBack:: MudarDelayDesmanche(playerid)
{
    DelayDesmanche[playerid] = false;
	return 1;
}
CallBack:: AttFome(playerid)
{
    if(Pp[playerid][Logado] == true)
	{
        if(Trabalhando[playerid] == false)
		{
    		Pp[playerid][Fome] --;

    		if(Pp[playerid][Fome] < 3)
    		{
    		    new string[450];
    		   	format(string, sizeof(string), "* O ID [%d] esta com fome e esta tendo problemas de saude. ", Pp[playerid][IDF]);
    		   	ProxDetector(15.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                new Float:vida;
    	        GetPlayerHealth(playerid, Float:vida);
			    SetPlayerHealth(playerid, vida-2);
    			SCM(playerid, COR_VERMELHO, "{FFDC33}INFO: {FFFFFF}Voce esta com fome, e esta perdendo vida. Coma algo.");
                GameTextForPlayer(playerid, "~w~Voce esta com ~y~Fome", 2000, 3);
    		}
    		else if(Pp[playerid][Fome] < 5)
    		{
    			SCM(playerid, COR_RED, "{FFDC33}INFO: {FFFFFF}Voce esta com muita fome, procure uma lanchonete para comer.");
    			GameTextForPlayer(playerid, "~w~Coma Algo", 2000, 1);
    		}
        }
	}
	return 1;
}
