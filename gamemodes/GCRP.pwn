                {
                    SendClientMessageToAll(0xFF8080AA,"{FFDC33}[GUERRA] Os Policiais estao Controlando o Trafico de Armas, nao Havera armas a Venda!");
					format(string, sizeof(string), "{FFDC33}[GUERRA] Os Policais venceram a disputa, e Pelo Controle Recebera uma Bonificacao de R$12000 assim como a prefeitura.");
					SendClientMessageToAll(0xFF9DFFFF, string);
                    for(new i; i < MAX_PLAYERS; i++)
                    {
                        if(Pp[i][Logado] == true)
                        {
                            if(Pp[i][OrgMembro] == FABInfo[Dono] || Pp[i][OrgMembro] == FABInfo[Dono])
                            {
                                GivePlayerCash(i, 12000);
                                GameTextForPlayer(i, "~g~+R$12000", 1200, 1);
                            }
                        }
                    }
                }
                if(GuettoInfo[Dono] == 13 || GuettoInfo[Dono] == 32 || GuettoInfo[Dono] == 41)
                {
					format(string, sizeof(string), "{FFDC33}[GUERRA] A gang %s venceu a guerra, e pelo controle recebera uma bonificacao de R$12000 na conta dos membros.", OrgInfo[opt][OrgNome]);
					SendClientMessageToAll(0xFF9DFFFF, string);
                    for(new i; i < MAX_PLAYERS; i++)
                    {
                        if(Pp[i][Logado] == true)
                        {
                            if(Pp[i][OrgMembro] == FABInfo[Dono] || Pp[i][OrgMembro] == FABInfo[Dono])
                            {
                                GivePlayerCash(i, 12000);
                                GameTextForPlayer(i, "~g~+R$12000", 1200, 1);
                            }
                        }
                    }
                }
                if(GuettoInfo[Dono] == 0)
                {
                    SendClientMessageToAll(-1, "{FFDC33}: {FFFFFF}Ninguem ganhou a guerra do Farm...");
                }
				FABInfo[Guerra] = 0;
				FABShowForAll();
				SalvarFAB();
				for(new o2; o2 < MAX_ORGS; o2++)
				{
					FABPontos[o2] = 0;
				}
				for(new i=0; i<MAX_PLAYERS; i++)
				{
	    			new Float:x,Float:y,Float:z;
	    			GetPlayerPos(i,x,y,z);
    				PlayerPlaySound(i, 1159, x, y, z);
    				PlayerPlaySound(i, 1159, x, y, z);
    				PlayerPlaySound(i, 1159, x, y, z);
				}
				return 1;
		    }
		}
	}
	return 1;
}
CallBack:: SendFamilyMessage(family, COLOR, string[])
{
	for(new i = 0; i < MAX_PLAYERS; i++)
	{
		if(IsPlayerConnected(i))
		{
		    if(Pp[i][OrgMembro] == family || Pp[i][OrgLider] == family)
            {
				SendClientMessage(i, COLOR, string);
                GameTextForPlayer(i, "~r~Mensagem Org", 1200, 1);
			}
		}
	}
}
CallBack:: Cassino(playerid)
{
    if(NumeroPegoA[playerid] == 1)
    {
        new string[450], str[5000];
    	if(GetPVarInt(playerid, "NumeroSorteado") == GetPVarInt(playerid, "NumeroApostado"))
    	{
            SCM(playerid, -1, "{00FF00}> [Cassino]: Seu numero foi sorteado! Parabens, voce ganhou 5 vezes o valor apostado.");
            SCM(playerid, -1, "{00FF00}> [Cassino]: Saque seu dinheiro no menu de saque do menu do cassino.");
            GameTextForPlayer(playerid, "~g~Parabens!", 1200, 1);
            format(str, sizeof(str), "%02d", GetPVarInt(playerid, "NumeroSorteado"));
            PlayerTextDrawSetString(playerid, TdCassino[playerid][8], str);
            PlayerTextDrawShow(playerid, TdCassino[playerid][8]);
            GameTextForPlayer(playerid, "~g~Ganhou!", 1200, 0);
    	}
    	else
    	{
        	format(string, 5000, "{FFD700}> [Cassino]: Nao Foi Dessa vez, Numero Sorteado: %d", GetPVarInt(playerid, "NumeroSorteado"));
        	SCM(playerid, -1, string);
            for(new i; i < 34; i++)
            {
            	PlayerTextDrawHide(playerid, TdCassino[playerid][i]);
            }
            CancelSelectTextDraw(playerid);
            AcessoCassino[playerid] = 0;
            NumeroPegoA[playerid] = 0;
            PlayerTextDrawSetString(playerid, TdCassino[playerid][8], "00");
            PlayerTextDrawSetString(playerid, TdCassino[playerid][30], "00");
            format(string, sizeof(string), "* O ID:[%d] fechou o menu do cassino", Pp[playerid][IDF]);
            ProxDetector(30.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
            GameTextForPlayer(playerid, "~r~Perdeu!", 1200, 0);
    	}
    }
	return 1;
}
CallBack:: ChecarCorrida()
{
    if(PlayersCorrida[CtPlayers] < 0)
    {
        PlayersCorrida[CtPlayers] = 0;
    }
    if(PlayersCorrida[CtColocado] >= 4)
    {
        PlayersCorrida[CtColocado] = 0;
    }
    if(PlayersCorrida[CtPlayers] >= 4)
    {
        for(new i; i < MAX_PLAYERS; i++)
        {
            if(Pp[i][Logado] == true)
            {
                if(ISP(i, 20.0, 2476.4463,-1851.6560,2.9672))
                {
                    if(EntrouCorrida[i] == 1)
                    {
                        PlayersCorrida[CtPlayers] = 0;
                        SCM(i, -1, "{FFDC33}Corrida: {FFFFFF}A contagem da corrida comecou, aguarde..."), GameTextForPlayer(i, "~w~Contagem", 2000, 1);
                        ContagemTela[i] = 0;
                        TimerContagem[i] = SetTimerEx("MarcarCheckC", 1000, true, "i", i);
                        TogglePlayerControllable(i, 0);
                        ProtecaoAlgemas[i] = SetTimerEx("k", 500, true, "d", i);
                    }
                }
            }
        }
    }
    return 1;
}

CallBack:: ChecarCorrida2()
{
    if(PlayersCorrida2[CtPlayers2] < 0)
    {
        PlayersCorrida2[CtPlayers2] = 0;
    }
    if(PlayersCorrida2[CtColocado2] >= 4)
    {
        PlayersCorrida2[CtColocado2] = 0;
    }
    if(PlayersCorrida2[CtPlayers2] >= 2)
    {
        for(new i; i < MAX_PLAYERS; i++)
        {
            if(Pp[i][Logado] == true)
            {
                if(ISP(i, 20.0, 2621.0979, 327.7351, 26.3867))
                {
                    if(EntrouCorrida2[i] == 1)
                    {
                        PlayersCorrida2[CtPlayers2] = 0;
                        SCM(i, -1, "{FFDC33}Corrida: {FFFFFF}A contagem da corrida comecou, aguarde..."), GameTextForPlayer(i, "~w~Contagem", 2000, 1);
                        ContagemTela[i] = 0;
                        TimerContagem[i] = SetTimerEx("MarcarCheckC2", 1000, true, "i", i);
                        TogglePlayerControllable(i, 0);
                        ProtecaoAlgemas[i] = SetTimerEx("k", 500, true, "d", i);
						SetPlayerWantedLevel(i, GetPlayerWantedLevel(i)+3);
						SendClientMessageToAll(COLOR_LIGHTRED, "Seguranca: Uma corrida ilegal foi Iniciada, todas as policias foram avisadas");
                        for(new ip; ip < MAX_PLAYERS; ip++)
        				{
        					if(IsPolicial(ip))
                            {
        						SetPlayerCheckpoint(ip, 369.1202,-2018.1229,7.2902, 6);
        						GameTextForPlayer(ip, "~w~Va ao ponto de chegada da ~r~Corrida!", 3000, 4);
                                CheckPointProfissao[ip] = 1;
        					}
        				}
                    }
                }
            }
        }
    }
    return 1;
}

