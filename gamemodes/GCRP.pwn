CallBack:: SalvarMorro()
{
	format(arquivo, sizeof(arquivo), PASTA_MORRO);
 	DOF2_SetInt(arquivo,"Dono",MorroInfo[Dono]);
    DOF2_SaveFile();
	DefinirCorMorro();
	printf("[Guetto]: Dono do Morro = ID: %d", MorroInfo[Dono]);
	return 1;
}
CallBack:: DefinirCorMorro()
{
    if(MorroInfo[Dono] == 0)
	{
		MorroInfo[Cor] = 0xC0C0C0AA;
	}
    if(MorroInfo[Dono] >= 1 && MorroInfo[Dono] <= 10)
	{
		MorroInfo[Cor] = COR_AZUL;
	}
    if(MorroInfo[Dono] >= 11 && MorroInfo[Dono] <= 45)
	{
		MorroInfo[Cor] = COR_VERMELHO;
	}
}
