CMD:kitvip(playerid)
{
    new string[10000], Float:ColeteP[MAX_PLAYERS], Float:pX, Float:pY, Float:pZ, Float:armour;
    GetPlayerArmour(playerid, Float:armour);
    if(Pp[playerid][Preso] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(PegouKitVip[playerid] == 1)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja pegou o kit, aguarde 30 minutos.");
    if(Pp[playerid][Vip] == 1)
	{
		if(armour < 100)
		{
            ColeteP[playerid] = armour;
		    ColeteP[playerid] += 25;
            SetPlayerArmour(playerid, ColeteP[playerid]);
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Seu colete nao foi recarregado por ja esta cheio.");
        }
        SetTimerEx("TempoSairKit", 1800000, 0, "i", playerid);
        PegouKitVip[playerid] = 1;
        GivePlayerWeapon(playerid, WEAPON_DILDO, 1);
        GivePlayerWeapon(playerid, WEAPON_COLT45, 100);
		format(string, sizeof(string), "* O ID:[%d] Pegou seu kit vip", Pp[playerid][IDF]);
		ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
		GameTextForPlayer(playerid, "~w~Kit ~y~Vip", 2000, 1);
		GetPlayerPos(playerid,pX,pY,pZ);
		PlayerPlaySound(playerid,1056,pX,pY,pZ);
    }
