						    {
						        new aquivoconce[5000];
				   	            format(aquivoconce, sizeof(aquivoconce), PASTA_CONCESSIONARIA, PlayerName(i));
								if(DOF2_FileExists(aquivoconce))
				    			{
								    IfCarro[i][TemCarro] = 0;
