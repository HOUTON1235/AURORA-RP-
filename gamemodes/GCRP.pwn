public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{
    for(new ttt =1; ttt < 11; ttt++)
    if(playertextid == InvCarTDP[playerid][ttt])
    {
        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode criar um carro estando dentro de um.");
        {
            if(Slots[playerid][ttt] !=999999)
            {
                new Float:Pos[3];
                GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
                CarroEventoIV[playerid] = CreateVehicle(Slots[playerid][ttt], Pos[0], Pos[1], Pos[2], 90, 1, 1, false);
                PutPlayerInVehicle(playerid, CarroEventoIV[playerid], 0);
                cmd_trancar(playerid);
                AcessouMenuCarInv[playerid] = 1;
                SCM(playerid, -1, "{FFFFFF}[INV] Voce spawnou seu Veiculo De Inventario, Bom Proveito, Para Guardar use: /gcarro");
                new string[1200];
    	        format(string, sizeof(string), "* O ID:[%d]: Spawnou seu Veiculo de Inventario", Pp[playerid][IDF]);
                ProxDetector(20.0, playerid, string, COR_PURPLE, COR_PURPLE, COR_PURPLE,COR_PURPLE,COR_PURPLE);
        		Slots[playerid][ttt] = 999999;
         		PlayerTextDrawSetPreviewModel(playerid, InvCarTDP[playerid][ttt], 999999);
                idslotiv[playerid] = ttt;
        		Cancel(playerid);
            }
        }
    }
    else if(playertextid ==  InvCarTDP[playerid][11])
    {
    	Cancel(playerid);
        AcessouMenuCarInv[playerid] = 0;
    }
	if(playertextid != PlayerText:INVALID_TEXT_DRAW)
    {
        if(playertextid == TdCassino[playerid][17])
	    {
            if(AcessoCassino[playerid] == 1)
            {
                if(NumeroPegoA[playerid] == 0)
                {
                    ShowPlayerDialog(playerid, DIALOG_DEPOSITAR, DIALOG_STYLE_INPUT, "{FFFFFF}Deposito {FFDC33}CassinoLV", "{FFDC33}: {FFFFFF}Digite o valor desejado para deposito.\nAssim voce podera apostar seu dinheiro", "Depositar", "X");
                }
                else
                {
                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja escolheu um numero, aposte para finalizar a jogada.");
                }
            }
        }
        if(playertextid == TdCassino[playerid][18])
	    {
            if(AcessoCassino[playerid] == 1)
            {
                if(NumeroPegoA[playerid] == 1)
                {
                    new string[450];
                	if(GetPVarInt(playerid, "NumeroSorteado") == GetPVarInt(playerid, "NumeroApostado"))
                	{
                        SCM(playerid, -1, "{00FF00}> [Cassino]: Seu numero foi sorteado! Parabens, voce ganhou 5 vezes o valor apostado.");
                        format(string, 5000, "{00FF00}> [Cassino]: Parabens pela sua vitoria! voce sacou: %d", GetPVarInt(playerid, "DinheiroApostado") * 5);
                        SCM(playerid, -1, string);
                        GameTextForPlayer(playerid, "~g~Parabens!", 1200, 1);
                        GivePlayerCash(playerid, GetPVarInt(playerid, "DinheiroApostado") * 5);
                        for(new i; i < 34; i++)
            		    {
            		    	PlayerTextDrawHide(playerid, TdCassino[playerid][i]);
            		    }
            		    CancelSelectTextDraw(playerid);
                        AcessoCassino[playerid] = 0;
                        NumeroPegoA[playerid] = 0;
            			format(string, sizeof(string), "* O ID:[%d] fechou o menu do cassino", Pp[playerid][IDF]);
            			ProxDetector(30.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                	}
                	else
                	{
                    	format(string, 5000, "{FFD700}> [Cassino]: Nao Foi Dessa vez, Numero Sorteado: %d", GetPVarInt(playerid, "NumeroSorteado"));
                    	SCM(playerid, -1, string);
                        for(new i; i < 34; i++)
            		    {
            		    	PlayerTextDrawHide(playerid, TdCassino[playerid][i]);
            		    }
            		    CancelSelectTextDraw(playerid);
                        AcessoCassino[playerid] = 0;
                        NumeroPegoA[playerid] = 0;
                        PlayerTextDrawSetString(playerid, TdCassino[playerid][8], "00");
                        PlayerTextDrawSetString(playerid, TdCassino[playerid][30], "00");
            			format(string, sizeof(string), "* O ID:[%d] fechou o menu do cassino", Pp[playerid][IDF]);
            			ProxDetector(30.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                	}
                }
                else
                {
                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao apostou nenhuma jogada para sacar quaiquer grana aqui. Caloteiro.");
                }
            }
        }
