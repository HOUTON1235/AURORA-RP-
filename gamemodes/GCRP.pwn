// Modulos
#include "../modulos/sistema_botsrck.inc"

// Inicio da Gamemode
public OnGameModeInit()
{
	//Inicio Da Gamemode
    gstream = SvCreateGStream(0x8B008BFF, "Aviso Staff Global");
    for(new i = 0; i < MAX_FREQUENCIAS; i++)
		Frequencia[i] = SvCreateGStream(0xFF2400FF, "Comunicador");
	//Inicio Dos ID's
	new File[150];format(File, sizeof(File), "IDs/ProxID.ini");
	if(DOF2_FileExists(File))
	{
		ProxID = DOF2_GetInt(File,"ProxID");
	}
	else
	{
		DOF2_CreateFile(File);
		DOF2_SetInt(File,"ProxID",99);
		DOF2_SaveFile();
		ProxID = 0;
	}
	//Loops > Veiculos e Afins
	for(new c=0;c<CAR_AMOUNT;c++)
    //=-=-=-=-=-= CONFIGS DA GAMEMODE =-=-=-=-=-=-
	ShowNameTags(0);
	SetGameModeText("Gold Roleplay | v1.0");
	DisableInteriorEnterExits();
	ShowPlayerMarkers(0);
	EnableStuntBonusForAll(0);
	ManualVehicleEngineAndLights();
    // Carregamentos da Gamemode
    CarregarGuetto();
    CarregarMorro();
    CarregarFAB();
	AntiDeAMX();
    CarregarPort();
	CarregarMapas();
	CriarEmpresas();
	CriarCasas();
	CarregarImpostos();
	CriarOrgs();
	CriarRadares();
    CriarSpawnsV();
    CriarSpawnsVEMP();
    CriarPostos();
	CriarCaixas();
	CriarBots();
	ConectarBotsSV();
	// Timers
	SetTimer("BotSpawn", 9000, false);
    // Distancia Streamer
    Streamer_SetVisibleItems(STREAMER_TYPE_OBJECT, 810, -1);
    //Variaveis definidas
	BancoDisp = 0;
    JODisp = 0;
	BancoDinheiro = 1500000;
	SetWeather(11);
	//animacoes do cj
	UsePlayerPedAnims();
    //Lojinhas
	RegLS1 = 0;
	RegLS2 = 0;
    RegLS3 = 0;
    RegLS4 = 0;
    RegLS5 = 0;
    RegLS6 = 0;
    RegLS7 = 0;
//	CupomGold City[0] = 0;
    ServidorEmManutencao = 1;
 	/* SetTimer */
    SetTimer("DarLoterica", 1800000, true);         // Loteria do Servidor
 	SetTimer("Tempo", 1000, true);                  // Tempo do Game
 	SetTimer("TimeCombustivel", 25000, true);       // Gasolina
 	SetTimer("RespawnAT", 2400000, true);           // Rc Automatico
  	SetTimer("SendMSG", 300000, true);              // Mensagens aleatorias
 	SetTimer("RecarregarCaixas", 900000,true);      // Recarregar Caixas Registradoras
	SetTimer("Postos", 1000, true);                 // INICIAR Postos
	SetTimer("AttIDF", 500, true);                  // IDF
    SetTimer("CheckGuettoArea", 4000, true);        // Dar Pontos Guetto
    SetTimer("CheckMorroArea", 4000, true);         // Dar Pontos Morro
    SetTimer("CheckFABArea", 4000, true);           // Dar Pontos FAB
    SetTimer("ChecarCorrida", 1000, true);          // Checar Corridas 1
    SetTimer("ChecarCorrida2", 1000, true);         // Checar Corridas 2
    SetTimer("ChecarCorrida3", 1000, true);         // Checar Corridas 3
    SetTimer("ChecarCorrida4", 1000, true);         // Checar Corridas 4
    SetTimer("UpChat", 9000, true);                 // Limpar Chat
    for(new j; j < MAX_ORGS; j++)
	{
	    CarregarCofre(j);
	}
	/* Npcs Gerais - Bots do Servidor */
    new bottraficante = CreateDynamicActor(30, 556.2463, -203.3579, 16.7846, 250.8694);//Ator do Trafico de Drogas
    ApplyDynamicActorAnimation(bottraficante, "DEALER","DRUGS_BUY", 4.0, 1, 0, 0, 0, 0);
    CreateDynamic3DTextLabel("{FFD700}INFO\n\n{FFFFFF}Eai menor? vai transportar pra mim ou nao?\nPara Transportar Use: /aceitarmissao", -1, 556.2463,-203.3579,16.7846+1, 15.0);
    CreateDynamic3DTextLabel("{FFD700}INFO\n\n{FFFFFF}Para Carregar Utilize: /carregarkg", -1, 563.4730,-203.6026,15.8182+1, 25.0);
	// Banco
	BotAtendente = CreateDynamicActor(71, 2142.9478,1605.9424,993.5684,214.6177); // npc Banco Atendente
	SetDynamicActorVirtualWorld(BotAtendente, 333);
	ApplyDynamicActorAnimation(BotAtendente, "DEALER", "DEALER_IDLE", 4.0, 0, 1, 1, 1, -1);
    // Bots do Mapa
    CreateDynamicActor(211, 400.9667,-1796.2256,7.828,174.1443); // npc Spawn 1
    // Joalheria
	BotJO = CreateDynamicActor(11, 1856.1652,-1593.0793,13.6703,271.4201); // npc Joalheria Atendente
	ApplyDynamicActorAnimation(BotJO, "DEALER", "DEALER_IDLE", 4.0, 0, 1, 1, 1, -1);
    TextBotJO = CreateDynamic3DTextLabel("{FFD700}Fiscal de Joias{FFFFFF}\n\nMire no personagem para Ameaca-lo.", -1, 1856.1652,-1593.0793,13.6703+1, 15.0);
	TextBotAtendente = CreateDynamic3DTextLabel("{FFD700}Seguranca Nascimento{FFFFFF}\nOla, Aqui e Local Restrito\n\nMire no personagem para Abrir a Porta do Setor N?1.", -1, 2142.9478,1605.9424,993.5684+1, 15.0);
    TextPortaCofre = CreateDynamic3DTextLabel("{FFD700}Porta do Cofre{FFFFFF}\nSecurity Door\n\nPorta Setor N?1 {FFD700}Fechada!.", -1, 2144.1882, 1627.0665, 994.2648+1, 15.0);

	//[======================================MAPAS DO SERVIDOR========================================]
       //--------------------------[novo spawn civil]------------------------]
