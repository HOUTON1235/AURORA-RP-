				GameTextForPlayer(playerid, "~g~+$[4500]", 1000, 3);
				GivePlayerCash(playerid, 4500);
				ApplyDynamicActorAnimation(BotAtendente, "DEALER", "DEALER_IDLE", 4.0, 0, 1, 1, 1, -1);
