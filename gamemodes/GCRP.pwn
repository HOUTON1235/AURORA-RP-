		DOF2_SaveFile();
	}
	return 1;
}

stock SalvarGangzone(playerid, gzid)
{
    if(IsPlayerInGangZone(playerid, GangZoneTR[gzid]))
	{
		new orgid = GetPlayerOrg(playerid), org;
		format(arquivo, sizeof(arquivo), PASTA_GANGZONE, gzid);
		if(DOF2_FileExists(arquivo))
		{
			DOF2_SetString(arquivo, "Dono", PlayerName(playerid));
			DOF2_SetString(arquivo, "OrgDono", OrgInfo[orgid][OrgNome]);
			if(Pp[playerid][OrgLider] > 0)
			{
				org = Pp[playerid][OrgLider];
				DOF2_SetInt(arquivo, "GzOrgID", org);
			}
			if(Pp[playerid][OrgMembro] > 0)
			{
				org = Pp[playerid][OrgMembro];
				DOF2_SetInt(arquivo, "GzOrgID", org);
			}
			if(Pp[playerid][OrgSubLider] > 0)
			{
				org = Pp[playerid][OrgSubLider];
				DOF2_SetInt(arquivo, "GzOrgID", org);
			}
			DOF2_SaveFile();
		}
	}
	return 1;
}

stock CarregarGangzone(playerid, gzid)
{
	format(arquivo, sizeof(arquivo), PASTA_GANGZONE, gzid);
	if(DOF2_FileExists(arquivo))
	{
        format(GangZIF[gzid][Dono], 64, DOF2_GetString(arquivo, "Dono"));
		format(GangZIF[gzid][OrgDono], 64, DOF2_GetString(arquivo, "OrgDono"));

        GangZIF[gzid][OrgID] = DOF2_GetInt(arquivo, "GzOrgID");
        if(GangZIF[gzid][OrgID] >= 1 && GangZIF[gzid][OrgID] < 10)
        {
        	GangZoneShowForPlayer(playerid, GangZoneTR[gzid], 0x0000FFFF);
        }
        else if(GangZIF[gzid][OrgID] >= 11 && GangZIF[gzid][OrgID] < 15)
        {
            GangZoneShowForPlayer(playerid, GangZoneTR[gzid], 0xFF0000FF);
        }
        else if(GangZIF[gzid][OrgID] == 0)
        {
            GangZoneShowForPlayer(playerid, GangZoneTR[gzid], 0xFFFFFF96);
        }
	}
	return 1;
}
stock GetXYBehindOfVehicle(vehicleid, &Float:x, &Float:y, Float:distance)
{
    new Float: a;
    GetVehiclePos( vehicleid, x, y, a );
    GetVehicleZAngle( vehicleid, a );
    x += ( distance * floatsin( -a+180, degrees ));
    y += ( distance * floatcos( -a+180, degrees ));
}

stock GetPlayerOrg(playerid)
{
    new org;
	if(Pp[playerid][OrgLider] > 0)
	{
		org = Pp[playerid][OrgLider];
		return org;
	}
	if(Pp[playerid][OrgMembro] > 0)
	{
		org = Pp[playerid][OrgMembro];
		return org;
	}
	if(Pp[playerid][OrgSubLider] > 0)
	{
		org = Pp[playerid][OrgSubLider];
		return org;
	}
	return 0;
}

stock VeiculoProximo(playerid)
{
    new Float:X, Float:Y, Float:Z, id = -1;
    for(new I = 1; I < GetVehiclePoolSize()+1; I++)
    {
        GetVehiclePos(I, X, Y, Z);
        if(ISP(playerid, 3.0, X, Y, Z))
        {
            id = I;
            break;
        }
    }
    return id;
}

stock NomeVeiculo(vehicleid)
{
	new vehmodel = GetVehicleModel(vehicleid);
	new nameVeh[75];

	if (vehmodel < 400 || vehmodel > 611) {
		strcat(nameVeh, "Nenhum");
		return nameVeh;
	}
	strcat(nameVeh, VehicleNames[vehmodel - 400]);
	return nameVeh;
}
stock DemitirLider(playerid)
{
	SCM(playerid, COR_VERMELHO, "{FFFFFF}Voce foi demitido de Lider por um admin, agora voce e um Civil.");
	Pp[playerid][OrgLider] = 0;
	Pp[playerid][OrgCargo] = 0;
	SpawnPlayer(playerid);
	return 1;
}

stock PlayerName(playerid)
{
	new Nome[24];
	GetPlayerName(playerid, Nome, sizeof(Nome));
	return Nome;
}

stock getPlayerAdmin(playerid) {
	return Pp[playerid][Admin];
}

stock CreateStrip(Float:x,Float:y,Float:z)
{
    for(new i = 0; i < sizeof(SpikeInfo); i++)
  	{
  	    if(SpikeInfo[i][sCreated] == 0)
  	    {
            SpikeInfo[i][sCreated]=1;
            SpikeInfo[i][sX]=x;
            SpikeInfo[i][sY]=y;
            SpikeInfo[i][sZ]=z-0.7;
	        return 1;
  	    }
  	}
  	return 0;
}

stock DeleteAllStrip()
{
    for(new i = 0; i < sizeof(SpikeInfo); i++)
  	{
  	    if(SpikeInfo[i][sCreated] == 1)
  	    {
  	        SpikeInfo[i][sCreated]=0;
            SpikeInfo[i][sX]=0.0;
            SpikeInfo[i][sY]=0.0;
            SpikeInfo[i][sZ]=0.0;
            DestroyDynamicObject(SpikeInfo[i][sObject]);
  	    }
	}
    return 0;
}

stock DeleteClosestStrip(playerid)
{
    for(new i = 0; i < sizeof(SpikeInfo); i++)
  	{
       if(ISP(playerid, 100000.0, SpikeInfo[i][sX], SpikeInfo[i][sY], SpikeInfo[i][sZ]))
        {
  	        if(SpikeInfo[i][sCreated] == 1)
            {
                SpikeInfo[i][sCreated]=0;
                SpikeInfo[i][sX]=0.0;
                SpikeInfo[i][sY]=0.0;
                SpikeInfo[i][sZ]=0.0;
                DestroyDynamicObject(SpikeInfo[i][sObject]);
                return 1;
  	        }
       }
  	}
    return 0;
}

SoltarPreso(playerid)
{
	if(Pp[playerid][Preso] == true)
	{
	    SetPlayerInterior(playerid, 0);
		SetPlayerPos(playerid, 1552.6405,-1675.6466,16.1953);
		SetPlayerFacingAngle(playerid, 89.4822);
		SetCameraBehindPlayer(playerid);
		SetPlayerHealth(playerid, 100);
		GameTextForPlayer(playerid, "~w~SOLTO", 3000, 0);
		Pp[playerid][Preso] = false;
		Pp[playerid][PresoSegundos] = 0;
		Pp[playerid][PresoMinutos] = 0;
		Pp[playerid][PresoHoras] = 0;
        SetPlayerSkin(playerid, Pp[playerid][Skin]);
	 	PlayerTextDrawHide(playerid, TextdrawPrisao[0][playerid]);
		PlayerTextDrawHide(playerid, TextdrawPrisao[1][playerid]);
	}
	return 1;
}

encode_tires(tires1, tires2, tires3, tires4) {

	return tires1 | (tires2 << 1) | (tires3 << 2) | (tires4 << 3);

}
IsNumeric(const string[])
{
	for (new i = 0, j = strlen(string); i < j; i++)
	{
		if (string[i] > '9' || string[i] < '0') return 0;
	}
	return 1;
}
