			    ShowPlayerDialog(playerid, DIALOG_CCREDITOS, DIALOG_STYLE_INPUT, "Creditos", "Digite abaixo a quantidade de creditos que deseja comprar, Preco:{00FF00}$2", "Comprar", "X");
				return 1;
			}
			if(dim < creditos*2)
			{
				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao tem dinheiro suficiente.");
			    ShowPlayerDialog(playerid, DIALOG_CCREDITOS, DIALOG_STYLE_INPUT, "Creditos", "Digite abaixo a quantidade de creditos que deseja comprar, Preco:{00FF00}$2", "Comprar", "X");
				return 1;
			}
			GivePlayerCash(playerid, -creditos*2);
			PlayerPlaySound(playerid, 1150, 0.0, 0.0, 10.0);
			Pp[playerid][Creditos] = Pp[playerid][Creditos] + creditos;
			format(string, sizeof(string), "{FFDC33}Lojinha: {FFFFFF}Voce comprou %d creditos no valor de {00FF00}$%d{FFFFFF} agora podera fazer ligacoes.", creditos, creditos*2);
			SCM(playerid, -1, string);
		}
	}
	if(dialogid == DIALOG_OLX)
	{
		if(response)
		{
			if(strlen(inputtext))
			{
				if(GetPlayerCash(playerid) >= 200)
				{
					GivePlayerCash(playerid, -200);
					SCM(playerid, -1, "| {FFFFFF}O{00FF00}L{FF0000}X{FFFFFF} |{FFFFFF} Voce anunciou sua mensagem no valor de {00FF00}$200");

     				for(new i; i < MAX_PLAYERS; i++)
					{
						if(Pp[i][Logado] == true)
						{
							if(Pp[i][Celular] == true)
							{
								new string[1000];
								format(string, sizeof(string), "{00FF00}Anuncio: %s[%d] Anuncia: (%s) Use: /par %d", PlayerName(playerid), Pp[playerid][IDF], inputtext, Pp[playerid][IDF]);
								SendClientMessage(i, -1, string);
							}
						}
					}
				}
				else
				{
					SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao possui dinheiro suficiente.");
					ShowPlayerDialog(playerid, DIALOG_OLX, DIALOG_STYLE_INPUT, "{FFFFFF}Anuncios 0{FFDC33}L{00FF00}X", "{FFDC33}>> {FFFFFF}Digite o texto que deseja anunciar abaixo. {00FF00}$200", "Anunciar", "Sair");
				}
			}
			else
			{
				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Digite o texto do anuncio abaixo.");
				ShowPlayerDialog(playerid, DIALOG_OLX, DIALOG_STYLE_INPUT, "{FFFFFF}Anuncios 0{FFDC33}L{00FF00}X", "{FFDC33}>> {FFFFFF}Digite o texto que deseja anunciar abaixo. {00FF00}$200", "Anunciar", "Sair");
			}
		}
	}
	return 1;
}

