	    {
	    	DOF2_SetInt(File, "Cor", IfCarro[playerid][Cor]);
		    DOF2_SetInt(File, "Nitro", IfCarro[playerid][Nitro]);
		    DOF2_SetInt(File, "Hidraulica", IfCarro[playerid][Hidraulica]);
		    DOF2_SetInt(File, "Roda", IfCarro[playerid][Roda]);
		    DOF2_SetInt(File, "Spoiler", IfCarro[playerid][Spoiler]);
		    DOF2_SetInt(File, "Placa", IfCarro[playerid][Placa]);
		    DOF2_SetInt(File, "ArmaM4", IfCarro[playerid][ArmaM4]);
		    DOF2_SetInt(File, "MunM4", IfCarro[playerid][MunM4]);
		    DOF2_SetInt(File, "ArmaMP5", IfCarro[playerid][ArmaMP5]);
		    DOF2_SetInt(File, "MunMP5", IfCarro[playerid][MunMP5]);
		    DOF2_SetInt(File, "ArmaDesert", IfCarro[playerid][ArmaDesert]);
		    DOF2_SetInt(File, "MunDesert", IfCarro[playerid][MunDesert]);
		    DOF2_SetInt(File, "Shotgun", IfCarro[playerid][Shotgun]);
		    DOF2_SetInt(File, "MunShot", IfCarro[playerid][MunShot]);
		    DOF2_SetInt(File, "ArmaAk", IfCarro[playerid][ArmaAk]);
		    DOF2_SetInt(File, "MunAk", IfCarro[playerid][MunAk]);
		    DOF2_SetInt(File, "GasVeh", Combustivel[VehConce[playerid]]);
		    DOF2_SetInt(File, "TemPlaca", IfCarro[playerid][TemPlaca]);
		    DOF2_SetInt(File, "VehAp", IfCarro[playerid][VehAp]);
		    DOF2_SetInt(File, "TemCarro", IfCarro[playerid][TemCarro]);
		    DOF2_SaveFile();
		}
    }
    return 1;
}

stock SalvarImpostos()
{
	new File[5000];
 	format(File, sizeof(File), PASTA_IMPOSTOS);
  	if(DOF2_FileExists(File))
   	{
   		DOF2_SetInt(File, "ImpostosGerais", Impostos[ImpostoG]);
   		DOF2_SetInt(File, "CombustivelGerais", Impostos[CombustivelG]);
   		DOF2_SetInt(File, "IluminacaoGerais", Impostos[IluminacaoG]);
        DOF2_SetInt(File, "ImpostoDeRendaGerais", Impostos[ImpostoDeRendaG]);
        DOF2_SetInt(File, "SalarioCorpsGerais", Impostos[SalarioCorpsG]);
        DOF2_SetInt(File, "DinheiroDispGov", Impostos[DinheiroDispGov]);
	    DOF2_SaveFile();
	}
    return 1;
}

stock CarregarImpostos()
{
	format(arquivo, sizeof(arquivo), PASTA_IMPOSTOS);
	if(DOF2_FileExists(arquivo))
	{
		Impostos[ImpostoG] = DOF2_GetInt(arquivo, "ImpostosGerais");
