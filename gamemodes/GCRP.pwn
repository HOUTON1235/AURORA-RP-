CMD:cadeia(playerid, params[])
{
	new id, motivo[30 + 1], String[220], tempo;
    if(Pp[playerid][Admin] < 1) return false;
    if(sscanf(params, "dds[30]", id, tempo, motivo)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /cadeia [IDF] [MINUTOS] [MOTIVO]");

    for(new i; i < MAX_PLAYERS; i++) {
		if(Pp[i][Logado] == false) continue;
		if(Pp[i][IDF] != id) continue;
        if(tempo >= 1)
		{
			format(String, sizeof(String), "[INFO] O Admin: %s[%d] deu cadeia no jogador: %s por: %d pelo motivo: %s", PlayerName(playerid), Pp[playerid][IDF], PlayerName(i), tempo, motivo);
			SendClientMessageToAll(COLOR_LIGHTRED, String);
			Pp[i][PresoHoras] = 0;
			Pp[i][PresoMinutos] = tempo;
			Pp[i][PresoSegundos] = 59;
			SetPlayerPos(i, 948.7023,2106.0054,1011.0234);
			SetPlayerSkin(i, 268);
			SetPlayerFacingAngle(i, 359.4802);
			SetPlayerInterior(i, 1);
			SetCameraBehindPlayer(i);
			SetPlayerHealth(i, 9999);
			GameTextForPlayer(i, "~w~Cadeia Staff", 1500, 0);
			ResetPlayerWeapons ( i ) ;
			Pp[i][Mutado] = 1;
			Pp[i][MinutosMutado] = tempo * 60;
			SvMutePlayerEnable(i);
			Pp[i][Preso] = true;
			SalvarDados(i);
            SpawnPlayer(i);
		}
		else
		{
			if(tempo == 0)
			{
				format(String, sizeof(String), "Soltura: O Admin: %s[%d] soltou o jogador da cadeia pelo motivo: %s", PlayerName(playerid), Pp[playerid][IDF], PlayerName(i), motivo);
				SendClientMessageToAll(COLOR_LIGHTRED, String);
				for(new i2; i2 < 2; i2++)
				{
					PlayerTextDrawHide(i, TextdrawPrisao[i2][i]);
				}
				Pp[i][PresoHoras] = 0;
				Pp[i][PresoMinutos] = 0;
				Pp[i][PresoSegundos] = 0;
				Pp[i][Mutado] = 0;
				Pp[i][MinutosMutado] = 0;
				SvMutePlayerDisable(i);
				SetPlayerSkin(i, Pp[playerid][Skin]);
				SetPlayerHealth(i, 100);
				SetPlayerInterior(i, 0);
				SetPlayerVirtualWorld(i, 0);
				GameTextForPlayer(i, "~w~Solto", 1500, 0);
				ResetPlayerWeapons ( i ) ;
				Pp[i][Preso] = false;
				SalvarDados(i);
				SpawnPlayer(i);
                format(gstring, sizeof(gstring), "ID'sPresos/%d.ini", Pp[i][IDF]);
    			if(DOF2_FileExists(gstring))
    			{
    				DOF2_RemoveFile(gstring);
    			}
			}
		}
    	return 1;
    }
	return 1;
}

CMD:rscar(playerid,params[])
{
	new String[220], id;
	if(Pp[playerid][Admin] >= 1)
	{
	    if(sscanf(params,"i",id))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /rscar [IDF]");
		{
   			for(new i; i < MAX_PLAYERS; i++)
