CMD:vendercoins(playerid, params[])
{
	new id, coins, preco;
	if(Pp[playerid][Coins] >= 1)
	{
	    if(sscanf(params,"iii",id,coins,preco))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /vendercoins [IDF] [Coins] [Reais]");
	    {
         	for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
				        if(id == Pp[playerid][IDF])
						{
				 			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Vender Coins!");
						 	return 1;
						}
				        if(Pp[playerid][Coins] > 1)
				        {
				            if(preco >= 1000000)
				            {
				                if(GetPlayerCash(i) >= preco)
				                {
									new string[10000];
							        SendClientMessageEx(playerid, -1, "{FFDC33}INFO Coins. {FFFFFF}Voce Vendeu %d Coins Para o Player: %s", coins, PlayerName(playerid));
								    format(string, sizeof(string), "* O ID:[%d] Vendeu Coins Para o ID:[%d]", Pp[playerid][IDF], Pp[i][IDF]);
				    				ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE, COR_PURPLE, COR_PURPLE, COR_PURPLE);
								    Pp[i][Coins] += coins;
								    Pp[playerid][Coins] -= coins;
                                    GivePlayerCash(playerid, preco);
                                    GivePlayerCash(i, -preco);
								    return 1;
								}
								else
								{
								    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Nao tem Tudo isso de Dinheiro");
								}
		                    }
							else
							{
							    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Valor Minimo para Venda de Coins: R$1.000.000");
							    return 1;
							}
						}
						else
						{
						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce precisa ter no minimo 1 dolar para vender");
						    return 1;
						}
				    }
				}
			}
			return 1;
		}
 	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem Coins");
	    return 1;
	}
}

CMD:amarrar(playerid, params[])
{
    if(IsBandido(playerid))
    {
		new id, String[220];
		if(sscanf(params,"i",id))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /amarrar [IDF]");
		{
      		for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
						if(id == Pp[playerid][IDF])
						{
						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode amarrar voce mesmo");
						}
		 	 			if(GetDistanceBetweenPlayers(playerid, i) < 10)
			  			{
			  			    if(amarrado[i] == 0)
			  			    {
								TogglePlayerControllable(i, 0);
								ProtecaoAlgemas[i] = SetTimerEx("k", 500, true, "d", i);
								GameTextForPlayer(i, "~r~Amarrado", 1500, 0);
								amarrado[i] = 1;
								format(String,sizeof(String),"{FFFFFF}Voce foi amarrado pelo criminoso %s",PlayerName(playerid));
								SendClientMessage(i,-1,String);
								format(String,sizeof(String),"{FFFFFF}%s foi amarrado pelo %s",PlayerName(i),PlayerName(playerid));
								SCM(playerid,-1,String);
							}
							else
							{
							    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Ja esta Amarrado");
							}
						}
						else
						{
							SCM(playerid,-1, "{FFD700}INFO: {FFFFFF}Chegue mais perto para amarrar");
						}
					}
				}
			}
		}
	}
	else
	{
		SCM(playerid,-1, "{FFD700}INFO: {FFFFFF}Voce nao e um criminoso para amarrar");
	}
	return 1;
}

CMD:verificarplaca(playerid, params[])
{
	if(IsPolicial(playerid))
	{
	    new id;
	   	if(sscanf(params, "i", id)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /verificarplaca [IDF]");
	   	{
         	for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
				    	if(id == Pp[playerid][IDF])
						{
							SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Verificar Placa!");
					 		return 1;
						}
						new Float:CarregarVeh[3];
			   			GetPlayerPos(i, CarregarVeh[0], CarregarVeh[1], CarregarVeh[2]);
			      		if(ISP(playerid, 3.0, CarregarVeh[0], CarregarVeh[1], CarregarVeh[2]))
			   			{
					  		if(IfCarro[i][TemCarro] == 1)
					    	{
						    	if(IfCarro[i][TemPlaca] == 1)
					 	    	{
					 	    	    new string[450], String[220];
					 	    	    SendClientMessageEx(playerid, -1, "{FFFFFF}Id Placa do Suspeito: {FFDC33}%d {FFD700}Anotado!", IfCarro[i][TemPlaca]);
					 	    	    format(String,sizeof(String),"* O ID:[%d] Esta Verificando a Placa do ID:[%d]",Pp[playerid][IDF], Pp[i][IDF]);
									ProxDetector(15.0, playerid, String, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
									return 1;
					  	    	}
					   	    	else
						   	    {
						        	SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player nao tem Placa");
					   	    	}
					   	    }
					   	    else
					   	    {
					        	SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player nao tem um Veiculo");
					   	    }
						}
						else
						{
						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a este Player");
						}
					}
				}
			}
			return 1;
	   	}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e de Corporacao");
	}
	return 1;
}

CMD:desamarrar(playerid, params[])
{
	if(IsBandido(playerid))
    {
        new id;
    	if(sscanf(params,"i",id))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /desamarrar [IDF]");
    	{
         	for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
				        if(id == Pp[playerid][IDF])
				        {
				            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Desamarrar");
				        }
			    	    if(amarrado[i] == 1)
				    	{
						    GameTextForPlayer(i, "~w~Voce Foi Solto Pela ~r~Gangue", 2500, 0);
							TogglePlayerControllable(i, 1);
							amarrado[i] = 0;
							KillTimer(ProtecaoAlgemas[i]);
							SetTimerEx("DCANIM", 200, false, "i", i);
							return 1;
						}
						else
						{
						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Nao esta Amarrado");
						}
					}
				}
			}
			return 1;
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e de Org");
	}
	return 1;
}

CMD:bq(playerid)
{
	new Float:X, Float:Y, Float:Z;
    if(Pp[playerid][Preso] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
    if(IsBandido(playerid))
    {
        if(UsouBrg[playerid] == 0)
        {
	        UsouBrg[playerid] = 1;
	        if (pRoadblock[playerid] != 0) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce so pode criar 1 barreira por vez, /rbr - para remover sua barreira");
			new Float:A;
			GetPlayerPos(playerid, X, Y, Z);
			GetPlayerFacingAngle(playerid, A);
			pRoadblock[playerid] = CreateObject(1358, X, Y, Z, 0.0, 0.0, A+180, 300.0);
			SetPlayerPos(playerid, X, Y, Z+4);
			GameTextForPlayer(playerid, "~w~Barreira ~g~Criada", 5000, 0);
			SCM(playerid, -1, "{FF00FF}: {FFFFFF}Barreira Implantada... Use /rbrg Para Remove-la!");
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce so pode usar Brg Uma Vez");
		    return 1;
		}
        return 1;
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e de Uma Org");
        return 1;
    }
}
CMD:rbq(playerid)
{
    if(IsBandido(playerid))
    {
        if(UsouBrg[playerid] == 1)
        {
	        if (pRoadblock[playerid] != 0)
			{
				RemoveRoadblock(playerid);
				SCM(playerid, -1, "{FFFFFF}Voce retirou a sua barreira!");
			}
			else
			{
				SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao criou uma barreira!");
			}
			UsouBrg[playerid] = 0;
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao criou Brg");
		    return 1;
		}
        return 1;
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e de Uma Org");
        return 1;
    }
}

CMD:ab(playerid)
{
	new String[220], org = GetPlayerOrg(playerid);
	if(IsPolicial(playerid))
    {
        format(String,sizeof(String),"{836FFF}*** [{FFFFFF}%s{836FFF}]%s: PARE O VEICULO, DESCA, E VAI PAREDE, AGORA!!! ***", OrgInfo[org][OrgNome], PlayerName(playerid));
        for(new i; i < MAX_PLAYERS; i++)
        {
            new Float:X123, Float:Y123, Float:Z123;
            GetPlayerPos(playerid, X123, Y123, Z123);
    		if(ISP(i, 30.0, X123, Y123, Z123))
    		{
                GameTextForPlayer(i, "~w~Abordagem ~b~Policial", 2000, 6);
            }
        }
        ProxDetector(60.0, playerid, String, -1,-1,-1,-1,-1);
    }
	else if(IsBandido(playerid))
    {
        format(String,sizeof(String),"{FFD700}*** [{FFFFFF}%s{FFD700}]%s: PARE AGORA!!!, DESCA E RENDA-SE!!! ***", OrgInfo[org][OrgNome], PlayerName(playerid));
        for(new i; i < MAX_PLAYERS; i++)
        {
            new Float:X123, Float:Y123, Float:Z123;
            GetPlayerPos(playerid, X123, Y123, Z123);
    		if(ISP(i, 30.0, X123, Y123, Z123))
    		{
                GameTextForPlayer(i, "~w~Abordagem ~r~Crime", 2000, 6);
            }
        }
        ProxDetector(60.0, playerid, String, -1,-1,-1,-1,-1);
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Policial e Nem um Criminoso.");
    }
	return 1;
}

CMD:kitadm(playerid)
{
    if(Pp[playerid][Admin] >= 6)
	{
		GivePlayerWeapon(playerid, 6, 1);
		GivePlayerWeapon(playerid, 24, 999);
		GivePlayerWeapon(playerid, 31, 999);
		GivePlayerWeapon(playerid, 29, 999);
		GivePlayerWeapon(playerid, 25, 999);
		GivePlayerWeapon(playerid, 43, 999);
		GivePlayerWeapon(playerid, 34, 999);
		GivePlayerWeapon(playerid, 16, 12);
		GivePlayerWeapon(playerid, 42, 1999);
		SetPlayerArmour(playerid, 100);
		SetPlayerHealth(playerid, 100);
		GameTextForPlayer(playerid, "~w~KitAdmin ~g~Equipado!", 2000, 3);
		new Float:pX, Float:pY, Float:pZ;
		GetPlayerPos(playerid,pX,pY,pZ);
		PlayerPlaySound(playerid,1056,pX,pY,pZ);
	}
    else if(Pp[playerid][Admin] >= 4)
	{
		if(Trabalhando[playerid] == true)
	    {
			GivePlayerWeapon(playerid, 6, 1);
			GivePlayerWeapon(playerid, 24, 999);
			GivePlayerWeapon(playerid, 31, 999);
			GivePlayerWeapon(playerid, 29, 999);
			GivePlayerWeapon(playerid, 25, 999);
			GivePlayerWeapon(playerid, 43, 999);
		    GivePlayerWeapon(playerid, 34, 999);
			GivePlayerWeapon(playerid, 16, 12);
			GivePlayerWeapon(playerid, 42, 1999);
			SetPlayerArmour(playerid, 100);
			SetPlayerHealth(playerid, 100);
		    GameTextForPlayer(playerid, "~w~KitAdmin ~g~Equipado!", 2000, 3);
		    new Float:pX, Float:pY, Float:pZ;
		    GetPlayerPos(playerid,pX,pY,pZ);
		    PlayerPlaySound(playerid,1056,pX,pY,pZ);
		}
		else
		{
		    SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta em modo trabalho");
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	}
	return 1;
}

