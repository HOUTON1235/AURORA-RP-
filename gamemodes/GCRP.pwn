                    format(TRString,sizeof(TRString),"~n~%s: ~w~%d~n~%s: ~w~%d~n~%s: ~w~%d~n~%s: ~w~%d~n~%s: ~w~%d~n~%s: ~w~%d~n~%s: ~w~%d~n~%s: ~w~%d~n~%s: ~w~%d~n~%s: ~w~%d~n~%s: ~w~%d~n~%s: ~w~%d~n~%s: ~w~%d~n~%s: ~w~%d~n~%s: ~w~%d~n~%s: ~w~%d", NomeOrg2, GuettoPontos[2], NomeOrg3, GuettoPontos[3], NomeOrg8, GuettoPontos[8], NomeOrg27, GuettoPontos[27], NomeOrg29, GuettoPontos[29], NomeOrg36, GuettoPontos[36], NomeOrg11, GuettoPontos[11], NomeOrg12, GuettoPontos[12], NomeOrg17, GuettoPontos[17], NomeOrg18, GuettoPontos[18], NomeOrg19, GuettoPontos[19], NomeOrg20, GuettoPontos[20], NomeOrg21, GuettoPontos[21], NomeOrg30, GuettoPontos[30], NomeOrg31, GuettoPontos[31], NomeOrg35, GuettoPontos[35]);
					PlayerTextDrawSetString(i, CorpsEOrgs[i], TRString);
                    PlayerTextDrawShow(i, CorpsEOrgs[i]);
                    PlayerTextDrawShow(i, CorpsEOrgs2[i][0]);
				}
                else
                {
                    PlayerTextDrawHide(i, CorpsEOrgs[i]);
                    PlayerTextDrawHide(i, CorpsEOrgs2[i][0]);
                }
			}
            else
            {
                PlayerTextDrawHide(i, CorpsEOrgs[i]);
                PlayerTextDrawHide(i, CorpsEOrgs2[i][0]);
