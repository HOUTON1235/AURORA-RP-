  	{
     	case 0: format(gstring, sizeof(gstring), "[DESCONNECT] O Jogador ID:[%d] deslogou pelo motivo: ({FFD700}Conexao ou crash{FFFFFF})", Pp[playerid][IDF]);
     	case 1: format(gstring, sizeof(gstring), "[DESCONNECT] O Jogador ID:[%d] deslogou pelo motivo: ({FFD700}Quitou - /q{FFFFFF})", Pp[playerid][IDF]);
     	case 2: format(gstring, sizeof(gstring), "[DESCONNECT] O Jogador ID:[%d] deslogou pelo motivo: ({FFD700}Kickado ou Banido{FFFFFF})", Pp[playerid][IDF]);
  	}
  	ProxDetector(15.0, playerid, gstring,-1,-1,-1,-1,-1);
	return 1;
}

public OnPlayerSpawn(playerid)
{
    if(IsPlayerNPC(playerid))
    {
        new
			lu,
			alar,
			por,
			cap,
			porma,
			ob
		;
        if(!strcmp(PlayerName(playerid), "Oficer_Onibus", true))
        {
        	PutPlayerInVehicle(playerid, OnibusNpc[0], 0);
            motor[OnibusNpc[0]] = true;
   			SetVehicleParamsEx( OnibusNpc[0], VEHICLE_PARAMS_ON, lu, alar, por, cap, porma, ob );
   			printf("[BOT] %s spawnado novamente.", PlayerName(playerid));
		}
        else if(!strcmp(PlayerName(playerid), "Oficer_Helicoptero", true))
        {
        	PutPlayerInVehicle(playerid, OnibusNpc[1], 0);
            motor[OnibusNpc[1]] = true;
   			SetVehicleParamsEx( OnibusNpc[1], VEHICLE_PARAMS_ON, lu, alar, por, cap, porma, ob );
   			printf("[BOT] %s spawnado novamente.", PlayerName(playerid));
		}
	}
 	else
 	{
		//Variaveis e Definicoes
 	    StopAudioStreamForPlayer(playerid);
	    PlayerPlaySound(playerid,1063,0.0,0.0,0.0);
	    PlayerPlaySound(playerid,1098,0.0,0.0,0.0);
		if(Pp[playerid][Logado] == false)
		{
			if(CriandoPersonagem[playerid] == false)
			{
				if(!IsPlayerNPC(playerid))
			    {
					Kick(playerid);
				}
			}
		}
		// SKILLS
		SetPlayerSkillLevel(playerid,WEAPONSKILL_PISTOL,200);
	    SetPlayerSkillLevel(playerid,WEAPONSKILL_MICRO_UZI,200);
		// SKIN
		SetPlayerSkin(playerid, Pp[playerid][Skin]);
		if(Pp[playerid][ChapelN] == 1)
		{
		    SetPlayerAttachedObject(playerid, 5, 19064, 2, 0.1109, 0.0310, 0.0100, 16.9999, 77.8000, 86.4999, 1.0000, 1.0000, 1.0000); // SantaHat1 attached to the Head of Apxgui_Staff
		}
		if(Pp[playerid][Guitarra] == 1)
		{
		    SetPlayerAttachedObject(playerid, 9, 19317, 1, 0.0000, -0.1059, 0.0000, 0.0000, 70.6999, -1.6999, 0.7700, 1.0000, 0.7489); // bassguitar01 attached to the Spine of Apxgui_Staff
		}
	    if(Pp[playerid][PcBruxa] == 1)
		{
		    SetPlayerAttachedObject(playerid, 6, 19528, 2, 0.1269, 0.0000, 0.0000, 0.0000, 0.0000, -23.4999, 1.0000, 1.0000, 1.0000); // WitchesHat1 attached to the Head of Apxgui_Staff
			SetPlayerAttachedObject(playerid, 4, 19527, 1, -0.3419, -0.2579, 0.0000, 0.0000, 84.8999, 0.0000, 0.5030, 0.5229, 0.5449); // Cauldron1 attached to the Spine of Apxgui_Staff
		}
	    if(Pp[playerid][CabecaBru] == 1)
	    {
	        SetPlayerAttachedObject(playerid, 6, 19528, 2, 0.1269, 0.0000, 0.0000, 0.0000, 0.0000, -23.4999, 1.0000, 1.0000, 1.0000); // WitchesHat1 attached to the Head of Apxgui_Staff
	    }
	    if(Pp[playerid][CjCabeca] == 1)
		{
	        SetPlayerAttachedObject(playerid, 8, 18963, 2, 0.1810, 0.0149, -0.0430, 0.0000, 109.9999, 90.0999, 2.4629, 2.4050, 2.7230);
	    }
		//orgs
		if(Pp[playerid][LocalSP] == 0 && Pp[playerid][OrgLider] != 0 && Pp[playerid][Ferido] == false && CriandoPersonagem[playerid] == false)
		{
			SetPlayerPos(playerid, OrgInfo[Pp[playerid][OrgLider]][SpawnX], OrgInfo[Pp[playerid][OrgLider]][SpawnY], OrgInfo[Pp[playerid][OrgLider]][SpawnZ]);
			SetPlayerFacingAngle(playerid, OrgInfo[Pp[playerid][OrgLider]][SpawnR]);
		}
		if(Pp[playerid][LocalSP] == 0 && Pp[playerid][OrgSubLider] != 0 && Pp[playerid][Ferido] == false && CriandoPersonagem[playerid] == false)
		{
			SetPlayerPos(playerid, OrgInfo[Pp[playerid][OrgSubLider]][SpawnX], OrgInfo[Pp[playerid][OrgSubLider]][SpawnY], OrgInfo[Pp[playerid][OrgSubLider]][SpawnZ]);
			SetPlayerFacingAngle(playerid, OrgInfo[Pp[playerid][OrgSubLider]][SpawnR]);
		}
		if(Pp[playerid][LocalSP] == 0 && Pp[playerid][OrgMembro] != 0 && Pp[playerid][Ferido] == false && CriandoPersonagem[playerid] == false)
		{
			SetPlayerPos(playerid, OrgInfo[Pp[playerid][OrgMembro]][SpawnX], OrgInfo[Pp[playerid][OrgMembro]][SpawnY], OrgInfo[Pp[playerid][OrgMembro]][SpawnZ]);
			SetPlayerFacingAngle(playerid, OrgInfo[Pp[playerid][OrgMembro]][SpawnR]);
		}
	  	if(Pp[playerid][Casa] >= 0 && Pp[playerid][LocalSP] == 1 && CriandoPersonagem[playerid] == false)
		{
	 		//Carregamento
	 		SetTimerEx("CarregandoObjetos", 5000, false, "d", playerid);
	        for(new i = 1; i < 3; i++){PlayerTextDrawShow(playerid, TdCarregarINT[playerid][i]);}
	 		Controle(playerid, 0);
			Pp[playerid][Entrada] = Pp[playerid][Casa];
			SetPlayerPos(playerid, CasaInfo[Pp[playerid][Casa]][CasaInteriorX], CasaInfo[Pp[playerid][Casa]][CasaInteriorY], CasaInfo[Pp[playerid][Casa]][CasaInteriorZ]);
			SetPlayerInterior(playerid, CasaInfo[Pp[playerid][Casa]][CasaInterior]);
			SetPlayerVirtualWorld(playerid, Pp[playerid][Casa]);
	        SetPlayerSkin(playerid, Pp[playerid][Skin]);
		}
		if(CriandoPersonagem[playerid] == true)
		{
	        for(new i = 1; i < 3; i++){PlayerTextDrawShow(playerid, TdCarregarINT[playerid][i]);}
			Controle(playerid, 0);
			SetTimerEx("CarregandoObjetos", 2000, false, "i", playerid);
		    SetPlayerVirtualWorld(playerid, 0);
			SetPlayerInterior(playerid, 0);
			SetPlayerPos(playerid, -2719.3230,-316.4448,57.4873);
			SetPlayerFacingAngle(playerid, 222.2180);
		}
	    if(Pp[playerid][Preso] == true && CriandoPersonagem[playerid] == false)
	    {
	        SetPlayerWantedLevel(playerid, 0);
	    	SetPlayerPos(playerid, 948.7023,2106.0054,1011.0234);
			SetPlayerFacingAngle(playerid, 359.4802);
			SetPlayerInterior(playerid, 1);
	        if(Pp[playerid][Sexo] == 1)
	        {
	            SetPlayerSkin(playerid, 268);
	        }
	        else if(Pp[playerid][Sexo] == 2)
	        {
	            SetPlayerSkin(playerid, 41);
	        }
			SetCameraBehindPlayer(playerid);
			SetPlayerHealth(playerid, 999999);
			PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "~r~Preso");
			ResetPlayerWeapons (playerid) ;
	    }
	    if(Pp[playerid][Ferido] == true && CriandoPersonagem[playerid] == false)
		{
	        SetPlayerInterior(playerid, Pp[playerid][Interior]);
	        SetPlayerVirtualWorld(playerid, 0);
		    ProtecaoAlgemas[playerid] = SetTimerEx("k", 500, true, "d", playerid);

	        new string[500];
			SetPlayerPos(playerid, Pp[playerid][FeridoPosX], Pp[playerid][FeridoPosY], Pp[playerid][FeridoPosZ]+0.9);
			TimerFerido[playerid] = SetTimerEx("JogadorFerido", 1000, true, "d", playerid);

			format(string, sizeof(string), "~w~Tempo de Resistencia: %02d:%02d", Pp[playerid][MinutosFerido], Pp[playerid][SegundosFerido]);
			PlayerTextDrawSetString(playerid, TextDrawMorte[playerid][2], string);
	        for(new i = 1; i < 4; i++)
	        {
	            PlayerTextDrawShow(playerid, TextDrawMorte[playerid][i]);
	        }
		}
		if(Pp[playerid][Mochila] == 1)
		{
		    SetPlayerAttachedObject(playerid, 7, 3026, 1, -0.1640, -0.0929, 0.0000, 0.0000, 0.0000, 0.0000, 1.0000, 1.0000, 1.0000, 0xFFFFFFFF, 0xFFFFFFFF);
		}
		if(Pp[playerid][TemCarro2] == 1)
		{
	    	CarregaCarro(playerid);
	    }
		if(Pp[playerid][ColocouCapacete] == true)
		{
			SetPlayerAttachedObject(playerid, 8, 18645, 2, 0.07, 0, 0, 88, 75, 0 );
			Pp[playerid][ColocouCapacete] = true;
		}
		if(!CarregouArmas[playerid])
		{
		    new arq[5000], str[5000], wid, wammo;
		    ResetPlayerWeapons(playerid);
		    format(arq, sizeof(arq), "ArmasPlayer/%s.ini", PlayerName(playerid));
		    if(DOF2_FileExists(arq))
			{
			    for(new i = 0; i < 13; i++)
				{
				    format(str, sizeof(str), "Arma%d", i);
					wid = DOF2_GetInt(arq, str);
					format(str, sizeof(str), "Municao%d", i);
					wammo = DOF2_GetInt(arq, str);
					GivePlayerWeapon(playerid, wid, wammo);
				}
				CarregouArmas[playerid] = true;
			}
		}
	    // Gangzones do Servidor
	    GangZoneShowForPlayer(playerid, GangZoneTR[0], 0xFF7F00FF);
	    GuettoShowForPlayer(playerid);
	    MorroShowForPlayer(playerid);
	    FABShowForPlayer(playerid);
		for(new i; i < 3; i++)
		{
			GangZoneShowForPlayer(playerid, SafeZone[i],  0xBEBEBEAA);
		}
		//Gangzones Carregamento por id
	    CarregarGangzone(playerid, 0);
	
	    StopAudioStreamForPlayer(playerid);
	
	}
	return 1;
}

public OnPlayerGiveDamage(playerid, damagedid, Float:amount, weaponid, bodypart)
{
	for(new i; i < 3; i++)
	{
	    if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
		{
		    if(Pp[playerid][Logado] == true)
			{
				if(!IsPlayerInGangZone(damagedid, SafeZone[i]))
				{
                    if(!ISP(damagedid, 200.0, 948.7023, 2106.0054, 1011.0234))
					{
    				    if(bodypart == 9)
    		  			{
    						if(GetPlayerWeapon(playerid) == 34 || GetPlayerWeapon(playerid) == 33)
    						{
    							PlayerPlaySound(playerid, 17802,0.0,0.0,0.0);
    							PlayerPlaySound(damagedid, 17802,0.0,0.0,0.0);
                    		    SetPlayerHealth(damagedid, 0.0);
    							PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "~r~Headshot");
    							PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "~g~Headshot");
    						}
          					else
          					{
                                PlayerPlaySound(playerid, 17802,0.0,0.0,0.0);
    							PlayerPlaySound(damagedid, 17802,0.0,0.0,0.0);
           						new Float:vida;
                       	        GetPlayerHealth(damagedid, Float:vida);
                    		    SetPlayerHealth(damagedid, vida-40);
    							PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "~r~+40 de dano!");
    							PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "~g~Headshot ~r~-40 de dano");
           					}
    					}
    		  			else
    					{
         					PlayerPlaySound(playerid, 17802,0.0,0.0,0.0);
    				   		PlayerPlaySound(damagedid, 17802,0.0,0.0,0.0);
    				   		return 1;
    					}
                    }
                    else
    				{
    					new Float:health, Float:X, Float:Y, Float:Z, string[100];

    					// Tomou dano
    					GetPlayerHealth(damagedid, Float:health);
    					SetPlayerHealth(damagedid, health);

    					// Atirador
    					GetPlayerPos(playerid, Float:X, Float:Y, Float:Z);
    					SetPlayerPos(playerid, X, Y, Z);
    					GameTextForPlayer(playerid, "~r~Area Safe...", 2000, 3);
    					ClearAnimations(playerid);

    					Controle(playerid, 0);
    					SetTimerEx("CarregandoObjetos", 2000, false, "i", playerid);
                        ResetPlayerWeapons(playerid);

    					VLimparAvisos[playerid] = SetTimerEx("LimparAvisos", 50000, true, "i", playerid);

    					dmsafe[playerid] ++;

    					format(string, sizeof(string), "{FFFFFF}[INFO] E proibido bater em jogadores em area safe (0%d/03).", dmsafe[playerid]);
    					SCM(playerid, COR_VERMELHO, string);
    				}
				}
				else
				{
					new Float:health, Float:X, Float:Y, Float:Z, string[100];

					// Tomou dano
					GetPlayerHealth(damagedid, Float:health);
					SetPlayerHealth(damagedid, health);

					// Atirador
					GetPlayerPos(playerid, Float:X, Float:Y, Float:Z);
					SetPlayerPos(playerid, X, Y, Z);
					GameTextForPlayer(playerid, "~r~Area Safe...", 2000, 3);
					ClearAnimations(playerid);

					Controle(playerid, 0);
					SetTimerEx("CarregandoObjetos", 2000, false, "i", playerid);

					VLimparAvisos[playerid] = SetTimerEx("LimparAvisos", 50000, true, "i", playerid);

					dmsafe[playerid] ++;

					format(string, sizeof(string), "{FFFFFF}[INFO] E proibido bater em jogadores em area safe (0%d/03).", dmsafe[playerid]);
					SCM(playerid, COR_VERMELHO, string);
				}
				new Infod[5000];
			    format(Infod, 50, "DANO -%.0f", amount);
			    TextDrawSetString(Atingir[0], Infod);
			    TextDrawShowForPlayer(playerid, Atingir[0]);
			    SetTimerEx("RemoveTextDraw", 2000, false, "i", playerid);
			}
		}
	}
    return 1;
}

public OnPlayerDeath(playerid, killerid, reason)
{
	//Morte do Player
    ResetPlayerWeapons(playerid);
    // Sistema de Morte
    CarregarMorteP(playerid);
    OrgConfigID[playerid] = 0;
    if(Pp[killerid][Logado] == true)
    {
        GameTextForPlayer(killerid, "~r~Matou", 6000, 6);
    }
    // Sistema de Guerra no Guetto
    if(GuettoInfo[Guerra] >= 1)
	{
	    new killerorg = GetPlayerOrg(killerid), org = GetPlayerOrg(playerid);
	    if(OrgPodeGuerriarGuetto(playerid,org) && OrgPodeGuerriarGuetto(killerid,killerorg))
    	{
            if(IsPlayerInGangZone(playerid, GangZoneTRG[0]) && IsPlayerInGangZone(killerid, GangZoneTRG[0]))
			{
	       		GuettoPontos[killerorg] += 5;
			}
		}
	}
    // Sistema de Guerra no Morro
    if(MorroInfo[Guerra] >= 1)
	{
	    new killerorg = GetPlayerOrg(killerid), org = GetPlayerOrg(playerid);
	    if(OrgPodeGuerriarMorro(playerid,org) && OrgPodeGuerriarMorro(killerid,killerorg))
    	{
            if(IsPlayerInGangZone(playerid, GangZoneTR[0]) && IsPlayerInGangZone(killerid, GangZoneTR[0]))
			{
	       		MorroPontos[killerorg] += 5;
			}
		}
	}
    // Sistema de Guerra na Fab de Armas
    if(FABInfo[Guerra] >= 1)
	{
	    new killerorg = GetPlayerOrg(killerid), org = GetPlayerOrg(playerid);
	    if(OrgPodeGuerriarFAB(playerid,org) && OrgPodeGuerriarFAB(killerid,killerorg))
    	{
            if(IsPlayerInGangZone(playerid, GangZoneTRF[0]) && IsPlayerInGangZone(killerid, GangZoneTRF[0]))
			{
	       		FABPontos[killerorg] += 5;
			}
		}
	}
    if(Neon[playerid] == true)
    {
        DestroyObject(GetPVarInt(playerid, "neon"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "Neon"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "neon2"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "neon3"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "neon4"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "neon5"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "neon6"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "neon7"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "neon8"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "neon9"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "Neon0"));
	    DeletePVar(playerid, "Status");
	    DestroyObject(GetPVarInt(playerid, "Neon1"));
	    DeletePVar(playerid, "Status");
	    Neon[playerid] = false;
    }
    if(AcessouMenuCarProfs[playerid] == 1)
    {
    	CarroTrank[CarroEventoProfs[playerid]] = 0;
    	CarroInfo[CarroEventoProfs[playerid]][ChaveCarro] = 0;
    	AcessouMenuCarProfs[playerid] = 0;
    	DestroyVehicle(CarroEventoProfs[playerid]);
    }
    if(Pp[playerid][OrgLider] == 43 || Pp[playerid][OrgSubLider] == 43 || Pp[playerid][OrgMembro] == 43)
    {
        if(AcessouMenuCarVtr[playerid] == 1)
    	{
    	    CarroTrank[CarroEventoVtr[playerid]] = 0;
    		CarroInfo[CarroEventoVtr[playerid]][ChaveCarro] = 0;
    		AcessouMenuCarVtr[playerid] = 0;
            if(GiroFV[CarroEventoVtr[playerid]] >= 1)
        	{
                DestroyObject(ObjGiroF[CarroEventoVtr[playerid]]);
        		GiroFV[CarroEventoVtr[playerid]] = 0;
            }
    		DestroyVehicle(CarroEventoVtr[playerid]);
    	}
    }
    if(IsPolicial(playerid))
    {
        if(AcessouMenuCarVtr[playerid] == 1)
    	{
    	    CarroTrank[CarroEventoVtr[playerid]] = 0;
    		CarroInfo[CarroEventoVtr[playerid]][ChaveCarro] = 0;
    		AcessouMenuCarVtr[playerid] = 0;
            if(GiroFV[CarroEventoVtr[playerid]] >= 1)
        	{
                DestroyObject(ObjGiroF[CarroEventoVtr[playerid]]);
        		GiroFV[CarroEventoVtr[playerid]] = 0;
            }
    		DestroyVehicle(CarroEventoVtr[playerid]);
    	}
    }
    if(IsBandido(playerid))
    {
        if(AcessouMenuCarVtr[playerid] == 1)
    	{
    	    CarroTrank[CarroEventoVtr[playerid]] = 0;
    		CarroInfo[CarroEventoVtr[playerid]][ChaveCarro] = 0;
    		AcessouMenuCarVtr[playerid] = 0;
            if(GiroFV[CarroEventoVtr[playerid]] >= 1)
        	{
                DestroyObject(ObjGiroF[CarroEventoVtr[playerid]]);
        		GiroFV[CarroEventoVtr[playerid]] = 0;
            }
    		DestroyVehicle(CarroEventoVtr[playerid]);
    	}
    }
    if(Pp[playerid][EmpLider] == 1 || Pp[playerid][EmpMembro] == 1)
    {
        if(AcessouMenuCarUber[playerid] == 1)
    	{
    	    CarroTrank[CarroEventoUber[playerid]] = 0;
    		CarroInfo[CarroEventoUber[playerid]][ChaveCarro] = 0;
    		AcessouMenuCarUber[playerid] = 0;
    		DestroyVehicle(CarroEventoUber[playerid]);
    	}
    }
	//Outras Verificacoes
    if(Koniler[playerid] >= 1)
   	{
		for(new i = 1; i < 11; i++)
		{
	 		DestroyObject(TrafikKoni[playerid][i]);
	 		Koniler[playerid] = 0;
	 	}
	}
    if(VehAlugado[playerid] == 1)
	{
	    CarroTrank[VeiculoCivil[playerid]] = 0;
		CarroInfo[VeiculoCivil[playerid]][ChaveCarro] = 0;
		VehAlugado[playerid] = 0;
		DestroyVehicle(VeiculoCivil[playerid]);
	}
	if(Pp[playerid][Algemado] == true)
	{
	    Pp[playerid][Algemado] = false;
	}
	if(Desman[playerid] == 1)
	{
	    new vehicleid = GetPlayerVehicleID(playerid);
	    Desmanchando[vehicleid] = 0;
	    Desman[playerid] = 0;
	    KillTimer(Desmanchar[playerid]);
	}
    if(Uniforme[playerid] == true)
   	{
   		Uniforme[playerid] = false;
  	}
    // Corridas Clandestinas 1
    if(CheckCorridaC[playerid] >= 1)
    {
        CheckCorridaC[playerid] = 0;
        EntrouCorrida[playerid] = 0;
    }
    if(EntrouCorrida[playerid] == 1)
    {
        if(Pp[playerid][Logado] == true)
        {
            PlayersCorrida[CtPlayers] -= 1;
            EntrouCorrida[playerid] = 0;
        }
    }
    // Corridas Clandestinas 2
    if(CheckCorridaC2[playerid] >= 1)
    {
        CheckCorridaC2[playerid] = 0;
        EntrouCorrida2[playerid] = 0;
    }
    if(EntrouCorrida2[playerid] == 1)
    {
        if(Pp[playerid][Logado] == true)
        {
            PlayersCorrida2[CtPlayers2] -= 1;
            EntrouCorrida2[playerid] = 0;
        }
    }
    // Corridas Clandestinas 3
    if(CheckCorridaC3[playerid] >= 1)
    {
        CheckCorridaC3[playerid] = 0;
        EntrouCorrida3[playerid] = 0;
    }
    if(EntrouCorrida3[playerid] == 1)
    {
        if(Pp[playerid][Logado] == true)
        {
            PlayersCorrida3[CtPlayers3] -= 1;
            EntrouCorrida3[playerid] = 0;
        }
    }
    // Corridas Clandestinas 4
    if(CheckCorridaC4[playerid] >= 1)
    {
        CheckCorridaC4[playerid] = 0;
        EntrouCorrida4[playerid] = 0;
    }
    if(EntrouCorrida4[playerid] == 1)
    {
        if(Pp[playerid][Logado] == true)
        {
            PlayersCorrida4[CtPlayers4] -= 1;
            EntrouCorrida4[playerid] = 0;
        }
    }
    // Variaveis
