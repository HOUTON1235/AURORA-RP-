}

public OnPlayerModelSelection(playerid, response, listid, modelid)
{
	if(listid == skinlist)
	{
	    if(response)
	    {
			if(GetPlayerCash(playerid) >= 100)
			{
			    SCM(playerid, 0xFF0000FF, "{FFD700}Info-Loja: {FFFFFF}A sua skin foi alterada , custo R$[100].");
		    	SetPlayerSkin(playerid, modelid);
				Pp[playerid][Skin] = modelid;
				SalvarDados(playerid);
				GivePlayerCash(playerid, -100);
				GameTextForPlayer(playerid, "~r~-R$100", 5000,1);
			}
			else
			{
			    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem dinheiro Suficiente");
			    return 1;
			}
	    }
    	return 1;
	}
	return 1;
}

forward InAnyBike(playerid);
