CMD:pradio(playerid)
{
	if(IsBandido(playerid))
	{
		if(Pp[playerid][Radio] == 1)
		{
		    new orgid = GetPlayerOrg(playerid);
		    if(PlyPegoRad[playerid] == 1) return SCM(playerid, 0xFFFFFFFF, "{FFD700}INFO: {FFFFFF}Voce ja esta com o radio nas maos!");
			PlyPegoRad[playerid] = 1;
			FrequenciaConectada[playerid] = orgid;
			SCM(playerid, -1,"{FFD700}[Radio]: {FFFFFF}Voce pegou seu radio, Use: /gradio Para Guardar");
		 	for(new s = 0; s < sizeof(RadVoipInbf); s++) TextDrawShowForPlayer(playerid, RadVoipInbf[s]);

		 	new string[1200];
			format(string, 128, "{FFD700}[Radio]: {FFFFFF}Frequencia conectada: (%d).", orgid);
			SCM(playerid, 0x00AE00FF, string);

			format(string, 128, "{FFD700}[Radio]: {FFFFFF}%s saiu da frequencia(%d)", VoipNomer(playerid), FrequenciaConectada[playerid]);
			MsgFrequencia(FrequenciaConectada[playerid], 0xBF0000FF, string);
			format(string, 128, "{FFD700}[Radio]: {FFFFFF}%s conectou na frequencia(%d)", VoipNomer(playerid), orgid);
			MsgFrequencia(orgid, 0xFF6C00FF, string);

			SetTimerEx("ConectarNaFrequencia", 100, false, "id", playerid, orgid);
			return 1;
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem um Radio Para Comunicacao");
		}
	}
	if(IsPolicial(playerid))
	{
		if(Pp[playerid][Radio] == 1)
		{
		    new orgid = GetPlayerOrg(playerid);
		    if(PlyPegoRad[playerid] == 1) return SCM(playerid, 0xFFFFFFFF, "{FFD700}INFO: {FFFFFF}Voce ja esta com o radio nas maos!");
			PlyPegoRad[playerid] = 1;
			SCM(playerid, -1,"{FFD700}[Radio]: {FFFFFF}Voce pegou seu radio, Use: /gradio Para Guardar");
		 	for(new s = 0; s < sizeof(RadVoipInbf); s++) TextDrawShowForPlayer(playerid, RadVoipInbf[s]);
		 	FrequenciaConectada[playerid] = orgid;

		 	new string[1200];
			format(string, 128, "{FFD700}[Radio]: {FFFFFF}Frequencia conectada: (%d).", orgid);
			SCM(playerid, 0x00AE00FF, string);

			format(string, 128, "{FFD700}[Radio]: {FFFFFF}%s saiu da frequencia(%d)", VoipNomer(playerid), FrequenciaConectada[playerid]);
			MsgFrequencia(FrequenciaConectada[playerid], 0xBF0000FF, string);
			format(string, 128, "{FFD700}[Radio]: {FFFFFF}%s conectou na frequencia(%d)", VoipNomer(playerid), orgid);
			MsgFrequencia(orgid, 0xFF6C00FF, string);

			SetTimerEx("ConectarNaFrequencia", 100, false, "id", playerid, orgid);
			return 1;
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem um Radio Para Comunicacao");
		}
	}
	return 1;
}
