					    	PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "Mochila ~g~Limpa");
					    	SetTimerEx("DCANIM", 4000, false, "i", i);
					    	SetTimerEx("DCANIM", 4001, false, "i", playerid);
