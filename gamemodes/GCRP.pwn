CMD:iniciarcontagem(playerid)
{
	if(Pp[playerid][Admin] >= 4)
	{
	    new Float:Xe, Float:Ye, Float:Ze;
	    GetPlayerPos(playerid, Xe, Ye, Ze);
	    for(new i;i<MAX_PLAYERS;i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(EventoCorrida[i] == 1)
			    {
				    if(IsPlayerInRangeOfPoint(i, 40.0, Xe, Ye, Ze))
	  				{
	  				    if(ContagemTela[i] == 0)
	  				    {
		  				    TimerContagem[i] = SetTimerEx("MarcarCheck1", 1000, true, "i", i);
		  				    TogglePlayerControllable(i, 0);
							ProtecaoAlgemas[i] = SetTimerEx("k", 500, true, "d", i);
						}
	  				}
	  			}
	  			else if(EventoBateBate[i] == 1)
			    {
				    if(IsPlayerInRangeOfPoint(i, 40.0, Xe, Ye, Ze))
	  				{
	  				    if(ContagemTela[i] == 0)
	  				    {
		  				    TimerContagem[i] = SetTimerEx("VoltarControles", 1000, true, "i", i);
		  				    TogglePlayerControllable(i, 0);
							ProtecaoAlgemas[i] = SetTimerEx("k", 500, true, "d", i);
						}
	  				}
	  			}
	  		}
	  	}
	  	return 1;
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	}
	return 1;
}
CMD:cevento(playerid)
{
    new car[MAX_PLAYER_NAME], string[450];
    GetPlayerName(playerid, car, sizeof(car));
    if(Pp[playerid][Admin] >= 5)
    {
	    if(EventoCorridaSv == 0)
	    {
		    if(EventoEscondeSv == 0)
		    {
			    if(EventoBateSv == 0)
			    {
				    if(EventoMataSv == 0)
				    {
					    new mercada[5000];
						strcat(string, "Evento\tStatus\n");
				  		format(mercada, sizeof(mercada), "{FFFFFF}Evento Corrida\t{00FF00}[Disponivel]\n");
						strcat(string, mercada);
						format(mercada, sizeof(mercada), "{FFFFFF}Evento Esconde-Esconde\t{00FF00}[Disponivel]\n");
						strcat(string, mercada);
						format(mercada, sizeof(mercada), "{FFFFFF}Evento Bate-Bate\t{00FF00}[Disponivel]\n");
						strcat(string, mercada);
						format(mercada, sizeof(mercada), "{FFFFFF}Evento Mata Mata\t{00FF00}[Disponivel]\n");
						strcat(string, mercada);

				  		return ShowPlayerDialog(playerid, DIALOG_EVENTO, DIALOG_STYLE_TABLIST_HEADERS, "Eventos {FFD700}Gold City Roleplay", string, "Abrir", "Voltar");
					}
					else
					{
					    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Um Evento de Mata-Mata ja esta Ocorrendo");
					}
				}
				else
				{
				    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Um Evento de Bate-Bate ja esta Ocorrendo");
				}
			}
			else
			{
			    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Um Evento de Esconde-Esconde ja esta Ocorrendo");
			}
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Um Evento de Corrida ja esta Ocorrendo");
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	}
	return 1;
}

CMD:evento(playerid)
{
    if(PodeEntrarEvento[playerid] == 1)
    {
        if(EventoCorridaSv == 1)
        {
            if(EventoCorrida[playerid] == 0)
            {
                new string[450];
        		format(string,sizeof(string),"<< O ID:[%d] Entrou no Evento Gold City Roleplay >>", Pp[playerid][IDF]);
    			SendClientMessageToAll(COLOR_LIGHTRED,string);

                EventoCorrida[playerid] = 1;
                GameTextForPlayer(playerid, "~r~Evento! ~n~ ~w~Voce entrou!", 5000, 3);
    			SCM(playerid, -1, "{FFD700}[ EVENTO ]: {FFFFFF}Voce entrou em um Evento, Use: (/sairevento)");
    			SetPlayerPos(playerid, -106.2490,-1433.0912,12.8768);
            }
            else
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja esta em um Evento");
            }
