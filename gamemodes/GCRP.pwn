                                new string[450];
				                format(string, sizeof(string), "{FFD700} Empresa Gold City\n\n{FFFFFF}Empresa ID: {FFDC33}%d\n{FFFFFF}Valor da Empresa: {00FF00}%d\n{FFFFFF}Aperte {FFD700}Y\n{FFFFFF}Nome da Empresa: %s\nFundos da Empresa: {00FF00}R$%d", EmPp[i][EmpresaId], EmPp[i][EmpresaDono], EmPp[i][EmpresaNome], EmPp[i][EmpresaValores]);
