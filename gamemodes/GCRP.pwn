            DOF2_SetString(arquivo, "Membro19", "Nenhum");
            DOF2_SetString(arquivo, "Membro20", "Nenhum");
			DOF2_SaveFile();

			format(OrgInfo[orgid][Lider], 30, DOF2_GetString(arquivo, "Lider"));
			format(OrgInfo[orgid][SubLider], 30, DOF2_GetString(arquivo, "SubLider"));
			format(OrgInfo[orgid][Membro3], 30, DOF2_GetString(arquivo, "Membro3"));
			format(OrgInfo[orgid][Membro4], 30, DOF2_GetString(arquivo, "Membro4"));
