CMD:fabricararmas(playerid)
{
    for(new i; i < 5; i++)
    {
        if(ISP(playerid, 2.0, LocaisDeFab[i][0], LocaisDeFab[i][1], LocaisDeFab[i][2]))
        {
            if(FABInfo[Dono] == 23 || FABInfo[Dono] == 39 || FABInfo[Dono] == 10)
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este territorio foi dominado pela Policia e voce nao pode usar-lo."), GameTextForPlayer(playerid, "~r~Indisponivel", 1200, 1);
            }
            else if(FABInfo[Dono] == 13 || FABInfo[Dono] == 32 || FABInfo[Dono] == 41)
            {
                if(Pp[playerid][OrgLider] == FABInfo[Dono] || Pp[playerid][OrgMembro] == FABInfo[Dono])
                {
                    new stg[5000];
        			strcat(stg,  "{FFD700}1. {FFFFFF}Fabricar AK-47\t{00FF00}[Disponivel]\n");
        			strcat(stg,  "{FFD700}2. {FFFFFF}Fabricar MP5\t{00FF00}[Disponivel]\n");
        			strcat(stg,  "{FFD700}3. {FFFFFF}Fabricar Desert Eagle\t{00FF00}[Disponivel]\n");
        			ShowPlayerDialog(playerid, DIALOG_FAZERPC, DIALOG_STYLE_LIST, "Arms for all", stg, "Fabricar", "X");
                }
                else
                {
                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e dessa org para fabricar armas."), GameTextForPlayer(playerid, "~r~Indisponivel", 1200, 1);
                }
            }
            else if(FABInfo[Dono] == 0)
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Ninguem dominou este territorio, portanto, ninguem pode acessar-lo."), GameTextForPlayer(playerid, "~r~Indisponivel", 1200, 1);
            }
        }
    }
    return 1;
}
