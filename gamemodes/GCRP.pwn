public OnGameModeExit()
{
 	for(new i; i < MAX_PLAYERS; i++)
	{
		if(IsPlayerConnected(i))
		{
			if(Pp[i][Logado] == true)
			{
				if(CriandoPersonagem[i] == false)
				{
					SalvarDados(i);
                    Kick(i);
				}
			}
		}
	}

	for(new i2; i2 < MAX_ORGS; i2++)
	{
	    SalvarCofre(i2);
	}
	for(new i = 0; i < MAX_FREQUENCIAS; i++)
		SvDeleteStream(Frequencia[i]);
	IniciarBots = 0;
	IniciarOrgs = 0;
	IniciarCasas = 0;
	IniciarCaixas = 0;
	IniciarPostos = 0;
	IniciarRadares = 0;
    IniciarSpawns = 0;
    IniciarEmpresas = 0;
	//	CupomGold City[0] = 0;
    SalvarGuetto();
    SalvarMorro();
    SalvarFAB();
	DOF2_Exit();
	return 1;
}

public OnPlayerRequestClass(playerid, classid)
{
    if(IsPlayerNPC(playerid))
    {
        if(!strcmp(PlayerName(playerid), "Oficer_Onibus", true))
        {
        	SetSpawnInfo(playerid, 221, 71, 1683.5056, -2245.9348, -2.6817, 187.4125, 0, 0 ,0 ,0 ,0 ,0);
        	PutPlayerInVehicle(playerid, OnibusNpc[0], 0);
   			printf("[BOT] %s spawnado e no onibus.", PlayerName(playerid));
		}
        else if(!strcmp(PlayerName(playerid), "Oficer_Helicoptero", true))
        {
        	SetSpawnInfo(playerid, 222, 171, 1683.5056, -2245.9348, -2.6817, 187.4125, 0, 0 ,0 ,0 ,0 ,0);
        	PutPlayerInVehicle(playerid, OnibusNpc[1], 0);
   			printf("[BOT] %s spawnado e no helicoptero.", PlayerName(playerid));
		}
		return 1;
	}
	else
	{
	    // Funcoes
        PlayAudioStreamForPlayer(playerid, "http://som.brasilplaygames.com.br/som/loadscreanfazendo.mp3");
	    LimparChat(playerid, 20);
	    TogglePlayerSpectating(playerid, true);
	    SetTimerEx("IniciandoServidor", 5000, false, "i", playerid);
	    // Textdraw de Bem Vindo
	    CarregouArmas[playerid] = false;
	    PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "Carregando o ~g~servidor");
        // Movimentacao da Cameta em InterpolateCameraLookAt
        InterpolateCameraPos(playerid, -3054.954833, 1463.255615, 106.046577, -2883.895751, 1578.394897, 99.360176, 15000);
        InterpolateCameraLookAt(playerid, -3050.775146, 1465.991821, 105.838813, -2879.750732, 1581.186645, 99.199249, 20000);
        SetPlayerPos(playerid, -3054.954833, 1463.255615, 106.046577);
	}
    return 1;
}

