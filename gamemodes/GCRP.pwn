stock GRAFITE_Create(playerid, iIndex)
{
	if(IsPlayerConnected(playerid))
	{
		new
			szMessage[128]
		;

		GRAFITEs[playerid][iIndex][_spPosX] = GRAFITE_positions[playerid][0];
		GRAFITEs[playerid][iIndex][_spPosY] = GRAFITE_positions[playerid][1];
		GRAFITEs[playerid][iIndex][_spPosZ] = GRAFITE_positions[playerid][2];
		GRAFITEs[playerid][iIndex][_spPosRX] = GRAFITE_positions[playerid][3];
		GRAFITEs[playerid][iIndex][_spPosRY] = GRAFITE_positions[playerid][4];
		GRAFITEs[playerid][iIndex][_spPosRZ] = GRAFITE_positions[playerid][5];

		format(GRAFITEs[playerid][iIndex][_spText], 50, GRAFITE_text[playerid]);
		format(GRAFITEs[playerid][iIndex][_spFont], 50, GRAFITE_font[playerid]);

		GRAFITEs[playerid][iIndex][_spFontColor] = GRAFITE_color[playerid];
		GRAFITEs[playerid][iIndex][_spFontSize] = GRAFITE_size[playerid];
		GRAFITEs[playerid][iIndex][_spBold] = GRAFITE_bold[playerid];

		GRAFITE_Spawn(playerid, iIndex);
		Tags_Save(playerid, iIndex);

		format(szMessage, sizeof szMessage, "{FFFFFF}Voce criou uma Grafite tag com ID # %i.", iIndex);
		SCM(playerid, -1, szMessage);
	}
}

stock GRAFITE_Spawn(playerid, iIndex)
{
	GRAFITEs[playerid][iIndex][_spObject] = CreateDynamicObject(SPRAY_TAG_OBJECT, GRAFITEs[playerid][iIndex][_spPosX], GRAFITEs[playerid][iIndex][_spPosY], GRAFITEs[playerid][iIndex][_spPosZ], GRAFITEs[playerid][iIndex][_spPosRX], GRAFITEs[playerid][iIndex][_spPosRY], GRAFITEs[playerid][iIndex][_spPosRZ], GRAFITEs[playerid][iIndex][_spVW], GRAFITEs[playerid][iIndex][_spInt], -1, SPRAY_TAG_OBJECT_DISTANCE);
	SetDynamicObjectMaterialText(GRAFITEs[playerid][iIndex][_spObject], 0, GRAFITEs[playerid][iIndex][_spText], OBJECT_MATERIAL_SIZE_512x512, GRAFITEs[playerid][iIndex][_spFont], GRAFITEs[playerid][iIndex][_spFontSize], GRAFITEs[playerid][iIndex][_spBold], GRAFITEs[playerid][iIndex][_spFontColor], 0, 1);
	return 1;
}

stock Tag_Load(playerid)
{
	if(IsPlayerConnected(playerid))
	{
		new
			szFile[40],
			szLine[28],
			szName[MAX_PLAYER_NAME]
		;
		GetPlayerName(playerid, szName, MAX_PLAYER_NAME);
		format(szFile, 40, PASTA_GRAFITES, szName);

		for(new i; i < MAX_PLAYERS_TAGS; i++)
		{
			format(szLine, sizeof szLine, "Text%i", i); format(GRAFITEs[playerid][i][_spText], 50, DOF2_GetString(szFile, szLine));
			format(szLine, sizeof szLine, "Font%i", i); format(GRAFITEs[playerid][i][_spFont], 50, DOF2_GetString(szFile, szLine));
			format(szLine, sizeof szLine, "FontSize%i", i); GRAFITEs[playerid][i][_spFontSize] = DOF2_GetInt(szFile, szLine);
			format(szLine, sizeof szLine, "FontBold%i", i); GRAFITEs[playerid][i][_spBold] = DOF2_GetInt(szFile, szLine);
			format(szLine, sizeof szLine, "FontColor%i", i); GRAFITEs[playerid][i][_spFontColor] = DOF2_GetInt(szFile, szLine);
			format(szLine, sizeof szLine, "PosX%i", i); GRAFITEs[playerid][i][_spPosX] = DOF2_GetFloat(szFile, szLine);
			format(szLine, sizeof szLine, "PosY%i", i); GRAFITEs[playerid][i][_spPosY] = DOF2_GetFloat(szFile, szLine);
			format(szLine, sizeof szLine, "PosZ%i", i); GRAFITEs[playerid][i][_spPosZ] = DOF2_GetFloat(szFile, szLine);
			format(szLine, sizeof szLine, "RotX%i", i); GRAFITEs[playerid][i][_spPosRX] = DOF2_GetFloat(szFile, szLine);
			format(szLine, sizeof szLine, "RotY%i", i); GRAFITEs[playerid][i][_spPosRY] = DOF2_GetFloat(szFile, szLine);
			format(szLine, sizeof szLine, "RotZ%i", i); GRAFITEs[playerid][i][_spPosRZ] = DOF2_GetFloat(szFile, szLine);
			format(szLine, sizeof szLine, "VirtualWorld%i", i); GRAFITEs[playerid][i][_spVW] = DOF2_GetInt(szFile, szLine);
			format(szLine, sizeof szLine, "Interior%i", i); GRAFITEs[playerid][i][_spInt] = DOF2_GetInt(szFile, szLine);

			if(GRAFITEs[playerid][i][_spPosX] != 0.0)
			{
				GRAFITE_Spawn(playerid, i);
			}
		}
	}
	return 1;
}

stock Tags_Clear(playerid, iIndex)
{
	format(GRAFITEs[playerid][iIndex][_spText], 50, "Exemplo");
	format(GRAFITEs[playerid][iIndex][_spFont], 50, "Arial");
	GRAFITEs[playerid][iIndex][_spFontSize] = 24;
	GRAFITEs[playerid][iIndex][_spBold] = 0;
	GRAFITEs[playerid][iIndex][_spFontColor] = -1;
	GRAFITEs[playerid][iIndex][_spPosX] = 0.0;
	GRAFITEs[playerid][iIndex][_spPosY] = 0.0;
	GRAFITEs[playerid][iIndex][_spPosZ] = 0.0;
	GRAFITEs[playerid][iIndex][_spPosRX] = 0.0;
	GRAFITEs[playerid][iIndex][_spPosRY] = 0.0;
	GRAFITEs[playerid][iIndex][_spPosRZ] = 0.0;
	GRAFITEs[playerid][iIndex][_spVW] = 0;
	GRAFITEs[playerid][iIndex][_spInt] = 0;
	DestroyDynamicObject(GRAFITEs[playerid][iIndex][_spObject]);
	Tags_Save(playerid, iIndex);
	return 1;
}

stock Tags_Save(playerid, iIndex)
{
	if(IsPlayerConnected(playerid))
	{
		new
			szFile[32],
			szLine[128],
			szName[MAX_PLAYER_NAME]
		;

		GetPlayerName(playerid, szName, MAX_PLAYER_NAME);
		format(szFile, 32, PASTA_GRAFITES, szName);
		if(!DOF2_FileExists(szFile)) DOF2_CreateFile(szFile);
		{
			format(szLine, sizeof szLine, "Text%i", iIndex); DOF2_SetString(szFile, szLine, GRAFITEs[playerid][iIndex][_spText]);
			format(szLine, sizeof szLine, "Font%i", iIndex); DOF2_SetString(szFile, szLine, GRAFITEs[playerid][iIndex][_spFont]);
			format(szLine, sizeof szLine, "FontSize%i", iIndex); DOF2_SetInt(szFile, szLine, GRAFITEs[playerid][iIndex][_spFontSize]);
			format(szLine, sizeof szLine, "FontBold%i", iIndex); DOF2_SetInt(szFile, szLine, GRAFITEs[playerid][iIndex][_spBold]);
			format(szLine, sizeof szLine, "FontColor%i", iIndex); DOF2_SetInt(szFile, szLine, GRAFITEs[playerid][iIndex][_spFontColor]);
			format(szLine, sizeof szLine, "PosX%i", iIndex); DOF2_SetFloat(szFile, szLine, GRAFITEs[playerid][iIndex][_spPosX]);
			format(szLine, sizeof szLine, "PosY%i", iIndex); DOF2_SetFloat(szFile, szLine, GRAFITEs[playerid][iIndex][_spPosY]);
			format(szLine, sizeof szLine, "PosZ%i", iIndex); DOF2_SetFloat(szFile, szLine, GRAFITEs[playerid][iIndex][_spPosZ]);
			format(szLine, sizeof szLine, "RotX%i", iIndex); DOF2_SetFloat(szFile, szLine, GRAFITEs[playerid][iIndex][_spPosRX]);
			format(szLine, sizeof szLine, "RotY%i", iIndex); DOF2_SetFloat(szFile, szLine, GRAFITEs[playerid][iIndex][_spPosRY]);
			format(szLine, sizeof szLine, "RotZ%i", iIndex); DOF2_SetFloat(szFile, szLine, GRAFITEs[playerid][iIndex][_spPosRZ]);
			format(szLine, sizeof szLine, "VirtualWorld%i", iIndex); DOF2_SetInt(szFile, szLine, GRAFITEs[playerid][iIndex][_spVW]);
			format(szLine, sizeof szLine, "Interior%i", iIndex); DOF2_SetInt(szFile, szLine, GRAFITEs[playerid][iIndex][_spInt]);
			DOF2_SaveFile();
		}
	}
	return 1;
}

stock HexToInt(const string[])
{
	if (string[0] == 0) return 0;

	new
		i,
		cur = 1,
		res = 0
	;

	for (i = strlen(string); i > 0; i --) {
		if (string[i-1] < 58) res = res + cur * (string[i-1]-48); else res = res + cur * (string[i-1]-65+10);
		cur = cur * 16;
	}
	return res;
}

stock Float:GetVehicleHealthEx(vehicleid)
{
    new Float:health;
    GetVehicleHealth(vehicleid, health);

    if ( health > 900.0) {
        return health / 10.0;
    }
    return ( health / 10.0 );//-(24);
}

stock GetPlayerIdfixo(playerid) return Pp[playerid][IDF];
stock GetIdfixo()
{
	new ID;
	ProxID ++;
	ID  = ProxID;
	new File[150];format(File, sizeof(File), "IDs/ProxID.ini");
	DOF2_SetInt(File,"ProxID",ProxID);
	DOF2_SaveFile();
	return ID;
}
stock MsgFrequencia(freq, color, const msg[])
{
	for(new i=0;i<MAX_PLAYERS;i++)
		if(Pp[i][Logado] == true)
			if(FrequenciaConectada[i] > 0 && FrequenciaConectada[i] == freq)
				SendClientMessage(i, color, msg);
	return 1;
}

public OnPlayerClickMap(playerid, Float:fX, Float:fY, Float:fZ)
{
    if(Pp[playerid][Admin] >= 1)
    {
        if(Pp[playerid][Admin] < 5)
    	{
	        if(Trabalhando[playerid] == true)
			{
	  			SetPVarFloat(playerid, "TeleX", fX);
		      	SetPVarFloat(playerid, "TeleY", fY);
		      	SetPVarFloat(playerid, "TeleZ", fZ);
				ShowPlayerDialog(playerid, DIALOG_TELEMAP, DIALOG_STYLE_MSGBOX, "{FFFFFF}TP {FFD700}Admins", "{FFFFFF}Voce Deseja Teleportar Para Esse Local?", "Sim", "Nao");
		  	}
		  	else
		  	{
		  	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em Mod Trabalho Para realizar esse Comando");
		  	}
		}
	}
    if(Pp[playerid][Admin] >= 6)
    {
        SetPVarFloat(playerid, "TeleX", fX);
   		SetPVarFloat(playerid, "TeleY", fY);
   		SetPVarFloat(playerid, "TeleZ", fZ);
		ShowPlayerDialog(playerid, DIALOG_TELEMAP, DIALOG_STYLE_MSGBOX, "{FFFFFF}TP {FFD700}Admins", "{FFFFFF}Voce Deseja Teleportar Para Esse Local?", "Sim", "Nao");
	}
    if(GetPlayerState(playerid) == PLAYER_STATE_PASSENGER)
    {
        new vehicleid = GetPlayerVehicleID(playerid), string[450];
        for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
                if(GetPlayerVehicleID(i) == vehicleid)
                {
                    if(GetPlayerState(i) == PLAYER_STATE_DRIVER)
                    {
                        if(BcUberV[i] == 1)
                        {
                            if(InCorridaUber[playerid] == 0)
                            {
                                if(AcessouMenuCarUber[i] == 1)
                                {
                                    if(vehicleid == CarroEventoUber[i])
                                    {
                                        SendClientMessageEx(i, -1, "{FFFFFF}Gps-Mark: {FFFFFF}O ID:[%d] marcou um local no mapa e foi marcado para voce!", Pp[playerid][IDF]), GameTextForPlayer(playerid, "~w~Local[Cliente] ~g~Marcado", 1200, 1);
                                        SCM(playerid, -1, "{FFFFFF}Gps-Mark: {FFFFFF}Voce marcou um local no mapa e tambem foi marcado para o motorista");
                                        SetPlayerRaceCheckpoint(i, 0, fX, fY, fZ, fX, fY, fZ, 7);
                                        CheckPointProfissao[i] = 1;
                                        InCorridaUber[playerid] = Pp[i][IDF];
                                        GameTextForPlayer(i, "~w~Viagem ~g~Marcada!", 1200, 1);
                                        GameTextForPlayer(playerid, "~w~Viagem ~p~Solicitada!", 1200, 1);
                                    }
                                }
                            }
                            else
                            {
                                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja iniciou uma Corrida");
                            }
                        }
                        else if(BcUberV[i] == 0)
                        {
                            SendClientMessageEx(i, -1, "{FFFFFF}Gps-Mark: {FFFFFF}O ID:[%d] marcou um local no mapa e foi marcado para voce!", Pp[playerid][IDF]), GameTextForPlayer(playerid, "~w~Local ~g~Marcado", 1200, 1);
                            SCM(playerid, -1, "{FFFFFF}Gps-Mark: {FFFFFF}Voce marcou um local no mapa e tambem foi marcado para o motorista");
                            SetPlayerRaceCheckpoint(i, 0, fX, fY, fZ, fX, fY, fZ, 7);
                            CheckPointProfissao[i] = 1;
                        }
                    }
                }
            }
        }
    }
	return 1;
}

CallBack:: RemoveRoadblock(playerid)
{
	DestroyObject(pRoadblock[playerid]);
	pRoadblock[playerid] = 0;
}

CallBack:: RespawnAT()
{
    format(gstring, sizeof(gstring), "[RESPAWN] OS VEICULOS DO SERVIDOR VOLTARAO AOS SEUS LOCAIS EM 30 SEGUNDOS!");
	SendClientMessageToAll(COLOR_LIGHTRED, gstring);
	SetTimer("ttrespawn",30000,false);
	return 1;
}

CallBack:: ttrespawn()
{
	SendClientMessageToAll(COLOR_LIGHTRED,"[RESPAWN] TODOS OS VEICULOS VOLTARAM AOS SEUS LOCAIS.");
	new bool:unwanted[CAR_AMOUNT];
	for(new player=0; player<MAX_PLAYERS; player++)
    {
		if(IsPlayerConnected(player) && IsPlayerInAnyVehicle(player))
		{
			unwanted[GetPlayerVehicleID(player)]=true;
		}
    }
	for(new car = 1; car <= CAR_AMOUNT; car++)
	{
		if(!unwanted[car]) SetVehicleToRespawn(car), CarroTrank[car] = 0, CarroInfo[car][ChaveCarro] = 0, PassageirosMt[car] = 0, PassageirosMaq[car] = 0, ProdutosCA[car] = 0, CorpoMV[car] = 0, DestroyObject(ObjGiroF[car]), GiroFV[car] = 0, ProdutosVeh[car] = 0, DrugsVeh[car] = 0; MalotesCr[car] = 0; CaminhaoGASA[car] = 0;
	}
	return 1;
}

CallBack:: RepararCaixa(playerid)
{
    new string[450], String[220], orgid = GetPlayerOrg(playerid), zone[MAX_ZONE_NAME], DinheiroCaixa = 1500 + random(2000);
	if(ReparandoCaixa[playerid] == 1)
	{
	    if(ISP(playerid, 2.0, CaixaInfo[CaixaIdRP[playerid]][CaixaPosX], CaixaInfo[CaixaIdRP[playerid]][CaixaPosY], CaixaInfo[CaixaIdRP[playerid]][CaixaPosZ]))
		{
            for(new i; i < MAX_PICKUPS_ROUBO; i++)
    		{
    		    DestroyPickup(Pickups_Roubo[CaixaIdRP[playerid]][i]);
    		}
		    Controle(playerid, 1);
			GetPlayer2DZone(playerid, zone, MAX_ZONE_NAME);
		    ClearAnimations(playerid);
   			SetTimerEx("DCANIM", 500, false, "d", playerid);
		    KillTimer(ProtecaoAlgemas[playerid]);
		    DestroyDynamicObject(ObjetoCaixa[CaixaIdRP[playerid]]);
		    DestroyDynamic3DTextLabel(TextoCaixa[CaixaIdRP[playerid]]);
		    ObjetoCaixa[CaixaIdRP[playerid]] = CreateDynamicObject(19324, CaixaInfo[CaixaIdRP[playerid]][CaixaPosX], CaixaInfo[CaixaIdRP[playerid]][CaixaPosY], CaixaInfo[CaixaIdRP[playerid]][CaixaPosZ]-0.3, 0.0, 0.0, CaixaInfo[CaixaIdRP[playerid]][CaixaPosR]);
			format(string, sizeof(string), "{FFD700}Caixinha Gold City\nCaixa: ({FFD700}%d{FFFFFF})\nPressione '{FFD700}F{FFFFFF}'", CaixaInfo[CaixaIdRP[playerid]][CaixaID]);
			TextoCaixa[CaixaIdRP[playerid]] = CreateDynamic3DTextLabel(string, -1, CaixaInfo[CaixaIdRP[playerid]][CaixaPosX], CaixaInfo[CaixaIdRP[playerid]][CaixaPosY], CaixaInfo[CaixaIdRP[playerid]][CaixaPosZ], 15.0);
			CaixaInfo[CaixaIdRP[playerid]][CaixaExplodido] = false;
			format(String, sizeof(String), "[INFO] A Corporacao %s Reparou um Caixa nas Proximidades de %s", OrgInfo[orgid][OrgNome], zone);
			SendClientMessageToAll(COLOR_LIGHTRED, String);
			format(String, sizeof(String), "~w~Caixa ~g~Reparado! ~n~ ~r~Voce Ganhou: [%d]", DinheiroCaixa);
			GameTextForPlayer(playerid, String, 10000, 6);
			GivePlayerCash(playerid, DinheiroCaixa);
			CaixaIdRP[playerid] = 0;
		}
	}
	return 1;
}
CallBack:: Levantar(playerid)
{
    //Morte do Player
	Pp[playerid][Ferido] = false;
	Pp[playerid][MinutosFerido] = 0;
	Pp[playerid][SegundosFerido] = 0;
	KillTimer(ProtecaoAlgemas[playerid]);
	ProtecaoAlgemas[playerid] = 0;
    for(new i = 1; i < 4; i++)
    {
        PlayerTextDrawHide(playerid, TextDrawMorte[playerid][i]);
    }
	KillTimer(TimerFerido[playerid]);
	TimerFerido[playerid] = 0;
	SetPlayerHealth(playerid, 100.0);
    Pp[playerid][Mutado] = 0;
	Pp[playerid][MinutosMutado] = 0;
	SvMutePlayerDisable(playerid);
	GameTextForPlayer(playerid, "~r~Reanimado!", 3000, 1);
	SCM(playerid, -1, "{FFD700}Reanimado: {FFFFFF}Voce foi reanimado com sucesso.");
	Controle(playerid, 1);
	SetTimerEx("DCANIM", 5000, false, "d", playerid);
	return 1;
}

CallBack:: GranaSamu(playerid)
{
    new granax = 1000 + random(1200), string[450];
    format(string, sizeof(string), "{FFD700}SAMU: {FFFFFF}Voce recebeu {00FF00}R$%d{FFFFFF} por socorrer o jogador.", granax);
    SCM(playerid, -1, string), GameTextForPlayer(playerid, "~r~Socorrido.", 2000, 1);
    GivePlayerCash(playerid, granax);
	return 1;
}

