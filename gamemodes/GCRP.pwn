		{
		    return 1;
		}
	}
	return 0;
}


CallBack:: AttVelocimetro(playerid)
{
    new string[450];
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
	    if(InAnyBike(playerid))
	    {
	        for(new i; i < 6; i++)
			{
				PlayerTextDrawHide(playerid, TdVelocimetro[playerid][i]);
			}
	    }
	    else if(InAnyMoto(playerid))
	    {
			SetTimerEx("AttVelocimetro", 200, false, "i", playerid);

            if(GetVehicleSpeed(GetPlayerVehicleID(playerid)) < 1001)
            {
                if(GetVehicleSpeed(GetPlayerVehicleID(playerid)) <= 70)
                {
                    format(string, sizeof(string), "~w~%03d", GetVehicleSpeed(GetPlayerVehicleID(playerid)));
			        PlayerTextDrawSetString(playerid, TdVelocimetro[playerid][6], string);
                }
                else if(GetVehicleSpeed(GetPlayerVehicleID(playerid)) >= 71)
                {
                    format(string, sizeof(string), "~r~%03d", GetVehicleSpeed(GetPlayerVehicleID(playerid)));
			        PlayerTextDrawSetString(playerid, TdVelocimetro[playerid][6], string);
                }
            }
            else if(GetVehicleSpeed(GetPlayerVehicleID(playerid)) >= 1001)
			{
			    format(string, sizeof(string), "~r~BAN", GetVehicleSpeed(GetPlayerVehicleID(playerid)));
				PlayerTextDrawSetString(playerid, TdVelocimetro[playerid][6], string);
			}

            if(Combustivel[GetPlayerVehicleID(playerid)] >= 10)
            {
                format(string, sizeof(string), "~w~%03d", Combustivel[GetPlayerVehicleID(playerid)]);
			    PlayerTextDrawSetString(playerid, TdVelocimetro[playerid][11], string);
            }
            else if(Combustivel[GetPlayerVehicleID(playerid)] < 10)
            {
                format(string, sizeof(string), "~w~%03d", Combustivel[GetPlayerVehicleID(playerid)]);
			    PlayerTextDrawSetString(playerid, TdVelocimetro[playerid][11], string);
            }
            PlayerTextDrawShow(playerid, TdVelocimetro[playerid][0]);
            PlayerTextDrawShow(playerid, TdVelocimetro[playerid][1]);
            PlayerTextDrawShow(playerid, TdVelocimetro[playerid][2]);
            PlayerTextDrawShow(playerid, TdVelocimetro[playerid][3]);
            PlayerTextDrawShow(playerid, TdVelocimetro[playerid][5]);
            PlayerTextDrawShow(playerid, TdVelocimetro[playerid][6]);
            PlayerTextDrawShow(playerid, TdVelocimetro[playerid][7]);
