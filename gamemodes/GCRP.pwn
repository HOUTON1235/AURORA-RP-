stock GetVehicleSpeed(vehicleid)
{
	new Float:xPos[3];
	GetVehicleVelocity(vehicleid, xPos[0], xPos[1], xPos[2]);
	return floatround(floatsqroot(xPos[0] * xPos[0] + xPos[1] * xPos[1] + xPos[2] * xPos[2]) * 170.00);
}

stock CriarDados(playerid)
{
	format(arquivo, sizeof(arquivo), PASTA_CONTAS, PlayerName(playerid));
	if(!DOF2_FileExists(arquivo))
	{
		DOF2_CreateFile(arquivo);
		DOF2_SetString(arquivo, "Senha", SENHA[playerid]);
		DOF2_SetInt(arquivo, "Dinheiro", 0);
		DOF2_SetInt(arquivo, "Level", 0);
		DOF2_SetInt(arquivo, "Skin", SkinsMasculinas[SkinsLogin[playerid]][0]);
		DOF2_SetInt(arquivo, "Sexo", 0);
		DOF2_SetInt(arquivo, "Admin", 0);
		DOF2_SetInt(arquivo, "Vip", 0);
		DOF2_SetInt(arquivo, "TempoVip", 0);
        DOF2_SetInt(arquivo, "Socio", 0);
        DOF2_SetInt(arquivo, "TempoSocio", 0);
        DOF2_SetInt(arquivo, "Patrocinador", 0);
		DOF2_SetInt(arquivo, "ChapelN", 0);
		DOF2_SetInt(arquivo, "Guitarra", 0);
        DOF2_SetInt(arquivo, "PcBruxa", 0);
        DOF2_SetInt(arquivo, "CabecaBru", 0);
        DOF2_SetInt(arquivo, "CjCabeca", 0);
		DOF2_SetInt(arquivo, "Youtuber", 0);
		DOF2_SetInt(arquivo, "Profissao", -1);
        DOF2_SetString(arquivo, "TagCabeca", "Nenhum");
        DOF2_SetInt(arquivo, "TemTagCab", 0);
		DOF2_SetInt(arquivo, "HabilitacaoA", 0);
		DOF2_SetInt(arquivo, "HabilitacaoB", 0);
		DOF2_SetInt(arquivo, "HabilitacaoC", 0);
		DOF2_SetInt(arquivo, "HabilitacaoD", 0);
        DOF2_SetInt(arquivo, "PontosCNH", 0);
        DOF2_SetInt(arquivo, "TemCarro2", 0);
		DOF2_SetInt(arquivo, "SpoilerV", 0);
		DOF2_SetInt(arquivo, "Coins", 0);
		DOF2_SetInt(arquivo, "Veiculos", 0);
		DOF2_SetInt(arquivo, "SaldoBancario", 0);
        DOF2_SetInt(arquivo, "DinheiroSujo", 0);
        DOF2_SetInt(arquivo, "Hall", 0);
        DOF2_SetInt(arquivo, "FezBanco", 0);
        DOF2_SetInt(arquivo, "Droga", 0);
		DOF2_SetInt(arquivo, "Sementes", 0);
		DOF2_SetInt(arquivo, "Empresa",-1);
		DOF2_SetInt(arquivo, "Fome", 100);
		DOF2_SetInt(arquivo, "Sede", 100);
        DOF2_SetInt(arquivo, "Bexiga", 100);
        DOF2_SetInt(arquivo, "Sono", 100);
		DOF2_SetInt(arquivo, "IDF", 0);
  		DOF2_SetInt(arquivo, "FezRg", 0);
		DOF2_SetInt(arquivo, "FezCarteira", 0);
		DOF2_SetInt(arquivo, "LocalSP", 0);
		DOF2_SetInt(arquivo, "ExpMec", 0);
        DOF2_SetInt(arquivo, "FezPorte", 0);
        DOF2_SetInt(arquivo, "TemPlano", 0);
        DOF2_SetInt(arquivo, "TemKit", 0);
        DOF2_SetInt(arquivo, "Remedios", 0);
        DOF2_SetInt(arquivo, "RemediosP", 0);
        DOF2_SetInt(arquivo, "LockPK", 0);
		DOF2_SetInt(arquivo, "TemJbl", 0);
        DOF2_SetInt(arquivo, "LotericaN", 0);
        DOF2_SetInt(arquivo, "ModoAndar", 0);
		DOF2_SetInt(arquivo, "Caixinha", 0);
		DOF2_SetInt(arquivo, "Mutado", 0);
		DOF2_SetInt(arquivo, "MinutosMutado", 0);
		DOF2_SetFloat(arquivo, "HPVida", 100.00000000);
		DOF2_SetFloat(arquivo, "HPColete", 100.00000000);
		DOF2_SetInt(arquivo, "Casa",-1);
		DOF2_SetInt(arquivo, "Estrelas", 0);
		DOF2_SetInt(arquivo, "Gps", 0);
        DOF2_SetInt(arquivo, "ConfigN", 0);
        DOF2_SetInt(arquivo, "ConfigNV", 0);
        DOF2_SetInt(arquivo, "ConfigOOC", 0);
		DOF2_SetInt(arquivo, "RelogioPayday", 0);
		DOF2_SetInt(arquivo, "NumeroPayday", 0);
		DOF2_SetInt(arquivo, "MinutosPayday", 30);
		DOF2_SetInt(arquivo, "SegundosPayday", 60);
		DOF2_SetBool(arquivo, "Ferido", false);
		DOF2_SetInt(arquivo, "MinutosFerido", 0);
		DOF2_SetInt(arquivo, "SegundosFerido", 0);
		DOF2_SetInt(arquivo, "PlayerLuta", 4);
		DOF2_SetInt(arquivo, "OrgLider", 0);
		DOF2_SetInt(arquivo, "OrgSubLider", 0);
		DOF2_SetInt(arquivo, "OrgMembro", 0);
		DOF2_SetInt(arquivo, "OrgCargo", 0);
		DOF2_SetInt(arquivo, "Multas", 0);
		DOF2_SetInt(arquivo, "PresoHoras", 0);
