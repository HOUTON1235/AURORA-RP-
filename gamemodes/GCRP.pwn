CMD:an(playerid)
{
	SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este Comando Aqui, Compre um Celular e Abra a OLX.");
	return 1;
}
CMD:feridos(playerid)
{
    new vehicleid = GetPlayerVehicleID(playerid);
	if(vehicleid == CarroEventoProfs[playerid])
	{
	    if(BcSamu[playerid] == 1)
	    {
			new stg[15000];
			if(Pp[playerid][Profissao] == PROF_SAMU)
			{
				strcat(stg, "Jogador\tResistencia\tLocal\n");
    			for(new i; i < MAX_PLAYERS; i++)
				{
                    if(Pp[i][Logado] == true)
                    {
    					if(Pp[i][Ferido] == true)
    					{
    						new zone[MAX_ZONE_NAME];
    						GetPlayer2DZone(i, zone, MAX_ZONE_NAME);

    						format(gstring, sizeof(gstring), "\n{FFFFFF}%s[%d]\t{FFD700}%02d:%02d\t{FFFFFF}%s - /localizar {FFDC33}%d\n", PlayerName(i), Pp[i][IDF], Pp[i][MinutosFerido], Pp[i][SegundosFerido], zone, Pp[i][IDF]);
    						strcat(stg, gstring);
    						ShowPlayerDialog(playerid, DIALOG_SAMU, DIALOG_STYLE_TABLIST_HEADERS, "Feridos {FFD700}Samu", stg, "Ok", "");
    					}
                    }
				}
			}
			else
			{
				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta em uma ambulancia.");
			}
		}
		else
		{
  			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao Bateu seu Cartao");
		}
	}
	return 1;
}

CMD:localizar(playerid, params[])
{
	if(Pp[playerid][Profissao] == PROF_SAMU)
	{
	    if(BcSamu[playerid] == 1)
	    {
            new vehicleid = GetPlayerVehicleID(playerid);
	        if(vehicleid == CarroEventoProfs[playerid])
	        {
				new id, Float:X, Float:Y, Float:Z;
				if(sscanf(params, "i", id))
				{
					return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /localizar [IDF].");
				}
    			for(new i; i < MAX_PLAYERS; i++)
				{
					if(Pp[i][Logado] == true)
					{
					    if(Pp[i][IDF] == id)
					    {
					        if(Pp[i][Ferido] == true)
					        {
								new zone[MAX_ZONE_NAME];
								GetPlayer2DZone(i, zone, MAX_ZONE_NAME);

								localizarjogador[playerid] = i;

								GetPlayerPos(i, Float:X, Float:Y, Float:Z);

								new string[10000];
								format(string, sizeof(string), "~b~Nome: ~w~%s ~y~Local:~w~ %s ~g~Resistencia: ~w~%02d:%02d", PlayerName(i), zone, Pp[i][MinutosFerido], Pp[i][SegundosFerido]);
								PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], string);
								PlayerTextDrawShow(playerid, TextDrawAviso3[playerid][0]);

								TimerLocalizado[playerid] = SetTimerEx("AtualizandoTextdraw", 200, true, "i", playerid);
								CheckpointSamu[playerid] = SetPlayerRaceCheckpoint(playerid, 1, X, Y, Z, X, Y, Z, 5.0);
							}
							else
							{
							    SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este Jogador nao precisa de socorro.");
							}
						}
					}
				}
				return 1;
			}
			else
			{
				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta em uma ambulancia.");
			}
		}
		else
		{
  			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao Bateu seu Cartao");
		}
	}
	return 1;
}

CMD:farol(playerid)
{
	if(!IsPlayerInAnyVehicle(playerid))
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta em um veiculo.");
	}
	else if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao e o motorista do veiculo.");
	}
	else if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 509 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 481 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 510)
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este veiculo nao possui farol");
	}
	else
	{
		new engine, lights, alarm, doors, bonnet, boot, objective, vehicleid = GetPlayerVehicleID(playerid);
		GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
		if(luzes[vehicleid] == true)
		{
			SetVehicleParamsEx(vehicleid, engine, VEHICLE_PARAMS_OFF, alarm, doors, bonnet, boot, objective);
			luzes[vehicleid] = false;

			GameTextForPlayer(playerid, "~w~Farol ~r~Desligado", 2000, 4);
		}
		else if(luzes[vehicleid] == false)
		{
			SetVehicleParamsEx(vehicleid, engine, VEHICLE_PARAMS_ON, alarm, doors, bonnet, boot, objective);
			luzes[vehicleid] = true;

			GameTextForPlayer(playerid, "~w~Farol ~r~Ligado", 2000, 4);
		}
	}
	return 1;
}

CMD:abastecer(playerid)
{
	for(new i; i < MAX_POSTO; i++)
	{
		if(ISP(playerid, 10.0, PostoInfo[i][PostoPosX], PostoInfo[i][PostoPosY], PostoInfo[i][PostoPosZ]))
		{
			if(!IsPlayerInAnyVehicle(playerid))
			{
				return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta em um veiculo.");
			}
			else if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 509 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 481 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 510)
			{
				return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Este veiculo nao possui motor");
			}
			else
			{
			    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
				{
				    new stg[5000];
					format(gstring, 128, "{FFDC33}B{00FF00}R{FFFFFF} - Gasolina:\t{00FF00}R$%d\n", Impostos[CombustivelG]);
					strcat(stg, gstring);
					format(gstring, 128, "{FFDC33}B{00FF00}R{FFFFFF} - Digite a quantidade de gasolina que deseja abastecer");
					strcat(stg, gstring);

					ShowPlayerDialog(playerid, DIALOG_ABASTECER, DIALOG_STYLE_INPUT, "Posto de Combustivel {FFDC33}B{00FF00}R", stg, "Abastecer", "X");
				}
				else
				{
				    SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta dirigindo o veiculo.");
				}
			}
		}
	}
	return 1;
}

CMD:abastecergalao(playerid)
{
    if(Pp[playerid][Logado] == true)
    {
        if(SegurandoMaoDireita[playerid] != 4)
        {
    		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta segurando um Galao de Gasolina");
    	}
        else
        {
        	for(new i; i < MAX_POSTO; i++)
        	{
        		if(ISP(playerid, 10.0, PostoInfo[i][PostoPosX], PostoInfo[i][PostoPosY], PostoInfo[i][PostoPosZ]))
        		{
        			if(!IsPlayerInAnyVehicle(playerid))
        			{
        				new stg[5000];
        				format(gstring, 128, "{FFDC33}B{00FF00}R{FFFFFF} - Gasolina:\t{00FF00}R$%d\n", Impostos[CombustivelG]);
        				strcat(stg, gstring);
        				format(gstring, 128, "{FFDC33}B{00FF00}R{FFFFFF} - Digite a quantidade de gasolina que deseja abastecer seu {FFD700}Galao");
        				strcat(stg, gstring);

        				ShowPlayerDialog(playerid, DIALOG_ABASTECERG, DIALOG_STYLE_INPUT, "Posto de Combustivel {FFDC33}B{00FF00}R", stg, "Abastecer", "X");
        			}
        			else
        			{
        				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pode abastecer um Galao estando em um veiculo.");
        			}
        		}
        	}
        }
    }
	return 1;
}

CMD:ajuda(playerid)
{
    if(Pp[playerid][Logado] == true)
	{
        MostrarComandosA(playerid);
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    }
    return 1;
}

CMD:gps(playerid)
{
    if(Pp[playerid][Logado] == true)
	{
        if(CheckCorridaC[playerid] == 0 && CheckCorridaC2[playerid] == 0 && CheckCorridaC3[playerid] == 0 && CheckCorridaC4[playerid] == 0)
        {
            MostrarGpsA(playerid);
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar gps em uma corrida.");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    }
	return 1;
}

CMD:mecanica(playerid)
{
    new vehicleid = GetPlayerVehicleID(playerid);
    for(new i; i < 4; i++)
    {
    	if(ISP(playerid, 5.0, MenuOficina[i][0], MenuOficina[i][1], MenuOficina[i][2]))
    	{
    	    if(!IsPlayerInAnyVehicle(playerid))
    		{
    			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta em um veiculo.");
    		}
    		else
    		{
    	    	if(IfCarro[playerid][TemCarro] < 1) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce Nao Tem Nenhum Veiculo!");
    	    	{
                    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
                    {
                        if(vehicleid == VehConce[playerid])
                        {
                            MostrarMenuOficina(playerid);
                        }
                        else
                        {
                            SCM(playerid, -1, "{FF2500}Falha: {FFFFFF}Voce nao esta no veiculo que voce comprou na concessionaria.");
                        }
                    }
                    else
                    {
                        SCM(playerid, -1, "{FF2500}Falha: {FFFFFF}Voce nao esta como motorista.");
                    }
    			}
    		}
    	}
    }
	return 1;
}

CMD:caixa(playerid)
{
    if(Pp[playerid][FezRg] == 1)
    {
        if(Pp[playerid][FezBanco] == 1)
        {
        	for(new i = 1; i < MAX_CAIXAS; i++)
        	{
        		if(ISP(playerid, 2.0, CaixaInfo[i][CaixaPosX], CaixaInfo[i][CaixaPosY], CaixaInfo[i][CaixaPosZ]))
        		{
        			if(CaixaInfo[i][CaixaExplodido] == false)
        			{
        			    if(BancoDinheiro >= 1000000)
        	    		{
                            new str[5000];
                            //Nome da Conta
                            format(str,sizeof(str),"Nome da Conta: %s", PlayerName(playerid));
                            PlayerTextDrawSetString(playerid, TextDrawCaixaL[playerid][6], str); //ok
                            //Saldo
                            format(str,sizeof(str),"Saldo: %d", Pp[playerid][SaldoBancario]);
                            PlayerTextDrawSetString(playerid, TextDrawCaixaL[playerid][7], str); //ok
                            for(new i2; i2 < 57; i2++)
            				{
            					PlayerTextDrawShow(playerid, TextDrawCaixaL[playerid][i2]);
            				}
                            SelectTextDraw(playerid, 0x8B008BFF);
        				    return 1;
        				}
        				else
        				{
        				    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Os Servicos do Caixa ou Banco Central Estao Indisponiveis");
        				}
        			}
        			else
        			{
        			    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Caixa esta Indisponivel");
        			    return 1;
        			}
        		}
        	}
        }
        else
        {
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem uma Conta no Banco, va ao banco central");
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao fez seu Documento RG");
    }
	return 1;
}

CMD:setvip(playerid, params[])
{
	if(Pp[playerid][Admin] >= 5)
	{
		new id, level, dias;
		if(sscanf(params, "ddd", id, level, dias))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /setvip [IDF] [level] [dias]");
		}
		else if(level < 0 || level > 5)
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Os valor tem que ser entre 1 e 5");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
					new string[1200];
					Pp[i][Vip] = level;
					Pp[i][TempoVip] = dias * 86400;
					SalvarDados(i);

					if(level == 1)
					{
						format(string,sizeof(string),"AdmCMD: %s definiu o jogador %s como Vip Bronze com %d dias", PlayerName(playerid), PlayerName(i), dias);
		            	SendClientMessageToAll(COLOR_LIGHTRED, string);
                        SendClientMessage(i, -1, "{FFDC33}InfoVip: {FFFFFF}Voce Recebeu seus Beneficios de {FFDC33}[VIP] {FFFFFF}Dinheiro: {00FF00}R$100000");
                        GivePlayerCash(i, 100000);
                        SetPlayerScore(i, GetPlayerScore(i)+2);
                        GameTextForPlayer(i, "~w~Para~y~bens!", 5000, 0);
						new Float:x, Float:y, Float:z;
						GetPlayerPos(i, x, y, z);
						CreateExplosion(x, y, z+25, 7, 5.0);
					}
					else if(level == 2)
					{
						format(string,sizeof(string),"AdmCMD: %s definiu o jogador %s como Vip Prata com %d dias", PlayerName(playerid), PlayerName(i), dias);
		            	SendClientMessageToAll(COLOR_LIGHTRED, string);
		            	SendClientMessage(i, -1, "{FFDC33}InfoVip: {FFFFFF}Voce Recebeu seus Beneficios de {FFDC33}[VIP] {FFFFFF}Dinheiro: {00FF00}R$200000");
		            	GivePlayerCash(i, 200000);
                        SetPlayerScore(i, GetPlayerScore(i)+4);
                        GameTextForPlayer(i, "~w~Para~y~bens!", 5000, 0);
						new Float:x, Float:y, Float:z;
						GetPlayerPos(i, x, y, z);
						CreateExplosion(x, y, z+25, 7, 5.0);
					}
					else if(level == 3)
					{
						format(string,sizeof(string),"AdmCMD: %s definiu o jogador %s como Vip Ouro com %d dias", PlayerName(playerid), PlayerName(i), dias);
		            	SendClientMessageToAll(COLOR_LIGHTRED, string);
		            	SendClientMessage(i, -1, "{FFDC33}InfoVip: {FFFFFF}Voce Recebeu seus Beneficios de {FFDC33}[VIP] {FFFFFF}Dinheiro: {00FF00}R$300000");
		            	GivePlayerCash(i, 300000);
                        SetPlayerScore(i, GetPlayerScore(i)+7);
                        GameTextForPlayer(i, "~w~Para~y~bens!", 5000, 0);
						new Float:x, Float:y, Float:z;
						GetPlayerPos(i, x, y, z);
						CreateExplosion(x, y, z+25, 7, 5.0);
					}
					else if(level == 4)
					{
						format(string,sizeof(string),"AdmCMD: %s definiu o jogador %s como Vip Platina com %d dias", PlayerName(playerid), PlayerName(i), dias);
		            	SendClientMessageToAll(COLOR_LIGHTRED, string);
		            	SendClientMessage(i, -1, "{FFDC33}InfoVip: {FFFFFF}Voce Recebeu seus Beneficios de {FFDC33}[VIP] {FFFFFF}Dinheiro: {00FF00}R$500000");
		            	GivePlayerCash(i, 500000);-
                        SetPlayerScore(i, GetPlayerScore(i)+11);
                        GameTextForPlayer(i, "~w~Para~p~bens!", 5000, 0);
						new Float:x, Float:y, Float:z;
						GetPlayerPos(i, x, y, z);
						CreateExplosion(x, y, z+25, 7, 5.0);
					}
					else if(level == 5)
					{
						format(string,sizeof(string),"AdmCMD: %s definiu o jogador %s como Vip Diamante com %d dias", PlayerName(playerid), PlayerName(i), dias);
		            	SendClientMessageToAll(COLOR_LIGHTRED, string);
		            	SendClientMessage(i, -1, "{FFDC33}InfoVip: {FFFFFF}Voce Recebeu seus Beneficios de {FFDC33}[VIP] {FFFFFF}Dinheiro: {00FF00}R$800000");
                        GivePlayerCash(i, 800000);-
                        SetPlayerScore(i, GetPlayerScore(i)+12);
                        GameTextForPlayer(i, "~w~Para~b~bens!", 5000, 0);
                        SetPlayerScore(i, GetPlayerScore(i)+15);
						new Float:x, Float:y, Float:z;
						GetPlayerPos(i, x, y, z);
						CreateExplosion(x, y, z+25, 7, 5.0);
					}
					format(string, sizeof(string), "SERVER: Voce definiu o jogador %s como um membro vip", PlayerName(i));
					SCM(playerid, -1, string);
					format(string, sizeof(string), "SERVER: O Admin %s Te setou Vip, Use: /ajuda - Vips", PlayerName(playerid));
					SendClientMessage(i, -1, string);
					return 1;
				}
			}
		}
		return 1;
	}
	else SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	return 1;
}

CMD:setsocio(playerid, params[])
{
	if(Pp[playerid][Admin] >= 6)
	{
		new id, level, dias;
		if(sscanf(params, "ddd", id, level, dias))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /setsocio [IDF] [level - [1] Comum || [2] Raro(Permanente)] [dias]");
		}
		else if(level < 0 || level > 2)
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Os valor tem que ser entre 1 e 2");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
					new string[1200];
					Pp[i][Socio] = level;
					Pp[i][TempoSocio] = dias * 86400;
					SalvarDados(i);

					if(level == 1)
					{
						format(string,sizeof(string),"AdmCMD: %s Setou a Tag de Socio Comum Para o Jogador %s por %d Dias", PlayerName(playerid), PlayerName(i), dias);
		            	SendClientMessageToAll(COLOR_LIGHTRED, string);
                        SendClientMessage(i, -1, "{48D1CC}InfoSocio: {FFFFFF}Voce Recebeu seus Beneficios de {48D1CC}[SOCIO] {FFFFFF}Dinheiro: {00FF00}R$1.200.000.00");
		            	GivePlayerCash(i, 1200000);
                        SetPlayerScore(playerid, GetPlayerScore(playerid)+20);
                        new stg[5000];
                        strcat(stg,  "{FFD700}1. {FFFFFF}Voce Recebeu O Valor de: {00FF00}R$1.200.000.00\n");
                        strcat(stg,  "{FFD700}2. {FFFFFF}E mais 20+ de Nivel!\n\n");
                        strcat(stg,  "{FFD700}3. {FFFFFF}Parabens Pela Compra! Voce agora e um {48D1CC}Socio GCRP\n");
	                    ShowPlayerDialog(i, 5000, DIALOG_STYLE_MSGBOX, "Beneficios {FFD700}Socio GCRP", stg, "Ok", "");
					}
					else if(level == 2)
					{
						format(string,sizeof(string),"AdmCMD: %s Setou a Tag de Socio Raro Para o Jogador: %s por %d Dias!", PlayerName(playerid), PlayerName(i), dias);
		            	SendClientMessageToAll(COLOR_LIGHTRED, string);
                        SendClientMessage(i, -1, "{48D1CC}InfoSocio: {FFFFFF}Voce Recebeu seus Beneficios de {48D1CC}[SOCIO] {FFFFFF}Dinheiro: {00FF00}R$5.000.000.00");
                        SendClientMessage(i, -1, "{48D1CC}InfoSocio: {FFFFFF}Voce Recebeu seus Beneficios de {48D1CC}[SOCIO] {FFFFFF}Coins: {FFDC33}50 Coins");
		            	GivePlayerCash(i, 5000000);
                        Pp[i][Coins] += 50;
                        Pp[i][HabilitacaoA] = 1;
                        Pp[i][HabilitacaoB] = 1;
                        Pp[i][HabilitacaoC] = 1;
                        Pp[i][HabilitacaoD] = 1;
                        Pp[i][FezPorte] = 1;
                        Pp[i][SaldoBancario] = 1200000;
                        SetPlayerScore(playerid, GetPlayerScore(playerid)+40);
                        new stg[5000];
                        strcat(stg,  "{FFD700}1. {FFFFFF}Voce Recebeu O Valor de: {00FF00}R$5.000.000.00\n");
                        strcat(stg,  "{FFD700}2. {FFFFFF}Voce Recebeu O Valor de: {48D1CC}R$1.200.000.00 {FFFFFF}No seu Banco!\n");
                        strcat(stg,  "{FFD700}3. {FFFFFF}Alem disso, Voce tambem recebeu Todas as Licencas! A, B, C, D, E Porte de Armas\n");
                        strcat(stg,  "{FFD700}4. {FFFFFF}E mais 40+ de Nivel!\n\n");
                        strcat(stg,  "{FFD700}5. {FFFFFF}Parabens Pela Compra! Voce agora e um {48D1CC}Socio GCRP\n");
	                    ShowPlayerDialog(i, 5000, DIALOG_STYLE_MSGBOX, "Beneficios {FFD700}Socio GCRP", stg, "Ok", "");
					}
					format(string, sizeof(string), "SERVER: Voce definiu o jogador %s como um membro Socio", PlayerName(i));
					SCM(playerid, -1, string);
					format(string, sizeof(string), "SERVER: O Admin %s Te setou Vip, Use: /ajuda - Comandos Socios", PlayerName(playerid));
					SendClientMessage(i, -1, string);
					return 1;
				}
			}
		}
		return 1;
	}
	else SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	return 1;
}

