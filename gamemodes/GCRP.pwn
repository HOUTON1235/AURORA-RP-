    || strfind(PlayerName(playerid), "Staff", true) != -1 || strfind(PlayerName(playerid), "STAFF", true) != -1 || strfind(PlayerName(playerid), "Ademiro", true) != -1 || strfind(PlayerName(playerid), "ADEMIRO", true) != -1 || strfind(PlayerName(playerid), "PatatiroGamer", true) != -1)
	{
        ShowPlayerDialog(playerid, 5000, DIALOG_STYLE_MSGBOX, "{FFD700}Nick","{FFFFFF}Voce Foi Kickado por usar algum nome incorreto!\n{FFFFFF}Seu nome deve ser no formato Nome_Sobrenome Ex: Apxgui_Staff\n{FFFFFF}Troque-o e volte, Obrigado","Sair","");
