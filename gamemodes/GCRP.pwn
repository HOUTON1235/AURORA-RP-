							format(gstring, sizeof(gstring), "{FFD700}[ EMPRESA ]: {FFFFFF}O Jogador %s comprou a empresa id %d no valor de R$%d.", PlayerName(playerid), EmPp[i][EmpresaId], EmPp[i][EmpresaValor]);
