	if(dialogid == DIALOG_COINS)
	{
		if(response)
		{
		    new string[450];
			if(listitem == 0)
			{
			    if(Pp[playerid][Coins] >= 10000)
				{
				    if(Pp[playerid][Vip] == 0)
				    {
				        Pp[playerid][Coins] -= 10000;
						Pp[playerid][Vip] = 1;
						Pp[playerid][TempoVip] = 30 * 86400;
						GivePlayerCash(playerid, 100000);
                        SetPlayerScore(playerid, GetPlayerScore(playerid)+2);
