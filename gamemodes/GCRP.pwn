CMD:reviver(playerid, params[])
{
	if(Pp[playerid][Admin] >= 1)
	{
	    new id;
		if(sscanf(params,"i",id)) return SCM(playerid,COR_VERMELHO,"{FFD700}INFO: {FFFFFF}Use: /reviver [IDF]");
		{
      		for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
					    if(Pp[i][Ferido] == true)
					    {
					        new Float:x,Float:y,Float:z;
							GetPlayerPos(i,x,y,z);
							if(ISP(playerid,5,x,y,z))
							{
							    //Morte do Player
								Pp[i][Ferido] = false;
								Pp[i][MinutosFerido] = 0;
								Pp[i][SegundosFerido] = 0;
								KillTimer(ProtecaoAlgemas[i]);
                                Pp[i][Mutado] = 0;
							    Pp[i][MinutosMutado] = 0;
							    SvMutePlayerDisable(i);
								ProtecaoAlgemas[i] = 0;
								for(new i3 = 1; i3 < 4; i3++)
								{
									PlayerTextDrawHide(i, TextDrawMorte[i][i3]);
								}
								KillTimer(TimerFerido[i]);
								TimerFerido[i] = 0;
								SetPlayerHealth(i, 100.0);
								GameTextForPlayer(i, "~r~Reanimado!", 3000, 1);
								GameTextForPlayer(playerid, "~w~Voce Reanimou um ~n~ ~r~Player!", 3000, 3);
								SCM(playerid, -1, "{FFFFFF}Voce reanimou um Player");
								SendClientMessage(i, -1, "{FFFFFF}Um Admin te Reanimou");

								Controle(playerid, 1);

				                SetTimerEx("DCANIM", 500, false, "d", i);
								return 1;
							}
							else
							{
							    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a este Player..");
							}
						}
						else
						{
						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Nao esta Ferido..");
						}
					}
				}
			}
			return 1;
		}
	}
	return 1;
}

CMD:reanimar(playerid, params[])
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
	if(Pp[playerid][Profissao] == PROF_SAMU)
	{
	    if(BcSamu[playerid] == 1)
	    {
		    new id;
			if(sscanf(params,"i",id)) return SCM(playerid,COR_VERMELHO,"{FFD700}INFO: {FFFFFF}Use: /reanimar [IDF]");
			{
       			for(new i; i < MAX_PLAYERS; i++)
				{
					if(Pp[i][Logado] == true)
					{
					    if(Pp[i][IDF] == id)
					    {
					        if(id == Pp[playerid][IDF])
					        {
								SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se reanimar");
					        }
						    if(Pp[i][Ferido] == true)
						    {
                                new Float:x,Float:y,Float:z;
    							GetPlayerPos(i,x,y,z);
    							if(ISP(playerid,5,x,y,z))
    							{
    						        new string[1200];
    								format(string, sizeof(string), "* O ID:[%d] esta tentando reanimar o jogador ID:[%d].", Pp[playerid][IDF], Pp[i][IDF]);
    							    ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);

    								ApplyAnimation(playerid, "MEDIC", "CPR", 4.0, 1, 0, 0, 0, 0);
    								SetTimerEx("DCANIM", 10000, false, "i", playerid);
    								SetTimerEx("DCANIM", 10001, false, "i", i);
    								SetTimerEx("GranaSamu", 10000, false, "i", playerid);
    								SetTimerEx("Levantar", 10001, false, "i", i);
    								return 1;
                                }
                                else
    							{
    							    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Nao esta Proximo a Voce..");
    							}
							}
							else
							{
							    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Nao esta Ferido..");
							}
						}
					}
				}
				return 1;
			}
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao Bateu seu Cartao");
		}
	}
	return 1;
}
CMD:curar(playerid, params[])
{
    if(Pp[playerid][Ferido] == true)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode usar este comando agora");
	if(Pp[playerid][Profissao] == PROF_SAMU)
	{
	    if(BcSamu[playerid] == 1)
	    {
		    new id;
			if(sscanf(params,"i",id)) return SCM(playerid,COR_VERMELHO,"{FFD700}INFO: {FFFFFF}Use: /curar [IDF]");
			{
       			for(new i; i < MAX_PLAYERS; i++)
				{
					if(Pp[i][Logado] == true)
					{
					    if(Pp[i][IDF] == id)
					    {
					        if(id == Pp[playerid][IDF])
					        {
								SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se curar");
					        }
						    else if(Pp[i][Ferido] == false)
						    {
						        new string[1200];
								format(string, sizeof(string), "* O ID:[%d] esta Curando o jogador ID:[%d].", Pp[playerid][IDF], Pp[i][IDF]);
							    ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);

                                GameTextForPlayer(playerid, "~w~Player ~g~Curado!", 1200, 6);
                                SetPlayerHealth(i, 100.0);
                                GivePlayerCash(playerid, 50);
								return 1;
							}
							else
							{
							    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Nao pode ser curado, use: /reanimar..");
							}
						}
					}
				}
				return 1;
			}
		}
		else
