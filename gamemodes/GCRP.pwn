CMD:vendercasa(playerid, params[])
{
	for(new i = 0; i < MAX_CASAS; i++)
	{
		if(ISP(playerid, 10.0, CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ]))
		{
			format(arquivo, sizeof(arquivo), PASTA_CASAS, i);
   			if(strcmp(DOF2_GetString(arquivo, "CasaDono"), PlayerName(playerid), false))
			{
				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Essa Casa nao pertence a voce.");
				return 1;
			}
			else if(CasaInfo[i][CasaAVenda] == 1)
			{
		        SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Sua Casa ja esta a venda.");
		        return 1;
			}
			else
			{
				if(IsPlayerConnected(playerid))
				{
					format(gstring, sizeof(gstring), "{FFDC33}INFO: {FFD700}O Jogador(a) {FFDC33}%s {FFD700}vendeu sua casa com o ID: [%d] Pelo Valor de: {00FF00}R$%d", PlayerName(playerid), CasaInfo[i][CasaId], CasaInfo[i][CasaValor]);
	                SendClientMessageToAll(COR_GREY, gstring);
	                Pp[playerid][Casa] = -1;
	                GivePlayerCash(playerid, CasaInfo[i][CasaValor]);

	                DOF2_SetString(arquivo, "CasaDono", "Nenhum");
	                DOF2_SetInt(arquivo, "CasaAVenda", 1);
					DOF2_SetInt(arquivo, "CasaPickup", 1273);
					DOF2_SetInt(arquivo, "CasaMapIcon", 31);
					DOF2_SaveFile();

					format(CasaInfo[i][CasaDono], 30, DOF2_GetString(arquivo, "CasaDono"));
					CasaInfo[i][CasaAVenda] = DOF2_GetInt(arquivo, "CasaAVenda");
					CasaInfo[i][CasaPickup] = DOF2_GetInt(arquivo, "CasaPickup");
					CasaInfo[i][CasaMapIcon] = DOF2_GetInt(arquivo, "CasaMapIcon");

					DestroyDynamicPickup(PickupCasa[i]);
					DestroyDynamicMapIcon(MapIconCasa[i]);

					PickupCasa[i] = CreateDynamicPickup(CasaInfo[i][CasaPickup], 23, CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ]);
					MapIconCasa[i] = CreateDynamicMapIcon(CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ], CasaInfo[i][CasaMapIcon], 0, -1, -1, -1, 100.0, MAPICON_LOCAL);
					return 1;
				}
			}
		}
	}
	return 1;
}

CMD:criarradar(playerid, params[])
{
	if(Pp[playerid][Admin] >= 4)
	{
		new velocidade, Float:RadarX, Float:RadarY, Float:RadarZ, Float:RadarRZ;
		if(sscanf(params, "i", velocidade))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /criarradar [velocidade]");
		}
		else if(velocidade <= 0)
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use uma velocidade de 0Km a 100Km.");
		}
		else
		{
			for(new i; i < MAX_RADAR; i++)
			{
				format(arquivo, sizeof(arquivo), PASTA_RADAR, i);
				if(!DOF2_FileExists(arquivo))
				{
					GetPlayerPos(playerid, Float:RadarX, Float:RadarY, Float:RadarZ);
                    GetPlayerFacingAngle(playerid, Float:RadarRZ);

					DOF2_CreateFile(arquivo);
					DOF2_SetInt(arquivo, "RadarID", i);
					DOF2_SetInt(arquivo, "RadarVelocidade", velocidade);

					DOF2_SetFloat(arquivo, "RadarPosX", RadarX);
					DOF2_SetFloat(arquivo, "RadarPosY", RadarY);
					DOF2_SetFloat(arquivo, "RadarPosZ", RadarZ);
					DOF2_SetFloat(arquivo, "RadarPosR", RadarRZ);
					DOF2_SaveFile();

					RadarInfo[i][RadarID] = DOF2_GetInt(arquivo, "RadarID");
					RadarInfo[i][RadarVelocidade] = DOF2_GetInt(arquivo, "RadarVelocidade");

					RadarInfo[i][RadarPosX] = DOF2_GetFloat(arquivo, "RadarPosX");
					RadarInfo[i][RadarPosY] = DOF2_GetFloat(arquivo, "RadarPosY");
					RadarInfo[i][RadarPosZ] = DOF2_GetFloat(arquivo, "RadarPosZ");
					RadarInfo[i][RadarPosR] = DOF2_GetFloat(arquivo, "RadarPosR");

                    ObjetoRadar[i] = CreateDynamicObject(18880, RadarInfo[i][RadarPosX], RadarInfo[i][RadarPosY], RadarInfo[i][RadarPosZ]-1.5, 0.0, 0.0, RadarInfo[i][RadarPosR]);
					ObjetoRadar2[i] = CreateDynamicObject(18880, RadarInfo[i][RadarPosX], RadarInfo[i][RadarPosY], RadarInfo[i][RadarPosZ]-1.5, 0.0, 0.0, RadarInfo[i][RadarPosR] + 180.0);

                    MapIconRadar[i] = CreateDynamicMapIcon(RadarInfo[i][RadarPosX], RadarInfo[i][RadarPosY], RadarInfo[i][RadarPosZ], 34, 0, -1, -1, -1, 100.0, MAPICON_LOCAL);

                    SetPlayerPos(playerid, RadarX + 1, RadarY + 1, RadarZ + 1);

     				new string[450];
					format(string, sizeof(string), "{FFFF00}[RADAR DE VELOCIDADE]\n{FFFFFF}ID: %d\n\n{FFFFFF}LIMITE DE VELOCIDADE : {FFFF00}%d KM/H", RadarInfo[i][RadarID], RadarInfo[i][RadarVelocidade]);
					TextoRadar[i] = CreateDynamic3DTextLabel(string, -1, RadarInfo[i][RadarPosX], RadarInfo[i][RadarPosY], RadarInfo[i][RadarPosZ]+4, 50.0);

					format(string, sizeof(string), "{FFD700}[Info-Radar]: {FFFFFF} Radar ID: {FFD700}[%d]{FFFFFF} com Velocidade de {FFD700}[%d KM/H]{FFFFFF} Criado com sucesso!", RadarInfo[i][RadarID], RadarInfo[i][RadarVelocidade]);
					SCM(playerid, -1, string);
					return 1;
				}
			}
		}
	}
	else
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando.");
	}
	return 1;
}

CMD:dradar(playerid, params[])
{
	if(Pp[playerid][Admin] >= 4)
	{
		new id, arq1[50], mensagem[128];
		if(sscanf(params, "i", id)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /destradar [ID do Radar].");
		format(arq1, sizeof(arq1), PASTA_RADAR, id);
		if(DOF2_FileExists(arq1))
		{
			format(mensagem, sizeof(mensagem), "{FFFFFF}Voce deletou o radar %d.", id);
		    SCM(playerid, 0xFF0000FF, mensagem);
		    DestroyDynamicObject(ObjetoRadar[id]);
		    DestroyDynamicObject(ObjetoRadar2[id]);
		    DestroyDynamic3DTextLabel(TextoRadar[id]);
            DestroyDynamicMapIcon(MapIconRadar[id]);
			RadarInfo[id][RadarPosX] = 0;
			RadarInfo[id][RadarPosY] = 0;
			RadarInfo[id][RadarPosZ] = 0;
			RadarInfo[id][RadarPosR] = 0;
			RadarInfo[id][RadarVelocidade] = 999;
			DOF2_RemoveFile(arq1);
			return 1;
		}
		else
		{
	        format(mensagem, sizeof(mensagem), "{FFD700}INFO: {FFFFFF}O Radar [%d] Nao Existe nso Arquivos do Servidor.", id);
			SCM(playerid, 0xFF0000FF, mensagem);
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	}
	return 1;
}

CMD:criarsp(playerid, params[])
{
	if(Pp[playerid][Admin] >= 4)
	{
		new Float:XX, Float:YY, Float:ZZ, Float:RR;
		for(new i; i < MAX_SPAWNS; i++)
		{
			format(arquivo, sizeof(arquivo), PASTA_SPAWNS, i);
			if(!DOF2_FileExists(arquivo))
			{
				GetPlayerPos(playerid, Float:XX, Float:YY, Float:ZZ);
                GetPlayerFacingAngle(playerid, Float:RR);

				DOF2_CreateFile(arquivo);
				DOF2_SetInt(arquivo, "SpID", i);

				DOF2_SetFloat(arquivo, "SpPosX", XX);
				DOF2_SetFloat(arquivo, "SpPosY", YY);
				DOF2_SetFloat(arquivo, "SpPosZ", ZZ);
				DOF2_SetFloat(arquivo, "SpPosR", RR);
				DOF2_SaveFile();

				SpawnVInfo[i][SpID] = DOF2_GetInt(arquivo, "SpID");

				SpawnVInfo[i][SpPosX] = DOF2_GetFloat(arquivo, "SpPosX");
				SpawnVInfo[i][SpPosY] = DOF2_GetFloat(arquivo, "SpPosY");
				SpawnVInfo[i][SpPosZ] = DOF2_GetFloat(arquivo, "SpPosZ");
				SpawnVInfo[i][SpPosR] = DOF2_GetFloat(arquivo, "SpPosR");

     			new string[450];
				format(string, sizeof(string), "{FFD700}Gold City {FFFFFF}ROLEPLAY\n\n{FFFFFF}Spawn de veiculos[%d]\nAperte {FFD700}F", SpawnVInfo[i][SpID]);
				TextoSpawnV[i] = CreateDynamic3DTextLabel(string, -1, SpawnVInfo[i][SpPosX], SpawnVInfo[i][SpPosY], SpawnVInfo[i][SpPosZ], 15.0);
                PickSpawnV[i] = CreateDynamicPickup(1098, 1, SpawnVInfo[i][SpPosX], SpawnVInfo[i][SpPosY], SpawnVInfo[i][SpPosZ]);

				format(string, sizeof(string), "{FFDC33}SpawnV: {FFFFFF}O Spawn de veiculos de org id: %d foi criado com sucesso!", SpawnVInfo[i][SpID]);
				SCM(playerid, -1, string);
				return 1;
			}
		}
	}
	else
	{
		return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando.");
	}
	return 1;
}

