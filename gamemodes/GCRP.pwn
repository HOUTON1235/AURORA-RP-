public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
    new Float:AX, Float:AY, Float:AZ;
	if(Pp[playerid][Algemado] == true)
	{
		if(Colocado[playerid] == false)
		{
			GetPlayerPos(playerid, Float:AX, Float:AY, Float:AZ);
            SetPlayerPos(playerid, AX, AY, AZ+1);

			SCM(playerid, COR_VERMELHO, "{FFFFFF}Voce tentou entrar em um veiculo algemado isso e proibido.");
            PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "Voce esta ~g~Algemado.");
		}
	}
    if(CarroTrank[vehicleid] == 1)
    {
        GetPlayerPos(playerid, Float:AX, Float:AY, Float:AZ);
        SetPlayerPos(playerid, AX, AY, AZ+1);
        SCM(playerid, 0xFF0080AA, "{FFD700}INFO: {FFFFFF}Este Veiculo Esta Trancado, Para Abrir use: /destrancar");
        PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "Veiculo ~r~Trancado.");
        return 1;
    }
	return 1;
}

public OnPlayerExitVehicle(playerid, vehicleid)
{
    new engine, lights, alarm, doors, bonnet, boot, objective;
	GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		if(motor[vehicleid] == true)
		{
			SetVehicleParamsEx(vehicleid, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective);
			motor[vehicleid] = false;
            PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "Desligado.");
            PlayerTextDrawShow(playerid, TextDrawAviso3[playerid][0]);
            SetTimerEx("TirarTD22", 2000, false, "i", playerid);
			new string[1200];
			format(string, sizeof(string), "* O ID: [%d] Girou a chave e desligou o motor de seu veiculo.", Pp[playerid][IDF]);
	   		ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
		}
		GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
		if(luzes[vehicleid] == true)
		{
			SetVehicleParamsEx(vehicleid, engine, VEHICLE_PARAMS_OFF, alarm, doors, bonnet, boot, objective);
			luzes[vehicleid] = false;
		}
	}
    if(vehicleid == CarroEvento[playerid])
	{
	    if(AcessouMenuCar[playerid] == 1)
		{
			AcessouMenuCar[playerid] = 0;

            CarroTrank[vehicleid] = 0;
         	CarroInfo[vehicleid][ChaveCarro] = 0;

            PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "Veiculo ~r~guardado.");
			DestroyVehicle(CarroEvento[playerid]);
		}
	}
    if(vehicleid == CarroEventoIV[playerid])
	{
        if(AcessouMenuCarInv[playerid] == 1)
        {
            new carid = GetVehicleModel(CarroEventoIV[playerid]);
            if(Slots[playerid][idslotiv[playerid]] == 999999)
            {
            	Slots[playerid][idslotiv[playerid]] = carid;
                PlayerTextDrawSetPreviewModel(playerid, InvCarTDP[playerid][idslotiv[playerid]], Slots[playerid][idslotiv[playerid]]);
            }
            idslotiv[playerid] = 0;

        	CarroTrank[CarroEventoIV[playerid]] = 0;
        	CarroInfo[CarroEventoIV[playerid]][ChaveCarro] = 0;

            PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "Veiculo ~r~Guardado.");
        	AcessouMenuCarInv[playerid] = 0;
        	DestroyVehicle(CarroEventoIV[playerid]);
            SalvarInvCars(playerid);
        }
    }
    if(vehicleid == CarroEventoIV[playerid])
	{
        if(AcessouMenuCarInv[playerid] == 1)
        {
            new carid = GetVehicleModel(CarroEventoIV[playerid]);
            if(Slots[playerid][idslotiv[playerid]] == 999999)
            {
            	Slots[playerid][idslotiv[playerid]] = carid;
                PlayerTextDrawSetPreviewModel(playerid, InvCarTDP[playerid][idslotiv[playerid]], Slots[playerid][idslotiv[playerid]]);
            }
            idslotiv[playerid] = 0;

        	CarroTrank[CarroEventoIV[playerid]] = 0;
        	CarroInfo[CarroEventoIV[playerid]][ChaveCarro] = 0;

            PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "Veiculo ~r~Guardado..");
        	AcessouMenuCarInv[playerid] = 0;
        	DestroyVehicle(CarroEventoIV[playerid]);
            SalvarInvCars(playerid);
        }
    }
	if(IniciouTesteHabilitacaoA[playerid] == 1)
	{
		if(IsPlayerInVehicle(playerid, AutoEscolaMoto[playerid]))
		{
            CarroTrank[vehicleid] = 0;
         	CarroInfo[vehicleid][ChaveCarro] = 0;
			RemovePlayerFromVehicle(playerid);
			DestroyVehicle(AutoEscolaMoto[playerid]);

			PlayerPlaySound(playerid,1137,0.0,0.0,0.0);
			DisablePlayerRaceCheckpoint(playerid);
			CheckpointPontosMoto[playerid] = 0;
			KillTimer(TimerTesteMoto[playerid]);

			SetPlayerPos(playerid, -501.1599,294.3547,2001.0950), SetPlayerInterior(playerid, 3);
			IniciouTesteHabilitacaoA[playerid] = 0;
			PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "~r~Reprovado.");
            SetPlayerVirtualWorld(playerid, 0);

			SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce foi reprovado por sair do veiculo no teste pratico.");

			SetTimerEx("CarregandoObjetos", 5000, false, "d", playerid);
            for(new i = 1; i < 3; i++){PlayerTextDrawShow(playerid, TdCarregarINT[playerid][i]);}
			Controle(playerid, 0);
		}
	}
	else if(IniciouTesteHabilitacaoB[playerid] == 1)
	{
		if(IsPlayerInVehicle(playerid, AutoEscolaVeiculo[playerid]))
		{
            CarroTrank[vehicleid] = 0;
         	CarroInfo[vehicleid][ChaveCarro] = 0;
			RemovePlayerFromVehicle(playerid);
			DestroyVehicle(AutoEscolaVeiculo[playerid]);

			PlayerPlaySound(playerid,1137,0.0,0.0,0.0);
			DisablePlayerRaceCheckpoint(playerid);
			CheckpointPontosVeiculo[playerid] = 0;
			KillTimer(TimerTesteVeiculo[playerid]);

			SetPlayerPos(playerid, -501.1599,294.3547,2001.0950), SetPlayerInterior(playerid, 3);
			IniciouTesteHabilitacaoB[playerid] = 0;
			PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "~r~Reprovado.");
            SetPlayerVirtualWorld(playerid, 0);

			SCM(playerid, COR_VERMELHO, "{FFD700}Info-Teste: {FFFFFF}Voce foi reprovado por sair do veiculo no teste pratico.");

			SetTimerEx("CarregandoObjetos", 5000, false, "d", playerid);
            for(new i = 1; i < 3; i++){PlayerTextDrawShow(playerid, TdCarregarINT[playerid][i]);}
			Controle(playerid, 0);
		}
	}
	else if(IniciouTesteHabilitacaoC[playerid] == 1)
	{
		if(IsPlayerInVehicle(playerid, AutoEscolaCaminhao[playerid]))
		{
            CarroTrank[vehicleid] = 0;
         	CarroInfo[vehicleid][ChaveCarro] = 0;
			RemovePlayerFromVehicle(playerid);
			DestroyVehicle(AutoEscolaCaminhao[playerid]);

			PlayerPlaySound(playerid,1137,0.0,0.0,0.0);
			DisablePlayerRaceCheckpoint(playerid);
			CheckpointPontosCaminhao[playerid] = 0;
			KillTimer(TimerTesteCaminhao[playerid]);

			SetPlayerPos(playerid, -501.1599,294.3547,2001.0950), SetPlayerInterior(playerid, 3);
			IniciouTesteHabilitacaoC[playerid] = 0;
			PlayerTextDrawSetString(playerid, TextDrawAviso3[playerid][0], "~r~Reprovado.");
            SetPlayerVirtualWorld(playerid, 0);

			SCM(playerid, COR_VERMELHO, "{FFD700}Info-Teste: {FFFFFF}Voce foi reprovado por sair do veiculo no teste pratico.");

			SetTimerEx("CarregandoObjetos", 5000, false, "d", playerid);
            for(new i = 1; i < 3; i++){PlayerTextDrawShow(playerid, TdCarregarINT[playerid][i]);}
			Controle(playerid, 0);
		}
	}
	else if(IniciouTesteHabilitacaoD[playerid] == 1)
	{
		if(IsPlayerInVehicle(playerid, AutoEscolaAerea[playerid]))
		{
            CarroTrank[vehicleid] = 0;
         	CarroInfo[vehicleid][ChaveCarro] = 0;
			RemovePlayerFromVehicle(playerid);
			DestroyVehicle(AutoEscolaAerea[playerid]);

			PlayerPlaySound(playerid,1137,0.0,0.0,0.0);
			DisablePlayerRaceCheckpoint(playerid);
			CheckpointPontosAerea[playerid] = 0;
			KillTimer(TimerTesteAerea[playerid]);

			SetPlayerPos(playerid, -501.1599,294.3547,2001.0950), SetPlayerInterior(playerid, 3);
			IniciouTesteHabilitacaoD[playerid] = 0;
			GameTextForPlayer(playerid, "~r~Reprovado!", 5001, 6);
            SetPlayerVirtualWorld(playerid, 0);

			SCM(playerid, COR_VERMELHO, "{FFD700}Info-Teste: {FFFFFF}Voce foi reprovado por sair do veiculo no teste pratico.");

			SetTimerEx("CarregandoObjetos", 5000, false, "d", playerid);
            for(new i = 1; i < 3; i++){PlayerTextDrawShow(playerid, TdCarregarINT[playerid][i]);}
			Controle(playerid, 0);
		}
	}
	return 1;
}

public OnPlayerStateChange(playerid, newstate, oldstate)
{
	new vehicleid = GetPlayerVehicleID(playerid);
	if(GetVehicleModel(vehicleid) == 510 || GetVehicleModel(vehicleid) == 481 || GetVehicleModel(vehicleid) == 509)
	{
		new engine, lights, alarm, doors, bonnet, boot, objective;
		GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
		SetVehicleParamsEx(vehicleid, VEHICLE_PARAMS_ON, lights, alarm, doors, bonnet, boot, objective);
	}
    if(oldstate == PLAYER_STATE_ONFOOT && newstate == PLAYER_STATE_DRIVER)
	{
        if(InAnyBike(playerid))
	    {
            SCM(playerid, -1, "{FFFF00}[INFO] Voce entrou em um veiculo sem motor.");
        }
        else if(InAnyMoto(playerid))
	    {
            SCM(playerid, -1, "{9ACD32}[Motor] {FFFFFF}Para ligar ou desligar seu veiculo use a tecla 'Y'");
            if(Pp[playerid][Capacete] == true)
            {
                SCM(playerid, -1, "{A0522D}[Capacete]{FFFFFF} Use o capacete e evite se acidentar /capacete");
            }
            else if(Pp[playerid][Capacete] == false)
            {
                SCM(playerid, -1, "{FFFF00}[INFO] Voce esta sem capacete, compre em uma Lojinha.");
            }
        }
        else
        {
            SCM(playerid, -1, "{FFFF00}[INFO] Voce entrou em um veiculo com motor, use /motor ou aperte Y");
        }
	}
	if(oldstate == PLAYER_STATE_ONFOOT && newstate == PLAYER_STATE_DRIVER)
	{
	    if(InAnyBike(playerid))
	    {
	        for(new i; i < 19; i++)
			{
				PlayerTextDrawHide(playerid, TdVelocimetro[playerid][i]);
			}
	    }
	    else if(InAnyMoto(playerid))
	    {
			vehicleDriver[GetPlayerVehicleID(playerid)] = playerid;
	        playerCurVeh[playerid] = GetPlayerVehicleID(playerid);

	        if(playerCurVeh[playerid] != INVALID_VEHICLE_ID)
			{
	   			if(vehicleDriver[playerCurVeh[playerid]] == playerid) vehicleDriver[playerCurVeh[playerid]] = INVALID_PLAYER_ID;
	       		playerCurVeh[playerid] = INVALID_VEHICLE_ID;
	        }

            PlayerTextDrawSetPreviewModel(playerid,  TdVelocimetro[playerid][4], GetVehicleModel(GetPlayerVehicleID(playerid)));

	        new string[450];
            if(GetVehicleSpeed(GetPlayerVehicleID(playerid)) < 1001)
            {
                if(GetVehicleSpeed(GetPlayerVehicleID(playerid)) <= 70)
                {
                    format(string, sizeof(string), "~w~%03d", GetVehicleSpeed(GetPlayerVehicleID(playerid)));
			        PlayerTextDrawSetString(playerid, TdVelocimetro[playerid][6], string);
                }
                else if(GetVehicleSpeed(GetPlayerVehicleID(playerid)) >= 71)
                {
                    format(string, sizeof(string), "~r~%03d", GetVehicleSpeed(GetPlayerVehicleID(playerid)));
			        PlayerTextDrawSetString(playerid, TdVelocimetro[playerid][6], string);
                }
            }
            else if(GetVehicleSpeed(GetPlayerVehicleID(playerid)) >= 1001)
			{
			    format(string, sizeof(string), "~r~BAN", GetVehicleSpeed(GetPlayerVehicleID(playerid)));
				PlayerTextDrawSetString(playerid, TdVelocimetro[playerid][6], string);
			}

            if(Combustivel[GetPlayerVehicleID(playerid)] >= 10)
            {
                format(string, sizeof(string), "~w~%03d", Combustivel[GetPlayerVehicleID(playerid)]);
			    PlayerTextDrawSetString(playerid, TdVelocimetro[playerid][11], string);
            }
            else if(Combustivel[GetPlayerVehicleID(playerid)] < 10)
            {
                format(string, sizeof(string), "~w~%03d", Combustivel[GetPlayerVehicleID(playerid)]);
			    PlayerTextDrawSetString(playerid, TdVelocimetro[playerid][11], string);
            }
            for(new i = 0; i < 19; i++)
                PlayerTextDrawShow(playerid, TdVelocimetro[playerid][i]);

			SetTimerEx("AttVelocimetro", 200, false, "i", playerid);
		}
		else
		{
		    vehicleDriver[GetPlayerVehicleID(playerid)] = playerid;
	        playerCurVeh[playerid] = GetPlayerVehicleID(playerid);

	        if(playerCurVeh[playerid] != INVALID_VEHICLE_ID)
			{
	   			if(vehicleDriver[playerCurVeh[playerid]] == playerid) vehicleDriver[playerCurVeh[playerid]] = INVALID_PLAYER_ID;
	       		playerCurVeh[playerid] = INVALID_VEHICLE_ID;
	        }

            PlayerTextDrawSetPreviewModel(playerid,  TdVelocimetro[playerid][4], GetVehicleModel(GetPlayerVehicleID(playerid)));

	        new string[450];
            if(GetVehicleSpeed(GetPlayerVehicleID(playerid)) < 1001)
            {
                if(GetVehicleSpeed(GetPlayerVehicleID(playerid)) <= 70)
                {
                    format(string, sizeof(string), "~w~%03d", GetVehicleSpeed(GetPlayerVehicleID(playerid)));
			        PlayerTextDrawSetString(playerid, TdVelocimetro[playerid][6], string);
                }
                else if(GetVehicleSpeed(GetPlayerVehicleID(playerid)) >= 71)
                {
                    format(string, sizeof(string), "~r~%03d", GetVehicleSpeed(GetPlayerVehicleID(playerid)));
			        PlayerTextDrawSetString(playerid, TdVelocimetro[playerid][6], string);
                }
            }
            else if(GetVehicleSpeed(GetPlayerVehicleID(playerid)) >= 1001)
			{
			    format(string, sizeof(string), "~r~BAN", GetVehicleSpeed(GetPlayerVehicleID(playerid)));
				PlayerTextDrawSetString(playerid, TdVelocimetro[playerid][6], string);
			}

            if(Combustivel[GetPlayerVehicleID(playerid)] >= 10)
            {
                format(string, sizeof(string), "~w~%03d", Combustivel[GetPlayerVehicleID(playerid)]);
			    PlayerTextDrawSetString(playerid, TdVelocimetro[playerid][11], string);
            }
            else if(Combustivel[GetPlayerVehicleID(playerid)] < 10)
            {
                format(string, sizeof(string), "~w~%03d", Combustivel[GetPlayerVehicleID(playerid)]);
			    PlayerTextDrawSetString(playerid, TdVelocimetro[playerid][11], string);
            }
            for(new i = 0; i < 19; i++)
                PlayerTextDrawShow(playerid, TdVelocimetro[playerid][i]);

			SetTimerEx("AttVelocimetro", 200, false, "i", playerid);
		}
	}
	if(newstate == PLAYER_STATE_DRIVER)
	{
		if(VehCorps(vehicleid))
		{
		    if(IsPolicial(playerid))
		    {
		    	return 1;
		    }
		    else
			{
				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Esse veiculo e Reservado ao's Policiais.");
				RemovePlayerFromVehicle(playerid);
				return 1;
			}
		}
        else if(VehProfAnunciante(vehicleid))
		{
		    if(Pp[playerid][Profissao] != PROF_ANUNCIANTE)
			{
				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Esse veiculo e Reservado aos Anunciantes");
				RemovePlayerFromVehicle(playerid);
				return 1;
			}
			else if(Pp[playerid][Profissao] == PROF_ANUNCIANTE)
			{
			    cmd_trancar(playerid);
			}
		}
        else if(VehProfIndustrial(vehicleid))
		{
		    if(Pp[playerid][Profissao] != PROF_INDUSTRIAL)
			{
				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Esse veiculo e Reservado aos Transportadores Industriais");
				RemovePlayerFromVehicle(playerid);
				return 1;
			}
			else if(Pp[playerid][Profissao] == PROF_INDUSTRIAL)
			{
			    cmd_trancar(playerid);
			}
		}
        else if(VehProfMaq(vehicleid))
		{
		    if(Pp[playerid][Profissao] != PROF_MAQUINISTA)
			{
				SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Esse veiculo e Reservado aos Maquinistas ");
				RemovePlayerFromVehicle(playerid);
				return 1;
			}
			else if(Pp[playerid][Profissao] == PROF_MAQUINISTA)
			{
			    cmd_trancar(playerid);
			}
		}
        else if(VehEmpPetro(vehicleid))
		{
		    if(Pp[playerid][EmpMembro] == 2 || Pp[playerid][EmpLider] == 2)
			{
			    cmd_trancar(playerid);
			}
            else
            {
                SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Esse veiculo e Reservado aos Petroleiros ");
				RemovePlayerFromVehicle(playerid);
				return 1;
            }
		}
        return 1;
	}
	return 1;
}

public OnPlayerEnterCheckpoint(playerid)
{
    if(IsPlayerInDynamicCP(playerid, PCheckpoint[7]))
	{
	    if(BancoDinheiro >= 1000000)
	    {
            new str[5000];
            //Nome da Conta
            format(str,sizeof(str),"%s", PlayerName(playerid));
            PlayerTextDrawSetString(playerid, TextDrawCaixaL[playerid][15], str); //ok
            //Saldo
            format(str,sizeof(str),"%d", Pp[playerid][SaldoBancario]);
            PlayerTextDrawSetString(playerid, TextDrawCaixaL[playerid][18], str); //ok
            for(new i2; i2 < 57; i2++)
        	{
        	   PlayerTextDrawShow(playerid, TextDrawCaixaL[playerid][i2]);
        	}
            SelectTextDraw(playerid, 0x8B008BFF);
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Os servicos do Banco estao Indisponiveis, Volte Mais Tarde");
		}
	}
    else if(IsPlayerInDynamicCP(playerid, PCheckpoint[8]))
	{
	    if(BancoDinheiro >= 1000000)
	    {
            new str[5000];
            //Nome da Conta
            format(str,sizeof(str),"%s", PlayerName(playerid));
            PlayerTextDrawSetString(playerid, TextDrawCaixaL[playerid][15], str); //ok
            //Saldo
            format(str,sizeof(str),"%d", Pp[playerid][SaldoBancario]);
            PlayerTextDrawSetString(playerid, TextDrawCaixaL[playerid][18], str); //ok
            for(new i2; i2 < 57; i2++)
        	{
        	   PlayerTextDrawShow(playerid, TextDrawCaixaL[playerid][i2]);
        	}
            SelectTextDraw(playerid, 0x8B008BFF);
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Os servicos do Banco estao Indisponiveis, Volte Mais Tarde");
		}
	}
	else if(IsPlayerInDynamicCP(playerid, PCheckpoint[1]))
	{
		new string[450], mercada[5000];
		strcat(string, "Servico\tValor Minimo\n");
  		format(mercada, sizeof(mercada), "{FFD700}1. {FFFFFF}Lavar Dinheiro\t{00FF00}R$5000\n");
		strcat(string, mercada);
		format(mercada, sizeof(mercada), "{FFD700}2. {FFFFFF}Muda de Maconha\t{00FF00}R$500\n");
		strcat(string, mercada);

  		return ShowPlayerDialog(playerid, DIALOG_BIQUEIRA, DIALOG_STYLE_TABLIST_HEADERS, "{FFFFFF}Biqueira {FFD700}Gold City", string, "Comprar", "Voltar");
	}
	else if(IsPlayerInDynamicCP(playerid, PCheckpoint[2]))
	{
	    if(Pp[playerid][FezRg] == 1)
	    {
			new string[450], mercada[5000];
			strcat(string, "Servico\tValor Minimo\n");
	  		format(mercada, sizeof(mercada), "{FFD700}1. {FFFFFF}Retirar Licenca de Porte de Armas\t{00FF00}R$20.000\n");
			strcat(string, mercada);
			format(mercada, sizeof(mercada), "{FFD700}2. {FFFFFF}Limpar Ficha de Crimes\t{00FF00}R$5.000\n");
			strcat(string, mercada);

	  		return ShowPlayerDialog(playerid, DIALOG_DP, DIALOG_STYLE_TABLIST_HEADERS, "Departamento {FFDC33}Policia Federal", string, "Selecionar", "Voltar");
	  	}
		else
		{
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem o seu Documento RG, Faca-o no Prefeitura. /gps - Locais Gerais - Prefeitura"), GameTextForPlayer(playerid, "~w~Voce nao tem ~r~RG", 3000, 1);
		}
	}
    else if(IsPlayerInDynamicCP(playerid, PCheckpoint[0]))
	{
	    if(Pp[playerid][FezRg] == 1)
	    {
			new string[450], mercada[5000];
			strcat(string, "Servico\tValor Minimo\n");
	  		format(mercada, sizeof(mercada), "{FFD700}1. {FFFFFF}Retirar Licenca de Porte de Armas\t{00FF00}R$20.000\n");
			strcat(string, mercada);
			format(mercada, sizeof(mercada), "{FFD700}2. {FFFFFF}Limpar Ficha de Crimes\t{00FF00}R$5.000\n");
			strcat(string, mercada);

	  		return ShowPlayerDialog(playerid, DIALOG_DP, DIALOG_STYLE_TABLIST_HEADERS, "Departamento da {FFD700}Policia Federal", string, "Retirar", "Voltar");
	  	}
		else
		{
            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem o seu Documento RG, Faca-o no Prefeitura. /gps - Locais Gerais - Prefeitura"), GameTextForPlayer(playerid, "~w~Voce nao tem ~r~RG", 3000, 1);
		}
	}
    else if(Pp[playerid][Profissao] == PROF_UBERETS)
	{
    	if(UberMarcado[playerid] == 1)
		{
			if(BcUberEts[playerid] == 0) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Uniformizado");
	    	{
				new string[10000];
            	format(string, sizeof(string), "* O ID:[%d] Esta Entregando um Lanche como 'Uber Eats'", Pp[playerid][IDF]);
            	SCM(playerid, -1, "{FFFFFF}[GCRP] Voce esta Entregando um Lanche, Aguarde o Pagamento...");
            	ProxDetector(15.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
            	GameTextForPlayer(playerid, "~w~Entregando...", 8000, 1);
	   			DisablePlayerCheckpoint(playerid);
	   			PlayerPlaySound(playerid,1131,0.0,0.0,0.0);
	        	TogglePlayerControllable(playerid, 0);
				UberMarcado[playerid] = 0;
				ApplyAnimation(playerid, "GANGS", "DEALER_DEAL", 10.1, 0, 1, 0, 0, -1);
	        	SetTimerEx("DinheiroUberETS", 8000, false, "d", playerid);
	        	return 1;
			}
   		}
   	}
    else if(Pp[playerid][Profissao] == PROF_ANUNCIANTE)
	{
    	if(AnuncioMarcado[playerid] == 1)
		{
			if(BcAnunciante[playerid] == 0) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Uniformizado");
	    	{
				new string[10000], DinheiroEntrega = 2000 + random(500);
            	format(string, sizeof(string), "* O ID:[%d] Esta Anunciando algo, Olhe para cima!!!", Pp[playerid][IDF]);
            	ProxDetector(400.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                format(string, sizeof(string), "{FFDC33}Anunciante: {FFFFFF}Voce anunciou algo e ganhou: {00FF00}R$%d{FFFFFF} por isso!", DinheiroEntrega);
            	SCM(playerid, -1, string);
                SCM(playerid, -1, "{FFDC33}Anunciante: {FFFFFF}Volte ao seu Hq e pegue mais um anuncio!");
            	GameTextForPlayer(playerid, "~w~Anunciado!", 2000, 4);
                TogglePlayerControllable(playerid, 1);
                GivePlayerCash(playerid, DinheiroEntrega);
	   			PlayerPlaySound(playerid,1131,0.0,0.0,0.0);
				AnuncioMarcado[playerid] = 0;
	        	return 1;
			}
   		}
   	}
    else if(Pp[playerid][Profissao] == PROF_ENTREGADOR)
	{
        if(JornalMarcado[playerid] == 1)
        {
    		if(BcEntregadorJ[playerid] == 0) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Uniformizado");
    	    {
                new vehicleid = GetPlayerVehicleID(playerid);
		        if(vehicleid == CarroEventoProfs[playerid])
		        {
                	new string[10000], granaa = 120 + random(30);
                    format(string, sizeof(string), "* O ID:[%d] Entregou um Jornal", Pp[playerid][IDF]);
                    ProxDetector(15.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                    SendClientMessageEx(playerid, -1, "{FFD700}>> Jornais: {FFFFFF}Voce entregou uma Unidade de Jornal Por: {00FF00}R$10, {FFFFFF}Gorjeta: {00FF00}R$%d", granaa);
                    GivePlayerCash(playerid, granaa);
                    GivePlayerCash(playerid, 10);
                    GameTextForPlayer(playerid, "~w~Entregue", 1200, 1);
            	   	DisablePlayerCheckpoint(playerid);
            		JornalMarcado[playerid] = 0;
            	    return 1;
                }
                else
                {
                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Na Bike de Jornaleiro");
                }
            }
        }
   	}

    else if(Pp[playerid][Profissao] == PROF_COVEIRO)
	{
        if(CorpoM[playerid] == 1)
        {
    		if(BcCoveiro[playerid] == 0) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Uniformizado");
    	    {
                new vehicleid = GetPlayerVehicleID(playerid), string[450];
				if(vehicleid == CarroEventoProfs[playerid])
				{
                    format(string, sizeof(string), "* O ID:[%d] Pegou um Corpo", Pp[playerid][IDF]);
                    SCM(playerid, -1, "{FFD700}>> Cemiterio: {FFFFFF}Voce pegou um corpo, leve ate o cemiterio.");
                    SCM(playerid, -1, "{FFD700}>> Cemiterio: {FFFFFF}Leve-o para a Cremacao no Cemiterio..");
                    ProxDetector(25.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                    GameTextForPlayer(playerid, "~w~Entregue O ~g~Corpo.", 4000, 4);
                    SetPlayerCheckpoint(playerid, 949.4603,-1102.9373,23.6476, 1.0);
                    CheckPointProfissao[playerid] = 1;
            	   	DisablePlayerCheckpoint(playerid);
                    CorpoMV[vehicleid] = 1;
                    CorpoM[playerid] = 0;
            	    return 1;
                }
                else
                {
                    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Na Bike de Jornaleiro");
                }
            }
        }
   	}

    else if(Pp[playerid][Profissao] == PROF_LIXEIRO)
	{
    	if(LixoMarcado[playerid] == 1)
		{
			if(BcLixeiro[playerid] == 0) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Uniformizado");
	    	{
				new string[10000];
            	format(string, sizeof(string), "* O ID:[%d] Esta Coletado Lixo de um Local", Pp[playerid][IDF]);
            	SCM(playerid, -1, "{FFFFFF}[GCRP] Voce esta coletando Lixo...");
            	ProxDetector(15.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
            	GameTextForPlayer(playerid, "~w~Pegando Lixo...", 8000, 1);
	   			DisablePlayerCheckpoint(playerid);
	   			PlayerPlaySound(playerid,1131,0.0,0.0,0.0);
	        	TogglePlayerControllable(playerid, 0);
				LixoMarcado[playerid] = 0;
                ProtecaoAlgemas[playerid] = SetTimerEx("k", 500, true, "d", playerid);
	        	SetTimerEx("DinheiroLixeiro", 5000, false, "d", playerid);
	        	return 1;
			}
   		}
   	}
    else if(AntenaConserto[playerid] == 1)
	{
		if(BcEletricista[playerid] == 0)  return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Uniformizado");
	    {
			new string[10000];
            format(string, sizeof(string), "* O ID:[%d] Esta Consertando uma Antena Quebrada *", Pp[playerid][IDF]);
            ProxDetector(15.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
	   		DisablePlayerCheckpoint(playerid);
	   		PlayerPlaySound(playerid,1131,0.0,0.0,0.0);
	        Controle(playerid, 0);
            ProtecaoAlgemas[playerid] = SetTimerEx("k", 500, true, "d", playerid);
            TimerEletricista[playerid] = SetTimerEx("TimerEletricista2", 1000, true, "i", playerid);
			AntenaConserto[playerid] = 0;
			ApplyAnimation(playerid,"BOMBER","BOM_Plant", 4.1, 1, 1, 1, 0, 0, 1);

		}
   	}
    else if(DnitRadar[playerid] == 1)
	{
		if(BcDNIT[playerid] == 0)  return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Uniformizado");
	    {
			new string[10000];
            format(string, sizeof(string), "* O ID:[%d] Esta Reparando um Radar..", Pp[playerid][IDF]);
            ProxDetector(15.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
	   		DisablePlayerCheckpoint(playerid);
	   		PlayerPlaySound(playerid,1131,0.0,0.0,0.0);
	        Controle(playerid, 0);
            ProtecaoAlgemas[playerid] = SetTimerEx("k", 500, true, "d", playerid);
            TimerEletricista[playerid] = SetTimerEx("TimerDNIT", 1000, true, "i", playerid);
			DnitRadar[playerid] = 0;
			ApplyAnimation(playerid,"BOMBER","BOM_Plant", 4.1, 1, 1, 1, 0, 0, 1);

		}
   	}
	else if(GRAFITE_find[playerid])
	{
		SCM(playerid, -1, "{FFFFFF}Gps: {FFFFFF}Voce chegou na sua Grafite tag.");
		DisablePlayerCheckpoint(playerid);
	}
    else if(CheckPointProfissao[playerid] == 1)
	{
        DisablePlayerRaceCheckpoint(playerid);
        DisablePlayerCheckpoint(playerid);
		PlayerPlaySound(playerid,1083,0.0,0.0,0.0);
        GameTextForPlayer(playerid, "~w~Checkpoint ~r~Desmarcado", 1200, 1);
	}
	return 1;
}
// CALLBACKS
CallBack:: OnPlayerMakeCBug(playerid)
{
    new String[220];
    if(AvisoCbug[playerid] < 2)
    {
        AvisoCbug[playerid] += 1;
        SCM(playerid, -1, "{FFD700}>> Ant-CBUG: {FFFFFF}Pare o C-BUG ou Lock-On Agora, Ou Sera Banido.");
        SCM(playerid, -1, "{FFD700}>> Ant-CBUG: {FFFFFF}60 Segundos Para Limpar os Avisos.");
        GameTextForPlayer(playerid, "~w~ANT ~g~C-BUG", 3000, 3);
        VLimparAvisos[playerid] = SetTimerEx("LimparAvisos2", 60000, true, "i", playerid);
        ClearAnimations(playerid);
        Controle(playerid, 0);
		SetTimerEx("CarregandoObjetos", 2000, false, "i", playerid);
    }
    else
    {
        AvisoCbug[playerid] = 0;
        format(String,sizeof(String),"O Jogador: %s[%d] Foi Kickado Pelo Motivo: Fazendo C-BUG ou Lock-On", PlayerName(playerid), Pp[playerid][IDF]);
		SendClientMessageToAll(COLOR_LIGHTRED,String);
        GameTextForPlayer(playerid, "~w~ANT ~r~C-BUG", 3000, 3);
		SetTimerEx("KickPlayer", 500, false, "i", playerid);
    }
    return  1;
}

public OnPlayerLeaveCheckpoint(playerid)
{
	return 1;
}
//CheckpointPiloto
public OnPlayerEnterRaceCheckpoint(playerid)
{
	if(CheckPointProfissao[playerid] == 1)
	{
        DisablePlayerRaceCheckpoint(playerid);
        DisablePlayerCheckpoint(playerid);
		PlayerPlaySound(playerid,1083,0.0,0.0,0.0);
        GameTextForPlayer(playerid, "~w~Checkpoint ~r~Desmarcado", 1200, 1);
	}
	if(CheckpointSamu[playerid])
	{
        PlayerTextDrawHide(playerid, TextDrawAviso3[playerid][0]);
		DisablePlayerRaceCheckpoint(playerid);
		PlayerPlaySound(playerid,1083,0.0,0.0,0.0);
		GameTextForPlayer(playerid, "~w~Ferido ao ~r~Solo - [/reanimar]", 3000, 1);
	}
    if(AnuncioMarcado[playerid] == 1)
	{
        if(Pp[playerid][Profissao] == PROF_ANUNCIANTE)
    	{
			if(BcAnunciante[playerid] == 0) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Uniformizado");
	    	{
				new string[10000], DinheiroEntrega = 2000 + random(500);
            	format(string, sizeof(string), "* O ID:[%d] Esta Anunciando algo, Olhe para cima!!!", Pp[playerid][IDF]);
            	ProxDetector(400.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                format(string, sizeof(string), "{FFDC33}Anunciante: {FFFFFF}Voce anunciou algo e ganhou: {00FF00}R$%d{FFFFFF} por isso!", DinheiroEntrega);
            	SCM(playerid, -1, string);
                SCM(playerid, -1, "{FFDC33}Anunciante: {FFFFFF}Volte ao seu Hq e pegue mais um anuncio!");
            	GameTextForPlayer(playerid, "~w~Anunciado!", 2000, 4);
                TogglePlayerControllable(playerid, 1);
                GivePlayerCash(playerid, DinheiroEntrega);
	   			PlayerPlaySound(playerid,1131,0.0,0.0,0.0);
				AnuncioMarcado[playerid] = 0;
	        	return 1;
			}
   		}
   	}
    switch(CheckCorridaC[playerid])
	{
        case 1:
