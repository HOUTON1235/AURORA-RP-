                            }
                            else
                            {
                        	    strcat(stg, "{FFFFFF}Habilitacao C:{FFD700} Nao.\n");
                            }
                            if(Pp[playerid][HabilitacaoD] == 1)
                            {
                        	    strcat(stg, "{FFFFFF}Habilitacao Aeria:{00FF00} Sim.\n");
                            }
                            else
                            {
                        	    strcat(stg, "{FFFFFF}Habilitacao Aeria:{FFD700} Nao.\n");
                            }
                            if(Pp[playerid][FezPorte] == 1)
                    		{
                    			format(gstring, sizeof(gstring), "{FFD700}Porte de Armas:{00FF00} Sim\n");
                    			strcat(stg, gstring);
                    		}
                    		else if(Pp[playerid][FezPorte] == 0)
                    		{
                    			format(gstring, sizeof(gstring), "{FFD700}Porte de Armas:{FF0000} Nao\n");
                    			strcat(stg, gstring);
                    		}

        					ShowPlayerDialog(i, DIALOG_RG, DIALOG_STYLE_MSGBOX, "{FFFFFF}Documento Nacional RG", stg, "Ok", "");
        					format(gstring, sizeof(gstring), "* O ID:[%d] Mostrou o RG para O ID:[%d]", Pp[playerid][IDF], Pp[i][IDF]);
            				ProxDetector(30.0, playerid, gstring, COR_PURPLE, COR_PURPLE, COR_PURPLE, COR_PURPLE, COR_PURPLE);
                            ApplyAnimation(playerid,"DEALER","DRUGS_BUY", 4.0, 1, 0, 0, 0, 0);
                            ApplyAnimation(i,"DEALER","DRUGS_BUY", 4.0, 1, 0, 0, 0, 0);
                            SetTimerEx("DCANIM", 5000, false, "d", i);
                            SetTimerEx("DCANIM", 5000, false, "d", playerid);
        					return 1;
                        }
                        else
                        {
                            SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a este Player");
                        }
    				}
    			}
    		}
    		return 1;
    	}
    	else
    	{
    	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem um RG");
    	}
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    }
	return 1;
}

CMD:orgs(playerid)
{
    if(Pp[playerid][Logado] == true)
	{
    	new stg[5000];
    	strcat(stg,  "{FFFFFF}>>{00FF00} Policias\n");
     	strcat(stg,  "{FFFFFF}>>{FFD700} Neutras\n");
     	strcat(stg,  "{FFFFFF}>>{FFFFFF} Governo\n");
     	strcat(stg,  "{FFFFFF}>>{FF4500} Criminosas\n");
    	ShowPlayerDialog(playerid, DIALOG_ORGS, DIALOG_STYLE_LIST, "{FFD700}Gold City", stg, "Mostrar", "X");
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    }
	return 1;
}
CMD:gc(playerid)
{
	if(Pp[playerid][Admin] >= 6)
	{
        if(!IsPlayerInAnyVehicle(playerid)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um Veiculo");
	    if(Ativado[playerid] == 0)
	    {
	        Ativado[playerid] = 1;
	    	SCM(playerid, -1, "{FFFFFF}Voce ativou o GodCar, Para Desativar, Use: /gc Novamente");
	    	GameTextForPlayer(playerid, "~w~God Car ~g~Ativo!", 3000, 1);
	    	TempoAutoReparar[playerid] = SetTimerEx("AutoReparar", 200, true, "i", playerid);
	    }
	    else if(Ativado[playerid] == 1)
	    {
	        Ativado[playerid] = 0;
	    	SCM(playerid, -1, "{FFFFFF}Voce Desativou o GodCar");
	    	GameTextForPlayer(playerid, "~w~God Car ~r~Desativado!", 3000, 1);
	    	KillTimer(TempoAutoReparar[playerid]);
	    }
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando Dono/Projetista/Developer");
	}
	return 1;
}

CMD:pegaremprego(playerid)
{
	if(ISP(playerid, 5.0, 1357.3013,378.9188,19.5547))
	{
		if(PegouEmpregoPrefeitura[playerid] == PROF_CARROFORTE)
		{
			if(Pp[playerid][Profissao] == PROF_CARROFORTE)
			{
				return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce ja trabalha nesta profissao, caso queira sair dela use /sairdoemprego.");
			}
			else
			{
				Pp[playerid][Profissao] = PROF_CARROFORTE;
				RemovePlayerAttachedObject(playerid, 3); // Maleta
				PegouEmpregoPrefeitura[playerid] = 0;
				if(Pp[playerid][Sexo] == 1)
				{
					SCM(playerid, -1, "{FFFF00}[PROFISSAO] Voce pegou a profissao de Transportador de Valores'r, use /ajuda - profissao para ver os comandos."), GameTextForPlayer(playerid, "~w~Profissao ~g~pega!", 1200, 1);
