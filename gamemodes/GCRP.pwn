            if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
            {
        		GranaRoubo2(playerid);
                DestroyDynamicPickup(PickDinheiro[0]);
                PickDinheiro[0] = CreateDynamicPickup(1550, 1, 2145.1687, 1640.3270, 993.5761, 2);
                GameTextForPlayer(playerid, "~w~Pegando o Dinheiro!", 6000, 1);
            }
        }
