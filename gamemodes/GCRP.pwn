		            SCM(playerid, -1, "{FFFFFF}[GCRP] Voce Ganhou: {00FF00}R$800 {FFFFFF}Por Vender 4+ Minerios!!");
		            SetPlayerCheckpoint(playerid, 607.4472,871.9578,-41.9849, 2.0);
		            return 1;
				}
				else
				{
				    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem 4 Minerios!");
				}
			}
			else
			{
			    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao bateu seu Cartao!");
			}
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Minerador");
	}
	return 1;
}
CMD:carregarp(playerid, params[])
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	if(IsBandido(playerid))
	{
	    new id, string[1200], Float:X123, Float:Y123, Float:Z123;
	    if(sscanf(params,"d",id))return SCM(playerid, -1,"{FFD700}INFO: {FFFFFF}Use: /carregarp [IDF].");
	    {
         	for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
				        if(id == Pp[playerid][IDF])
						{
					 		SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Arrastar!");
						 	return 1;
						}
				        if(ArrastadoID[playerid] == 0)
				        {
				            GetPlayerPos(i, X123, Y123, Z123);
							if(ISP(playerid, 10.0, X123, Y123, Z123))
							{
							    format(string, sizeof(string), "* O ID: [%d] Comecou a Carregar o Jogador ID:[%d].", Pp[playerid][IDF], Pp[i][IDF]);
					    		ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
							    SCM(playerid, 0xFFFF00FF, "{FFFFFF}Voce esta Carregando um Player");
				        		GameTextForPlayer(i, "~r~Carregado!", 2000, 3);
				        		ApplyAnimation(i, "DEALER", "DEALER_IDLE", 4.0, 0, 1, 1, 1, -1);
				        		ApplyAnimation(i, "DEALER", "DEALER_IDLE", 4.0, 0, 1, 1, 1, -1);
				        		ArrastadoID[playerid] = Pp[i][IDF];
				        		ProtecaoAlgemas[i] = SetTimerEx("k", 500, true, "d", i);
				        		AttArrastar[playerid] = SetTimerEx("AttArrastar2", 100, true, "i", playerid);
				        		return 1;
							}
							else
							{
							    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a Este Player!");
							}
				        }
						else
						{
						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce ja esta arrastando Alguem, Use (/largarp)!");
						}
					}
				}
			}
			return 1;
		}
    }
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Policial!");
	}
	return 1;
}
CMD:largarp(playerid, params[])
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	if(IsBandido(playerid))
	{
	    for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == ArrastadoID[playerid])
			    {
			    	new Float:X123, Float:Y123, Float:Z123, string[450];
		 	    	GetPlayerPos(i, X123, Y123, Z123);
					if(ISP(playerid, 10.0, X123, Y123, Z123))
					{
		   				format(string, sizeof(string), "* O ID: [%d] Largou o Jogador ID:[%d].", Pp[playerid][IDF], Pp[i][IDF]);
						ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
		    			SCM(playerid, 0xFFFF00FF, "{FFFFFF}Voce Largou o Player!");
			       		GameTextForPlayer(i, "~w~Largado!", 2000, 0);
		    			KillTimer(ProtecaoAlgemas[i]);
		    			ClearAnimations(i);
						SetTimerEx("DCANIM", 200, false, "d", i);
					   	KillTimer(AttArrastar[playerid]);
					   	Arrastado[i] = 0;
					   	ArrastadoID[playerid] = 0;
					   	return 1;
		 			}
		 			else
		 			{
		    			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a Este Player!");
		 			}
		    	}
		    }
		}
		return 1;
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Policial");
	}
	return 1;
}
CMD:sequestrar(playerid, params[])
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
	new id, string[450];
    if(IsBandido(playerid))
	{
	    if(sscanf(params,"d",id))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /sequestrar [ID]");
	    {
	 		for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
					    if(id == Pp[playerid][IDF])
						{
							SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Limpar Ficha!");
					 		return 1;
						}
						if(Sequestrado[i] >= 1)
		    			{
					       SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}O Jogador ja esta sequestrado !");
					       return 1;
					    }
						if (ProxDetectorS(8.0, playerid, i))
						{
							 new ttext[2000], orgid = GetPlayerOrg(playerid);
							 if(GetPlayerOrg(i) == 0) { ttext = "500000"; }
						     if(GetPlayerOrg(i) == 1) { ttext = "1500000"; }
						     if(GetPlayerOrg(i) == 2) { ttext = "2000000"; }
						     if(GetPlayerOrg(i) == 3) { ttext = "1000000"; }
						   	 if(GetPlayerOrg(i) == 4) { ttext = "1500000"; }
						     if(GetPlayerOrg(i) == 5) { ttext = "2000000"; }
						     if(GetPlayerOrg(i) == 6) { ttext = "1000000"; }
						     if(GetPlayerOrg(i) == 7) { ttext = "1000000"; }
						     if(GetPlayerOrg(i) == 8) { ttext = "2000000"; }
						     if(GetPlayerOrg(i) == 9) { ttext = "1000000"; }
						     if(GetPlayerOrg(i) == 10) { ttext = "1500000"; }
						     if(GetPlayerOrg(i) == 11) { ttext = "2000000"; }
						     if(GetPlayerOrg(i) == 12) { ttext = "1000000"; }
						     if(GetPlayerOrg(i) == 13) { ttext = "1500000"; }
						     if(GetPlayerOrg(i) == 14) { ttext = "1500000"; }
						     if(GetPlayerOrg(i) == 15) { ttext = "2000000"; }
						     if(GetPlayerOrg(i) == 16) { ttext = "1000000"; }
							 if(GetPlayerOrg(i) == 17) { ttext = "1500000"; }
                             if(GetPlayerOrg(i) == 18) { ttext = "1500000"; }
                             if(GetPlayerOrg(i) == 19) { ttext = "1500000"; }
                             if(GetPlayerOrg(i) == 20) { ttext = "500000"; }
						     if(GetPlayerOrg(i) == 21) { ttext = "1500000"; }
						     if(GetPlayerOrg(i) == 22) { ttext = "2000000"; }
						     if(GetPlayerOrg(i) == 23) { ttext = "1000000"; }
						   	 if(GetPlayerOrg(i) == 24) { ttext = "1500000"; }
						     if(GetPlayerOrg(i) == 25) { ttext = "2000000"; }
						     if(GetPlayerOrg(i) == 26) { ttext = "1000000"; }
						     if(GetPlayerOrg(i) == 27) { ttext = "1000000"; }
						     if(GetPlayerOrg(i) == 28) { ttext = "2000000"; }
						     if(GetPlayerOrg(i) == 29) { ttext = "1000000"; }
						     if(GetPlayerOrg(i) == 30) { ttext = "1500000"; }
						     if(GetPlayerOrg(i) == 31) { ttext = "2000000"; }
						     if(GetPlayerOrg(i) == 32) { ttext = "1000000"; }
						     if(GetPlayerOrg(i) == 33) { ttext = "1500000"; }
						     if(GetPlayerOrg(i) == 34) { ttext = "1500000"; }
						     if(GetPlayerOrg(i) == 35) { ttext = "2000000"; }
						     if(GetPlayerOrg(i) == 36) { ttext = "1000000"; }
							 if(GetPlayerOrg(i) == 37) { ttext = "1500000"; }
                             if(GetPlayerOrg(i) == 38) { ttext = "1500000"; }
                             if(GetPlayerOrg(i) == 39) { ttext = "1500000"; }

						     new car = GetPlayerVehicleID(playerid);
						     if(IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) == 2 && IsPlayerInVehicle(i, car))
						  	 {
						    	format(string, sizeof(string), "{FFD700}[ SEQUESTRO ]: {FFFFFF}Voce Voce Foi Sequestrado Por um Criminoso");
								SendClientMessage(i, -1, string);
								format(string, sizeof(string), "{FFD700}[ SEQUESTRO ]: {FFFFFF}Voce Esta Sequestrando o Jogador: %s De Olho Nele!", PlayerName(i));
								SCM(playerid, -1, string);
								format(string, sizeof(string), "Sequestro: A Org: %s Esta sequestrando o: %s e pede o valor de: R$%s", PlayerName(playerid),Pp[playerid][IDF], OrgInfo[orgid][OrgNome], PlayerName(i), ttext);
								SendClientMessageToAll(COLOR_LIGHTRED, string);
								GameTextForPlayer(i, "~w~Voce Foi ~r~Sequestrado", 3500, 6);
								GameTextForPlayer(playerid, "~w~Player ~r~Sequestrado!", 3500, 1);
								Controle(i, 0);
								Sequestrado[i] = 1;
								ProtecaoAlgemas[i] = SetTimerEx("k", 500, true, "d", i);
                                for(new ip; ip < MAX_PLAYERS; ip++)
            					{
            						if(IsPolicial(ip))
                                    {
            						   	new Float:x,Float:y,Float:z;
            							GetPlayerPos(playerid, x,y,z);
            							SetPlayerCheckpoint(ip, x,y,z, 6);
            							GameTextForPlayer(ip, "~w~Sequestro ~r~Marcado!", 3000, 1);
            						}
            					}
						     }
				  			 else
						  	 {
		        				 SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}O Jogador nao esta no seu carro, ou voce nao e o motorista !");
		        				 return 1;
							 }
						}
						else
						{
						    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}O Jogador esta longe de Voce !");
						    return 1;
						}
					}
				}
			}
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Criminoso");
	}
	return 1;
}
CMD:soltarseq(playerid, params[])
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    new id;
    if(IsBandido(playerid))
	{
    	if(sscanf(params,"d",id))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /soltarseq [ID]");
    	{
    	    for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
					    if(id == Pp[playerid][IDF])
						{
							SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Soltar!");
					 		return 1;
						}
						if (ProxDetectorS(8.0, playerid, i))
						{
				    	    if(Sequestrado[i] == 1)
				    	    {
							    GameTextForPlayer(i, "~w~Voce Foi ~g~Solto", 2500, 3);
							    GameTextForPlayer(playerid, "~w~Player ~g~Solto!", 3500, 1);
								Controle(i, 1);
								Sequestrado[i] = 0;
								KillTimer(ProtecaoAlgemas[i]);
							    return 1;
					    	}
					    	else
					    	{
					    	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Nao esta Sequestrado");
					    	}
					    }
					    else
					    {
					        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a este Player");
					    }
				    }
				}
			}
	    }
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e de Corp");
	}
	return 1;
}

CMD:soltarseqp(playerid, params[])
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    new id;
    if(IsPolicial(playerid))
	{
    	if(sscanf(params,"d",id))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /soltarseq [ID]");
    	{
    	    for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
					    if(id == Pp[playerid][IDF])
						{
							SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Soltar!");
					 		return 1;
						}
			    	    if (ProxDetectorS(8.0, playerid, i))
						{
				    	    if(Sequestrado[i] == 1)
				    	    {
							    GameTextForPlayer(i, "~w~Voce Foi ~g~Solto", 2500, 3);
							    GameTextForPlayer(playerid, "~w~Player ~g~Solto!", 3500, 1);
								Controle(i, 1);
								Sequestrado[i] = 0;
								KillTimer(ProtecaoAlgemas[i]);
							    return 1;
					    	}
					    	else
					    	{
					    	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Player Nao esta Sequestrado");
					    	}
					    }
					    else
					    {
					        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a este Player");
					    }
				    }
				}
			}
	    }
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e de Corp");
	}
	return 1;
}/*
