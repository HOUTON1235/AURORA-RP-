        		SetTimerEx("DCANIM", 500, false, "d", playerid);
                GivePlayerCash(playerid, antenad);
        		format(gstring, sizeof(gstring), "{FFDC33}[ ANTENA ]: {FFFFFF}Voce Reparou uma Antena e Ganhou: {00FF00}R$%d {FFFFFF}Use: /procurarantena Novamente!", antenad);
        		SCM(playerid, -1, gstring);
            }
        }
    }
    return 1;
}

CallBack:: TimerDNIT(playerid)
{
    if(Pp[playerid][Profissao] == PROF_DNIT)
	{
        if(BcDNIT[playerid] == 1)
        {
            new Str[5000];
           	if(ContagemEletricista[playerid] < 20)
            {
            	ContagemEletricista[playerid] += 1;
             	format(Str, sizeof(Str), "~w~Consertando... ~n~ ~y~%02d/20", ContagemEletricista[playerid]);
               	GameTextForPlayer(playerid, Str, 1000, 6);
               	PlayerPlaySound(playerid,3211056,0.0,0.0,0.0);
            }
            else
            {
                new antenad = 500 + random(500);
                Controle(playerid, 1);
           		KillTimer(TimerEletricista[playerid]);
            	KillTimer(ProtecaoAlgemas[playerid]);
        		ClearAnimations(playerid);
        		ContagemEletricista[playerid] = 0;
        		SetTimerEx("DCANIM", 500, false, "d", playerid);
                GivePlayerCash(playerid, antenad);
        		format(gstring, sizeof(gstring), "{FFDC33}[ DNIT ]: {FFFFFF}Voce Reparou um Radar e Ganhou: {00FF00}R$%d {FFFFFF}Use: /pradar!", antenad);
        		SCM(playerid, -1, gstring);
            }
        }
    }
    return 1;
}

CallBack:: TimerCarregandoCAM2(playerid)
{
    if(Pp[playerid][Profissao] == PROF_CAMINHONEIRO)
	{
        if(BcCaminhoneiro[playerid] == 1)
        {
            new Str[5000], vehicleid = GetPlayerVehicleID(playerid);
           	if(ContagemCarregandoCA[playerid] < 20)
            {
            	ContagemCarregandoCA[playerid] += 1;
             	format(Str, sizeof(Str), "~w~Carregando Caminhao ~n~ ~y~%02d/20", ContagemCarregandoCA[playerid]);
               	GameTextForPlayer(playerid, Str, 1000, 6);
               	PlayerPlaySound(playerid,3211056,0.0,0.0,0.0);
            }
            else
            {
                if(vehicleid == CarroEventoProfs[playerid])
	            {
                    CarregandoCaminhao[playerid] = 0;
        	        ContagemCarregandoCA[playerid] = 0;
                    CheckPointProfissao[playerid] = 1;
        	        ProdutosCA[vehicleid] = 10;
        	        Controle(playerid, 1);
        	   		KillTimer(TimerCarregandoCAM[playerid]);
        	    	KillTimer(ProtecaoAlgemas[playerid]);
        			SCM(playerid, -1, "{FFFFFF}[GCRP] Voce Carregou seu Caminhao com {FFDC33}10 Produtos{FFFFFF}, Entregue no CheckPoint!");
        			GameTextForPlayer(playerid, "~w~Carregado!", 5000, 1);
                    new DesCA = random(sizeof(EntregasCa));
            		SetPlayerCheckpoint(playerid, EntregasCa[DesCA][0], EntregasCa[DesCA][1], EntregasCa[DesCA][2], 5.0);
        			CheckPointProfissao[playerid] = 1;
        		}
        		else
        		{
        		    ContagemCarregandoCA[playerid] = 0;
        	        Controle(playerid, 1);
        	   		KillTimer(TimerCarregandoCAM[playerid]);
        	    	KillTimer(ProtecaoAlgemas[playerid]);
        		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta no Caminhao que pegou!");
        		}
            }
        }
    }
    return 1;
}
CallBack:: Postos()
{
	new gStr[500];
    for(new i; i < MAX_PLAYERS; i++)
	{
        if(Pp[i][Logado] == true)
		{
            for(new ii; ii < MAX_POSTO; ii++)
			{
				if(ISP(i, 5.0, PostoInfo[ii][PostoPosX], PostoInfo[ii][PostoPosY], PostoInfo[ii][PostoPosZ]))
				{
				    if(InAnyBike(i))
	        		{
	        		    GameTextForPlayer(i, gStr, 1500, 1);
	            	}
	            	else
	            	{
                        GameTextForPlayer(i, gStr, 1500, 1);
			    	}
			    }
			}
            if(IsPlayerInGangZone(i, GangZoneTRG[0]))
			{
                if(GuettoInfo[Dono] >= 1)
                {
    			    format(gStr, sizeof(gStr), "~w~Territorio: ~r~%s", OrgInfo[GuettoInfo[Dono]][OrgNome]);
                    PlayerTextDrawSetString(i, TextDrawAviso[i][0], gStr);
                    PlayerTextDrawShow(i, TextDrawAviso[i][0]);
                }
                else if(GuettoInfo[Dono] == 0)
                {
                    format(gStr, sizeof(gStr), "~w~Territorio: ~g~NINGUEM!", OrgInfo[GuettoInfo[Dono]][OrgNome]);
                    PlayerTextDrawSetString(i, TextDrawAviso[i][0], gStr);
                    PlayerTextDrawShow(i, TextDrawAviso[i][0]);
                }
            }
            else if(IsPlayerInGangZone(i, GangZoneTR[0]))
			{
                if(MorroInfo[Dono] >= 1)
                {
    			    format(gStr, sizeof(gStr), "~w~Territorio: ~r~%s", OrgInfo[MorroInfo[Dono]][OrgNome]);
                    PlayerTextDrawSetString(i, TextDrawAviso[i][0], gStr);
                    PlayerTextDrawShow(i, TextDrawAviso[i][0]);
                }
                else if(MorroInfo[Dono] == 0)
                {
                    format(gStr, sizeof(gStr), "~w~Territorio: ~g~NINGUEM!", OrgInfo[MorroInfo[Dono]][OrgNome]);
                    PlayerTextDrawSetString(i, TextDrawAviso[i][0], gStr);
                    PlayerTextDrawShow(i, TextDrawAviso[i][0]);
                }
            }
            else if(IsPlayerInGangZone(i, GangZoneTRF[0]))
			{
                if(FABInfo[Dono] >= 1)
                {
    			    format(gStr, sizeof(gStr), "~w~Territorio: ~r~%s", OrgInfo[FABInfo[Dono]][OrgNome]);
                    PlayerTextDrawSetString(i, TextDrawAviso[i][0], gStr);
                    PlayerTextDrawShow(i, TextDrawAviso[i][0]);
                }
                else if(FABInfo[Dono] == 0)
                {
                    format(gStr, sizeof(gStr), "~w~Territorio: ~g~NINGUEM!", OrgInfo[FABInfo[Dono]][OrgNome]);
                    PlayerTextDrawSetString(i, TextDrawAviso[i][0], gStr);
                    PlayerTextDrawShow(i, TextDrawAviso[i][0]);
                }
            }
            else
            {
                SetTimerEx("TirarTD", 1000, false, "i", i);
	    	}
		}
	}
	return 1;
}
