CallBack:: MarcarCheckC(playerid)
{
	new Str[5000];
    if(EntrouCorrida[playerid] == 1)
    {
        if(ContagemTela[playerid] < 5)
        {
            ContagemTela[playerid] += 1;
            format(Str, sizeof(Str), "~w~%02d/05", ContagemTela[playerid]);
        	GameTextForPlayer(playerid, Str, 1000, 6);
            PlayerPlaySound(playerid,3211056,0.0,0.0,0.0);
        }
        else
        {
            EntrouCorrida[playerid] = 0;
            ContagemTela[playerid] = 0;
            CheckCorridaC[playerid] = 1;
            Controle(playerid, 1);
            PlayerPlaySound(playerid,1057,0.0,0.0,0.0);
        	KillTimer(TimerContagem[playerid]);
        	KillTimer(ProtecaoAlgemas[playerid]);
        	SetPlayerRaceCheckpoint(playerid, 0, CheckCorrida[0][0], CheckCorrida[0][1], CheckCorrida[0][2],CheckCorrida[1][0], CheckCorrida[1][1], CheckCorrida[1][2], 5);
			SCM(playerid, COR_VERDE, "{FFDC33}Corrida: {FFFFFF}A corrida iniciou, va e ganhe essa parada!");
			GameTextForPlayer(playerid, "~w~GO GO!", 2000, 0);
        }
    }
    return 1;
}

