CMD:puxarnome(playerid, params[])
{
	if(IsPolicial(playerid))
	{
	    new id, string[450], Float:px, Float:py, Float:pz;
		if(sscanf(params, "i", id))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /puxarnome [IDF]");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
			        GetPlayerPos(i, px, py, pz);
			        if(id == Pp[playerid][IDF])
			        {
						SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Dar Tv");
			        }
			        if(PlayerToPoint(4.0, playerid, px, py, pz))
    				{
			        	SendClientMessageEx(playerid, -1, "PuxeGOV: O Nome do Jogador ID: [%d] e: (%s) Esta Com: %d Estrelas de Procurado", Pp[i][IDF], PlayerName(i), GetPlayerWantedLevel(i));
			        	return 1;
			        }
                    else
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta proximo a este Jogador.");
                    }
				}
			}
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem permissao para usar este comando.");
	}
    return 1;
}

CMD:ejetartodos(playerid, params[])
{
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}O jogador nao esta no seu veiculo!");
	new vehicleid = GetPlayerVehicleID(playerid),  msg[5000];
	format(msg, sizeof(msg), "{FFFFFF}O ID:[%d] Retirou Voce do Veiculo Dele.", Pp[playerid][IDF]);
	for(new i; i < MAX_PLAYERS; i++)
	{
		if(IsPlayerConnected(i) && i != playerid && IsPlayerInVehicle(i, vehicleid))
		{
			RemovePlayerFromVehicle(i);
			SendClientMessage(i, -1, msg);
		}
	}
	SCM(playerid, -1, "{FFFFFF}Voce ejetou todos os passageiros");
	return 1;
}
CMD:mudarlocal(playerid)
{
    if(IsPlayerConnected(playerid))
	{
	    if(Pp[playerid][LocalSP] == 1)
		{
			SCM(playerid, -1, "{BC8F8F}Info-Casa: {FFFFFF}Voce Vai Nascer em Seu HQ!");
            GameTextForPlayer(playerid, "~w~Spawn ~g~Mudado", 1200, 1);
		    Pp[playerid][LocalSP] = 0;
		}
		else
		{
			SCM(playerid, -1, "{BC8F8F}Info-Casa: {FFFFFF}Agora Voce vai Nascer em Sua Casa!");
            GameTextForPlayer(playerid, "~w~Spawn ~g~Mudado", 1200, 1);
		    Pp[playerid][LocalSP] = 1;
	   	}
	}
	return 1;

}
CMD:rebocaradm(playerid, params[])
{
    if(Pp[playerid][Admin] >= 4)
 	{
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voca nao esta dirigindo um veiculo!");
		new vehicleid = GetPlayerVehicleID(playerid);
		if(IsTrailerAttachedToVehicle(vehicleid))
		{
			DetachTrailerFromVehicle(vehicleid);
			SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta mais rebocando");
			return 1;
		}
		new Float:x, Float:y, Float:z;
		new Float:dist, Float:closedist=8, closeveh;
		for(new i=1; i < MAX_VEHICLES; i++)
		{
			if(i != vehicleid && GetVehiclePos(i, x, y, z))
			{
				dist = GetPlayerDistanceFromPoint(playerid, x, y, z);
				if(dist < closedist)
				{
					closedist = dist;
					closeveh = i;
				}
			}
		}
		if(!closeveh) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta perto de um veiculo!");
		AttachTrailerToVehicle(closeveh, vehicleid);
		SCM(playerid, -1, "{FFD700}[ ADM-CMD ]: {FFFFFF}Voce esta rebocando um Veiculo em sua Trazeira!");
		GameTextForPlayer(playerid, "~w~Veiculo ~g~Rebocado!", 3000, 3);
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem autorizacao para usar este comando");
	}
	return 1;
}
CMD:rebocarmec(playerid, params[])
{
    if(Pp[playerid][Profissao] == PROF_MECANICO)
	{
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voca nao esta dirigindo um veiculo!");
		new vehicleid = GetPlayerVehicleID(playerid), string[450];
		if(VehProfMec(vehicleid))
		{
		    if(Pp[playerid][ExpMec] >= 20)
			{
				if(IsTrailerAttachedToVehicle(vehicleid))
				{
					DetachTrailerFromVehicle(vehicleid);
					SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta mais rebocando");
					return 1;
				}
				new Float:x, Float:y, Float:z;
				new Float:dist, Float:closedist=8, closeveh;
				for(new i=1; i < MAX_VEHICLES; i++)
				{
					if(i != vehicleid && GetVehiclePos(i, x, y, z))
					{
						dist = GetPlayerDistanceFromPoint(playerid, x, y, z);
						if(dist < closedist)
						{
							closedist = dist;
							closeveh = i;
						}
					}
				}
				if(!closeveh) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta perto de um veiculo!");
				AttachTrailerToVehicle(closeveh, vehicleid);
				SCM(playerid, -1, "{FFD700}[ MECANICO ]: {FFFFFF}Voce esta rebocando um Veiculo em sua Trazeira!");
				GameTextForPlayer(playerid, "~w~Veiculo ~g~Rebocado!", 3000, 3);
			}
			else
			{
			    SendClientMessageEx(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce tem (%d/20) e por isso Nao pode Rebocar veiculos.", Pp[playerid][ExpMec]);
			}
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta em um Camihao de reboque dos Mecanicos.");
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Mecanico");
	}
	return 1;
}
CMD:manutencaoGCRP(playerid)
{
	if(Pp[playerid][Admin] >= 6)
	{
	    if(ServidorEmManutencao == 0)
	    {
	        format(gstring, sizeof(gstring), "O Admin: [%s]%s Abriu uma Manutencao no Servidor!",NomeAdm(Pp[playerid][Admin]), PlayerName(playerid));
			SendClientMessageToAll(COLOR_LIGHTRED,gstring);
			GameTextForAll("~w~Servidor ~g~Trancado!", 5000, 6);
			ServidorEmManutencao = 1;
	    }
	    else if(ServidorEmManutencao == 1)
	    {
	        format(gstring, sizeof(gstring), "O Admin: [%s]%s Fechou a Manutencao e Abriu o Servidor a Todos!!",NomeAdm(Pp[playerid][Admin]), PlayerName(playerid));
			SendClientMessageToAll(COLOR_LIGHTRED,gstring);
			GameTextForAll("~w~Servidor ~r~Destrancado!", 5000, 6);
			ServidorEmManutencao = 0;
	    }
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem autorizacao para usar este Comando");
	}
	return 1;
}
CMD:tsv(playerid,params[])
{
	new senha[90 + 1], String[220];
	if(Pp[playerid][Admin] >= 6)
	{
		if(sscanf(params,"s[90]",senha))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /tsv [SENHA]");
		{
			format(String, sizeof(String), "O Admin: [%s] %s Trancou o Servidor",NomeAdm(Pp[playerid][Admin]), PlayerName(playerid));
			SendClientMessageToAll(COLOR_LIGHTRED,String);
			GameTextForAll("~w~Servidor ~g~Trancado!", 5000, 6);
			format(String,sizeof(String),"password %s",senha);
			SendRconCommand(String);
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao tem autorizacao para usar este comando");
	}
	return 1;
}
CMD:asv(playerid,params[])
{
	new String[220];
	if(Pp[playerid][Admin] >= 6)
	{
		format(String, sizeof(String), "O Admin: [%s] %s Destrancou o Servidor",NomeAdm(Pp[playerid][Admin]), PlayerName(playerid));
		SendClientMessageToAll(COLOR_LIGHTRED,String);
		GameTextForAll("~w~Servidor ~r~Destrancado!", 5000, 6);
