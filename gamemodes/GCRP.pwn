CMD:dbot(playerid, params[])
{
	if(Pp[playerid][Admin] >= 4)
	{
		new id, arquivoCA[5000], mensagem[128];
		if(sscanf(params, "i", id)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /dbot [ID do Bot].");
		{
		    if(ISP(playerid, 2.0, BotInfo[id][BotPosX], BotInfo[id][BotPosY], BotInfo[id][BotPosZ]))
			{
				format(arquivoCA, sizeof(arquivoCA), PASTA_BOTS, id);
				if(DOF2_FileExists(arquivoCA))
				{
				    DOF2_RemoveFile(arquivoCA);
					format(mensagem, sizeof(mensagem), "{FFD700}[Info-Bot]: {FFFFFF}Voce deletou o Bot id: %d.", id);
				    SCM(playerid, 0xFF0000FF, mensagem);
				    DestroyDynamicActor(CriarNPCS[id]);
        			DestroyDynamic3DTextLabel(TextoBot[id]);
				    BotInfo[id][BotPosX] = 0;
					BotInfo[id][BotPosY] = 0;
					BotInfo[id][BotPosZ] = 0;
					return 1;
				}
				else
				{
			        format(mensagem, sizeof(mensagem), "{FFD700}INFO: {FFFFFF}O Bot [%d] Nao Existe nso Arquivos do Servidor.", id);
					SCM(playerid, 0xFF0000FF, mensagem);
				}
			}
			else
			{
			    format(mensagem, sizeof(mensagem), "{FFD700}INFO: {FFFFFF}Voce nao esta Proximo do Bot Id: %d.", id);
				SCM(playerid, 0xFF0000FF, mensagem);
			}
		}
	}
	return 1;
}
CMD:rtaccs(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    //Objetos no Corpo
	RemovePlayerAttachedObject(playerid, 0);
	RemovePlayerAttachedObject(playerid, 1);
	RemovePlayerAttachedObject(playerid, 2);
	RemovePlayerAttachedObject(playerid, 3);
	RemovePlayerAttachedObject(playerid, 4);
	RemovePlayerAttachedObject(playerid, 5);
	RemovePlayerAttachedObject(playerid, 6);
	RemovePlayerAttachedObject(playerid, 7);
	RemovePlayerAttachedObject(playerid, 8);
    RemovePlayerAttachedObject(playerid, 9);
	RemovePlayerAttachedObject(playerid, 10);
    GameTextForPlayer(playerid, "~w~Acessorios ~r~Removidos", 3000, 4);
    SCM(playerid, -1, "{FFFFFF}Voce retirou todos os objetos do seu personagem");
    return 1;
}
CMD:rtaccsadm(playerid)
