stock GetWeaponNameEx(id, name[], len) return format(name,len, "%s", GunNames[id]);
stock CarregaCarro(playerid)
{
    new File[5000];
    format(File, sizeof(File), PASTA_CONCESSIONARIA, PlayerName(playerid));
    if(DOF2_FileExists(File))
    {
        IfCarro[playerid][Cor] = DOF2_GetInt(File, "Cor");
        IfCarro[playerid][Nitro] = DOF2_GetInt(File, "Nitro");
        IfCarro[playerid][Hidraulica] = DOF2_GetInt(File, "Hidraulica");
        IfCarro[playerid][Roda] = DOF2_GetInt(File, "Roda");
        IfCarro[playerid][Spoiler] = DOF2_GetInt(File, "Spoiler");
        IfCarro[playerid][Placa] = DOF2_GetInt(File, "Placa");
        IfCarro[playerid][ArmaM4] = DOF2_GetInt(File, "ArmaM4");
        IfCarro[playerid][MunM4] = DOF2_GetInt(File, "MunM4");
        IfCarro[playerid][ArmaMP5] = DOF2_GetInt(File, "ArmaMP5");
        IfCarro[playerid][MunMP5] = DOF2_GetInt(File, "MunMP5");
        IfCarro[playerid][ArmaDesert] = DOF2_GetInt(File, "ArmaDesert");
        IfCarro[playerid][MunDesert] = DOF2_GetInt(File, "MunDesert");
        IfCarro[playerid][Shotgun] = DOF2_GetInt(File, "Shotgun");
        IfCarro[playerid][MunShot] = DOF2_GetInt(File, "MunShot");
        IfCarro[playerid][ArmaAk] = DOF2_GetInt(File, "ArmaAk");
        IfCarro[playerid][MunAk] = DOF2_GetInt(File, "MunAk");
        IfCarro[playerid][GasVeh] = DOF2_GetInt(File, "GasVeh");
        IfCarro[playerid][TemPlaca] = DOF2_GetInt(File, "TemPlaca");
        IfCarro[playerid][VehAp] = DOF2_GetInt(File, "VehAp");
        IfCarro[playerid][TemCarro] = DOF2_GetInt(File, "TemCarro");
    }
    else
    {
        DOF2_CreateFile(File);
        DOF2_SetInt(File, "Cor", 0);
        DOF2_SetInt(File, "Nitro", 0);
        DOF2_SetInt(File, "Hidraulica", 0);
        DOF2_SetInt(File, "Roda", 0);
        DOF2_SetInt(File, "Spoiler", 0);
        DOF2_SetInt(File, "Placa", 0);
        DOF2_SetInt(File, "ArmaM4", 0);
        DOF2_SetInt(File, "MunM4", 0);
        DOF2_SetInt(File, "ArmaMP5", 0);
        DOF2_SetInt(File, "MunMP5", 0);
        DOF2_SetInt(File, "ArmaDesert", 0);
        DOF2_SetInt(File, "MunDesert", 0);
        DOF2_SetInt(File, "Shotgun", 0);
        DOF2_SetInt(File, "MunShot", 0);
        DOF2_SetInt(File, "ArmaAk", 0);
        DOF2_SetInt(File, "MunAk", 0);
        DOF2_SetInt(File, "GasVeh", 0);
        DOF2_SetFloat(File, "VidaC", 00.00);
        DOF2_SetInt(File, "TemPlaca", 0);
        DOF2_SetInt(File, "VehAp", 0);
        DOF2_SetInt(File, "TemCarro", 0);
        DOF2_SaveFile();
    }
    return 1;
}
stock SalvarVeiculo(playerid)
{
	if(Pp[playerid][Logado] == true)
	{
	    new File[5000];
	    format(File, sizeof(File), PASTA_CONCESSIONARIA, PlayerName(playerid));
