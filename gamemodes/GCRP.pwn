CMD:girof(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(IsPolicial(playerid))
    {
        if(!IsPlayerInAnyVehicle(playerid))
    	{
    		return SCM(playerid, -16776961, "{FFD700}INFO: {FFFFFF}Voce nao esta em um veiculo!");
    	}
    	if(2 != GetPlayerState(playerid))
    	{
    		return SCM(playerid, -16776961, "{FFD700}INFO: {FFFFFF}Voce nao esta dirigindo");
    	}
    	new var1[250];
    	strcat(var1, "{FF0000}Remover{FFFFFF} Giro-Flex\n", 250);
    	strcat(var1, "{FF7F50}>> {FFFFFF}Colocar Giro-Flex (1) : Teto\n", 250);
    	strcat(var1, "{FF7F50}>> {FFFFFF}Colocar Giro-Flex (2) : Painel\n", 250);
    	strcat(var1, "{FF7F50}>> {FFFFFF}Colocar Giro-Flex (3) : Teto\n", 250);
    	strcat(var1, "{FF7F50}>> {FFFFFF}Colocar Giro-Flex (4) : Teto\n", 250);
    	ShowPlayerDialog(playerid, DIALOG_GIROF, 2, "GiroFlex -", var1, "Selecionar", "X");
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Policial");
    }
	return 1;
}
CMD:dcasap(playerid, params[])
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(Pp[playerid][Admin] >= 1)
	{
		new id;
		if(sscanf(params, "i", id))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /dcasap [IDF]");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
                    if(Pp[i][Casa] >= 0)
                    {
                        SCM(playerid, -1, "{FFFFFF}Voce deletou uma Casa de um Jogador");
                        SCM(i, -1, "{FFFFFF}Um Admin deletou sua Casa");
                        GameTextForPlayer(i, "~w~Casa ~r~Deletada", 1200, 4);
                        GameTextForPlayer(playerid, "~w~Casa do Jogador ~n~ Foi ~g~Deletada", 1200, 4);
                        Pp[i][Casa] = -1;
                    }
                }
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este Comando.");
    }
    return 1;
}
CMD:dempp(playerid, params[])
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(Pp[playerid][Admin] >= 1)
	{
		new id;
		if(sscanf(params, "i", id))
		{
			return SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Use: /dempp [IDF]");
		}
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(Pp[i][Logado] == true)
			{
			    if(Pp[i][IDF] == id)
			    {
                    if(Pp[i][Empresa] >= 0)
                    {
                        SCM(playerid, -1, "{FFFFFF}Voce deletou uma empresa de um Jogador");
                        SCM(i, -1, "{FFFFFF}Um Admin deletou sua empresa");
                        GameTextForPlayer(i, "~w~Empresa ~r~Deletada", 1200, 4);
                        GameTextForPlayer(playerid, "~w~Empresa do Jogador ~n~ Foi ~g~Deletada", 1200, 4);
                        Pp[i][Empresa] = -1;
                    }
                }
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este Comando.");
    }
    return 1;
}
CMD:carrodono(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(Pp[playerid][Admin] >= 6)
    {
        new Float:Pos[3];
        GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
        if(AcessouMenuCar[playerid] == 0)
        {
            if(GetPlayerInterior(playerid) == 0)
            {
                CarroEvento[playerid] = CreateVehicle(411, Pos[0], Pos[1], Pos[2], 90, 2, 2, false);
                PutPlayerInVehicle(playerid, CarroEvento[playerid], 0);
                cmd_trancar(playerid);
                AcessouMenuCar[playerid] = 1;
                GameTextForPlayer(playerid, "~w~Veiculo ~g~Spawnado!", 3000, 3);
                new string[1200];
	            format(string, sizeof(string), "* O ID:[%d]: Spawnou seu Veiculo", Pp[playerid][IDF]);
                ProxDetector(20.0, playerid, string, COR_PURPLE, COR_PURPLE, COR_PURPLE,COR_PURPLE,COR_PURPLE);
            }
        }
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
    }
    return 1;
}
CMD:gcarro(playerid)
{
    if(Pp[playerid][Logado] == false)return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta Logado.");
    if(AcessouMenuCarInv[playerid] == 1)
    {
        new carid = GetVehicleModel(CarroEventoIV[playerid]);
        if(Slots[playerid][idslotiv[playerid]] == 999999)
        {
            	Slots[playerid][idslotiv[playerid]] = carid;
                PlayerTextDrawSetPreviewModel(playerid, InvCarTDP[playerid][idslotiv[playerid]], Slots[playerid][idslotiv[playerid]]);
                return 1;
        }
        idslotiv[playerid] = 0;
        CarroTrank[CarroEventoIV[playerid]] = 0;
        CarroInfo[CarroEventoIV[playerid]][ChaveCarro] = 0;
        AcessouMenuCarInv[playerid] = 0;
        DestroyVehicle(CarroEventoIV[playerid]);
        SalvarInvCars(playerid);
        SCM(playerid, -1, "{FFFFFF}Veiculo Deletado..");
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao spawnou seu veiculo de inv");
    }
    return 1;
}
CMD:neon(playerid)
{
    if(Pp[playerid][Vip] >= 1 || Pp[playerid][Socio] >= 1 || Pp[playerid][Patrocinador] >= 1)
    {
    	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao esta em um Veiculo!");
    	ShowPlayerDialog(playerid, DIALOG_NEON, DIALOG_STYLE_LIST, "{FFFFFF}Nenon {FFDC33}Vip-GCRP", "{4876FF}Azul\n{FF230A}Vermelho\n{00FF00}Verde\n{FFFFFF}Branco\n{FF00FF}Rosa\n{FFFF00}Amarelo\n{8B7D7B}Remover Neon", "Selecionar", "Cancelar");
    }
    else
    {
        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao e um Vip, Patrocinador e nem Socio");
    }
    return 1;
}
