    		TextoArma[f] = CreateDynamic3DTextLabel(string, -1, ObjCoords[f][0],ObjCoords[f][1],ObjCoords[f][2]-1, 15.0);
    	}
    }
    else if(IsPolicial(playerid))
    {
    	new gunID = GetPlayerWeapon(playerid);
    	new gunAmmo = GetPlayerAmmo(playerid);
    	if(gunID != 0 && gunAmmo != 0)
    	{
    		new f = MAX_ARMAS+1;
    		for(new a = 0; a < sizeof(ObjCoords); a++)
    		{
    			if(ObjCoords[a][0] == 0.0)
    			{
    				f = a;
    				break;
    			}
    		}
      		ObjectID[f][0] = gunID;
    		ObjectID[f][1] = gunAmmo;
     		GetPlayerPos(playerid, ObjCoords[f][0], ObjCoords[f][1], ObjCoords[f][2]);
     		Object[f] = CreateDynamicObject(GunObjects[gunID][0],ObjCoords[f][0],ObjCoords[f][1],ObjCoords[f][2]-1,93.7,120.0,120.0);
     		new gunname[25];
       	    GetWeaponNameEx(gunID, gunname, sizeof(gunname));
     		new string[450];
    		format(string, sizeof(string), "{FFFFFF}(%s)\n/pegararma", gunname);
    		TextoArma[f] = CreateDynamic3DTextLabel(string, -1, ObjCoords[f][0],ObjCoords[f][1],ObjCoords[f][2]-1, 15.0);
    	}
    }
    if(Ativado[playerid] == 1)
	{
	    Ativado[playerid] = 0;
	    KillTimer(TempoAutoReparar[playerid]);
	}
    if(AtivadoC[playerid] == 1)
	{
	    AtivadoC[playerid] = 0;
	    KillTimer(TempoCamaleao[playerid]);
	}
	return 1;
}

public OnVehicleSpawn(vehicleid)
{
    new engine, lights, alarm, doors, bonnet, boot, objective, placa = random(99999);
	GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
	SetVehicleParamsEx(vehicleid, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective);
    DestroyObject(ObjGiroF[vehicleid]);
	GiroFV[vehicleid] = 0;
    CorpoMV[vehicleid] = 0;
    ProdutosVeh[vehicleid] = 0;
    DrugsVeh[vehicleid] = 0;
	PlacaVeiculoGCRP[vehicleid] = placa;
	motor[vehicleid] = false;
	Combustivel[vehicleid] = 60;
	PassageirosMt[vehicleid] = 0;
    PassageirosMaq[vehicleid] = 0;
    MalotesCr[vehicleid] = 0;
    CaminhaoGASA[vehicleid] = 0;
    ProdutosCA[vehicleid] = 0;
    CarroTrank[vehicleid] = 0;
    CarroInfo[vehicleid][ChaveCarro] = 0;
	return 1;
}

public OnVehicleDeath(vehicleid, killerid)
{
    if(GiroFV[vehicleid] >= 1)
	{
        DestroyObject(ObjGiroF[vehicleid]);
		GiroFV[vehicleid] = 0;
    }
    CorpoMV[vehicleid] = 0;
    ProdutosVeh[vehicleid] = 0;
    motor[vehicleid] = false;
    PassageirosMaq[vehicleid] = 0;
    ProdutosCA[vehicleid] = 0;
    MalotesCr[vehicleid] = 0;
    CaminhaoGASA[vehicleid] = 0;
    CarroTrank[vehicleid] = 0;
    DrugsVeh[vehicleid] = 0;
    PassageirosMt[vehicleid] = 0;
    CarroInfo[vehicleid][ChaveCarro] = 0;
    return 1;
}

public OnPlayerText(playerid, text[])
{
	new string[50000];
	if(floodChat[playerid] > gettime())
	{
		if(Pp[playerid][Admin] == 0)
		{
			SCM(playerid, COR_VERMELHO, "{FFD700}AntFlood: {FFFFFF}Pare de Floodar mensagems e proibido.");
			return 0;
		}
	}
	floodChat[playerid] = gettime() + 3;
	if(strlen(text) == strlen(digitouChat[playerid]) && !strcmp(digitouChat[playerid], text, false))
	{

		SCM(playerid, COR_VERMELHO, "{FFD700}AntFlood: {FFFFFF}Nao repita a mesma mensagem.");
		floodChat[playerid] = gettime();
		return 0;
	}
	if(Pp[playerid][Logado] == false)
	{
		SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao esta logado.");
		return 0;
	}
	if(Pp[playerid][Ferido] == true)
	{
		SCM(playerid, COR_VERMELHO, "{FFD700}INFO: {FFFFFF}Voce nao pode falar no chat morto.");
		return 0;
	}
    if(RPChat)
	{
      	new Float:chatX, Float:chatY, Float:chatZ;
		GetPlayerPos(playerid, chatX, chatY, chatZ);
  		for(new i; i < MAX_PLAYERS; i++)
		{
			if(IsPlayerInRangeOfPoint(i, 10.0, chatX, chatY, chatZ))
			{
				if(GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(i))
				{
				    if(UsouMascara[playerid] == 0)
   					{
                        if(Pp[playerid][Admin] == 0)
                        {
                            format(string, 5000, "{C0C0C0}* [%d] diz: {FFFFFF}%s",Pp[playerid][IDF], text);
    	  					SendClientMessage(i, -1, string);
                        }
                        else if(Pp[playerid][Admin] >= 1)
                        {
                            if(Trabalhando[playerid] == false)
                            {
                                format(string, 5000, "{C0C0C0}* [%d] diz: {FFFFFF}%s",Pp[playerid][IDF], text);
            	  				SendClientMessage(i, -1, string);
                            }
                            else if(Trabalhando[playerid] == true)
                            {
                                format(string, 5000, "{C0C0C0}* [%d][{FFD700}%s{C0C0C0}] diz: {FFFFFF}%s", Pp[playerid][IDF], NomeAdm(Pp[playerid][Admin]), text);
    	  					    SendClientMessage(i, -1, string);
                            }
                        }
					}
					else
					{
					    format(string, 5000, "{C0C0C0}* [Local]: [{FFD700}Capuz{808080}] diz: {FFFFFF}%s", text);
				    	SendClientMessage(i, -1, string);
					}
				}
			}
            else if(IsPlayerInRangeOfPoint(i, 15.0, chatX, chatY, chatZ))
			{
				if(GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(i))
				{
				    if(UsouMascara[playerid] == 0)
   					{
                        if(Pp[playerid][Admin] == 0)
                        {
                            format(string, 5000, "{A9A9A9}* [%d] diz: {FFFFFF}%s",Pp[playerid][IDF], text);
    	  					SendClientMessage(i, -1, string);
                        }
                        else if(Pp[playerid][Admin] >= 1)
                        {
                            if(Trabalhando[playerid] == false)
                            {
                                format(string, 5000, "{A9A9A9}* [%d] diz: {FFFFFF}%s",Pp[playerid][IDF], text);
            	  				SendClientMessage(i, -1, string);
                            }
                            else if(Trabalhando[playerid] == true)
                            {
                                format(string, 5000, "{A9A9A9}* [%d][{FFD700}%s{A9A9A9}] diz: {FFFFFF}%s", Pp[playerid][IDF], NomeAdm(Pp[playerid][Admin]), text);
    	  					    SendClientMessage(i, -1, string);
                            }
                        }
					}
					else
					{
					    format(string, 5000, "{C0C0C0}* [Local]: [{FFD700}Capuz{808080}] diz: {FFFFFF}%s", text);
				    	SendClientMessage(i, -1, string);
					}
				}
			}
            else if(IsPlayerInRangeOfPoint(i, 20.0, chatX, chatY, chatZ))
			{
				if(GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(i))
				{
				    if(UsouMascara[playerid] == 0)
   					{
                        if(Pp[playerid][Admin] == 0)
                        {
                            format(string, 5000, "{808080}* [%d] diz: {FFFFFF}%s",Pp[playerid][IDF], text);
        	  				SendClientMessage(i, -1, string);
                        }
                        else if(Pp[playerid][Admin] >= 1)
                        {
                            if(Trabalhando[playerid] == false)
                            {
                                format(string, 5000, "{808080}* [%d] diz: {FFFFFF}%s",Pp[playerid][IDF], text);
            	  				SendClientMessage(i, -1, string);
                            }
                            else if(Trabalhando[playerid] == true)
                            {
                                format(string, 5000, "{808080}* [%d][{FFD700}%s{808080}] diz: {FFFFFF}%s", Pp[playerid][IDF], NomeAdm(Pp[playerid][Admin]), text);
    	  					    SendClientMessage(i, -1, string);
                            }
                        }
					}
					else
					{
					    format(string, 5000, "{C0C0C0}* [Local]: [{FFD700}Capuz{808080}] diz: {FFFFFF}%s", text);
				    	SendClientMessage(i, -1, string);
					}
				}
			}
            SetPlayerChatBubble(playerid, text, COR_PURPLE, 20.0, 10000);
		}
		return 0;
	}
	return 1;
}

