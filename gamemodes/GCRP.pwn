CMD:cbraco(playerid, params[])
{
	new braco, string[450];
	if(sscanf(params, "i", braco)) return SCM(playerid, COR_VERMELHO,"{FFD700}INFO: {FFFFFF}Use: /cbraco [1~4]");
	{
		if(braco > 10)return SCM(playerid,COR_VERMELHO,"{FFD700}INFO: {FFFFFF}Use: /cbraco [1~4]");
		{
			switch(braco)
			{
		        case 1:ApplyAnimation(playerid,"OTB","wtchrace_in",4.1,0,1,1,1,1);
			    case 2:ApplyAnimation(playerid, "COP_AMBIENT", "Coplook_loop", 4.0, 0, 1, 1, 1, -1);
			    case 3:ApplyAnimation(playerid, "DEALER", "DEALER_IDLE", 4.0, 0, 1, 1, 1, -1);
			    case 4:ApplyAnimation(playerid, "DEALER", "DEALER_IDLE_01", 4.0, 0, 1, 1, 1, -1);
			}
			format(string, sizeof(string), "* O ID [%d] Cruzou Os Bracos!", Pp[playerid][IDF]);
   			ProxDetector(5.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
   			SCM(playerid,COR_VERMELHO,"{FFFFFF}Para Parar a Animacao Use: /anim");
   		}
   	}
    return 1;
}
