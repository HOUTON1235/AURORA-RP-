CarregarPort()
{
    for(new x; x != MAX_PORTAO; x++)
	{

	    InfoPortao[x][Cria] = false;

		static
			 fepp[128],
			 st[128+MAX_PLAYER_NAME];

		format(fepp, sizeof(fepp), PASTA_PORTOES, x);
		if(DOF2_FileExists(fepp))
		{
            InfoPortao[x][Cria] = true;
 		    InfoPortao[x][XP] = DOF2_GetFloat(fepp, "X");
 		    InfoPortao[x][YP] = DOF2_GetFloat(fepp, "Y");
 		    InfoPortao[x][ZP] = DOF2_GetFloat(fepp, "Z");
 		    InfoPortao[x][RXP] = DOF2_GetFloat(fepp, "RX");
 		    InfoPortao[x][RYP] = DOF2_GetFloat(fepp, "RY");
 		    InfoPortao[x][RZP] = DOF2_GetFloat(fepp, "RZ");
 		    format(InfoPortao[x][Donop], 24, DOF2_GetString(fepp, "Dono"));
 		    format(InfoPortao[x][Senha], 128, DOF2_GetString(fepp, "Senha"));
 		    InfoPortao[x][porT]  =  CreateDynamicObject(980,
			 											InfoPortao[x][XP],
													    InfoPortao[x][YP],
														InfoPortao[x][ZP],
														InfoPortao[x][RXP],
														InfoPortao[x][RYP],
														InfoPortao[x][RZP]);
	   		format(st, sizeof(st), "{FF8C00}Portao ID: {FFFFFF}%d\nUse: '/abpt'",x);
	   		InfoPortao[x][PortLabel]= CreateDynamic3DTextLabel(st, -1, 			 											InfoPortao[x][XP],
													    InfoPortao[x][YP],
														InfoPortao[x][ZP],
													    15.0);
            InfoPortao[x][Cria] = true;
		}
	}
}

CriarPt(Float: X, Float: Y, Float: Z, Float: RX, Float: RY, Float: RZ, const Seinha[], const Nego[])
{
	for(new p; p != MAX_PORTAO; p++)
	{
		if(!InfoPortao[p][Cria])
 		{
 		    static st[105+MAX_PLAYER_NAME];
 		    InfoPortao[p][Cria] = true;
 		    InfoPortao[p][XP] = X;
 		    InfoPortao[p][YP] = Y;
 		    InfoPortao[p][ZP] = Z;
 		    InfoPortao[p][RXP] = X;
 		    InfoPortao[p][RYP] = Y;
 		    InfoPortao[p][RZP] = Z;
 		    format(InfoPortao[p][Donop], MAX_PLAYER_NAME, Nego);
 		    format(InfoPortao[p][Senha], 90, Seinha);
 		    InfoPortao[p][porT] = CreateDynamicObject(980, X, Y, Z, RX, RY, RZ);
 		    format(st, sizeof(st), "{FF8C00}Portao ID: {FFFFFF}%d\nUse: '/abpt'",p);
 		    InfoPortao[p][PortLabel] = CreateDynamic3DTextLabel(st, -1, X,Y,Z, 15.0);
 		    return p;
		}
	}
	return -1;
}

