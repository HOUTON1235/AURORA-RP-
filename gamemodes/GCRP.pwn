CMD:ip(playerid,params[])
{
	new id, string[450], ip[25], StringContas[5000], car[MAX_PLAYER_NAME];
    GetPlayerName(playerid, car, sizeof(car));
	if(!strcmp(car,"Scoffield_K", false))
	{
		if(sscanf(params, "i", id)) return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /ip [IDF]");
		{
   			for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
						GetPlayerIp(i,ip,sizeof(ip));
						format(string, sizeof(string), "IPCmd: Ip do Player: %s[%d] foi Anotado Como: [ %s ]", PlayerName(i), Pp[i][IDF], ip);
						SCM(playerid, COLOR_LIGHTRED, string);
						format(StringContas,sizeof(StringContas),"IpsSalvos/%s.ini",ip);
      					DOF2_CreateFile(StringContas);
	     				DOF2_SetString(StringContas,"NomeP",PlayerName(i));
		        		DOF2_SetString(StringContas,"Ip",ip);
				        DOF2_SaveFile();
					}
				}
			}
			return 1;
		}
	}
	if(!strcmp(car,"Gabriel_Gaspar", false))
	{
		if(sscanf(params, "i", id)) return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /ip [IDF]");
		{
   			for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
						GetPlayerIp(i,ip,sizeof(ip));
						format(string, sizeof(string), "IPCmd: Ip do Player: %s[%d] foi Anotado Como: [ %s ]", PlayerName(i), Pp[i][IDF], ip);
						SCM(playerid, COLOR_LIGHTRED, string);
						format(StringContas,sizeof(StringContas),"IpsSalvos/%s.ini",ip);
      					DOF2_CreateFile(StringContas);
	     				DOF2_SetString(StringContas,"NomeP",PlayerName(i));
		        		DOF2_SetString(StringContas,"Ip",ip);
				        DOF2_SaveFile();
					}
				}
			}
			return 1;
		}
	}
	return 1;
}
CMD:deletarconta(playerid, params[])
{
	if(Pp[playerid][Admin] >= 4)
	{
    	new Nick[90 + 1], string[15000];
    	if(sscanf(params, "s[90]", Nick)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /deletarconta [Nome]");
    	format(string, sizeof(string), PASTA_CONTAS, Nick);
    	if(DOF2_FileExists(string))
		{
		    DOF2_RemoveFile(string);
		    SendClientMessageEx(playerid, -1, "{FFFFFF}Conta Nick: %s Foi Deletada Com Sucesso.", Nick);
		    return 1;
		}
		else
		{
		    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Este Nick nao esta Registrado ou voce digitou errado!");
		    return 1;
		}
	}
	else
	{
	    SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	}
    return 1;
}

CMD:deslogartodos(playerid, params[])
{
	new motivo[30 + 1], String[220];
    if(Pp[playerid][Admin] < 1) return false;
    if(sscanf(params, "s[30]", motivo)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /deslogartodos [MOTIVO]");

    for(new i; i < MAX_PLAYERS; i++)
    {
        format(String,sizeof(String),"Closed: Voce foi kickado do servidor pelo motivo: %s",motivo);
		SCM(i, COLOR_LIGHTRED,String);

		format(String,sizeof(String),"password %s",motivo);
		SendRconCommand(String);

        GameTextForPlayer(i, "~w~Todos do Servidor ~n~ ~w~Foram ~r~Kickados", 10000, 3);

        new strmoch[5000];
        format(strmoch, sizeof(strmoch),"{FFDC33}: {FFFFFF}Voce foi Deslogado Pelo Admin: {FFDC33}%s\n{FFDC33}: {FFFFFF}Pelo Motivo: {FFDC33}%s\n\n{FFFFFF}Volte em Breve..", PlayerName(playerid), motivo);
        ShowPlayerDialog(i, 5000, DIALOG_STYLE_MSGBOX, "{FFFFFF}Status do {FFDC33}Deslogamento", strmoch, "Ok", "");
        SetTimerEx("KickPlayer", 500, false, "i", i);
    }
	return 1;
}

CMD:explodir(playerid,params[])
{
	new id, string[450];
	if(Pp[playerid][Admin] >= 4)
	{
		if(sscanf(params, "i", id)) return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /explodir [IDF]");
		{
   			for(new i; i < MAX_PLAYERS; i++)
			{
				if(Pp[i][Logado] == true)
				{
				    if(Pp[i][IDF] == id)
				    {
				        if(id == Pp[playerid][IDF])
				        {
							SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Explodir");
				        }
				        format(string, sizeof(string), "O Jogador %s foi Explodido Pelo Admin %s",PlayerName(i), PlayerName(playerid));
						SendClientMessageToAll(COLOR_LIGHTRED,string);
						SetPlayerHealth(i, 10);
						new Float:boomx, Float:boomy, Float:boomz;
						GetPlayerPos(i,boomx, boomy, boomz);
						CreateExplosion(boomx, boomy , boomz, 7, 10);
					}
				}
			}
			return 1;
		}
	}
	else
	{
	    SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Voce nao esta autorizado a usar este comando");
	}
	return 1;
}
