CMD:ban(playerid, params[])
{
	new id, motivo[30 + 1], String[220];
    if(Pp[playerid][Admin] < 3) return false;
    if(sscanf(params, "ds[30]", id, motivo)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /ban [IDF] [MOTIVO]");

    for(new i; i < MAX_PLAYERS; i++) {
		if(Pp[i][Logado] == false) continue;
		if(Pp[i][IDF] != id) continue;
		if(id == Pp[playerid][IDF]) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se banir!");
        if(Pp[playerid][Admin] < 6)
        {
            if(Pp[i][Admin] >= 1)
            {
                SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode banir outro admin.");
            }
            else
            {
                new strmoch[5000], ip[128];
                format(arquivo,sizeof(arquivo),"Banidos/%s.ini",PlayerName(i));
        		DOF2_CreateFile(arquivo);
        		DOF2_SetString(arquivo,"Admin",PlayerName(playerid));
        		DOF2_SetString(arquivo,"Motivo",motivo);
        		DOF2_SaveFile();
        		format(String,sizeof(String),"[INFO] O Admin: %s[%d] baniu o jogador: %s[%d] pelo motivo: %s",PlayerName(playerid), Pp[playerid][IDF], PlayerName(i), Pp[i][IDF], motivo);
        		SendClientMessageToAll(COLOR_LIGHTRED,String);

        		format(strmoch, sizeof(strmoch),"{FFFFFF}Voce foi Banido Pelo Admin: {FFD700}%s\n{FFFFFF}Pelo Motivo: {FFD700}%s\n\n{FFFFFF}Tchau, e Parabens por Ter Sido Banido!!", PlayerName(playerid), motivo);
        		ShowPlayerDialog(i, 5000, DIALOG_STYLE_MSGBOX, "{FFFFFF}Status do {FFD700}Banimento", strmoch, "Ok", "");

        		GetPlayerIp(i,ip,128);
        		format(gstring, sizeof(gstring), "IP STAFF - O Ip Do Player Banido: %s e: %s", PlayerName(i),ip);
        		SCM(playerid, COLOR_LIGHTRED, gstring);
        		SetTimerEx("KickPlayer", 100, false, "i", i);
            }
        }
        else
        {
            new strmoch[5000], ip[128];
            format(arquivo,sizeof(arquivo),"Banidos/%s.ini",PlayerName(i));
        	DOF2_CreateFile(arquivo);
        	DOF2_SetString(arquivo,"Admin",PlayerName(playerid));
        	DOF2_SetString(arquivo,"Motivo",motivo);
        	DOF2_SaveFile();
        	format(String,sizeof(String),"[INFO] O Admin: %s[%d] baniu o jogador: %s[%d] pelo motivo: %s",PlayerName(playerid), Pp[playerid][IDF], PlayerName(i), Pp[i][IDF], motivo);
        	SendClientMessageToAll(COLOR_LIGHTRED,String);

        	format(strmoch, sizeof(strmoch),"{FFFFFF}Voce foi Banido Pelo Admin: {FFD700}%s\n{FFFFFF}Pelo Motivo: {FFD700}%s\n\n{FFFFFF}Tchau, e Parabens por Ter Sido Banido!!", PlayerName(playerid), motivo);
        	ShowPlayerDialog(i, 5000, DIALOG_STYLE_MSGBOX, "{FFFFFF}Status do {FFD700}Banimento", strmoch, "Ok", "");

        	GetPlayerIp(i,ip,128);
        	format(gstring, sizeof(gstring), "IP STAFF - O Ip Do Player Banido: %s e: %s", PlayerName(i),ip);
        	SCM(playerid, COLOR_LIGHTRED, gstring);
        	SetTimerEx("KickPlayer", 100, false, "i", i);
        }
    	return 1;
    }
	return 1;
}

CMD:banip(playerid, params[])
{
	new id, motivo[30 + 1], String[220];
    if(Pp[playerid][Admin] < 3) return false;
    if(sscanf(params, "ds[30]", id, motivo)) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Use: /banip [IDF] [MOTIVO]");

    for(new i; i < MAX_PLAYERS; i++)
    {
		if(Pp[i][Logado] == true)
        {
		    if(Pp[i][IDF] == id)
            {
                if(id == Pp[playerid][IDF]) return SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se banir!");
                if(Pp[playerid][Admin] < 6)
                {
                    if(Pp[i][Admin] >= 1)
                    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode banir o ip outro admin.");
                    }
                    else
                    {
                        new strmoch[5000], ip[128];
                        GetPlayerIp(i,ip,128);
                		format(String,sizeof(String),"BanidosIp/%s.ini",ip);
                		DOF2_CreateFile(String);
                		DOF2_SetString(String,"Nome",PlayerName(i));
                		DOF2_SetString(String,"Admin",PlayerName(playerid));
                		DOF2_SetString(String,"Motivo",motivo);
                		DOF2_SaveFile();

                		format(String,sizeof(String),"[INFO] O Admin: %s[%d] baniu o IP do jogador: %s[%d] pelo motivo: %s",PlayerName(playerid), Pp[playerid][IDF], PlayerName(i), Pp[i][IDF], motivo);
                		SendClientMessageToAll(COLOR_LIGHTRED,String);

                		format(strmoch, sizeof(strmoch),"{FFFFFF}Voce foi Banido Pelo Admin: {FFD700}%s\n{FFFFFF}Pelo Motivo: {FFD700}%s\n\n{FFFFFF}Tchau, e Parabens por Ter Sido Banido!!", PlayerName(playerid), motivo);
                		ShowPlayerDialog(i, 5000, DIALOG_STYLE_MSGBOX, "{FFFFFF}Status do {FFD700}Banimento", strmoch, "Ok", "");

                        new str22[500];
                        format(str22, sizeof(str22), "%s", motivo);
                        BanEx(i,str22);

                		format(gstring, sizeof(gstring), "IP STAFF - O Ip Do Player Banido: %s e: %s", PlayerName(i),ip);
                		SCM(playerid, COLOR_LIGHTRED, gstring);
                		SetTimerEx("KickPlayer", 100, false, "i", i);
                    }
                }
                else
                {
                    new strmoch[5000], ip[128];
                    GetPlayerIp(i,ip,128);
                	format(String,sizeof(String),"BanidosIp/%s.ini",ip);
                	DOF2_CreateFile(String);
                	DOF2_SetString(String,"Nome",PlayerName(i));
                	DOF2_SetString(String,"Admin",PlayerName(playerid));
                	DOF2_SetString(String,"Motivo",motivo);
                	DOF2_SaveFile();

                	format(String,sizeof(String),"[INFO] O Admin: %s[%d] baniu o IP do jogador: %s[%d] pelo motivo: %s",PlayerName(playerid), Pp[playerid][IDF], PlayerName(i), Pp[i][IDF], motivo);
                	SendClientMessageToAll(COLOR_LIGHTRED,String);

                    new str22[500];
                    format(str22, sizeof(str22), "%s", motivo);
                    BanEx(i,str22);

                	format(strmoch, sizeof(strmoch),"{FFFFFF}Voce foi Banido Pelo Admin: {FFD700}%s\n{FFFFFF}Pelo Motivo: {FFD700}%s\n\n{FFFFFF}Tchau, e Parabens por Ter Sido Banido!!", PlayerName(playerid), motivo);
                	ShowPlayerDialog(i, 5000, DIALOG_STYLE_MSGBOX, "{FFFFFF}Status do {FFD700}Banimento", strmoch, "Ok", "");

                	format(gstring, sizeof(gstring), "IP STAFF - O Ip Do Player Banido: %s e: %s", PlayerName(i),ip);
                	SCM(playerid, COLOR_LIGHTRED, gstring);
                	SetTimerEx("KickPlayer", 100, false, "i", i);
                }
            }
        }
    }
	return 1;
}

CMD:baniptab(playerid,params[])
{
	new id, motivo[30 + 1], Ip[25], String[220], StringContas[5000];
	if(Pp[playerid][Admin] >= 5)
	{
		if(sscanf(params,"ds[30]",id,motivo))return SCM(playerid,-1,"{FFD700}INFO: {FFFFFF}Use: /baniptab [IDF] [MOTIVO]");
	    {
         	if(Pp[playerid][Logado] == true)
            {
                if(Banimentos[playerid] < 5)
				{
					if(id == playerid)
				    {
                        SCM(playerid, -1, "{FFD700}INFO: {FFFFFF}Voce nao pode se Banir!");
					    return 1;
					}
                    GetPlayerIp(id,Ip,sizeof(Ip));
        			format(StringContas,sizeof(StringContas),"BanidosIp/%s.ini",Ip);
        			DOF2_CreateFile(StringContas);
        			DOF2_SetString(StringContas,"Nome",PlayerName(id));
        			DOF2_SetString(StringContas,"Admin",PlayerName(playerid));
        			DOF2_SetString(StringContas,"Motivo",motivo);
        			DOF2_SaveFile();
        			format(String,sizeof(String),"[INFO] O Admin: %s(%d) baniu o IP do jogador: %s(%d) pelo motivo: %s",PlayerName(playerid), playerid, PlayerName(id), id, motivo);
        			SendClientMessageToAll(COLOR_LIGHTRED,String);
        			new strmoch[5000];
        			format(strmoch, sizeof(strmoch),"{FFFFFF}Voce foi Banido Pelo Admin: {FFD700}%s\n{FFFFFF}Pelo Motivo: {FFD700}%s\n\n{FFFFFF}Tchau, e Parabens por Ter Sido Banido!!", PlayerName(playerid), motivo);
        			ShowPlayerDialog(id, 5000, DIALOG_STYLE_MSGBOX, "{FFFFFF}Status do {FFD700}Banimento", strmoch, "Ok", "");
                    new str22[500];
                    format(str22, sizeof(str22), "%s", motivo);
                    BanEx(id,str22);
                    new ip[128];
        			GetPlayerIp(id,ip,128);
        			format(gstring, sizeof(gstring), "IP STAFF - O Ip Do Player Banido: %s e: %s", PlayerName(id),ip);
        			SCM(playerid, COLOR_LIGHTRED, gstring);
        			SetTimerEx("KickPlayer", 100, false, "i", id);
        			SetTimerEx("SairBanimentos", 180000, false, "i", playerid);
				}
			}
	    }
	}
	return 1;
}

